package components

import "strings"

// TransactionDocket renders one record as the kitchen docket (M6-03).
//
// 🔴 IT IS A DOCKET AND NOT A TABLE ROW. skill tappa-brand's "Yapma" list ends
// with "adisyon yerine düz tablo satırı", and its sketch of the motif is what this
// renders: venue and person top left, direction and time in mono, a line of
// evidence, the plaque's uid and counter, and the rubber stamp set at an angle in
// the corner.
//
//	┌─◠─◠─◠─◠─◠─◠─◠─◠─◠─◠─┐
//	│ KF ST JULIANS        │        ╭────────────╮
//	│ MARIA BORG           │        │ APPROVED   │
//	│ IN   14:03:22        │        ╰────────────╯
//	│ TRUST 100  IP ✓ GPS ✓│
//	│ TAG 91AC-7E55 #000641│
//	└─◡─◡─◡─◡─◡─◡─◡─◡─◡─◡─┘
//
// THE STAMP'S ANATOMY IS NOT TOUCHED. .stamp and its five modifiers were settled
// by measurement on 2026-08-01 — the word is ink, and the status colour moved into
// the border, the inset hairline it casts and a tenth-strength ground. The group-level
// transparency was dropped in the same change because it faded the only carrier of
// that colour. This component consumes those rules and adds nothing to them.
//
// ⚠️ THE UTILITIES ABOVE ARE DESCRIBED RATHER THAN NAMED, on purpose: Tailwind
// scans this file as raw text, so writing a utility name in a COMMENT compiles a
// rule nothing renders. Two names in this paragraph did exactly that and were
// measured out again.
//
// EVERY NUMBER IS MONO because .docket sets font-mono for its whole subtree; the
// docket feel comes from exactly that.
templ TransactionDocket(d DocketView) {
	<article class="docket">
		<div class="flex items-start justify-between gap-3">
			<div class="min-w-0">
				<p class="docket-label">Where</p>
				<p class="truncate font-display text-sm font-bold tracking-tight text-ink">{ docketVenue(d) }</p>
				if d.Department != "" {
					<p class="truncate text-xs text-ink/70">{ d.Department }</p>
				}
				<p class="mt-2 docket-label">Who</p>
				<p class="truncate font-display text-sm font-bold tracking-tight text-ink">{ docketWho(d) }</p>
			</div>
			<div class="shrink-0 text-right">
				@VerdictStamp(d.Verdict)
				if d.Practice {
					<p class="mt-2"><span class="stamp stamp--training">TRAINING</span></p>
				}
			</div>
		</div>
		// ONE COMPONENT AT EVERY WIDTH, NOT TWO COPIES (M12-11). Below the desk
		// breakpoint the docket is compact: the direction in a small ink box beside
		// the time, and the evidence folded into the foot line. From desk the four-cell
		// definition list below takes over and this row and the folded line are
		// hidden. Only the four short values are printed twice; the header, the
		// stamp, the plaque, the tallies and both notes exist once.
		<p class="mt-2 flex items-baseline gap-2 desk:hidden">
			<span class="border border-ink px-1.5 text-xs font-bold uppercase text-ink">{ docketDirection(d) }</span>
			<span class="text-lg text-ink">{ d.At }</span>
		</p>
		<dl class="mt-3 hidden gap-x-4 gap-y-1 desk:grid desk:grid-cols-4">
			<div>
				<dt class="docket-label">Direction</dt>
				<dd class="uppercase tracking-widest text-ink">{ docketDirection(d) }</dd>
			</div>
			<div>
				<dt class="docket-label">Time</dt>
				<dd class="text-ink">{ d.At }</dd>
			</div>
			if d.PartnerVenue {
				// M11 API-1c, K-39: a record at a partner business's venue was judged against
				// that business's network and coordinate, which are not this panel's to
				// describe -- the score and the signs are not shown, and the docket says so
				// rather than printing a value that would claim nothing was assessed.
				<div class="col-span-2">
					<dt class="docket-label">Trust · Evidence</dt>
					<dd class="text-ink/85">not shown at a partner venue</dd>
				</div>
			} else {
				<div>
					<dt class="docket-label">Trust</dt>
					<dd class="text-ink">{ docketTrust(d) }</dd>
				</div>
				<div>
					<dt class="docket-label">Evidence</dt>
					<dd class="text-ink">IP { d.IPSign } · GPS { d.GPSSign }</dd>
				</div>
			}
		</dl>
		<div class="mt-2 flex flex-wrap justify-between gap-x-3 gap-y-1 border-t border-dashed border-line pt-2 text-xs text-ink/85">
			// The folded evidence (below desk). On a partner row it is the K-39 phrase
			// alone: no score, no sign and no label for either.
			<span class="desk:hidden">
				if d.PartnerVenue {
					not shown at a partner venue
				} else {
					Trust { docketTrust(d) } · IP { d.IPSign } · GPS { d.GPSSign }
				}
			</span>
			<span>{ docketPlaque(d) }</span>
		</div>
		if d.Manual || d.Queued || d.Review != "" {
			<p class="mt-2 flex flex-wrap gap-2">
				if d.Manual {
					<span class="tally tally--manual">Entered by a manager</span>
				}
				// THE THREE STATES OF A REVIEW, and only one of them is ever printed.
				// "Waiting" is the ABSENCE of a decision, so it is gated on Review
				// being empty rather than on Queued alone: transactions is immutable,
				// so the queued column can never be cleared and a decided record would
				// otherwise go on claiming to be waiting forever.
				switch d.Review {
					case "approved":
						<span class="tally tally--approved">Approved by a manager</span>
					case "rejected":
						<span class="tally tally--rejected">Rejected by a manager</span>
					default:
						if d.Queued {
							<span class="tally tally--queued">Waiting for review</span>
						}
				}
			</p>
		}
		// THE ENGINE'S "WHY", AND WHOSE RULE PRODUCED IT.
		//
		// 🔴 THE LABEL IS PRINTED FOR THE TENANT'S OWN RULES ONLY, and the asymmetry
		// is the decision rather than an omission. An unlabelled note came from a
		// document we own, which is what decided every record in this database
		// today; labelling those too would put a line of chrome on every docket on
		// the page to say "normal". The label marks the case a manager may have to
		// chase somewhere else: the deciding statement sat on their own
		// organisation's policy document, so the rule behind the sentence is one
		// they can change.
		//
		// ⚠️ IT SAYS WHOSE RULE, NOT WHOSE WORDS, and an M8-04 round wrote the
		// opposite here. The sentence is ours on all three layers the column can
		// hold — policy_layer is a CHECK-constrained enum of guardrail, baseline
		// and tenant (migration 0008), the first two are this binary's and the
		// third is a scoped copy of a shipped statement. See
		// ledger.Record.NoteIsTenants for the write paths that make that so, and
		// for the note class this label does NOT catch.
		//
		// It reuses the treatment the manager's note already has one block down —
		// same label class, same tone, no new colour and no new token.
		if d.Note != "" {
			if d.NoteIsTenants {
				<p class="mt-2 docket-label">Your own policy rule</p>
				<p class="text-xs text-ink/85">{ d.Note }</p>
			} else {
				<p class="mt-2 text-xs text-ink/85">{ d.Note }</p>
			}
		}
		// THE MANAGER'S OWN SENTENCE, LABELLED, so it is never mistaken for the
		// engine's Note above it. One is what the RULE said; this is what a PERSON
		// said, and a card that ran them together would make the record look as
		// though the system had reasoned about a shift it knows nothing about.
		//
		// The tone is the one the line above already uses, so this adds no new
		// colour to the palette and nothing to the contrast surface.
		if d.ReviewNote != "" {
			<p class="mt-2 docket-label">Manager's note</p>
			<p class="text-xs text-ink/85">{ d.ReviewNote }</p>
		}
	</article>
}

// RailDocket renders one record as the compact docket hung on The Pass's rail
// (M12-11, README §5 "Rail docket"). It takes the same DocketView as
// TransactionDocket, so the words cannot drift between the two: the venue, the
// person, the direction and the time, the stamp, and a foot line with the score
// and the two signs.
//
// WHAT IT LEAVES OUT IS THE FULL DOCKET'S JOB, not a second rule about the
// record: the plaque and its counter, the department, the engine's note, and the
// manager's note and decision stay on the full docket (the day's ledger). What it may
// NOT leave out is anything that would make one record read as another, so:
//   - a partner row (K-39) prints "not shown at a partner venue" in the foot and
//     no score, no sign and no label for either -- the ledger has already blanked
//     them, and the docket says why instead of printing "none" and "n/a";
//   - a manual entry carries the same "Entered by a manager" tally as the full
//     docket, and a practice tap the TRAINING stamp, so the two stay apart (§5:
//     a manual entry is reported separately);
//   - a record with no venue or no person says so in words.
//
// The rail's tilt is not here: the list item the screen wraps this in is
// rotated by position from the stylesheet, never by a class built per item.
// Width is the list item's too. The docket keeps its sharp corners (D2).
templ RailDocket(d DocketView) {
	<article class="docket -mt-1 flex flex-col gap-2 pt-4 desk:pt-[18px]">
		<div class="flex flex-col items-start gap-2">
			<p class="max-w-full truncate docket-label">{ docketVenue(d) }</p>
			<p class="flex flex-wrap items-center gap-2 self-end">
				@VerdictStamp(d.Verdict)
				if d.Practice {
					<span class="stamp stamp--training">TRAINING</span>
				}
			</p>
		</div>
		<p class="truncate font-display text-[17px] font-bold tracking-tight text-ink desk:text-lg">{ docketWho(d) }</p>
		<p class="flex items-baseline gap-2.5">
			<span class="border border-ink px-1.5 text-xs font-bold uppercase text-ink">{ docketDirection(d) }</span>
			<span class="text-xl text-ink desk:text-[22px]">{ d.At }</span>
		</p>
		if d.Manual {
			<p><span class="tally tally--manual">Entered by a manager</span></p>
		}
		if d.PartnerVenue {
			<p class="border-t border-dashed border-line pt-2 text-[11px] text-ink/85">not shown at a partner venue</p>
		} else {
			<p class="flex flex-wrap justify-between gap-x-2 gap-y-0.5 border-t border-dashed border-line pt-2 text-[11px] text-ink/70">
				<span>Trust { docketTrust(d) }</span>
				<span>IP { d.IPSign } · GPS { d.GPSSign }</span>
			</p>
		}
	</article>
}

// The words both dockets print for the values a record may lack. They live in
// one place so the full docket and the rail docket cannot disagree about what an
// absent value is called; every one of them is a word, never a blank, because
// §4.6 writes a record even when almost nothing about it could be resolved.

// docketVenue is the venue's name, marked when it is a partner business's venue
// (ADR 0027): the name alone would read as one of this business's own.
func docketVenue(d DocketView) string {
	switch {
	case d.Venue == "":
		return "No location recorded"
	case d.PartnerVenue:
		return d.Venue + " · partner venue"
	default:
		return d.Venue
	}
}

func docketWho(d DocketView) string {
	if d.Who == "" {
		return "Nobody recognised"
	}
	return d.Who
}

func docketDirection(d DocketView) string {
	if d.Direction == "" {
		return "none"
	}
	return d.Direction
}

func docketTrust(d DocketView) string {
	if d.Trust == "" {
		return "none"
	}
	return d.Trust
}

// docketPlaque is the plaque line: the uid and the counter exactly as the
// handler formatted it -- unpadded, "#612" and not a six-digit field (D1).
func docketPlaque(d DocketView) string {
	switch {
	case d.TagUID == "":
		return "No plaque on this record"
	case d.Ctr == "":
		return "TAG " + d.TagUID
	default:
		return "TAG " + d.TagUID + " · #" + d.Ctr
	}
}

// VerdictStamp renders the rubber stamp for a verdict.
//
// THE WORD IS ALWAYS THERE, which is the accessibility half of the brand rule:
// status is never told by colour alone, so a stamp that lost its tint still says
// APPROVED. An unrecognised verdict renders NOTHING rather than a bare .stamp — a
// frame with no word in it would say only "something happened" — and the four
// words below are a CHECK-constrained closed set (migration 0005), so that branch
// is unreachable from the database.
templ VerdictStamp(verdict string) {
	switch verdict {
		case "ok":
			<span class="stamp stamp--approved">APPROVED</span>
		case "flag":
			<span class="stamp stamp--flagged">FLAGGED</span>
		case "reject":
			<span class="stamp stamp--rejected">REJECTED</span>
		case "ignored":
			<span class="stamp stamp--ignored">IGNORED</span>
	}
}

// SpikeDocket is the record a manager is deciding on The Spike (M12-28, README §5 "Docket",
// screens/spike-odd.md S.2 rows 9-22). It is a docket -- the motif, perforated on both edges,
// sharp corners (D2) -- and it is built from the same DocketView as the ledger's two dockets
// through SpikeFocus, so the evidence cannot read differently here and on The Pass.
//
// Top to bottom: the venue and the plaque's last four characters, the person, the direction
// with the date-ful time and the channel, and the engine's stamp; the evidence tiles; "Why it is
// here" -- the engine's own sentence (never board prose), labelled when the deciding rule is the
// business's own, and the rule and score in mono; then the children, which are the decision
// form's note field.
//
// 🔴 A PARTNER-VENUE RECORD (K-39) gets one merged tile for the network and the location and no
// rule-and-score line: the ledger has already blanked the score, the signs, the rule and the
// evidence sentence (nameSiteRecords), and this only declines to draw labels for values that are
// not there. PartnerVenueNote is the sentence it prints.
//
// The tile's mark is drawing that assistive technology does not read; the value word and the
// sentence under it carry the meaning, so a tone is never told by colour alone.
templ SpikeDocket(f SpikeFocusView) {
	<article class="docket flex flex-col gap-[18px] px-[18px] pt-[22px] pb-6 md:gap-5 md:p-6 desk:gap-[22px] desk:px-[30px] desk:pt-7 desk:pb-[30px]">
		<div class="flex items-start justify-between gap-2.5 md:gap-4">
			<div class="flex min-w-0 flex-col gap-1.5">
				<p class="lbl break-words">{ spikeLabel(f.Docket) }</p>
				<p class="break-words font-display text-[28px] font-bold leading-none tracking-[-0.03em] text-ink md:text-[30px] desk:text-[34px]">{ docketWho(f.Docket) }</p>
				<p class="text-sm text-ink desk:text-[15px]">{ spikeLine(f.Docket) }</p>
			</div>
			<p class="flex flex-none flex-col items-end gap-2 pt-1">
				@VerdictStamp(f.Docket.Verdict)
				if f.Docket.Practice {
					<span class="stamp stamp--training">TRAINING</span>
				}
			</p>
		</div>
		if f.Docket.Manual {
			<p><span class="tally tally--manual">Entered by a manager</span></p>
		}
		<div class="grid grid-cols-2 gap-2 md:gap-2.5 desk:grid-cols-[repeat(auto-fit,minmax(150px,1fr))]">
			for _, t := range f.Tiles {
				@evidenceTile(t)
			}
		</div>
		<div class="flex flex-col gap-1.5 border-t border-dashed border-line pt-3.5 md:pt-4">
			<p class="lbl">Why it is here</p>
			if f.Docket.NoteIsTenants {
				<p class="docket-label">Your own policy rule</p>
			}
			if f.Docket.Note != "" {
				<p class="font-display text-sm leading-normal text-ink md:text-[15px]">{ f.Docket.Note }</p>
			}
			if !f.Docket.PartnerVenue {
				<p class="text-xs text-ink/70">{ spikeRuleLine(f.Docket) }</p>
			}
		</div>
		{ children... }
	</article>
}

// evidenceTile is one tile of SpikeDocket. The frame's tone is chosen here, from literal class
// names, so the stylesheet keeps every one of them.
templ evidenceTile(t EvidenceTile) {
	<div class={ "ev-tile min-w-0", templ.KV("ev-tile--ok", t.Tone == toneOK), templ.KV("ev-tile--bad", t.Tone == toneBad), templ.KV("ev-tile--none", t.Tone != toneOK && t.Tone != toneBad) }>
		<p class="lbl">{ t.Label }</p>
		<p class="ev-tile-value flex min-w-0 items-center gap-2 break-words">
			<span class="ev-tile-mark" aria-hidden="true">{ evidenceMark(t.Tone) }</span>
			<span class="min-w-0">{ t.Value }</span>
		</p>
		if t.Sub != "" {
			<p class="ev-tile-sub font-display">{ t.Sub }</p>
		}
	</div>
}

func evidenceMark(tone string) string {
	switch tone {
	case toneOK:
		return "✓"
	case toneBad:
		return "✗"
	default:
		return "–"
	}
}

// SpikeQueueEntry is one record in The Spike's queue: a link that puts it in focus (selection is
// a link, not a script -- README §3.3), marked as the current one when it is. Name and when on
// the first line; venue, direction (desk only, as the boards draw it) and the short reason on
// the second. The when is the handler's ("today 14:26", "yesterday 02:14", "Mon 09:02").
templ SpikeQueueEntry(d DocketView, when, href string, current bool) {
	<a
		href={ templ.URL(href) }
		class={ "queue-item md:h-full md:min-h-14 md:w-[220px] desk:h-auto desk:min-h-11 desk:w-full", templ.KV("queue-item--current", current) }
		if current {
			aria-current="true"
		}
	>
		<span class="flex min-w-0 items-baseline justify-between gap-2">
			<span class="min-w-0 break-words font-display text-sm font-bold desk:text-[15px]">{ docketWho(d) }</span>
			<span class="flex-none whitespace-nowrap font-mono text-[11px] desk:text-xs">{ when }</span>
		</span>
		<span class="break-words font-mono text-[11px] text-ink/70 desk:text-xs">
			{ docketVenue(d) }
			<span class="hidden desk:inline">· { strings.ToUpper(docketDirection(d)) }</span>
			· { SpikeWhy(d) }
		</span>
	</a>
}
