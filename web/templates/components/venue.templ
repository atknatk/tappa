package components

import "strconv"

// The venue list and the venue it opens are venuedetail.templ (M12-34): VenueCard and
// VenueDetail replaced the venue and department dockets this file drew, so a venue's
// words exist in one place.

// VenueForm is the add/edit page for one venue (M12-35): four numbered sections in one
// form card, and beside it what a tap here can prove, the venue's departments and
// plaques, its external ref and its removal.
//
// 🔴 IT IS ONE FORM FOR BOTH ACTS. A hidden id decides which; empty means add. Two
// forms would mean two copies of eight fields, their labels and their sentences —
// the shape where one of them quietly gains a field the other never got.
//
// 🔴 EVERY FIELD THAT CHANGES A VERDICT CARRIES ITS RULE BESIDE IT, and that is the
// whole design of this card rather than decoration. Emptying the address list, or
// clearing the coordinate, or clearing the shift, are all silent, valid changes that
// alter how later taps are judged (CLAUDE.md §5). None of them errors, so the only
// place a manager can learn what they are doing is here, before they press Save. The
// sentences name the channel: for a plaque tap either half of the evidence is enough,
// a QR scan needs the network (base:qr-requires-ip) — and they say "under the standard
// rules" where a rule the business can change is meant.
//
// ACCESSIBILITY: every control has a <label for>, the error message is tied to its
// input with aria-describedby and marked aria-invalid, and each control reserves
// 44px of height — a manager checks this at the pass, on a phone, with one thumb. The
// section numbers are drawing and are not read.
templ VenueForm(v VenueFormView, side VenueFormSide) {
	<div class="panel-measure flex flex-col gap-6 desk:grid desk:grid-cols-[minmax(0,1fr)_340px] desk:items-start">
		<div class="flex min-w-0 flex-col gap-4">
			if v.ErrorMessage != "" && v.ErrorField == "" {
				@PanelNotice(ToneAlert, "Nothing was saved") {
					<p>{ v.ErrorMessage }</p>
				}
			}
			<form method="post" action={ templ.URL(Bound(ctx, v.Action)) } aria-label={ v.Heading } class="flex min-w-0 flex-col rounded-[18px] border border-line bg-paper px-4 pb-6 pt-1 md:px-7 md:pb-7 md:pt-2">
				if v.ID != "" {
					<input type="hidden" name="id" value={ v.ID }/>
				}
				@formSection("venue-s1", "01", "Name") {
					<div class="field-stack md:max-w-[420px]">
						<label class="lbl" for="venue-name">Name</label>
						<input
							class="field-input"
							id="venue-name"
							type="text"
							name="name"
							value={ v.Name }
							autocomplete="off"
							spellcheck="false"
							aria-invalid={ ariaInvalid(v.ErrorField, "name") }
							aria-describedby="venue-name-help"
						/>
						@fieldNote("venue-name-help", v.ErrorField, "name", v.ErrorMessage) {
							What your staff call this place.
						}
					</div>
				}
				@formSection("venue-s2", "02", "Where it is") {
					<p class="field-help -mt-1.5">Two ways Taptime checks a tap really happened here. For a plaque tap either one is enough; a QR scan needs the network.</p>
					<div class="field-stack">
						<label class="lbl" for="venue-ranges">Address ranges — one per line</label>
						// A TEXTAREA, ONE RANGE PER LINE. This section loads no script, so a
						// repeater with an add button is not available to it — and the trade is
						// stated in VenueFormView.Ranges rather than felt.
						<textarea
							class="field-input field-input--mono min-h-[92px] py-2.5 leading-relaxed"
							id="venue-ranges"
							name="static_ips"
							rows="3"
							autocomplete="off"
							spellcheck="false"
							aria-invalid={ ariaInvalid(v.ErrorField, "static_ips") }
							aria-describedby="venue-ranges-help"
						>{ v.Ranges }</textarea>
						// The parser's own sentence, verbatim, when the list was refused: the
						// bound is on the WHOLE list (a /7 of IPv4 or a /31 of IPv6 in all), so
						// no heading here names a per-line limit.
						@fieldNote("venue-ranges-help", v.ErrorField, "static_ips", v.ErrorMessage) {
							A range like 203.0.113.0/24, or a single address like 203.0.113.5; commas
							and spaces between them work too. This is how Taptime checks somebody is
							really at this venue.
							<strong class="font-bold text-ink">
								Leave it empty and plaque taps here are checked against GPS alone, and
								QR scans go to The Spike; with no coordinate either, every tap goes to
								The Spike.
							</strong>
						}
					</div>
					<div class="flex flex-wrap items-start gap-5">
						<div class="flex min-w-0 flex-[1_1_300px] flex-col gap-2.5">
							<div class="grid grid-cols-2 gap-3">
								<div class="field-stack">
									<label class="lbl" for="venue-lat">Latitude</label>
									<input
										class="field-input field-input--mono"
										id="venue-lat"
										type="text"
										inputmode="decimal"
										name="gps_lat"
										value={ v.GPSLat }
										autocomplete="off"
										aria-invalid={ ariaInvalid(v.ErrorField, "gps") }
										aria-describedby="venue-gps-help"
									/>
								</div>
								<div class="field-stack">
									<label class="lbl" for="venue-lng">Longitude</label>
									<input
										class="field-input field-input--mono"
										id="venue-lng"
										type="text"
										inputmode="decimal"
										name="gps_lng"
										value={ v.GPSLng }
										autocomplete="off"
										aria-invalid={ ariaInvalid(v.ErrorField, "gps") }
										aria-describedby="venue-gps-help"
									/>
								</div>
							</div>
							// §4.2: the position is read at the moment of the tap and at no other
							// time, and the radius is configuration (TAPPA_GPS_RADIUS_M) — the
							// figure comes from the panel's configuration, never a literal.
							@fieldNote("venue-gps-help", v.ErrorField, "gps", v.ErrorMessage) {
								A phone that shares its location at the moment of the tap counts as here
								when it is within { radiusPhrase(side.Radius) } of this point. The radius is
								set by Taptime, not per venue. Fill both or leave both empty — empty means
								this venue has no registered position, which is not the same as a position
								of zero. Taptime never reads location at any other time.
							}
						</div>
						if side.Radius != "" {
							@RadiusSchematic(side.Radius)
						}
					</div>
				}
				@formSection("venue-s3", "03", "Shift") {
					<p class="field-help -mt-1.5">Lateness is measured against the shift of the venue a person taps at, unless their department has its own.</p>
					@shiftFields("venue", v.ShiftStart, v.ShiftEnd, v.Overnight, v.ErrorField)
					@fieldNote("venue-shift-help", v.ErrorField, "shift", v.ErrorMessage) {
						Fill both or leave both empty —
						<strong class="font-bold text-ink">empty means lateness is not measured here</strong>,
						which is not the same as a shift starting at midnight. Tick "ends next day"
						for a shift that runs past midnight, like 18:00 to 02:00.
					}
					@ShiftBar(v.ShiftStart, v.ShiftEnd, v.Overnight)
				}
				@formSectionLast("venue-s4", "04", "Wi-Fi to show at activation") {
					<div class="field-stack md:max-w-[420px]">
						<label class="lbl" for="venue-wifi">Wi-Fi network name <span class="normal-case tracking-normal">(optional)</span></label>
						<input
							class="field-input field-input--mono"
							id="venue-wifi"
							type="text"
							name="wifi_ssid"
							value={ v.WiFiSSID }
							autocomplete="off"
							spellcheck="false"
							aria-invalid={ ariaInvalid(v.ErrorField, "wifi_ssid") }
							aria-describedby="venue-wifi-help"
						/>
						@fieldNote("venue-wifi-help", v.ErrorField, "wifi_ssid", v.ErrorMessage) {
							Shown to staff when they first set up their phone, so they know which
							network to join. It is not used to check anything — leave it empty if
							there is nothing to show.
						}
					</div>
				}
				<div class="flex flex-wrap gap-2.5 border-t border-line pt-[18px]">
					<button type="submit" class="btn btn--primary rounded-xl">{ v.Submit }</button>
					<a class="btn btn--line" href={ templ.URL(v.CloseHref) }>Cancel</a>
				</div>
			</form>
		</div>
		<div class="flex min-w-0 flex-col gap-4 md:grid md:grid-cols-2 md:items-start desk:flex desk:flex-col desk:items-stretch">
			if v.ID != "" && side.Saved {
				@proofDocket(side)
			}
			if v.ID != "" && side.Saved && (side.DepartmentCount > 0 || len(side.Departments) > 0) {
				@formDepartments(side)
			}
			if v.ID != "" && side.Saved && len(side.Plaques) > 0 {
				@formPlaques(side)
			}
			if v.ExternalRef != nil {
				// OUTSIDE the save form for Removal's reason, and its own route because
				// binding is an owner's act (M11 API-1).
				@venueRefForm(*v.ExternalRef)
			}
			if v.BusinessDay != nil {
				// OUTSIDE the save form too: its first press reviews the change (M15-07).
				@DayCutoffCard(*v.BusinessDay)
			}
			if v.Removal != nil {
				// OUTSIDE the save form: a nested form is invalid HTML and the browser
				// would drop one of them.
				@Removal(*v.Removal)
			}
		</div>
	</div>
}

// formSection is one numbered section of a form card, with a dashed rule under it.
templ formSection(id, number, heading string) {
	<section aria-labelledby={ id } class="flex gap-3 border-b border-dashed border-line py-[22px] md:gap-4">
		<span class="secno" aria-hidden="true">{ number }</span>
		<div class="flex min-w-0 flex-1 flex-col gap-3.5">
			<h2 id={ id } class="font-display text-lg font-bold tracking-tight md:text-xl">{ heading }</h2>
			{ children... }
		</div>
	</section>
}

// formSectionLast is the last section: the actions' rule closes it instead.
templ formSectionLast(id, number, heading string) {
	<section aria-labelledby={ id } class="flex gap-3 py-[22px] md:gap-4">
		<span class="secno" aria-hidden="true">{ number }</span>
		<div class="flex min-w-0 flex-1 flex-col gap-3.5">
			<h2 id={ id } class="font-display text-lg font-bold tracking-tight md:text-xl">{ heading }</h2>
			{ children... }
		</div>
	</section>
}

// shiftFields are a shift's start, end and "ends next day", for the venue form and the
// department form (prefix names their ids). The checkbox sits in a bordered label so the
// whole 44 px box is the target.
templ shiftFields(prefix, start, end string, overnight bool, errorField string) {
	<div class="grid grid-cols-2 items-end gap-3 md:flex md:flex-wrap">
		<div class="field-stack md:w-[150px]">
			<label class="lbl" for={ prefix + "-shift-start" }>Shift start</label>
			<input
				class="field-input field-input--mono"
				id={ prefix + "-shift-start" }
				type="time"
				name="shift_start"
				value={ start }
				aria-invalid={ ariaInvalid(errorField, "shift") }
				aria-describedby={ prefix + "-shift-help" }
			/>
		</div>
		<div class="field-stack md:w-[150px]">
			<label class="lbl" for={ prefix + "-shift-end" }>Shift end</label>
			<input
				class="field-input field-input--mono"
				id={ prefix + "-shift-end" }
				type="time"
				name="shift_end"
				value={ end }
				aria-invalid={ ariaInvalid(errorField, "shift") }
				aria-describedby={ prefix + "-shift-help" }
			/>
		</div>
		// THE ACCENT IS THE PALETTE'S, NOT THE BROWSER'S (skill tappa-brand): a native
		// checkbox with no accent paints itself the user agent's blue.
		<label for={ prefix + "-overnight" } class="col-span-2 inline-flex min-h-11 cursor-pointer items-center gap-2.5 self-start rounded-[10px] border border-line px-3.5">
			<input
				class="size-5 accent-tappa-green"
				id={ prefix + "-overnight" }
				type="checkbox"
				name="overnight"
				value="1"
				checked?={ overnight }
			/>
			<span class="text-sm font-medium">Ends next day</span>
		</label>
	</div>
}

// ShiftBar draws the posted (or stored) shift on a 24-hour bar: an SVG whose x and
// width are WHOLE MINUTES, so no fraction is ever computed (§6). An overnight shift is
// two pieces. Nothing is drawn when the shift does not parse — the field's own note
// says what is wrong.
templ ShiftBar(start, end string, overnight bool) {
	if rects := shiftBarRects(start, end, overnight); len(rects) > 0 {
		<div aria-hidden="true" class="flex flex-col gap-1.5">
			<svg viewBox="0 0 1440 14" preserveAspectRatio="none" class="h-3.5 w-full rounded-[7px]" aria-hidden="true" focusable="false">
				<rect width="1440" height="14" class="fill-porcelain"></rect>
				for _, r := range rects {
					<rect x={ strconv.Itoa(r.X) } y="0" width={ strconv.Itoa(r.W) } height="14" class="fill-tappa-green"></rect>
				}
			</svg>
			<div class="flex justify-between font-mono text-[10px] text-ink/70">
				<span>00</span><span>06</span><span>12</span><span>18</span><span>24</span>
			</div>
		</div>
	}
}

// proofDocket is what a tap here can prove, from what is SAVED (not from what was
// typed): a docket, because it is a receipt of the venue's configuration. There is no
// trust arithmetic on it — the score is the engine's, written once.
templ proofDocket(side VenueFormSide) {
	<section aria-labelledby="proves-h" class="docket flex flex-col gap-3">
		<p id="proves-h" class="lbl">What a tap here can prove</p>
		<div class="flex flex-col gap-2 font-mono text-[13px]">
			<div class="flex flex-wrap justify-between gap-x-2 gap-y-0.5">
				<span class="whitespace-nowrap">Network</span>
				<span class="ml-auto text-right font-bold">{ side.Network }</span>
			</div>
			<div class="flex flex-wrap justify-between gap-x-2 gap-y-0.5">
				<span class="whitespace-nowrap">
					if side.Radius != "" {
						{ "GPS (within " + side.Radius + ")" }
					} else {
						GPS
					}
				</span>
				<span class="ml-auto break-all text-right font-bold">{ side.GPS }</span>
			</div>
			<div class="flex justify-between gap-2 border-t border-dashed border-line pt-2">
				<span>Plaque tap</span><span class="text-right">network or GPS</span>
			</div>
			<div class="flex justify-between gap-2">
				<span>QR scan</span><span class="text-right">network only</span>
			</div>
		</div>
		<p class="text-xs leading-snug text-ink/70">Under the standard rules, as saved. A list too wide to be one venue's network is not evidence, and saving one is refused.</p>
	</section>
}

// formDepartments is the venue's departments on its form, each opening its own form.
templ formDepartments(side VenueFormSide) {
	<section aria-labelledby="vf-dept-h" class="flex flex-col gap-2.5 rounded-[18px] border border-line bg-paper px-[22px] py-5">
		<div class="flex flex-wrap items-baseline justify-between gap-x-3">
			<h2 id="vf-dept-h" class="font-display text-lg font-bold tracking-tight">Departments ({ departmentCountText(side.DepartmentCount) })</h2>
			<a class="inline-flex min-h-11 items-center text-[13px] font-bold text-ink underline underline-offset-4" href={ templ.URL(side.AddDepartmentHref) }>Add a department</a>
		</div>
		<p class="text-xs leading-snug text-ink/70">A department's shift is what lateness is measured against — it replaces the venue's shift for the people in it.</p>
		for _, dep := range side.Departments {
			<div class="flex min-h-11 flex-wrap items-center justify-between gap-x-3 border-t border-dashed border-line">
				<span class="min-w-0 break-words text-sm font-bold">{ dep.Name }</span>
				<span class="font-mono text-[13px] text-ink/70">
					if dep.Shift != "" {
						{ dep.Shift }
					} else {
						Uses the venue's shift
					}
				</span>
				<a class="inline-flex min-h-11 items-center text-[13px] font-bold text-ink underline underline-offset-4" href={ templ.URL(dep.EditHref) }>Edit { dep.Name }</a>
			</div>
		}
	</section>
}

// formPlaques lists the plaques on this venue's walls (and the ones it had); they are
// managed on the venue's detail, which the link opens.
templ formPlaques(side VenueFormSide) {
	<section aria-labelledby="vf-plaques-h" class="flex flex-col gap-2 rounded-[18px] border border-line bg-paper px-[22px] py-5">
		<h2 id="vf-plaques-h" class="font-display text-lg font-bold tracking-tight">Plaques on these walls</h2>
		<ul class="flex flex-col">
			for _, p := range side.Plaques {
				<li class="flex min-h-12 flex-wrap items-center justify-between gap-2 border-b border-dashed border-line">
					<span class="break-all font-mono text-[13px] font-bold">{ p.UID }</span>
					<span class={ plaqueStatusClass(p.Status) }>{ p.Status }</span>
				</li>
			}
		</ul>
		<a class="inline-flex min-h-11 items-center self-start text-sm font-bold text-ink underline underline-offset-4" href={ templ.URL(side.VenueHref) }>Manage plaques on the venue</a>
	</section>
}

// venueRefForm binds the venue to the identifier the customer's HR or ERP system uses
// for it (M11 API-1, K-18): venues are never matched by name, so a venue that already
// exists is bound here before the integration's first sync. MONO: an identifier.
templ venueRefForm(v VenueRefFormView) {
	<section aria-labelledby="vf-ref-h" class="flex flex-col gap-2.5 rounded-[18px] border border-line bg-paper px-[22px] py-5">
		<h2 id="vf-ref-h" class="font-display text-lg font-bold tracking-tight">External ref <span class="font-mono text-xs font-normal text-ink/70">optional</span></h2>
		if v.CanChange {
			<form method="post" action={ templ.URL(Bound(ctx, v.Action)) } class="flex flex-col gap-2.5">
				<input type="hidden" name="id" value={ v.ID }/>
				<div class="field-stack">
					<label class="lbl" for="venue-external-ref">Identifier in your HR or ERP system</label>
					<input
						class="field-input field-input--mono"
						id="venue-external-ref"
						type="text"
						name="external_ref"
						value={ v.Value }
						maxlength="64"
						autocomplete="off"
						spellcheck="false"
						aria-describedby="venue-external-ref-help"
					/>
					<p id="venue-external-ref-help" class="field-help">
						The identifier your HR or ERP system uses for this venue: letters, digits
						and . _ ~ - only, up to 64 characters. Leave it empty to unlink.
					</p>
				</div>
				<button type="submit" class="btn btn--line self-start">Save external ref</button>
			</form>
		} else {
			if v.Value != "" {
				<p class="break-all font-mono text-sm text-ink">{ v.Value }</p>
			} else {
				<p class="text-sm text-ink">Not linked to an HR or ERP record.</p>
			}
			<p class="field-help">Only the business owner can change an external ref.</p>
		}
	</section>
}

// DepartmentForm is the add/edit page for one department: its venue, its name and its
// shift, in the venue form's numbered sections.
templ DepartmentForm(v DepartmentFormView) {
	<div class="panel-measure flex flex-col gap-6 desk:grid desk:grid-cols-[minmax(0,1fr)_340px] desk:items-start">
		<div class="flex min-w-0 flex-col gap-4">
			if v.ErrorMessage != "" && v.ErrorField == "" {
				@PanelNotice(ToneAlert, "Nothing was saved") {
					<p>{ v.ErrorMessage }</p>
				}
			}
			<form method="post" action={ templ.URL(Bound(ctx, v.Action)) } aria-label={ v.Heading } class="flex min-w-0 flex-col rounded-[18px] border border-line bg-paper px-4 pb-6 pt-1 md:px-7 md:pb-7 md:pt-2">
				if v.ID != "" {
					<input type="hidden" name="id" value={ v.ID }/>
				}
				@formSection("dept-s1", "01", "Venue") {
					if v.VenueFixed {
						// 🔴 NO CONTROL, AND A SENTENCE INSTEAD OF A DISABLED ONE. The server has
						// no statement that moves a department between venues, on purpose
						// (db/queries/departments.sql), so a control here would offer something
						// that cannot happen.
						<p class="font-display text-base font-bold tracking-tight text-ink">
							if v.VenueName != "" {
								{ v.VenueName }
							} else {
								Venue could not be read
							}
						</p>
						<p class="field-help">
							A department cannot be moved to another venue. The people already in it
							would end up working at one place and counted against another's hours.
							Add a department at the other venue instead.
						</p>
					} else {
						<div class="field-stack md:max-w-[420px]">
							<label class="lbl" for="dept-venue">Venue</label>
							<select
								class="field-input"
								id="dept-venue"
								name="location_id"
								aria-invalid={ ariaInvalid(v.ErrorField, "location_id") }
								aria-describedby="dept-venue-help"
							>
								for _, o := range v.Venues {
									<option value={ o.Value } selected?={ o.Value == v.VenueID }>{ o.Label }</option>
								}
							</select>
							@fieldNote("dept-venue-help", v.ErrorField, "location_id", v.ErrorMessage) {
								Which place this department is part of. It cannot be changed afterwards.
							}
						</div>
					}
				}
				@formSection("dept-s2", "02", "Name") {
					<div class="field-stack md:max-w-[420px]">
						<label class="lbl" for="dept-name">Name</label>
						<input
							class="field-input"
							id="dept-name"
							type="text"
							name="name"
							value={ v.Name }
							autocomplete="off"
							spellcheck="false"
							aria-invalid={ ariaInvalid(v.ErrorField, "name") }
							aria-describedby="dept-name-help"
						/>
						@fieldNote("dept-name-help", v.ErrorField, "name", v.ErrorMessage) {
							What your staff call this part of the venue — Kitchen, Bar, Packing.
						}
					</div>
				}
				@formSectionLast("dept-s3", "03", "Shift") {
					<p class="field-help -mt-1.5">A department's own hours beat the venue's when working out who was late.</p>
					@shiftFields("dept", v.ShiftStart, v.ShiftEnd, v.Overnight, v.ErrorField)
					@fieldNote("dept-shift-help", v.ErrorField, "shift", v.ErrorMessage) {
						Fill both or leave both empty —
						<strong class="font-bold text-ink">
							empty means this department follows the venue's
							shift
						</strong>, not that nobody is ever late.
					}
					@ShiftBar(v.ShiftStart, v.ShiftEnd, v.Overnight)
				}
				<div class="flex flex-wrap gap-2.5 border-t border-line pt-[18px]">
					<button type="submit" class="btn btn--primary rounded-xl">{ v.Submit }</button>
					<a class="btn btn--line" href={ templ.URL(v.CloseHref) }>Cancel</a>
				</div>
			</form>
		</div>
		if v.Removal != nil || v.BusinessDay != nil {
			<div class="flex min-w-0 flex-col gap-4">
				if v.BusinessDay != nil {
					@DayCutoffCard(*v.BusinessDay)
				}
				if v.Removal != nil {
					@Removal(*v.Removal)
				}
			</div>
		}
	</div>
}

// fieldNote is the help text under a control, or the REFUSAL when this is the field
// that failed.
//
// 🔴 ONE ELEMENT FOR BOTH, WITH ONE id, WHICH IS WHAT MAKES aria-describedby POINT
// AT THE RIGHT THING IN BOTH STATES. Two elements would mean the described-by id
// resolves to the help text while the error sits somewhere a screen reader reaches
// separately, if at all. The refusal is the parser's sentence, verbatim, in the error
// box; the help line's place is reserved either way.
templ fieldNote(id, errorField, field, message string) {
	if errorField == field && message != "" && field != "" {
		<p id={ id } role="alert" class="rounded-xl border border-tomato bg-tomato/5 px-3.5 py-3 text-[13px] leading-snug text-ink">{ message }</p>
	} else {
		<p id={ id } class="field-help">
			{ children... }
		</p>
	}
}

// ariaInvalid marks the control that failed. It answers the attribute's own
// vocabulary ("true"/"false") rather than a Go bool, because that is what the
// attribute takes.
func ariaInvalid(errorField, field string) string {
	if errorField == field && field != "" {
		return "true"
	}
	return "false"
}

// shiftRect is one piece of the shift bar, in whole minutes from midnight.
type shiftRect struct{ X, W int }

// shiftBarRects turns the form's two "HH:MM" strings into the bar's pieces, or nil when
// either does not parse or the pair is not a shift the server would store (an end at
// or before the start needs "ends next day"). Whole minutes only.
func shiftBarRects(start, end string, overnight bool) []shiftRect {
	s, okS := clockMinutes(start)
	e, okE := clockMinutes(end)
	if !okS || !okE {
		return nil
	}
	switch {
	case e > s && !overnight:
		return []shiftRect{{X: s, W: e - s}}
	case overnight && e <= s:
		out := []shiftRect{{X: s, W: 1440 - s}}
		if e > 0 {
			out = append(out, shiftRect{X: 0, W: e})
		}
		return out
	default:
		return nil
	}
}

// clockMinutes reads "HH:MM" (what a time input posts) as minutes after midnight.
func clockMinutes(t string) (int, bool) {
	if len(t) != 5 || t[2] != ':' {
		return 0, false
	}
	h, errH := strconv.Atoi(t[:2])
	m, errM := strconv.Atoi(t[3:])
	if errH != nil || errM != nil || h < 0 || h > 23 || m < 0 || m > 59 {
		return 0, false
	}
	return h*60 + m, true
}

// Removal renders the delete control on an edit card, or the sentence that replaces
// it (user decision, 2026-08-08).
//
// 🔴 THREE STATES AND NO FOURTH. Blocked -> no button, a counted reason and the rule.
// Armed -> a link that asks the server for a warning. Confirming -> the warning and
// the real POST. There is never a button that leads to a refusal, which is the
// property this whole card exists to hold.
templ Removal(v RemovalView) {
	<section aria-labelledby="removal-h" class="flex flex-col gap-2.5 rounded-[18px] border border-tomato bg-tomato/5 px-[22px] py-5">
		<h2 id="removal-h" class="font-display text-lg font-bold tracking-tight">Remove this { v.Kind }</h2>
		if v.Reserved {
			// 🔴 NO CONTROL AND NO PATH TO ONE. Removal is owner-only (user decision,
			// 2026-08-09) because it is the product's first irreversible act and there
			// is no archive to restore from. The server refuses it independently — this
			// is what stops a manager pressing something that could only fail.
			<p class="text-[13px] leading-snug text-ink">
				Removing a { v.Kind } cannot be undone, so it is reserved for an owner.
				Ask one of your business's owners if this { v.Kind } should go.
			</p>
		} else if v.Blocked {
			// 🔴 A RULE, NOT A FAULT. Nothing is wrong with a venue that has staff and
			// taps; §4.3 is why it must stay — the transaction rows point at it, and a
			// record whose venue can be deleted is a record whose evidence can be
			// edited away.
			<p class="text-[13px] leading-snug text-ink">
				This { v.Kind } cannot be removed while anything still belongs to it:
				for i, reason := range v.Reasons {
					if i > 0 {
						{ " · " }
					}
					<strong class="font-bold">{ reason }</strong>
				}
				— its records point back at it, so removing it would leave hours nobody
				could account for. Move or deactivate them first.
			</p>
		} else if v.Confirming {
			<div class="flex flex-col gap-1.5 rounded-xl border-2 border-tomato bg-paper px-3.5 py-3">
				<p class="font-display text-sm font-bold tracking-tight text-ink">
					Remove { v.Name }?
				</p>
				<p class="text-[13px] leading-snug text-ink">
					This cannot be undone — there is no archive to restore it from. Nothing
					belongs to this { v.Kind } right now, so no hours are affected. A record
					of the removal is kept.
				</p>
				<form method="post" action={ templ.URL(Bound(ctx, v.Action)) } class="mt-1.5 flex flex-wrap gap-2.5">
					<input type="hidden" name="id" value={ v.ID }/>
					<input type="hidden" name={ v.ConfirmField } value={ v.ConfirmToken }/>
					<button type="submit" class="btn btn--danger">Yes, remove it</button>
					<a class="btn btn--line" href={ templ.URL(v.CancelHref) }>Keep it</a>
				</form>
			</div>
		} else {
			<p class="text-[13px] leading-snug text-ink">
				// 🔴 THE SENTENCE LISTS WHAT THIS CARD'S QUERY ACTUALLY COUNTED, and the
				// list comes from the view rather than from the prose because the two
				// cards count DIFFERENT things: a venue's query looks at four kinds, a
				// department's at two. A single hard-coded sentence made the department
				// card name sub-departments and plaques — neither of which can belong to
				// a department at all — which is a claim about a search that never ran.
				//
				// AND IT IS STILL NOT A UNIVERSAL ABSENCE. policy_attachments.resource can
				// hold "location/&lt;uuid&gt;" as free text with no foreign key (migration
				// 00007); no production path writes one today, and M6-09's scope binding
				// will. Naming what was checked is what keeps the sentence true either way.
				No { countedList(v.Counted) } belong to this { v.Kind }, so it can be
				removed. This cannot be undone.
			</p>
			<a class="btn btn--danger self-start" href={ templ.URL(v.ConfirmHref) }>
				Remove this { v.Kind }…
			</a>
		}
	</section>
}
