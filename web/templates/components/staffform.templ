package components

// The ADD-SOMEBODY control and form (M6-13). The view models and the arguments for
// their shape are in staffformview.go; this file is the markup.
//
// BRAND (skill tappa-brand): the form is a DOCKET like every other card in the
// panel: the paper ground, one hairline border, perforated edges from the shared
// class, uppercase small-caps field labels. Nothing here invents a colour: the refusal
// note takes its warning colour from the shared fieldNoteClass helper, and the only
// accent is the primary button. No script, no dark theme, touch targets inherited
// from the shared button and field rules.
//
// ACCESSIBILITY: every control has a <label for>, each error is tied to its input
// with aria-describedby and marked aria-invalid, and every field reserves its note
// line so a refusal does not reflow the form. It is VenueForm's shape, deliberately —
// two forms in one product that behave differently under refusal is how one of them
// quietly loses its accessibility.

// RosterAdd renders either the control that opens the form, the form itself, or the
// sentence that explains why neither is available.
//
// 🔴 THE THIRD BRANCH IS THE ONE WORTH READING. A business with no venue cannot have
// employees through the panel — the panel always places somebody; a NULL venue is only
// for a row the integration manages (K-14) — so the screen states the rule and
// links to the place it is fixed, instead of rendering a venue picker with nothing in
// it. A picker with no options is a control that can only produce a refusal, and this
// repository's most expensive lesson is that the EMPTY path is the one nobody builds.
templ RosterAdd(v RosterAddView) {
	if !v.Possible {
		<section class="panel-card" aria-label="Add somebody">
			<p class="lbl">Add somebody</p>
			<h2 class="font-display text-xl font-bold tracking-tight text-ink">Add a venue first</h2>
			if v.Refusal != "" {
				// 🔴 THE REFUSAL COMES FIRST, BECAUSE SOMETHING WAS JUST REFUSED (§4.6).
				// This branch also renders on an ordinary GET, where nothing was
				// attempted and there is nothing to refuse — so the notice is
				// conditional. Without it a manager who pressed Add got a page about
				// venues and no acknowledgement that their submission had been rejected.
				@PanelNotice(ToneWarn, "Nobody was added") {
					<p>{ v.Refusal }</p>
				}
			}
			<p class="text-sm text-ink/85">
				Everybody on this list works somewhere, so there has to be a venue before there
				can be a person. Add the place your staff tap in at, then come back here.
			</p>
			<p>
				<a class="btn btn--primary rounded-xl" href={ templ.URL(v.VenuesHref) }>Go to venues</a>
			</p>
		</section>
	} else if v.Open {
		@StaffForm(v.Form)
	} else {
		// THE HEADING'S CONTROL (M12-30): drawn at the right of the title from a tablet
		// up, and across the screen under it on a phone, where the thumb is.
		<div class="flex w-full flex-col gap-1.5 md:w-auto md:max-w-[360px] md:items-end">
			<a class="btn btn--primary min-h-[52px] w-full gap-2 rounded-xl md:min-h-12 md:w-auto" href={ templ.URL(v.Href) }>
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M12 5v14M5 12h14"></path></svg>
				Add somebody
			</a>
			<p class="text-xs text-ink/70 md:text-right">
				They are added as invited — you send them their activation link afterwards.
			</p>
		</div>
	}
}

// StaffForm is the new-employee form, laid out as its own page on the roster's URL
// (M12-31): the form on the left from a desk, what happens next beside it; one column
// below that, the two selects side by side from a tablet; and on a phone the submit
// bar stays in reach above the navigation.
//
// 🔴 TWO REQUIRED CONTROLS AND THREE OPTIONAL ONES, AND THE SCREEN SAYS WHICH. The
// split comes from migration 00003 (full_name and location_id are NOT NULL; role,
// email and department_id are not), so marking a label optional is a fact about the
// database rather than a house style.
//
// ⚠️ THERE IS NO FORM-LEVEL NOTICE HERE, AND ITS ABSENCE IS A DELETION RATHER THAN AN
// OVERSIGHT: every addFormAgain call site names a field, so the message always has a
// control to sit beside; the venueless case is answered by RosterAddView.Refusal.
templ StaffForm(v StaffFormView) {
	<div class="flex flex-col gap-7 desk:flex-row desk:items-start">
		<section class="panel-card min-w-0 desk:flex-[999_1_520px]" aria-label="Add somebody to this business">
			<form method="post" action={ templ.URL(v.Action) } class="flex flex-col gap-[18px]">
				@hiddenFields(v.Hidden)
				<div class="field-stack">
					<label class="lbl" for="add-full-name">Name</label>
					<input
						class="field-input"
						id="add-full-name"
						type="text"
						name="full_name"
						value={ v.FullName }
						autocomplete="off"
						spellcheck="false"
						aria-invalid={ ariaInvalid(v.ErrorField, "full_name") }
						aria-describedby="add-full-name-help"
					/>
					@fieldNote("add-full-name-help", v.ErrorField, "full_name", v.ErrorMessage) {
						What your team calls them. This is the only thing we need.
					}
				</div>
				<div class="grid grid-cols-1 gap-4 md:grid-cols-2">
					<div class="field-stack min-w-0">
						<label class="lbl" for="add-location">Venue</label>
						// 🔴 THE PLACEHOLDER IS WHAT MAKES "NOBODY CHOOSES BY ACCIDENT" TRUE.
						// HTML submits a select's FIRST option when none is marked selected,
						// so without an empty first choice a manager who never touched the
						// control would hire into whichever venue sorts first. The empty
						// choice submits "", and the boundary refuses it with a sentence
						// that names the field. The MOVE form offers no empty venue: moving
						// somebody to "no venue" is not a destination.
						<select class="field-input" id="add-location" name="location_id" required aria-invalid={ ariaInvalid(v.ErrorField, "location_id") } aria-describedby="add-location-help">
							<option value="" selected?={ v.LocationID == "" }>Choose a venue…</option>
							for _, o := range v.Locations {
								<option value={ o.Value } selected?={ o.Value == v.LocationID }>{ o.Label }</option>
							}
						</select>
						// THE HELP SAYS WHAT IS TRUE AND NOTHING ABOUT LATENESS: lateness is
						// measured against the department's shift, else the shift of the
						// venue TAPPED (§5) -- never this home venue's.
						@fieldNote("add-location-help", v.ErrorField, "location_id", v.ErrorMessage) {
							Where they normally work. They can still tap in at any of your venues.
						}
					</div>
					<div class="field-stack min-w-0">
						<label class="lbl" for="add-department">Department (optional)</label>
						// AN EMPTY CHOICE IS OFFERED AND IS FIRST CLASS (00003: a bar does not
						// model departments), unlike the venue.
						<select class="field-input" id="add-department" name="department_id" aria-invalid={ ariaInvalid(v.ErrorField, "department_id") } aria-describedby="add-department-help">
							<option value="" selected?={ v.DepartmentID == "" }>No department</option>
							for _, o := range v.Departments {
								<option value={ o.Value } selected?={ o.Value == v.DepartmentID }>{ o.Label }</option>
							}
						</select>
						@fieldNote("add-department-help", v.ErrorField, "department_id", v.ErrorMessage) {
							Only if some of your staff work different hours from the rest of the venue.
							It has to be one of the chosen venue's.
						}
					</div>
				</div>
				<div class="field-stack">
					<label class="lbl" for="add-role">Job title (optional)</label>
					<input
						class="field-input"
						id="add-role"
						type="text"
						name="role"
						value={ v.Role }
						autocomplete="off"
						spellcheck="false"
						aria-invalid={ ariaInvalid(v.ErrorField, "role") }
						aria-describedby="add-role-help"
					/>
					@fieldNote("add-role-help", v.ErrorField, "role", v.ErrorMessage) {
						Waiter, chef, floor manager — whatever you call it. Nothing depends on it.
					}
				</div>
				<div class="field-stack">
					<label class="lbl" for="add-email">Email (optional)</label>
					<input
						class="field-input field-input--mono"
						id="add-email"
						type="email"
						name="email"
						value={ v.Email }
						placeholder="name@example.com"
						autocomplete="off"
						spellcheck="false"
						aria-invalid={ ariaInvalid(v.ErrorField, "email") }
						aria-describedby="add-email-help"
					/>
					// 🔴 THE CASE SENTENCE IS ON THE SCREEN RATHER THAN ONLY IN THE REFUSAL.
					// `email` is citext, so two addresses differing only in capitalisation
					// are the SAME address.
					@fieldNote("add-email-help", v.ErrorField, "email", v.ErrorMessage) {
						Leave it blank if they do not have one — an activation link can be handed
						over instead. Capitals make no difference: two people here cannot share an
						address.
					}
				</div>
				if v.BillingNote != "" {
					// 🔴 M6-12 BILLS ON A HEADCOUNT, SO THIS FORM OWES THE MANAGER THE TRUTH
					// ABOUT WHAT PRESSING SAVE COSTS. The sentence is built by the handler
					// from the billing predicate, so it cannot drift from what is charged.
					<p class="border-t border-dashed border-line pt-3.5 text-[13px] leading-normal text-ink">{ v.BillingNote }</p>
				}
				// THE SUBMIT BAR STAYS IN REACH ON A PHONE: it holds to the foot of the
				// screen above the navigation bar while the form is in view, and sits in
				// the form's flow from a tablet up. Cancel stays beside it.
				<div class="sticky bottom-[calc(68px+env(safe-area-inset-bottom))] z-10 -mx-4 flex flex-wrap items-center gap-3 border-t border-line bg-paper px-4 py-3 md:static md:mx-0 md:border-0 md:p-0">
					<button type="submit" class="btn btn--primary min-h-[52px] rounded-xl px-6">Add them</button>
					<a class="btn btn--quiet rounded-xl" href={ templ.URL(v.CloseHref) }>Cancel</a>
				</div>
			</form>
		</section>
		// WHAT HAPPENS NEXT, said once and truthfully: the link is the second step (the
		// form does not invite), how it reaches the person depends on this deployment,
		// and activation finishes on a tap at one of the business's OWN plaques (ADR
		// 0026, K-35) -- a tap that writes no attendance record.
		<aside class="panel-card min-w-0 desk:flex-[1_1_300px]" aria-label="After you add them">
			<h2 class="font-display text-lg font-bold tracking-tight text-ink">After you add them</h2>
			<ol class="flex flex-col gap-3 text-sm leading-normal text-ink">
				<li class="grid grid-cols-[28px_1fr] gap-2.5">
					<span aria-hidden="true" class="font-mono text-xs font-bold leading-5">01</span>
					if v.InviteByEmail {
						<span>From their card, send their activation link. We email it to the address on file; with no address, the owner can show it on screen instead.</span>
					} else {
						<span>From their card, show them their activation link. It is shown once, on screen, for you to hand over.</span>
					}
				</li>
				<li class="grid grid-cols-[28px_1fr] gap-2.5">
					<span aria-hidden="true" class="font-mono text-xs font-bold leading-5">02</span>
					<span>They open it on their own phone and confirm it is them.</span>
				</li>
				<li class="grid grid-cols-[28px_1fr] gap-2.5">
					<span aria-hidden="true" class="font-mono text-xs font-bold leading-5">03</span>
					<span>Their first tap on one of your plaques finishes the setup. That tap writes no attendance record.</span>
				</li>
			</ol>
			<p class="text-[13px] leading-normal text-ink/70">Until then they show as <strong class="font-bold text-ink">INVITED</strong> in People.</p>
		</aside>
	</div>
}
