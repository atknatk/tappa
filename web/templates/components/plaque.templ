package components

// The PLAQUE CARD: the one plaque a manager opened from the Venues screen (M6-06 phase B,
// ported to the panel redesign in M12-34).
//
// 🔴 IT IS A CARD OF THE VENUE DETAIL, NOT A SLIP. Before the port it was a docket with
// a second docket inside it, and that put the plaque id on the screen twice and an "Open"
// button on the card that opened the card itself. A plaque's lifecycle is not a record
// of a tap: the slip and the rubber stamp belong to those (skill tappa-brand, D2), so the
// card wears the detail's own frame and says the id once, in its heading. The open link
// a row carries lives on the row (PlaqueTable, StockRow); the card is where it leads.
//
// 🔴 EVERY NUMBER IS MONO AND SO IS THE UID. The counter, the last-seen stamp and the chip
// id are data; the plaque id is the value a manager compares against the one printed on
// the wall.
//
// 🔴 SECTION 4.7: THERE IS NO KEY ON THIS CARD AND NOTHING THAT STANDS IN FOR ONE. The
// "Key" field prints the encoded/pending STATE, derived from the encode round's step-9
// stamp and the wall; components/plaqueview.go states exactly what backs that word and
// what does not. The view model has no field a key could arrive in.
//
// 🔴 AN UNRECORDED ENCODE GETS A BANNER, NOT ONLY A WORD (M10 F0-6, incident A-1). The
// word alone was how Rusty Bar happened: the card said "Encoded", a manager believed it,
// and the door refused every tap. The banner is the panel's own PanelNotice -- the shared
// notice also draws the tap and activation screens and stays theirs (CLAUDE.md §9).
//
// ⚠️ THE UTILITY CLASSES ARE DESCRIBED RATHER THAN NAMED in the prose here, on purpose:
// the Tailwind CLI scans this file as raw text, so a utility name written in a COMMENT
// compiles a live CSS rule nothing renders.

// PlaqueCard is the one plaque a manager opened: what it is, what happened to it, and the
// single act available on it.
//
// 🔴 ONE ARM PER MODE AND A DEFAULT THAT OFFERS NOTHING — the shape Removal holds for
// venues. The modes are enumerated at components.PlaqueFormView.Mode and nowhere else;
// the switch below has an arm for each, and anything it does not know falls to the
// default, which offers NO control and says why.
templ PlaqueCard(v PlaqueFormView) {
	<section id="plaque" aria-labelledby="plaque-h" class="flex min-w-0 flex-col gap-4 rounded-[18px] border border-line bg-paper px-4 py-4 md:px-6 md:py-[22px]">
		<div class="flex flex-wrap items-start justify-between gap-3">
			<div class="flex min-w-0 flex-col gap-1">
				<p class="lbl">Plaque</p>
				<h2 id="plaque-h" class="break-all font-mono text-lg font-bold text-ink">{ v.Heading }</h2>
			</div>
			// The status is a word in a pill, the same word and tone as the row it was
			// opened from; the colour is never the only carrier.
			<span class={ plaqueStatusClass(v.Plaque.Status) }>{ v.Plaque.Status }</span>
		</div>
		if v.ErrorMessage != "" {
			@PanelNotice(ToneAlert, "Nothing was changed") {
				<p>{ v.ErrorMessage }</p>
			}
		}
		@plaqueBanners(v.Plaque)
		// No drawing on the card: the Venues detail it sits in draws its venue's plaque
		// (M12-34), and a page carries at most one QR code.
		@plaqueFacts(v.Plaque)
		if len(v.Trail) > 0 {
			// 🔴 THE AUDIT HALF OF THE HISTORY, AND IT ANSWERS THE ONE QUESTION THE ROW
			// CANNOT. The facts above say WHAT happened and WHEN, read off the `tags` row,
			// which has no actor column and never will. "Who took this plaque off the
			// wall?" is what a manager arrives with when a door has stopped working, and
			// only audit_log can answer it. Two sources, two jobs.
			<div class="flex flex-col gap-2 border-t border-dashed border-line pt-3">
				<p class="lbl">Who did what</p>
				<ul class="flex flex-col gap-1">
					for _, e := range v.Trail {
						<li class="break-words font-mono text-[13px] text-ink">
							{ e.What } { e.When }
							if e.Who != "" {
								{ " · " }{ e.Who }
							} else if e.BySystem {
								// audit_log.actor_id is nullable — the column is polymorphic and
								// holds NULL for SYSTEM events. Saying so beats a blank a reader
								// would take for "nobody knows".
								<span class="text-ink/70">{ " · by the system" }</span>
							} else {
								// 🔴 AN ADMIN WITH NO NAME IS NOT THE SYSTEM. full_name is
								// `text NOT NULL` with no non-blank CHECK, so "" is storable —
								// and calling that act the product's would misattribute it in
								// the one place a manager comes to ask who did this.
								<span class="text-ink/70">{ " · by an administrator with no name set" }</span>
							}
						</li>
					}
				</ul>
			</div>
		}
		switch v.Mode {
			case "mount":
				<form method="post" action={ templ.URL(Bound(ctx, v.Action)) } class="flex flex-col gap-4 border-t border-dashed border-line pt-4">
					<input type="hidden" name="uid" value={ v.Plaque.UID }/>
					<div class="field-stack">
						<label class="lbl" for="plaque-venue">Mount it at</label>
						<select class="field-input" id="plaque-venue" name="location_id" aria-describedby="plaque-venue-help">
							for _, o := range v.Venues {
								<option value={ o.Value }>{ o.Label }</option>
							}
						</select>
						<p id="plaque-venue-help" class="field-help">
							The entrance this plaque is screwed to. From then on, a tap on it is a tap
							at that place — its address ranges and coordinate are what the tap is
							checked against.
						</p>
					</div>
					<div class="flex flex-wrap gap-2.5">
						<button type="submit" class="btn btn--primary rounded-xl">{ v.Submit }</button>
						<a class="btn btn--line" href={ templ.URL(v.CloseHref) }>Cancel</a>
					</div>
				</form>
			case "onwall":
				// 🔴 TWO SHAPES UNDER ONE MODE: a plaque in service can always be taken DOWN
				// (the link below the switch), and can be REPLACED only when there is a spare
				// to put up. With no spare the card says so and still offers the way out.
				if len(v.Successors) > 0 {
					<div class="flex flex-col gap-3 border-t border-dashed border-line pt-4">
						// 🔴 THE WARNING IS PART OF THE CARD, and the server minted a confirmation
						// to render it (internal/handler/plaques.go says why it is one screen
						// rather than two). Pressing the button below is what spends it.
						<div class="flex flex-col gap-1.5 rounded-xl border-2 border-tomato bg-paper px-3.5 py-3">
							<p class="font-display text-sm font-bold tracking-tight text-ink">
								This takes this plaque off the wall
							</p>
							<p class="text-[13px] leading-snug text-ink">
								From the moment you press this, a tap on the old plaque is REJECTED — so
								take it down and put the new one up. We cannot put it back for you: its
								record is kept, but there is no undo button here. Nothing that already
								happened at this door changes.
							</p>
						</div>
						<form method="post" action={ templ.URL(Bound(ctx, v.Action)) } class="flex flex-col gap-4">
							<input type="hidden" name="uid" value={ v.Plaque.UID }/>
							<input type="hidden" name={ v.ConfirmField } value={ v.ConfirmToken }/>
							<div class="field-stack">
								<label class="lbl" for="plaque-successor">Replace it with</label>
								<select class="field-input field-input--mono" id="plaque-successor" name="successor" aria-describedby="plaque-successor-help">
									for _, o := range v.Successors {
										<option value={ o.Value }>{ o.Label }</option>
									}
								</select>
								<p id="plaque-successor-help" class="field-help">
									// 🔴 THE WALL IS NOT A CONTROL HERE AND THE SENTENCE SAYS WHY. A
									// replacement is the same door with a different plaque, so the venue
									// is read from the plaque coming off. Asking for it again would be a
									// second chance to send the new plaque somewhere else.
									The new plaque goes on the same wall as this one. The old one stops working
									the moment you press this — taps on it are rejected — and its record stays,
									so nothing that already happened there is lost.
								</p>
							</div>
							<div class="flex flex-wrap gap-2.5">
								<button type="submit" class="btn btn--danger">{ v.Submit }</button>
								<a class="btn btn--line" href={ templ.URL(v.CloseHref) }>Cancel</a>
							</div>
						</form>
					</div>
				} else if v.Blocked != "" {
					<p class="text-[13px] leading-snug text-ink">{ v.Blocked }</p>
				}
			case "unmount":
				// 🔴 THE UNDO OF A MOUNT, AND IT IS A SEPARATE STEP RATHER THAN A SECOND
				// BUTTON ON THE CARD ABOVE. The confirmation cookie is one per browser, so a
				// card carrying two armed forms would leave whichever one the manager did not
				// submit unusable — a control that can only fail.
				<div class="flex flex-col gap-1.5 rounded-xl border-2 border-saffron bg-saffron/10 px-3.5 py-3">
					<p class="font-display text-sm font-bold tracking-tight text-ink">
						Take this plaque off the wall?
					</p>
					<p class="text-[13px] leading-snug text-ink">
						It goes back into stock, ready to mount somewhere else — nothing is
						retired and no spare is used. Until you mount something at
						{ v.Plaque.Venue }, a tap there is REJECTED, so do this when you have the
						plaque in your hand.
					</p>
					<form method="post" action={ templ.URL(Bound(ctx, v.Action)) } class="mt-1.5 flex flex-wrap gap-2.5">
						<input type="hidden" name="uid" value={ v.Plaque.UID }/>
						<input type="hidden" name={ v.ConfirmField } value={ v.ConfirmToken }/>
						<button type="submit" class="btn btn--ink">{ v.Submit }</button>
						<a class="btn btn--line" href={ templ.URL(v.CloseHref) }>Leave it up</a>
					</form>
				</div>
			default:
				if v.Blocked != "" {
					<p class="text-[13px] leading-snug text-ink">{ v.Blocked }</p>
				}
				<a class="btn btn--line self-start" href={ templ.URL(v.CloseHref) }>Close</a>
		}
		if v.UnmountHref != "" && v.Mode != "unmount" {
			// 🔴 ALWAYS ON OFFER FOR A MOUNTED PLAQUE, WITH OR WITHOUT A SPARE. "It is on
			// the wrong door" is a real state, and before this the card answered it with
			// "ask us for a spare" — sending a manager to us for something they already
			// had, while every tap at that door was measured against the wrong venue.
			<div class="flex flex-col gap-2 border-t border-dashed border-line pt-4">
				<p class="lbl">On the wrong door?</p>
				<p class="text-[13px] leading-snug text-ink">
					Take it off the wall and it goes back into stock, ready to mount where it
					belongs. Nothing is retired and no spare is spent.
				</p>
				<a class="btn btn--line self-start" href={ templ.URL(v.UnmountHref) }>
					Take it off the wall…
				</a>
			</div>
		}
	</section>
}

// plaqueBanners are the states a word alone would undersell: a row the database will not
// let anyone change, and an encode that was not recorded as finished.
templ plaqueBanners(p PlaqueRowView) {
	if p.Frozen {
		// 🔴 A CONTROL THAT COULD ONLY FAIL IS NOT OFFERED, AND THE REASON IS SAID
		// PLAINLY. This row's id was written in a spelling migration 00013 no longer
		// accepts, so the database refuses every UPDATE to it. It exists only in
		// development databases; production has none.
		@PanelNotice(ToneWarn, "This one cannot be changed") {
			<p>
				Its id was recorded in a spelling this system no longer accepts, so nothing
				can be written to it. It is shown because it exists — it cannot be mounted,
				replaced or retired.
			</p>
		}
	}
	switch p.KeyAlert {
		case "wall":
			// 🔴 RUSTY BAR'S SHAPE: on a wall, with no record that its encode finished. The
			// act that fixes it is a replacement, which the card keeps on offer.
			//
			// ⚠️ NO CLAIM ABOUT ITS TAPS (second round, 2026-09-25). The row cannot know
			// that: the same NULL covers a personalised chip whose marking failed (its trail
			// says "do not re-encode"), and taps on that one verify. The words say what the
			// row says; the tone is the alert because the rule it breaks is a security line.
			@PanelNotice(ToneAlert, "This plaque needs replacing") {
				<p>
					Its encoding was not recorded as finished, so it should not be on a
					wall. Replace it with a freshly encoded plaque.
				</p>
			}
		case "stock":
			// The same fact in the box: the card withholds the mount control rather than
			// offering one the database would refuse. This banner is the ONE place the
			// reason is spelled out; the Key field and the closing line stay short.
			@PanelNotice(ToneWarn, "This plaque cannot go on a wall") {
				<p>
					Its encoding was not recorded as finished. Mount a freshly encoded
					plaque instead.
				</p>
			}
	}
}

// plaqueFacts is the plaque's row read out: where it hangs, how often its chip was read,
// when it was last tapped, what its encoding state is, and its history. The id is not
// here: the card's heading says it, once.
templ plaqueFacts(p PlaqueRowView) {
	<dl class="grid grid-cols-[auto_minmax(0,1fr)] items-baseline gap-x-4 gap-y-2.5">
		<dt class="lbl">Wall</dt>
		<dd class="min-w-0 break-words text-sm text-ink">
			if p.Venue != "" {
				{ p.Venue }
			} else if p.VenueUnknown {
				// 🔴 MOUNTED, BUT WE COULD NOT NAME THE WALL. Saying "not mounted" here would
				// be false about a plaque that is in service.
				<span class="text-ink/70">Venue could not be read</span>
			} else {
				// 🔴 "None" WOULD READ AS A FAULT. A plaque with no wall is INVENTORY — Tappa
				// loaded it, and nobody has decided which door it goes on yet (00013, part 3).
				<span class="text-ink/70">Not mounted yet</span>
			}
		</dd>
		<dt class="lbl">Chip reads</dt>
		<dd class="font-mono text-[13px] text-ink">{ p.Counter }</dd>
		<dt class="lbl">Last seen</dt>
		<dd class="font-mono text-[13px] text-ink">
			if p.LastSeen != "" {
				{ p.LastSeen }
			} else {
				// 🔴 "NEVER" IS A MEASURED ANSWER, NOT A BLANK. The last-seen query returns no
				// row at all for a plaque that has not been tapped.
				<span class="text-ink/70">Never tapped</span>
			}
		</dd>
		<dt class="lbl">Key</dt>
		<dd class="min-w-0 text-sm text-ink">{ p.KeyState }</dd>
		// 🔴 THE HISTORY IS ALWAYS SHOWN, EVEN WHEN IT IS ONE LINE. "Tappa loaded this on
		// the 3rd and nothing has happened since" IS the history of most plaques.
		<dt class="lbl">History</dt>
		<dd class="flex min-w-0 flex-col gap-0.5 font-mono text-[13px] text-ink">
			<span>Loaded { p.Loaded }</span>
			if p.Replaces != "" {
				<span class="break-all">Took over from { p.Replaces }</span>
			}
			if p.RetiredAt != "" {
				<span>Retired { p.RetiredAt }</span>
			}
			if p.ReplacedBy != "" {
				// 🔴 THE OLD ROW IS STILL HERE AND SO IS ITS SUCCESSOR'S ID. The database
				// refuses a DELETE on this table outright, so the chain cannot be broken.
				<span class="break-all">Replaced by { p.ReplacedBy }</span>
			}
		</dd>
	</dl>
}
