// Package components holds the repeated visual patterns of the employee-facing
// screens. skill tappa-brand: "Tekrar eden desen (docket, damga, buton, bos
// durum) BILESENDIR — kopyala-yapistir Tailwind zinciri degil."
//
// This package exists because an audit counted the same
// `border-l-4 border-<tone> bg-<ground> px-4 py-4` chain five times in one
// template. A chain repeated five times is a component that has not been written
// yet: the sixth copy is where the tone drifts.
package components

// Tone is the fixed status vocabulary. It mirrors the brand's status -> colour
// mapping, which is never inverted (skill tappa-brand): approved/ok is
// tappa-green, a warning is saffron, a refusal or a danger is tomato.
type Tone string

const (
	ToneOK    Tone = "ok"
	ToneWarn  Tone = "warn"
	ToneAlert Tone = "alert"
)

// noticeClass maps a tone to its border. Written as a switch rather than string
// concatenation so an unknown tone cannot silently produce a class Tailwind never
// generated — the class names below appear literally, which is what the
// standalone CLI scans for.
func noticeClass(t Tone) string {
	switch t {
	case ToneOK:
		return "border-l-4 border-tappa-green bg-green-lite px-4 py-4"
	case ToneWarn:
		return "border-l-4 border-saffron bg-saffron-lite px-4 py-4"
	default:
		return "border-l-4 border-tomato bg-paper px-4 py-4"
	}
}

// Notice is a bordered block carrying one piece of status text. Accessibility
// (skill tappa-brand): status is never carried by colour alone — every caller
// puts the meaning in the heading text, and the tone only reinforces it.
templ Notice(tone Tone, heading string) {
	<section class={ noticeClass(tone) }>
		if heading != "" {
			<p class="font-display font-bold tracking-tight">{ heading }</p>
		}
		<div class="mt-1 text-sm text-ink/85">
			{ children... }
		</div>
	</section>
}

// Card is the plain paper block used for the notice, the Wi-Fi step and the
// consent box: the same `bg-paper border border-line` frame, once.
templ Card(heading string) {
	<section class="bg-paper border border-line px-4 py-4">
		if heading != "" {
			<h2 class="font-display text-lg font-bold tracking-tight">{ heading }</h2>
		}
		{ children... }
	</section>
}
