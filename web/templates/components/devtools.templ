package components

// DevTapStrip is the DEV-ONLY "Simulate a plaque tap" control (ADR 0026,
// "Geliştirme aracı"). It renders NOTHING unless the render context was marked by
// WithDevTools, which only a development deployment does — so the product screens
// keep their no-button rule everywhere else.
//
// It is a form, not a link: the route is a POST behind an Origin check. newTab
// opens the simulated tap in a new tab, which is what a real NFC tap does and lets
// the waiting screen be watched while it happens.
//
// Deliberately loud and off-brand-in-shape: a dashed saffron strip pinned to the
// bottom, mono uppercase, so nobody mistakes it for product UI in a screenshot.
templ DevTapStrip(newTab bool) {
	if DevToolsOn(ctx) {
		<form
			method="post"
			action={ templ.SafeURL(DevSimulateTapPath) }
			class="dev-strip"
			if newTab {
				target="_blank"
			}
		>
			<span class="dev-strip-label">DEV ONLY</span>
			<button type="submit" class="dev-strip-button">Simulate a plaque tap</button>
		</form>
	}
}
