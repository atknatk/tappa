package components

// RosterRow renders one person as the kitchen docket (M6-05 phase A).
//
// 🔴 IT IS A DOCKET AND NOT A TABLE ROW, which is the last line of skill
// tappa-brand's "Yapma" list. A roster is the screen where a plain grid of rows is
// most tempting — it is a list of people with four attributes each — and that is
// exactly why the motif is written out here: it is what the product is recognised
// by, and the first screen to drop it is the one that argues it does not need it.
//
// ⚠️ THE WORD ON THAT LIST IS SPELT IN CAPITALS ABOVE FOR A MECHANICAL REASON. The
// Tailwind CLI scans this file as raw text and its candidate extractor is
// case-sensitive, so the lower-case spelling of that display utility compiles a
// live CSS rule out of a sentence. Measured in this task: one lower-case occurrence
// in this comment added a dead rule to app.css, which is the exact trap skill
// tappa-brand documents and the fifth time it has fired in this repository.
//
//	┌─◠─◠─◠─◠─◠─◠─◠─◠─◠─┐
//	│ MARIA BORG         │      ┌──────────┐
//	│ KF ST JULIANS      │      │ ACTIVE   │
//	│ Kitchen            │      └──────────┘
//	│ SINCE    DEVICES   │
//	│ 3 Aug    1 · 14:03 │
//	└─◡─◡─◡─◡─◡─◡─◡─◡─◡─┘
//
// 🔴 THE LIFECYCLE MARK IS A TALLY, NOT A STAMP, AND THE DIFFERENCE IS THE BRAND'S
// OWN. skill tappa-brand reserves the rubber stamp for a VERDICT — the engine's
// judgement of a tap, set at an angle, double framed. Being invited, employed or
// deactivated is not a judgement of anything; it is a fact about where somebody is
// in their employment, which is what input.css's .tally exists for ("a small fact
// ABOUT a record"). Giving a person a rubber stamp would also put the product in
// the position of stamping REJECTED-shaped marks on human beings.
//
// ⚠️ THE UTILITY CLASSES ARE DESCRIBED RATHER THAN NAMED in the prose above, on
// purpose: Tailwind scans this file as raw text, so a utility name written in a
// COMMENT compiles a rule nothing renders.
templ RosterRow(p RosterRowView) {
	<article class="docket">
		<div class="flex items-start justify-between gap-3">
			<div class="min-w-0">
				<p class="docket-label">Who</p>
				<p class="truncate font-display text-base font-bold tracking-tight text-ink">{ p.Name }</p>
				<p class="mt-2 docket-label">Where</p>
				<p class="truncate font-display text-sm font-bold tracking-tight text-ink">
					if p.Venue != "" {
						{ p.Venue }
					} else {
						// employees.location_id is NOT NULL, so this is a repair
						// problem rather than a person with no venue. Saying so beats
						// an empty line, which a reader would take for "none".
						Venue could not be read
					}
				</p>
				if p.Department != "" {
					<p class="truncate text-xs text-ink/70">{ p.Department }</p>
				}
			</div>
			<div class="shrink-0 text-right">
				@lifecycleTally(p.Status)
			</div>
		</div>
		<dl class="mt-3 grid grid-cols-2 gap-x-4 gap-y-1">
			<div>
				<dt class="docket-label">Since</dt>
				<dd class="text-ink">
					if p.Since != "" {
						{ p.Since }
					} else {
						not recorded
					}
				</dd>
			</div>
			<div>
				<dt class="docket-label">Devices</dt>
				<dd class="text-ink">{ p.Devices }</dd>
			</div>
		</dl>
		if p.ManageHref != "" {
			// A LINK, NOT A CONTROL THAT ACTS. It opens this person's card on the
			// same screen; everything that changes anything is a POST from there.
			// The word is deliberately not one of the four verbs: a row does not
			// invite, deactivate or move anybody, it opens the place where a manager
			// can.
			<p class="mt-3">
				<a class="btn btn--quiet" href={ templ.URL(p.ManageHref) }>Manage</a>
			</p>
		}
	</article>
}

// RosterActions is the action card for one person (M6-05 phase B): the four things
// a manager can do, on one screen, with no script.
//
// 🔴 EACH ACTION IS ITS OWN FORM, exactly as the review queue's decisions are, and
// for the same reason: a press is one complete instruction with nothing to select
// first, so a keyboard user is one tab away from submitting and a stray Enter cannot
// pick a default action.
//
// 🔴 EVERY FORM CARRIES THE ROSTER POSITION BACK, as hidden fields the server
// re-validates with the SAME parser the address bar goes through. Without it, acting
// on the fortieth person returns the manager to page one of an unfiltered list —
// which is not a lie, but it is a screen that loses your place every time you use it.
//
// 🔴 THE DESTRUCTIVE ACTION HAS TWO STEPS AND THE FIRST ONE IS A SENTENCE. Nothing
// in this product can bring a deactivated person back (docs/adr/0010), so the screen
// says that BEFORE the button appears rather than after it has been pressed. The
// step is a plain link because this section loads no script.
//
// ✅ AND IT IS ENFORCED (user decision, 2026-08-08). This screen mints a one-shot
// value bound to this person; the form below carries it and the server refuses a
// deactivation without it, so the write cannot be reached with the sentence unread.
// It was NOT enforced for one round and this comment claimed it was — a security
// audit posted straight at the route and deactivated somebody. Both the gate and the
// sentence are asserted now:
// TestEmployeeDeactivate_TheConfirmationStepIsENFORCED.
templ RosterActions(v RosterActionsView) {
	<section class="docket" aria-label={ "Actions for " + v.Name }>
		<div class="flex items-start justify-between gap-3">
			<div class="min-w-0">
				<p class="docket-label">Managing</p>
				<p class="truncate font-display text-base font-bold tracking-tight text-ink">{ v.Name }</p>
				<p class="mt-1 truncate text-xs text-ink/70">
					if v.Venue != "" {
						{ v.Venue }
					} else {
						Venue could not be read
					}
					if v.Department != "" {
						{ " · " + v.Department }
					}
				</p>
			</div>
			<div class="shrink-0 text-right">
				@lifecycleTally(v.Status)
			</div>
		</div>
		<div class="mt-4 flex flex-col gap-4 border-t border-line pt-4">
			<div class="flex flex-wrap items-center gap-3">
				if v.CanInvite {
					<form method="post" action={ templ.URL(v.InviteAction) }>
						@hiddenFields(v.Hidden)
						<button type="submit" class="btn btn--primary">{ v.InviteLabel }</button>
					</form>
					<p class="text-xs text-ink/70">
						The link is shown once, on the next screen. Tappa keeps no copy of it.
					</p>
				} else {
					// 🔴 IT SAYS WHY RATHER THAN SHOWING NOTHING. A missing button
					// reads as a bug; this is a rule the database enforces
					// (db/queries/invites.sql refuses to spend an invitation for a
					// deactivated person), so the screen states it.
					//
					// ⚠️ BOTH THE ABSENCE AND THE SENTENCE ARE ASSERTED, and they were
					// not until an audit hard-wired the two conditions to true and
					// found the package still green:
					// TestEmployeesSection_OffersNoActionTheServerWouldRefuse.
					<p class="text-xs text-ink/85">
						No invitation can be sent to somebody who has been deactivated.
					</p>
				}
			</div>
			<div class="flex flex-wrap items-center gap-3 border-t border-line pt-4">
				// 🔴 A LINK TO A GET, NOT A CONTROL THAT WRITES (M6-08). Entering a record
				// is a two-step flow with its own confirmation, so what belongs on this
				// card is the way IN to it; putting the form here would mean a permanent
				// attendance record one press away from a list of people. Following this
				// link changes nothing, which is also why it is safe for a crawler.
				//
				// IT IS OFFERED FOR EVERYBODY, INCLUDING SOMEBODY DEACTIVATED, and that
				// is the one action on this card that is. Their last shift is often typed
				// after they leave, and the server does not refuse it — so a screen that
				// hid the control would be hiding something the product supports. The
				// entry screen says who it is recording for.
				<a class="btn btn--quiet" href={ templ.URL(v.RecordHref) }>Enter a record by hand</a>
				<p class="text-xs text-ink/70">
					For somebody with no phone, or a shift nobody tapped out of.
				</p>
			</div>
			<div class="flex flex-wrap items-center gap-3 border-t border-line pt-4">
				if v.CanDeactivate {
					if v.Confirming {
						<p class="text-sm text-ink">
							Deactivating { v.Name } stops their taps from being accepted. Tappa has no
							way to undo it: bringing them back means adding them again as a new person,
							and their old records stay where they are.
						</p>
						<form method="post" action={ templ.URL(v.DeactivateAction) }>
							@hiddenFields(v.Hidden)
							// THE ONE-SHOT CONFIRMATION. Its twin is an HttpOnly cookie bound
							// to this person, so this field alone proves nothing and its
							// absence refuses the write — which is what turns this screen
							// into a gate (user decision, 2026-08-08).
							<input type="hidden" name={ v.ConfirmField } value={ v.ConfirmToken }/>
							<button type="submit" class="btn btn--quiet">Yes, deactivate</button>
						</form>
						<a class="btn btn--quiet" href={ templ.URL(v.CloseHref) }>Cancel</a>
					} else {
						<a class="btn btn--quiet" href={ templ.URL(v.ConfirmHref) }>Deactivate</a>
						<p class="text-xs text-ink/70">Asks first. It cannot be undone afterwards.</p>
					}
				} else {
					<p class="text-xs text-ink/85">
						Their taps are already being refused. Deactivating again would change nothing.
					</p>
				}
			</div>
			<form
				method="post"
				action={ templ.URL(v.MoveAction) }
				class="flex flex-wrap items-end gap-3 border-t border-line pt-4"
			>
				@hiddenFields(v.Hidden)
				// THE FIELDS ARE NAMED to_location AND to_department, not location and
				// department: those two names belong to the FILTERS this form is also
				// carrying back, and one name for two meanings would make saving a move
				// silently narrow the list the manager returns to.
				//
				// 🔴 THE VENUE HAS NO EMPTY OPTION AND THE DEPARTMENT DOES, WHICH IS THE
				// SCHEMA SPEAKING. employees.location_id is NOT NULL (00003): everybody
				// works somewhere, so "no venue" is not a destination, and offering it
				// would offer a submission the server can only refuse.
				// department_id IS nullable — a bar does not model departments — so "No
				// department" is a real choice rather than the absence of one.
				@placementSelect("move-location", "to_location", "Venue", "", v.LocationID, v.Locations)
				@placementSelect("move-department", "to_department", "Department", "No department", v.DepartmentID, v.Departments)
				<div class="filter-actions">
					<button type="submit" class="btn btn--primary">Save placement</button>
					<a class="btn btn--quiet" href={ templ.URL(v.CloseHref) }>Close</a>
				</div>
			</form>
		</div>
	</section>
}

// hiddenFields writes the roster position back into a form.
//
// THE NAMES AND VALUES ARE SERVER-BUILT. The handler produces them from the filter
// it has already parsed, so nothing a client sent is echoed here unvalidated, and
// templ escapes both halves on the way out.
templ hiddenFields(fields []FormField) {
	for _, f := range fields {
		<input type="hidden" name={ f.Name } value={ f.Value }/>
	}
}

// lifecycleTally renders the chip for one lifecycle state.
//
// THE WORD IS ALWAYS THERE, which is the accessibility half of the brand rule:
// status is never told by colour alone, so a chip that lost its tint still says
// DEACTIVATED. An unrecognised status renders NOTHING rather than a bare frame — a
// frame with no word says only "something is true of this person" — and the three
// words below are migration 00003's CHECK vocabulary, a closed set, so that branch
// is unreachable from the database.
//
// THE THREE WORDS ARE THE DATABASE'S OWN, not friendlier synonyms. "No longer here"
// reads better and claims more than the column knows: deactivating somebody is an
// administrative act that a manager may reverse, not a statement that they left the
// company. One vocabulary across the chip, the filter and the schema also means a
// manager who filters on "Deactivated" gets exactly the rows marked DEACTIVATED.
templ lifecycleTally(status string) {
	switch status {
		case "invited":
			<span class="tally tally--invited">INVITED</span>
		case "active":
			<span class="tally tally--active">ACTIVE</span>
		case "deactivated":
			<span class="tally tally--deactivated">DEACTIVATED</span>
	}
}

// RosterFilterBar is the employees section's filter form.
//
// 🔴 IT IS A PLAIN GET FORM AND CARRIES NO SCRIPT, for the reasons FilterBar gives
// and one more that belongs to this section: the employees section loads no script
// at all, so there is nothing here that could have been an interception. Every
// narrowed view is an address — bookmarkable, shareable, openable in a second tab,
// working with JavaScript switched off — and the request cost of filtering stays at
// exactly one, which is the unit adminratelimit.go's budget is counted in.
//
// THE CURSOR IS DELIBERATELY NOT A FIELD OF THIS FORM. Submitting means "show me
// this list with these filters", which must start at the first name; carrying the
// paging position through a filter change would drop the reader into the middle of
// a list they have not seen the top of.
//
// ACCESSIBILITY: every control has a <label for>, the closed vocabularies are
// <select> so nothing can be typed that the validator would reject, and each
// control reserves 44px of height.
templ RosterFilterBar(v RosterFilterView) {
	<form class="filter-bar" method="get" action={ templ.URL(v.Action) } role="search" aria-label="Filter employees">
		<div class="filter-field">
			<label class="docket-label" for="filter-name">Name</label>
			<input
				class="filter-input"
				id="filter-name"
				type="text"
				name="name"
				value={ v.Name }
				placeholder="Part of a name"
				autocomplete="off"
				spellcheck="false"
			/>
		</div>
		@filterSelect("filter-status", "status", "Status", "Everyone", v.Status, v.Statuses)
		@filterSelect("filter-location", "location", "Location", "All locations", v.LocationID, v.Locations)
		@filterSelect("filter-department", "department", "Department", "All departments", v.DepartmentID, v.Departments)
		<div class="filter-actions">
			<button type="submit" class="btn btn--primary">Apply</button>
			if v.Narrowed {
				<a class="btn btn--quiet" href={ templ.URL(v.Action) }>Clear</a>
			}
		</div>
	</form>
}

// placementSelect is the move form's dropdown. It is NOT filterSelect, and the
// difference is one line with a rule behind it: a filter's empty option means "do
// not narrow", which is always a legitimate choice, while a DESTINATION's empty
// option means "nowhere" — legitimate for a department and impossible for a venue.
// Passing "" as the empty label omits the option entirely.
templ placementSelect(id, name, label, emptyLabel, selected string, options []OptionView) {
	<div class="filter-field">
		<label class="docket-label" for={ id }>{ label }</label>
		<select class="filter-input" id={ id } name={ name }>
			if emptyLabel != "" {
				<option value="" selected?={ selected == "" }>{ emptyLabel }</option>
			}
			for _, o := range options {
				<option value={ o.Value } selected?={ o.Value == selected }>
					{ o.Label }
					if o.Group != "" {
						{ " — " + o.Group }
					}
				</option>
			}
		</select>
	</div>
}
