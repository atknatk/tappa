package operatorpages

import (
	"strconv"

	"github.com/atknatk/tappa/web/templates/components"
)

// Tenants is /operator/tenants (M10 OP-11; ADR 0020 §4): the search, a page of the tenant
// list newest first, and the pager.
//
// THE SEARCH IS A POST FORM, AND SO IS EVERY PAGE OF A LIST. A term can be a panel
// account's email address -- personal data -- and a URL is written to the ingress's
// access log and the browser's history; so the form posts the term in its body, and the
// pager is two forms that post the term and the page number as hidden fields. The box
// asks the browser to keep no history of what was typed in it (autocomplete off). The
// links on this page carry no term.
//
// A TENANT CHOSE ITS NAME, AND THE OPERATOR TYPED THE TERM: both reach the page as data.
// Every value is a templ expression, escaped, and the two are isolated for bidirectional
// text (bdi), so a direction override inside one does not turn the words around it.
// A row whose tenant shows no name says "Unnamed tenant"; its id is printed beside it.
//
// THE REDESIGN (M13-07; docs/design/operator-redesign README §6.1 "Tenants row", screens.md §5,
// boards OpTenants): one card -- the mono label, the h1 at the board's 28 px at every width, the
// search form, the matching line under a dashed rule and the card's links on one row from the
// tablet -- then the list on its docket and the pager, which keeps its text links. The form's
// four children stay in the order a phone reads them (label, box, help, button); from the
// tablet the button stands beside the box and the help under both, by placement, not by moving
// an element. The card spaces its blocks; its bodies carry no top margin. Pinned by
// TestTenantsScreen_IsTheSearchCardTheDocketAndThePager.
templ Tenants(v TenantsView) {
	@screen("Tenants", true, navTenants) {
		<section class="op-card">
			<p class="op-label">Tenants</p>
			<h1 class="font-display text-[28px] font-bold leading-[1.1] tracking-[-0.03em]">Find a tenant</h1>
			<form method="post" action="/operator/tenants" role="search" class="flex flex-col gap-2 md:grid md:grid-cols-[minmax(0,1fr)_auto] md:gap-x-2.5">
				<label for="tenant-search" class="op-label md:col-span-2">Search</label>
				<input id="tenant-search" type="search" name="q" value={ v.Search } maxlength="254" autocomplete="off" spellcheck="false" class="op-input"/>
				<p class="text-xs leading-[1.45] text-ink/70 md:col-span-2 md:row-start-3">
					Part of a business name, a panel account's whole email address, or a tenant id. Leave it
					empty to list every tenant.
				</p>
				<button type="submit" class="btn btn--primary md:col-start-2 md:row-start-2">Search</button>
			</form>
			if v.Search != "" {
				<p class="border-t border-dashed border-line pt-3.5 text-sm [overflow-wrap:anywhere] [&>bdi]:font-bold">
					Tenants matching <bdi class="font-mono">{ v.Search }</bdi>.
				</p>
			}
			<p class="flex flex-col items-start text-sm md:flex-row md:flex-wrap md:gap-x-6">
				if v.Search != "" {
					<a href="/operator/tenants" class="op-link">Show every tenant</a>
				}
				<a href="/operator" class="op-link">Back to the console</a>
			</p>
		</section>
		@tenantList(v)
		@tenantPager(v)
	}
}

// tenantList is the page of tenants on a docket: each row links to the tenant's
// overview by its name and shows when it signed up (UTC), its plan, its id, mono, and -- for a
// tenant whose panel refuses writes -- the suspension's chip (OP-15 C), in the rejection tone.
// The row's layout per width is input.css's, scoped from the list's heading id, so the row's
// pinned markup carries no class for it (README §6.1 "Tenants row").
templ tenantList(v TenantsView) {
	<section class="docket" aria-labelledby="tenant-list">
		<h2 id="tenant-list" class="docket-label">Newest first · page <span class="font-mono">{ strconv.Itoa(v.Page) }</span></h2>
		if len(v.Rows) == 0 {
			if v.Page > 1 {
				<p class="mt-4 pb-1 font-display">This page is empty: the list ended on the page before.</p>
			} else if v.Search != "" {
				<p class="mt-4 pb-1 font-display">No tenant matches that search.</p>
			} else {
				<p class="mt-4 pb-1 font-display">There are no tenants yet.</p>
			}
		} else {
			<ol class="mt-3">
				for _, r := range v.Rows {
					<li class="op-row">
						<a href={ templ.URL(r.Path) } class="op-link">
							if r.Name == "" {
								<span class="italic">{ unnamedTenant }</span>
							} else {
								<bdi>{ r.Name }</bdi>
							}
						</a>
						<span>Since { r.CreatedAt }</span>
						<span>{ r.Plan }</span>
						if r.Suspended {
							<span class="tally tally--tenant-suspended">Suspended</span>
						}
						<span class="break-all text-xs text-ink/70">{ r.ID }</span>
					</li>
				}
			</ol>
		}
	</section>
}

// tenantPager is the way to the page before and after this one -- each a form that
// posts the same term and the page's number.
templ tenantPager(v TenantsView) {
	if v.Page > 1 || v.HasNext {
		<nav class="flex flex-wrap items-center gap-x-6" aria-label="Pages of the list">
			if v.Page > 1 {
				@tenantPageForm(v.Search, v.Page-1, "Previous page")
			}
			if v.HasNext {
				@tenantPageForm(v.Search, v.Page+1, "Next page")
			}
		</nav>
	}
}

templ tenantPageForm(search string, page int, label string) {
	<form method="post" action="/operator/tenants">
		<input type="hidden" name="q" value={ search }/>
		<input type="hidden" name="page" value={ strconv.Itoa(page) }/>
		<button type="submit" class="op-link">{ label }</button>
	</form>
}

// TenantOverview is /operator/tenants/{id} (M10 OP-11; ADR 0020 §4, §9): one tenant's
// identity and four counts of what is live, inside TenantScreen -- the tenant's name is
// in the banner and the document title, and a tenant whose stored name shows nothing is
// named by its id. The counts are what op_read_tenant_detail returns: every location, and
// the employees, plaques and panel accounts whose status is active -- no person, no
// address, no plaque uid (ADR 0021, OP-11 note md. 5). Under the counts, links to the
// tenant's plaques (OP-13), its billing months (OP-12) and its VAT number (OP-16), each a read
// of its own -- the overview itself shows no VAT number (OP-11's minimisation). Below them, the
// overview's two cards that change the tenant, each its state and the form that state calls for:
// the integration API (M11 API-13a; tenantAPISection) and, last, whether the business's panel
// takes writes (OP-15 C; tenantSuspension) -- the gravest of the overview's writes at its foot.
//
// THE REDESIGN (M13-08; docs/design/operator-redesign screens.md §6, boards OpTenant): the page's
// one h1 is the first card's small label "Tenant overview" -- the page heading, not the tenant's
// name, which is the banner's (orchestrator decision (c)); it keeps the label's look, as the boards
// draw it. The facts: on the phone the id and the sign-up time each on a line of their own and
// plan and business type side by side, two columns on the tablet, and on the desktop the boards'
// four tracks, wide enough for the id on one line. The counts: two by two on the phone, four
// across from the tablet, their figures at the boards' sizes by a rule on the list (the figure's
// own markup is pinned). Each card spaces its blocks; its bodies carry no top margin. Links stack
// on the phone and stand in a row from the tablet. Pinned by
// TestTenantOverviewScreen_IsTheFactsTheCountsAndTheTwoWriteCards.
templ TenantOverview(v TenantOverviewView) {
	@TenantScreen("Tenant overview", v.Name, v.Tabs, TabOverview) {
		<section class="op-card">
			<h1 class="docket-label">Tenant overview</h1>
			<dl class="grid grid-cols-2 gap-x-4 gap-y-3.5 md:gap-x-5 md:gap-y-4 desk:grid-cols-[320px_200px_minmax(0,1fr)_minmax(0,1fr)]">
				@tenantFact("Tenant id", v.ID, true)
				@tenantFact("Signed up", v.CreatedAt, true)
				@tenantFact("Plan", v.Plan, false)
				@tenantFact("Business type", v.BusinessType, false)
			</dl>
		</section>
		<section class="docket" aria-labelledby="tenant-live">
			<h2 id="tenant-live" class="docket-label">Live now</h2>
			<dl class="mt-3 grid grid-cols-2 items-end gap-4 md:grid-cols-4 md:gap-x-5">
				@tenantCount("Locations", v.Locations)
				@tenantCount("Active employees", v.ActiveEmployees)
				@tenantCount("Active plaques", v.ActivePlaques)
				@tenantCount("Active panel accounts", v.ActiveAdmins)
			</dl>
			<p class="mt-3 text-xs leading-[1.45] text-ink/70">
				Counted when this page was opened. Locations have no status; the other three count the
				active ones only.
			</p>
			<p class="mt-2 flex flex-col items-start text-sm md:flex-row md:flex-wrap md:gap-x-6">
				<a href={ templ.URL(v.PlaquesPath) } class="op-link">See this tenant's plaques</a>
				<a href={ templ.URL(v.BillingPath) } class="op-link">See this tenant's billing</a>
				<a href={ templ.URL(v.VATPath) } class="op-link">See this tenant's VAT number</a>
			</p>
		</section>
		@tenantAPISection(v.API)
		@tenantSuspension(v.Suspension)
		<p class="flex flex-col items-start text-sm md:flex-row md:flex-wrap md:gap-x-6">
			<a href="/operator/tenants" class="op-link">Back to the tenants</a>
			<a href="/operator" class="op-link">Back to the console</a>
		</p>
	}
}

// tenantFact is one labelled fact. A wide one takes both of the phone's two columns (the id, a
// time) and one track from the tablet on.
templ tenantFact(label, value string, wide bool) {
	if wide {
		<div class="col-span-2 md:col-span-1">
			<dt class="docket-label">{ label }</dt>
			<dd class="mt-1 break-all font-mono text-sm">{ value }</dd>
		</div>
	} else {
		<div>
			<dt class="docket-label">{ label }</dt>
			<dd class="mt-1 break-all font-mono text-sm">{ value }</dd>
		</div>
	}
}

templ tenantCount(label, value string) {
	<div>
		<dt class="docket-label">{ label }</dt>
		<dd class="mt-1 font-mono text-3xl font-bold">{ value }</dd>
	</div>
}

// tenantAPISection is the overview's integration API section (M11 API-13a; K-22): whether the API is
// open, since when and under which code, the form that opens it (or changes the code of an open one),
// and -- open -- the button that closes it. The sentence above it is the overview's own read about the
// last write: the write's answer says nothing about what the database found (ADR 0021 §2 v 7).
templ tenantAPISection(a TenantAPIView) {
	@apiNotice(a)
	<section class="op-card" aria-labelledby="tenant-api">
		<h2 id="tenant-api" class="docket-label">Integration API</h2>
		<p class="flex flex-wrap items-center gap-x-3.5 gap-y-2">
			if a.Open {
				<span class="tally tally--active">Open</span>
				<span class="text-sm">Since <span class="font-mono">{ a.OpenedAt }</span></span>
			} else {
				<span class="tally tally--deactivated">Closed</span>
			}
			if a.Code == "" {
				<span class="text-sm">No API code</span>
			} else {
				<span class="text-sm">API code <span class="font-mono">{ a.Code }</span></span>
			}
		</p>
		<p class="text-sm leading-normal">
			if a.Open {
				The business's integration keys work and its webhooks are sent. Every punch names it by this code.
			} else if a.Code != "" {
				The business's integration keys are refused and no webhook is sent. Punches are still recorded, and keep this code.
			} else {
				The API has never been opened for this business. Its owner can create keys in the panel; they work once it is open.
			}
		</p>
		<form method="post" action={ templ.URL(a.OpenPath) } class="flex flex-col gap-2 border-t border-dashed border-line pt-3.5 md:grid md:grid-cols-[minmax(0,220px)_auto] md:justify-start md:gap-x-2.5">
			<label for="tenant-api-code" class="op-label md:col-span-2">API code</label>
			<input id="tenant-api-code" type="text" name="api_code" value={ a.Code } maxlength="16" required autocomplete="off" spellcheck="false" class="op-input font-mono"/>
			<p class="text-xs leading-[1.45] text-ink/70 md:col-span-2 md:row-start-3">A capital letter followed by 1 to 15 capital letters or digits, such as KF. No other business in its holding may have it.</p>
			<button type="submit" class="btn btn--primary md:col-start-2 md:row-start-2 md:justify-self-start">
				if a.Open {
					Change the code
				} else {
					Open the API
				}
			</button>
		</form>
		if a.Open {
			<form method="post" action={ templ.URL(a.ClosePath) } class="flex flex-col md:block">
				<button type="submit" class="btn btn--quiet">Close the API</button>
			</form>
		}
	</section>
}

// apiNotice is the sentence about the last API write, in the notice block of the tone the handler
// chose; the enable's rules, when set, are listed under it.
templ apiNotice(a TenantAPIView) {
	switch a.NoticeTone {
		case HoldingNoticeOK:
			@opNotice(components.ToneOK, a.NoticeHeading) {
				<p>{ a.Notice }</p>
			}
		case HoldingNoticeWarn:
			@opNotice(components.ToneWarn, a.NoticeHeading) {
				<p>{ a.Notice }</p>
				if len(a.NoticeRules) > 0 {
					<ul class="mt-1 list-disc pl-5">
						for _, rule := range a.NoticeRules {
							<li>{ rule }</li>
						}
					</ul>
				}
			}
	}
}

// tenantSuspension is the overview's suspension card (M10 OP-15 C; ADR 0025 §5): whether the
// business's panel takes writes -- the chip says it in words, its frame repeats it -- and, by that
// state, ONE form. The answer to either form is a redirect back to this overview, which reads the
// database again: the page never says "already suspended" (ADR 0021 §2 v 7).
templ tenantSuspension(v TenantSuspensionView) {
	<section class="op-card" aria-labelledby="tenant-suspension">
		<h2 id="tenant-suspension" class="docket-label">Panel writes</h2>
		if v.Suspended {
			<p><span class="tally tally--tenant-suspended">Suspended</span></p>
			<p class="text-sm leading-normal">
				The business's panel refuses its writes. Taps, signing in, reading every section, the CSV exports and the
				four paths of the time record stay open.
			</p>
			<dl class="grid grid-cols-1 gap-4 md:grid-cols-2">
				@tenantFact("Suspended since", v.Since, false)
				<div>
					<dt class="docket-label">Reason</dt>
					<dd class="mt-1 text-sm">
						@suspensionReason(v.Reason)
					</dd>
				</div>
			</dl>
			@reinstateForm(v)
		} else {
			<p><span class="tally tally--tenant-active">Active</span></p>
			<p class="text-sm leading-normal">The business's panel accepts its writes.</p>
			@suspendForm(v)
		}
	</section>
}

// suspensionReason is the stored reason: the operator's label, or an unrecognised value -- its raw
// text in the data face when the handler kept it, and the unrecognised chip.
templ suspensionReason(w AuditWord) {
	if w.Unknown && w.Text != "" {
		<span class="font-mono">{ w.Text }</span> <span class="tally tally--unrecognised">Unrecognised</span>
	} else if w.Unknown {
		<span class="tally tally--unrecognised">Unrecognised</span>
	} else {
		{ w.Text }
	}
}

// suspendForm suspends the tenant: a reason of the closed set and a ticked box, nothing else -- no
// free text (ADR 0025 §1), and the tenant is the action's path, not a field.
//
// THE SECURITY HOLD'S WARNING IS CLOSED TEXT, written here and nowhere else, and it is in the
// page whatever is chosen: the stylesheet hides it until the security-hold choice is checked (the
// warning follows the choices in the same parent, so a sibling rule can see it -- no script; the
// page's policy allows none). A browser that loads no stylesheet shows it always.
templ suspendForm(v TenantSuspensionView) {
	<form method="post" action={ templ.URL(v.SuspendPath) } class="flex flex-col gap-3 border-t border-dashed border-line pt-3.5">
		<h3 class="font-display text-lg font-bold tracking-tight">Suspend this tenant's writes</h3>
		<p class="text-sm leading-normal">
			Every write of the business's panel is refused until the suspension is lifted — except signing in and out,
			a panel account's own password, and the four paths of the time record: adding a person to the staff, a new
			invitation and both steps of a manual entry. Taps, reading every section and the CSV exports go on, and the
			months of a suspension are billed as usual.
		</p>
		<p class="text-sm leading-normal">
			Every section shows the business a banner with a sentence for the reason: non-payment and a breach of the
			terms are named; a security hold and the business's own request share one neutral sentence.
		</p>
		<fieldset>
			<legend class="docket-label">Reason</legend>
			<div class="op-reasons mt-1">
				for _, o := range v.Reasons {
					if o.Hold {
						<input
							id={ "suspend-reason-" + o.Value }
							class="op-reason-hold h-5 w-5 accent-tappa-green"
							type="radio"
							name="reason"
							value={ o.Value }
							required
							aria-describedby="suspend-hold-warning"
						/>
					} else {
						<input
							id={ "suspend-reason-" + o.Value }
							class="h-5 w-5 accent-tappa-green"
							type="radio"
							name="reason"
							value={ o.Value }
							required
						/>
					}
					<label for={ "suspend-reason-" + o.Value } class="inline-flex min-h-11 items-center text-sm">{ o.Label }</label>
				}
				<div id="suspend-hold-warning" class="op-hold-warning">
					@opNotice(components.ToneWarn, "A security hold freezes writes. It does not contain an account.") {
						@holdWarning()
					}
				</div>
			</div>
		</fieldset>
		<label class="inline-flex min-h-11 items-center gap-2 text-sm">
			<input type="checkbox" name="confirm" value="yes" required class="h-5 w-5 shrink-0 accent-tappa-green"/>
			I have checked that this is the right tenant.
		</label>
		<button type="submit" class="btn btn--quiet self-start">Suspend writes</button>
	</form>
}

// holdWarning is the security hold's closed text (ADR 0025 §5; the gist of its limits 11 and 13):
// what a suspension leaves open to whoever holds a session of the business, what it closes to the
// business itself, and the three acts that do stop an account.
templ holdWarning() {
	<p>Whoever holds a session of this business keeps it. While the business is suspended, that session still:</p>
	<ul class="mt-1 list-disc pl-5">
		<li>reads every section and exports the CSV files;</li>
		<li>
			adds people to the staff and sends new invitations — an invitation signs a new phone in as an employee and
			signs that employee's other phones out;
		</li>
		<li>
			enters manual records, which are written with no approval and count in the hours at once. A record that
			cuts a real employee's hours cannot be undone by another record: a correction can only shorten.
		</li>
	</ul>
	<p class="mt-2">
		The business's own defensive writes stop too: it cannot deactivate an employee or replace or remove a plaque.
		Every section shows a banner saying its writes are suspended — the sentence names no reason, but the freeze
		itself tells the session holder something changed.
	</p>
	<p class="mt-2 font-bold">What does stop an account:</p>
	<ul class="mt-1 list-disc pl-5">
		<li>disabling the panel account — today the platform owner sets it to disabled in the database;</li>
		<li>
			a password reset by the business's rightful admin — it does not ask for the current password and ends every
			session of that account, so it is the tool when the password may have been changed;
		</li>
		<li>the rightful admin changing their own password — it ends their other sessions, and asks for the current password.</li>
	</ul>
}

// reinstateForm lifts the suspension: a ticked box, nothing else.
templ reinstateForm(v TenantSuspensionView) {
	<form method="post" action={ templ.URL(v.ReinstatePath) } class="flex flex-col gap-3 border-t border-dashed border-line pt-3.5">
		<h3 class="font-display text-lg font-bold tracking-tight">Lift the suspension</h3>
		<p class="text-sm leading-normal">
			The business's panel accepts its writes again from its next request. The suspension and its lifting stay on
			record in the business's own audit log and in the operator audit log.
		</p>
		<label class="inline-flex min-h-11 items-center gap-2 text-sm">
			<input type="checkbox" name="confirm" value="yes" required class="h-5 w-5 shrink-0 accent-tappa-green"/>
			I have checked that this is the right tenant.
		</label>
		<button type="submit" class="btn btn--primary self-start">Lift the suspension</button>
	</form>
}
