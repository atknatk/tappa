package operatorpages

import "github.com/atknatk/tappa/web/templates/components"

// TenantVAT is /operator/tenants/{id}/vat (M10 OP-16; ADR 0020 §4, §9): one tenant's VAT number
// and the EU VAT register's (VIES) verdict on file, inside TenantScreen -- the tenant's name in
// the banner and the document title, and a tenant whose stored name shows nothing named by its
// id.
//
// THE FORM CARRIES NOTHING BUT ITS BUTTON. The server sends VIES the number its own read
// returned, never one from the request (the orchestrator's K16-1), so there is no field to
// edit, hide or forge -- the page shows the number as text in the data face. When the number is
// not in the format VIES accepts for its country, the form is not drawn and a sentence says why,
// and who can correct it (vat.go's vatNotices).
//
// THE VERDICT IS SAID IN WORDS, with a chip that repeats it: the customer's account screen's
// four words, the operator's sentences. A POST that changed nothing -- VIES did not answer,
// the number could not be sent, the session's VIES budget -- answers with this same screen and
// a notice above the record saying that nothing was changed; a POST whose answer was recorded
// answers with a redirect to this screen, which reads the record again.
templ TenantVAT(v TenantVATView) {
	@TenantScreen("VAT number", v.Name) {
		<section class="op-card">
			<p class="docket-label">VAT number</p>
			<h1 class="mt-1 font-display text-2xl font-bold tracking-tight">VAT re-check</h1>
			<p class="mt-3 text-sm">
				The VAT number this business registered with, and the answer of the EU VAT register (VIES) on file for it.
			</p>
			<p class="mt-2 flex flex-wrap gap-x-6">
				<a href={ templ.URL(v.OverviewPath) } class="op-link">Back to the overview</a>
				<a href="/operator/tenants" class="op-link">Back to the tenants</a>
			</p>
		</section>
		if v.Notice != "" {
			@components.Notice(components.ToneWarn, v.NoticeHeading) {
				<p>{ v.Notice }</p>
			}
		}
		<section class="docket" aria-labelledby="tenant-vat">
			<h2 id="tenant-vat" class="docket-label">On file</h2>
			<dl class="mt-3 flex flex-col gap-3">
				<div>
					<dt class="docket-label">VAT number</dt>
					<dd class="mt-1 break-all font-mono text-lg font-bold">{ v.Number }</dd>
				</div>
				<div>
					<dt class="docket-label">VIES answer</dt>
					<dd class="mt-1">
						@vatChip(v)
					</dd>
				</div>
			</dl>
			<p class="mt-3 text-sm">{ v.Sentence }</p>
			if v.AskedAt != "" && v.Answered {
				<p class="mt-2 text-sm">Last answer <span class="font-mono">{ v.AskedAt }</span></p>
			} else if v.AskedAt != "" {
				<p class="mt-2 text-sm">Asked <span class="font-mono">{ v.AskedAt }</span></p>
			} else {
				<p class="mt-2 text-sm">No time of asking is on file.</p>
			}
		</section>
		<section class="op-card" aria-labelledby="tenant-vat-ask">
			<h2 id="tenant-vat-ask" class="docket-label">Ask again</h2>
			if v.Askable {
				<p class="mt-2 text-sm">
					Sends the number above to VIES now. If VIES answers, its answer replaces the one on file and is written
					to this tenant's own audit log; if it does not answer, nothing changes.
				</p>
				<form method="post" action={ templ.URL(v.VATPath) } class="mt-4">
					<button type="submit" class="btn btn--primary">Ask VIES again</button>
				</form>
			} else {
				<p class="mt-2 text-sm">
					This number is not in the format VIES accepts for its country, so it cannot be sent from here. Only the platform owner can correct it, in the database.
				</p>
			}
		</section>
	}
}

// vatChip is the verdict's chip: the word is the view's label, the frame and ground its tone's.
// A tone this switch does not name -- the zero value included -- draws the unrecognised chip.
templ vatChip(v TenantVATView) {
	switch v.Tone {
		case VATToneConfirmed:
			<span class="tally tally--vat-confirmed">{ v.Label }</span>
		case VATToneNotFound:
			<span class="tally tally--vat-not-found">{ v.Label }</span>
		case VATToneNoAnswer:
			<span class="tally tally--vat-no-answer">{ v.Label }</span>
		case VATToneNotChecked:
			<span class="tally tally--vat-not-checked">{ v.Label }</span>
		default:
			<span class="tally tally--unrecognised">{ v.Label }</span>
	}
}
