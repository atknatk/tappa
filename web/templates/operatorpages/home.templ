package operatorpages

import "github.com/atknatk/tappa/web/templates/components"

// Home is /operator, the console's front page.
//
// It shows no tenant data and makes no read: it is the operator's menu. The page says it
// is signed in and links the operator screens this build has -- the tenants (OP-11; ADR
// 0020 §4 named /operator itself as the tenant list, but the list is a READ, two units of
// the session budget and an audit row, and the front page every sign-in lands on is not
// made to cost one), Taptime's legal texts (OP-10), the holdings (M11 API-1a; a read too) and
// the operator's own audit log (OP-14; a read as well, so a link and not the landing page) --
// beside the bar's sign-out form.
// Its links are held to the mounted routes by
// TestOperatorScreens_EveryActionAndLinkIsAMountedRoute. The session facts it states are
// ADR 0020 §2's, enforced by op_touch_session.
//
// It does not show the operator's address: the session resolves to an id, and no
// definer reads an operator's email (a new op_* is a migration).
//
// THE REDESIGN (M13-06; docs/design/operator-redesign README §6.1 "Home hub", screens.md §3):
// still one card -- the mono label over the h1, at the board's 28 px at every width; the four
// links each beside its gloss from the tablet on and above it on the phone, every link 44 px
// tall; the session sentence the card's last line. The links' 17 px comes from their list item,
// not from a class on the anchor, whose whole tag is pinned. No icon tiles: the only drawings a
// signed-in page carries are the nav's five (TestEnrollQR_OnlyOnTheFirstLoad). Pinned by
// TestHomeScreen_IsOneCardOfFourLinksAndReadsNothing.
templ Home() {
	@screen("Console", true, navConsole) {
		<section class="op-card flex flex-col gap-3.5">
			<div class="flex flex-col gap-1.5">
				<p class="op-label">Operator console</p>
				<h1 class="font-display text-[28px] font-bold leading-[1.1] tracking-[-0.03em]">You are signed in</h1>
			</div>
			<ul class="border-t border-line">
				<li class="flex flex-col items-start border-b border-dashed border-line pt-0.5 pb-3 text-[17px] md:grid md:grid-cols-[128px_minmax(0,1fr)] md:items-baseline md:justify-items-start md:gap-x-4 md:py-1">
					<a href="/operator/tenants" class="op-link">Tenants</a>
					<span class="text-sm leading-[1.45] text-ink/70">— find a business, and see what it has live</span>
				</li>
				<li class="flex flex-col items-start border-b border-dashed border-line pt-0.5 pb-3 text-[17px] md:grid md:grid-cols-[128px_minmax(0,1fr)] md:items-baseline md:justify-items-start md:gap-x-4 md:py-1">
					<a href="/operator/legal" class="op-link">Legal texts</a>
					<span class="text-sm leading-[1.45] text-ink/70">— Taptime's privacy policy, terms, company details and cookie notice</span>
				</li>
				<li class="flex flex-col items-start border-b border-dashed border-line pt-0.5 pb-3 text-[17px] md:grid md:grid-cols-[128px_minmax(0,1fr)] md:items-baseline md:justify-items-start md:gap-x-4 md:py-1">
					<a href="/operator/holdings" class="op-link">Holdings</a>
					<span class="text-sm leading-[1.45] text-ink/70">— group businesses that work in one timezone, and see who is in each</span>
				</li>
				<li class="flex flex-col items-start border-b border-dashed border-line pt-0.5 pb-3 text-[17px] md:grid md:grid-cols-[128px_minmax(0,1fr)] md:items-baseline md:justify-items-start md:gap-x-4 md:py-1">
					<a href="/operator/audit" class="op-link">Audit log</a>
					<span class="text-sm leading-[1.45] text-ink/70">— every sign-in, read and publication on this surface</span>
				</li>
			</ul>
			<p class="max-w-[620px] text-sm leading-normal text-ink/70">
				A session ends after 30 minutes without use, and after 8 hours in any case. Sign out
				when you are done.
			</p>
		</section>
	}
}

// Problem is the operator surface's refusal and fault page. Its sentences come from the
// handler's ProblemView constants.
//
// THE PAGE IS ONE ALERT CARD (M13-03; docs/design/operator-redesign README §6 "Problem page",
// screens.md §4): the operator notice in its alert tone, holding the page's one h1 (the title) and
// the message, and under it the way on, when the constant names one. Signed out it sits in the
// narrow centred column of the sign-in, with no nav; signed in it sits in the frame, whose nav marks
// no section (navNone: a refusal is no section's page) and which has no tenant banner, because no
// problem names a tenant. No state chip either: the view carries no state, only words (D1). The
// card's inner spacing is written here, on its two lines; its padding and type are the op-problem
// rules of input.css.
templ Problem(v ProblemView) {
	@screen(v.Title, v.SignedIn, navNone) {
		<div class="op-problem">
			@opNotice(components.ToneAlert, "") {
				<h1 class="op-problem-title">{ v.Title }</h1>
				<p class="mt-2.5 text-[15px] leading-normal">{ v.Message }</p>
			}
			if v.Back != "" {
				<p class="text-[15px]">
					<a href={ templ.URL(v.Back) } class="op-link">{ v.BackLabel }</a>
				</p>
			}
		</div>
	}
}
