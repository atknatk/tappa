package operatorpages

import "github.com/atknatk/tappa/web/templates/components"

// SignIn is the operator's password step (ADR 0020 §3.1): one address, one password.
//
// THE FAILURE SENTENCE NAMES NO CAUSE. An unknown address, a wrong password, a pending
// account and a disabled one are ADR 0020 §3's "same answer, same time" set, and
// SignInView has no field for which one it was. The typed address is not put back into
// the field: internal/operatorauth's
// TestSurface_EveryRefusedSignInPaysOneComparisonAndAnswersAlike compares the refused
// pages of its eight arms byte for byte.
//
// No synchronizer token: the operator's cookies are SameSite=Strict on a host of their
// own, and a POST here passes the operator surface's origin check before the form is
// read -- the Origin, or with none the fetch metadata's same-origin
// (internal/handler/operator, sameOriginGate; TestSameOriginGate_ACrossOriginPostReachesNoStore).
//
// THE CARD (M13-04; docs/design/operator-redesign screens.md §1, boards OpSignIn): at most 480 px,
// centred in screen's signed-out column; the heading and its line under it, then the notice when
// there is one, then the form. Nothing else: no reset, no sign-up, no "keep me signed in" -- none
// exists (a reset is the owner's new setup link, cmd/opadmin). The code step is the same card.
templ SignIn(v SignInView) {
	@screen("Sign in", false, navNone) {
		<section class="op-card mx-auto flex w-full max-w-[480px] flex-col gap-3.5">
			<div class="flex flex-col gap-2">
				<h1 class="font-display text-[26px] font-bold leading-[1.08] tracking-[-0.03em] md:text-[30px]">Operator sign-in</h1>
				<p class="text-sm leading-[1.45] text-ink/70">Taptime staff only. This is not the business panel.</p>
			</div>
			if v.Expired {
				@opNotice(components.ToneWarn, "That sign-in step expired") {
					<p>Sign in again with your email address and password.</p>
				}
			}
			if v.Failed {
				@opNotice(components.ToneAlert, "We could not sign you in") {
					<p>Check the email address and the password, then try again.</p>
				}
			}
			<form method="post" action="/operator/login" class="flex flex-col gap-[18px]">
				<div class="flex flex-col gap-1.5">
					<label for="op-email" class="op-label">Email</label>
					<input id="op-email" name="email" type="email" autocomplete="username" required autofocus class="op-input"/>
				</div>
				<div class="flex flex-col gap-1.5">
					<label for="op-password" class="op-label">Password</label>
					<input id="op-password" name="password" type="password" autocomplete="current-password" required class="op-input"/>
				</div>
				<button type="submit" class="btn btn--primary">Continue</button>
			</form>
		</section>
	}
}

// Code is the TOTP step (ADR 0020 §3.2). The handler renders it for a request with a
// login challenge cookie and redirects the others to the password step.
//
// Locked is the database's lock (ADR 0020 §3: N wrong codes). It is shown to a request
// holding a challenge, which the right password mints, so it tells the password holder
// what trying codes would tell them.
templ Code(v CodeView) {
	@screen("Sign-in code", false, navNone) {
		<section class="op-card mx-auto flex w-full max-w-[480px] flex-col gap-3.5">
			<div class="flex flex-col gap-2">
				<h1 class="font-display text-[26px] font-bold leading-[1.08] tracking-[-0.03em] md:text-[30px]">Enter your code</h1>
				<p class="text-sm leading-[1.45] text-ink/70">Type the six-digit code your authenticator app shows for Taptime operator.</p>
			</div>
			if v.Rejected {
				@opNotice(components.ToneAlert, "That code was not accepted") {
					<p>Check that your phone's clock is right, then type the next code.</p>
				}
			}
			if v.Locked {
				@opNotice(components.ToneAlert, "Sign-in is locked for a while") {
					<p>Too many wrong codes. Wait a quarter of an hour, then try again.</p>
				}
			}
			<form method="post" action="/operator/login/totp" class="flex flex-col gap-[18px]">
				<div class="flex flex-col gap-1.5">
					<label for="op-code" class="op-label">Code</label>
					<input id="op-code" name="code" type="text" inputmode="numeric" autocomplete="one-time-code" required autofocus class="op-input min-h-14 text-[22px] tracking-[0.3em]"/>
				</div>
				<button type="submit" class="btn btn--primary">Sign in</button>
			</form>
			<p class="text-sm">
				<a href="/operator/login" class="op-link">Start again</a>
			</p>
		</section>
	}
}
