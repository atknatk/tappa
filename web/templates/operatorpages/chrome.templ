package operatorpages

import "github.com/atknatk/tappa/web/templates/layout"

// THE OPERATOR CHROME (M10 OP-8). The nine exported screens of this package (OP-10
// added Legal, OP-11 Tenants and TenantOverview) render inside screen, scriptedScreen or
// tenantScreen below, and each of the three draws bar first. Measured:
// TestOperatorScreens_EveryOneWearsTheOperatorChrome renders the variants screens() makes
// of the nine and looks for the "TAPTIME OPERATOR" lockup. A page that called the layout
// shell itself would skip the bar; that is code review's.
//
// HOW IT IS SET APART FROM THE RESTAURANT PANEL, AND WHY BY PLACEMENT RATHER THAN BY A
// NEW COLOUR (skill tappa-brand: no colour outside the palette). The panel is light
// chrome on porcelain: the green "taptime" wordmark, a tab bar underlined in
// tappa-green, white cards. The operator bar inverts that -- a full-width ink band
// with the lockup in IBM Plex Mono capitals and a saffron rule under it. Saffron is
// the palette's WARNING colour (the skill's status table), and the bar uses it for that:
// this surface reaches across tenants (ADR 0021: the op_* definers). No tab bar, no green
// wordmark, a narrower column: the two surfaces are meant not to be mistaken for each
// other -- a design judgement the brand review makes, not a test.
//
// CONTRAST, COMPUTED (WCAG 2.1 relative luminance, sRGB; the ground is ink #152219):
// paper text 16.17:1 · saffron text 6.16:1 · the docket label tone (ink at 70%) on the
// tenant banner's saffron-lite 5.6:1 (the skill's own table). AA asks 4.5:1 of the
// three -- the lockup is 14px and bold, which is NOT large text.
// TestOperatorChrome_TheColouredTextClearsAA recomputes the first two from the palette
// in tailwind.config.js.

// bar is the operator band. signedIn adds the sign-out control -- a POST form, because
// ending a session changes server state (op_close_session) and a GET link would let a
// page that makes the browser fetch a URL sign the operator out.
templ bar(signedIn bool) {
	<header class="op-bar">
		<div class="mx-auto flex w-full max-w-3xl flex-wrap items-center justify-between gap-3 px-4 py-3">
			<p class="op-lockup">
				TAPTIME <span class="text-saffron">OPERATOR</span>
			</p>
			if signedIn {
				<form method="post" action="/operator/logout">
					<button type="submit" class="op-signout">Sign out</button>
				</form>
			}
		</div>
	</header>
}

// tenantBanner names the tenant a screen is showing, under the bar and above the
// screen's content (ADR 0020 §9). In this package's source today its caller is
// tenantScreen, whose caller is TenantScreen, which refuses the zero name (read, not
// pinned). A tenant named by its id (UnnamedTenant) shows the placeholder's words and
// the id, mono. The name is isolated for bidirectional text: a tenant chose it, and a
// direction override inside it must not turn the banner's other words around.
templ tenantBanner(name TenantName) {
	<section class="op-tenant" aria-label="Tenant">
		<div class="mx-auto w-full max-w-3xl px-4 py-3">
			<p class="docket-label">Tenant</p>
			if name.byID {
				<p class="font-display text-xl font-bold tracking-tight">{ unnamedTenant }</p>
				<p class="break-all font-mono text-sm">{ name.v }</p>
			} else {
				<p class="font-display text-xl font-bold tracking-tight"><bdi>{ name.v }</bdi></p>
			}
		</div>
	</section>
}

// screen is a platform-wide operator screen: no tenant in view.
templ screen(title string, signedIn bool) {
	@layout.Operator(title + " — Taptime operator") {
		@bar(signedIn)
		<main class="mx-auto flex w-full max-w-3xl flex-col gap-6 px-4 py-8">
			{ children... }
		</main>
	}
}

// scriptedScreen is screen plus one script; Enroll is its caller. It draws the bar
// signed out: enrollment ends in a session, it does not start in one.
templ scriptedScreen(title, src string) {
	@layout.OperatorWithScript(title+" — Taptime operator", src) {
		@bar(false)
		<main class="mx-auto flex w-full max-w-3xl flex-col gap-6 px-4 py-8">
			{ children... }
		</main>
	}
}

// tenantScreen is a screen showing one tenant: the tenant's name is in the document
// title and in the banner. Unexported; TenantScreen calls it after checking the name.
templ tenantScreen(title string, name TenantName) {
	@layout.Operator(title + " — " + name.title() + " — Taptime operator") {
		@bar(true)
		@tenantBanner(name)
		<main class="mx-auto flex w-full max-w-3xl flex-col gap-6 px-4 py-8">
			{ children... }
		</main>
	}
}
