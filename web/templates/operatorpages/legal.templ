package operatorpages

import (
	"strconv"

	"github.com/atknatk/tappa/web/templates/components"
)

// Legal is /operator/legal (M10 OP-10; ADR 0020 §7): Taptime's own four documents --
// one editor each, re-opened on the text the public page serves -- and the version
// list with who published each version.
//
// UNDOING A PUBLICATION IS A PUBLICATION. legal_documents is append-only (ADR 0016 §3),
// so the page says so beside the editors: the earlier text is published again and
// becomes a new version. The list carries no text (op_read_legal_versions returns a
// length, not a body); a "publish this version again" control would need a read of an
// old text, which is a new op_read_* (a migration) and not part of this screen.
//
// The texts reach the page as data: the editor's content and every list value are
// templ expressions, escaped (TestLegalScreen_ReopensOnPastedMarkupWithoutExecutingIt).
//
// THE REDESIGN (M13-14; docs/design/operator-redesign README §6 "Card", §6.1 "Legal editor",
// "Legal versions", screens.md §12, boards OpLegal): the intro card -- the mono label, the h1 at
// the board's 26 / 28 / 32 px, the intro, where the public pages are and the way back; the card
// spaces its blocks and its bodies carry no top margin. Then one editor card per document, the
// whole column's width, which is the one operator card with no padding and no gap of its own: it
// is split in bands, each inset by the card scale (24 px from the tablet, 20 px on the phone) --
// the head (the path in the data face on the left; on the right a dot that only decorates and
// the words that carry the state), the warning when the public page is behind, and the form: the
// text in a framed box under a label bar, the help on the left and the button on the right (the
// whole width on the phone). The versions are the docket: from the tablet each row is the
// boards' five columns (time, path, length, publisher, the Live chip); on the phone the time and
// the chip share the first line, the path the second, the length and the publisher the third.
// The row's markup is the code's; its places are rules in input.css scoped from the docket's
// heading id. Words are Space Grotesk, values the data face; the publisher's name is someone's
// own text and Space Grotesk. Pinned by TestLegalScreen_IsTheIntroCardTheEditorsAndTheDocket and
// TestLegalVersions_TheScopedRulesKeepTheBoardsColumns.
templ Legal(v LegalView) {
	@screen("Legal texts", true, navLegal) {
		<section class="op-card flex flex-col gap-3.5">
			<p class="op-label">Legal texts</p>
			<h1 class="font-display text-[26px] font-bold leading-[1.1] tracking-[-0.03em] md:text-[28px] desk:text-[32px]">Taptime's legal texts</h1>
			<p class="text-[15px] leading-[1.55]">
				Publishing adds a new version; nothing is overwritten. To undo a change, publish
				the earlier text again.
			</p>
			<p class="text-sm text-ink/70">The public pages are on the customer site, under <span class="font-mono">/legal</span>.</p>
			<p class="text-sm">
				<a href="/operator" class="op-link">Back to the console</a>
			</p>
		</section>
		for _, d := range v.Docs {
			@legalEditor(d)
		}
		@legalVersions(v)
	}
}

// legalEditor is one document's form. The slug field names the document; the server
// checks it against the closed set, and the form carries nothing else but the text. When
// the public page is behind the list's live version (LegalDoc.Behind) the editor says so
// above the form: it opened on the page's text, not on the newest version.
//
// The card has no padding and no gap: its bands carry the inset. The status dot is
// decoration for a sighted reader (aria-hidden); the sentence beside it says the state. The
// focus ring is drawn on the text's frame, not on the text, whose box the frame clips; so is
// the transparent outline a forced-colours display paints in its place.
templ legalEditor(d LegalDoc) {
	<section class="op-card flex flex-col gap-0 overflow-hidden p-0" aria-labelledby={ "legal-" + d.Slug }>
		<div class="flex flex-wrap items-center justify-between gap-x-5 gap-y-1.5 border-b border-line px-5 pt-[18px] pb-3.5 md:px-6 md:pt-5 md:pb-4">
			<h2 id={ "legal-" + d.Slug } class="min-w-0 font-mono text-[17px] font-bold leading-[1.3] [overflow-wrap:anywhere] md:text-[18px]">{ d.Path }</h2>
			if d.Published {
				<p class="flex min-w-0 items-start gap-2 text-sm leading-[1.4] text-ink/75"><span class="mt-1.5 size-2 flex-none rounded-full bg-tappa-green" aria-hidden="true"></span><span>Live since <span class="font-mono text-[13px] text-ink">{ d.PublishedAt }</span></span></p>
			} else {
				<p class="flex min-w-0 items-start gap-2 text-sm leading-[1.4] text-ink/75"><span class="mt-1.5 size-2 flex-none rounded-full border-[1.5px] border-ink/45" aria-hidden="true"></span><span>Not published. The public page shows its placeholder.</span></p>
			}
		</div>
		if d.Behind {
			<div class="px-5 pt-4 md:px-6">
				@opNotice(components.ToneWarn, "The public page is behind") {
					<p>
						The newest version, published <span class="font-mono">{ d.LiveAt }</span>, has not reached
						the public page yet. This editor opened on the text the page shows, so publishing it
						replaces the newest version.
					</p>
					<p class="mt-2">Reload this screen to try again. The page also catches up after the next publication or a restart.</p>
				}
			</div>
		}
		<form method="post" action="/operator/legal" class="flex flex-col gap-3 px-5 pt-[18px] pb-[22px] md:px-6">
			<input type="hidden" name="slug" value={ d.Slug }/>
			<div class="overflow-hidden rounded-[10px] border border-line bg-paper focus-within:border-tappa-green focus-within:outline-none focus-within:ring-1 focus-within:ring-tappa-green">
				<div class="flex min-h-9 items-center border-b border-line bg-ink/[0.04] px-4">
					<label for={ "legal-body-" + d.Slug } class="docket-label">Text</label>
				</div>
				<textarea id={ "legal-body-" + d.Slug } name="body" rows="12" required class="op-input block resize-y rounded-none border-0 bg-transparent px-3.5 py-[18px] leading-[1.7] focus:ring-0 md:px-5 desk:px-[22px]">{ d.Body }</textarea>
			</div>
			<div class="flex flex-wrap items-center justify-between gap-x-5 gap-y-3">
				<p class="min-w-0 flex-[1_1_220px] text-xs leading-[1.45] text-ink/70">
					A blank line starts a new paragraph. Addresses starting with http:// or https://, e-mail addresses and
					phone numbers starting with + become links; <span class="font-mono">[text](https://…)</span>
					links your own text. At most 256 KiB.
				</p>
				<button type="submit" class="btn btn--primary w-full md:w-auto">Publish a new version</button>
			</div>
		</form>
	</section>
}

// legalVersions is the version list, newest first, on a docket: the publication time
// (UTC), the document, the length in the data face and the publisher, with the live
// version of each document marked.
templ legalVersions(v LegalView) {
	<section class="docket" aria-labelledby="legal-versions">
		<h2 id="legal-versions" class="docket-label">Versions, newest first</h2>
		if len(v.Versions) == 0 {
			<p class="pt-[22px] pb-2 font-display text-[15px] leading-normal">Nothing has been published yet.</p>
		} else {
			<ol>
				for _, r := range v.Versions {
					<li class="op-version">
						<span>{ r.PublishedAt }</span>
						<span>{ r.Path }</span>
						<span>{ r.Bytes }</span>
						<span>{ r.Publisher }</span>
						if r.Current {
							<span class="tally tally--active">Live</span>
						}
					</li>
				}
			</ol>
			if v.Limit > 0 && len(v.Versions) >= v.Limit {
				<p class="mt-1 border-t-2 border-dashed border-line pt-3 font-display text-[13px] text-ink/70">The newest <span class="font-mono">{ strconv.Itoa(v.Limit) }</span> are listed. Older versions are not shown here.</p>
			}
		}
	</section>
}
