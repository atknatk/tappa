package pages

import "github.com/atknatk/tappa/web/templates/layout"

// The INTEGRATION GUIDE on the product site (M11 DOCS-1, ADR 0030): /docs/api in English and
// /docs/api/tr in Turkish, public and without a sign-in, in the public site's chrome (PublicChrome,
// since LP-11; in its own roots, so the guide's utility classes keep their spacing).
//
// THE BODY IS THE MARKDOWN, CONVERTED. docs/api/integration-guide.md (and .tr.md) is the one
// source: /v1/guide.md serves its bytes on the API host, and internal/apiguide turns the same bytes
// into the body below, once per process. That conversion writes no raw HTML and draws a link only
// to http(s), this site or this page; the body is the one block on this page written without
// escaping, and only that package can produce it (apiguide.Guide's body is unexported).
//
// LAYOUT. On a phone, a tablet and a small laptop the page is one centred column of at most
// 48 rem, and the guide's own contents list, right after the title, is the
// table of contents (its links are 44 px touch targets: the scoped rules in input.css). From the
// extra-large breakpoint up a sticky side navigation lists the sections and subsections in the
// left margin, and the text column stays centred. Tables and code blocks scroll inside their own
// box (input.css), so the page itself never scrolls sideways.
//
// THE SIDE NAVIGATION STICKS BELOW THE HEADER. The public header sticks too (69 px tall from the
// tablet width: its 68 px row and its 1 px hairline, input.css's .lp .lp-headIn and .lp .lp-head;
// the desk width changes neither), so the navigation's offset is that height plus the 24 px
// gap it always kept, 93, and its height leaves the same 24 px below it, 100vh less 117. Stuck at
// the old offset its first entries sat under the header. The two numbers are written out because
// Tailwind can only read a literal; TestAPIGuidePages_TheSideNavigationSticksBelowTheHeader
// derives them from the compiled stylesheet, so a header of another height turns it red.
//
// ANCHOR JUMPS ARE INSTANT HERE (InstantScroll), unlike the rest of the public site.
//
// LANGUAGE. The document is English (the chrome is); the article carries the page's language,
// and the head names both translations (layout.MarketingTranslated).
templ APIGuide(v APIGuideView) {
	@layout.MarketingTranslated(v.pageTitle(), layout.RobotsPublic, v.alternates()) {
		@PublicChrome(PublicChromeOpts{Current: v.path(), SignInHref: v.SignInHref, SignupHref: v.SignupHref, OwnRoots: true, InstantScroll: true}) {
			<article class="px-4 py-10 sm:py-14" lang={ v.lang() }>
				<div class="mx-auto w-full max-w-3xl xl:grid xl:max-w-none xl:grid-cols-[minmax(0,1fr)_minmax(0,48rem)_minmax(0,1fr)] xl:gap-8">
					@apiGuideSideNav(v)
					<div class="min-w-0">
						<p class="docket-label">{ v.say("Integration API", "Entegrasyon API'si") }</p>
						<h1 class="mt-2 font-display text-3xl font-bold tracking-tight">{ v.Guide.Title }</h1>
						@apiGuideLinks(v)
						<div class="guide-prose mt-8">
							@v.Guide.Body()
						</div>
					</div>
				</div>
			</article>
		}
	}
}

// apiGuideLinks is the other language and, where this deployment has an API host, the OpenAPI
// document to download.
templ apiGuideLinks(v APIGuideView) {
	<p class="mt-4 flex flex-wrap gap-x-6 gap-y-1 text-sm">
		if v.Turkish {
			<a href={ templ.URL(APIGuidePath) } hreflang="en" lang="en" class="inline-flex min-h-11 items-center font-display font-bold tracking-tight text-ink underline underline-offset-4 hover:text-tappa-green">
				English
			</a>
		} else {
			<a href={ templ.URL(APIGuideTRPath) } hreflang="tr" lang="tr" class="inline-flex min-h-11 items-center font-display font-bold tracking-tight text-ink underline underline-offset-4 hover:text-tappa-green">
				Türkçe
			</a>
		}
		if v.OpenAPIHref != "" {
			<span class="inline-flex min-h-11 flex-wrap items-center gap-x-2">
				<a href={ templ.URL(v.OpenAPIHref) } class="font-display font-bold tracking-tight text-ink underline underline-offset-4 hover:text-tappa-green">
					{ v.say("Download openapi.yaml", "openapi.yaml'ı indir") }
				</a>
				<span class="text-ink/70">{ v.say("the OpenAPI 3.1 document, to load into your tools", "OpenAPI 3.1 belgesi, araçlarınıza yüklemek için") }</span>
			</span>
		}
	</p>
}

// apiGuideSideNav lists the guide's sections beside it on a wide screen. It is not drawn on a
// narrower one: there the guide's own contents list is at the top of the page.
templ apiGuideSideNav(v APIGuideView) {
	<nav class="hidden xl:block xl:w-full xl:max-w-56 xl:justify-self-end" aria-label={ v.say("On this page", "Bu sayfada") }>
		<div class="sticky top-[93px] max-h-[calc(100vh-117px)] overflow-y-auto pr-2">
			<p class="docket-label">{ v.say("On this page", "Bu sayfada") }</p>
			<ul class="mt-3 flex flex-col text-sm">
				for _, s := range v.sideSections() {
					if s.Level == 2 {
						<li class="mt-2">
							<a href={ templ.URL("#" + s.ID) } class="block py-1 font-display font-bold tracking-tight text-ink hover:text-tappa-green hover:underline">{ s.Title }</a>
						</li>
					} else {
						<li>
							<a href={ templ.URL("#" + s.ID) } class="block py-0.5 pl-3 text-ink/70 hover:text-ink hover:underline">{ s.Title }</a>
						</li>
					}
				}
			</ul>
		</div>
	</nav>
}
