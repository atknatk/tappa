package pages

import (
	"github.com/atknatk/tappa/web/templates/components"
	"github.com/atknatk/tappa/web/templates/layout"
)

// The ACCOUNT section (M7-05) — the business's own facts, the three it may change,
// what the VAT register said, and the sentence its staff read after a good tap.
// Drawn in the panel redesign's look since M12-41 ("The Pass", boards Account,
// T-Account, M-Account; docs/design/panel-redesign/screens/account-auth.md §1).
//
// 🔴 THE BRAND SENTENCES ARE RENDERED BY THE TAP SCREEN'S OWN COMPONENT, not copied.
// `@brandMessage(...)` below is the same templ component result.templ renders to an
// employee, called with this business's type — so the preview cannot drift from what
// is actually shown, because it IS what is actually shown. A copy of those four
// sentences here would be the "second representation" failure class this repository
// has paid for repeatedly, and it would be the worst possible one: a settings screen
// that tells a customer their staff read something they do not.
//
// 🔴 IT CHANGES NOTHING ON THE SACRED SCREEN (CLAUDE.md §9). result.templ and tap.templ
// are not edited by this screen — the calls go the other way, and the one tap-screen
// part the panel cannot reuse as it is (the greeting, which is the tap screen's <h1>)
// has a panel-only twin below, TapPreviewHeading, held to the original's markup by a
// test.
//
// 🔴 IT LOADS NO SCRIPT and renders PanelShell rather than PanelShellWithScript.
// Everything here is a link or a form post; there is nothing to append and nothing to
// swap, which keeps the panel's widened Content-Security-Policy pinned to exactly one
// url.
//
// 🔴 §4.7 — NOTHING ON THIS PAGE NAMES A PERSON. The only names are the BUSINESS's own
// and the signed-in admin's, which the panel shell already prints on every section.
//
// 🔴 §4.5 — A MANAGER READS THIS PAGE, so nothing on it is owner data the manager may not
// read: the billing link and the Developers card are drawn only for a reader who may open
// them, and the Developers card is a link, never a key, a prefix or a webhook address.
//
// THE LAYOUT IS ONE MARKUP AT EVERY WIDTH: the cards stack on a phone and a tablet in the
// tablet board's order (Identity, Your brand, Your password, What your staff read,
// Developers) and from the desk width the same order fills two columns, so Identity,
// the password and Developers sit on the left and the brand and the staff sentences on
// the right, as the desk board draws them.
//
// THE COMMENTS IN THIS FILE NAME NO CLASS: Tailwind reads them as source (skill
// tappa-brand, "templ + Tailwind").
templ AdminAccount(v AccountView) {
	@PanelShell(v.PanelChrome) {
		if v.Problem != "" {
			@components.PanelNotice(components.ToneAlert, "That was not saved") {
				<p>{ v.Problem }</p>
			}
		}
		if v.Saved != "" {
			@components.PanelNotice(components.ToneOK, "Saved") {
				<p>{ v.Saved }</p>
			}
		}
		if v.Identity != nil && v.Identity.WindowOpen {
			// M14-18: the confirmation window comes first while it is open -- it asks for a decision.
			@accountWindowCard(*v.Identity)
		}
		<div class="grid grid-cols-1 items-start gap-5 desk:grid-cols-2">
			@accountIdentity(v)
			if v.BusinessDay != nil {
				// M15-07: the business level of the business day, its own card and its own
				// route (the first press only reviews the change).
				@components.DayCutoffCard(*v.BusinessDay)
			}
			if v.DayCheck != nil {
				// M15-08: the owner's read-only check of every level, beside the business card.
				@accountBusinessDayCheck(*v.DayCheck)
			}
			@accountBrand(v.Brand, v.PanelChrome)
			@accountPasswordForm(v)
			if v.Identity != nil {
				// M14-18: the person's businesses (and the e-mail verification), and linking another.
				@accountBusinessesCard(*v.Identity)
				@accountLinkCard(*v.Identity)
			}
			if v.SignOutEverywhereHref != "" {
				@accountSignOutEverywhere(v)
			}
			@accountMessages(v)
			if v.ManagersHref != "" {
				@accountManagers(v)
			}
			if v.ShowDevelopers() {
				@accountDevelopers(v)
			}
		</div>
	}
}

// accountCardHeading is a card's own heading: the card is a region of the page, its
// heading an h2 under the shell's one h1.
templ accountCardHeading(id, text string) {
	<h2 id={ id } class="font-display text-[19px] font-bold tracking-tight text-ink md:text-xl">{ text }</h2>
}

// accountIdentity is the "Identity" card: what is on file, what the VAT register said,
// and -- for an owner -- the three fields that can move, with the money screen's link at
// the foot. A manager reads the same facts and the sentence saying who changes them.
//
// THE SAVE BUTTON STAYS AT THE FOOT OF THE FORM AT EVERY WIDTH. The desk board also draws
// it in the page header; a button there would need a form= attribute to reach this form,
// and the page holds that attribute to zero (the brand preview's rule:
// TestBrandPreview_IsTheTapScreensOwnComponentsAndCannotSubmit).
templ accountIdentity(v AccountView) {
	<section class="panel-card min-w-0" aria-labelledby="account-identity-heading">
		@accountCardHeading("account-identity-heading", "Identity")
		@accountFacts(v)
		@accountVAT(v)
		if v.CanEdit {
			@accountForm(v)
		} else {
			@accountNoForm(v)
		}
		if v.ShowBilling() {
			// 🔴 IT IS A BUTTON-SHAPED LINK RATHER THAN A WORD INSIDE A SENTENCE, AND THE
			// FIRST DRAFT WAS THE SENTENCE. TestPanelScreens_EveryPressTargetCarriesATouchTargetClass
			// turned RED on it: an inline link is a press target with no 44px minimum,
			// which is the accessibility floor skill tappa-brand states.
			<div class="flex flex-wrap items-center justify-between gap-3 border-t border-dashed border-line pt-4">
				<p class="text-[13px] leading-normal text-ink/70">
					What this business is charged, month by month, is not here.
				</p>
				<a class="btn btn--line" href={ templ.URL(v.BillingHref) }>Open Billing</a>
			</div>
		}
	</section>
}

// accountFacts is what is on file, as a docket. Everything here is READ ONLY — the
// three fields that can move are in the form below, so a reader can see at a glance
// which facts are theirs to change and which are not.
//
// 🔴 EVERY VALUE HERE COMES FROM v.OnFile AND NEVER FROM v.Form, WHICH IS THE WHOLE
// POINT OF THE BLOCK AND WAS THE BUG IT SHIPPED WITH. On a render answering a refused
// save, Form holds what the customer typed; printing that under a heading reading "On
// file" states a fact about the business that is not true and hides the one that is.
// See AccountView.OnFile for the measurement.
//
// IT IS A DOCKET INSIDE THE CARD, the record motif with its sharp corners (D2), the way
// the staff sentences sit as dockets inside their card.
templ accountFacts(v AccountView) {
	<section class="docket">
		// 🔴 THE BUSINESS NAME IS THIS BLOCK'S HEADING, AND IT WAS A BARE <p>. A test that
		// searched the whole document for the stored name was satisfied by the form's own
		// value= attribute, so emptying this cell left the entire handler package green.
		// It is an h3 since M12-41: the docket sits inside the Identity card, whose h2 is
		// the heading it belongs under.
		<div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
			<h3 class="font-display text-lg font-bold tracking-tight text-ink">{ v.OnFile.Name }</h3>
			<p class="font-mono text-xs uppercase tracking-widest text-ink/70">On file</p>
		</div>
		<dl class="mt-3 grid grid-cols-1 gap-x-4 gap-y-2 sm:grid-cols-2">
			<div>
				<dt class="docket-label">VAT number</dt>
				<dd class="font-mono text-sm text-ink">{ v.VATNumber }</dd>
			</div>
			<div>
				<dt class="docket-label">Registered on</dt>
				<dd class="font-mono text-sm text-ink">{ v.RegisteredOn }</dd>
			</div>
			<div>
				<dt class="docket-label">Timezone</dt>
				<dd class="font-mono text-sm text-ink">{ v.OnFile.Timezone }</dd>
			</div>
		</dl>
		<p class="mt-3 text-sm text-ink/85">
			The VAT number is what your invoice is made out to and it cannot be changed
			from here: it is unique across every business on Taptime, and the record of
			what the tax register said about it belongs to the number it was asked
			about. If it is wrong, tell us and we will correct both together.
		</p>
	</section>
}

// accountVAT is the VAT register's answer — the first screen in the product that
// reads migration 00017's two columns back.
//
// 🔴 IT IS A MARKER AND NOT A DOCKET STAMP. The stamp motif belongs to a record of a
// tap (skill tappa-brand); this is the current state of a lookup. The colour follows
// the fixed mapping and the WORD carries the meaning on its own.
//
// THE STAMP SAYS WHAT THE TIME IS (M10 OP-16 B, the security audit's D2): beside a verdict it is
// the register's last answer -- an ask it did not answer writes nothing, so the record cannot
// say when it was last ASKED; beside "No answer" it is the ask that got none.
templ accountVAT(v AccountView) {
	<div class="flex flex-col gap-1.5">
		<div class="flex flex-wrap items-center justify-between gap-2">
			<h3 class="font-display text-base font-bold tracking-tight text-ink">The VAT register</h3>
			@accountVATMarker(v)
		</div>
		<p class="text-[13px] leading-normal text-ink/85">{ v.VATLine }</p>
		if v.VATCheckedAt != "" {
			switch v.VATState {
				case "valid", "invalid":
					<p class="font-mono text-xs text-ink/70">Last answer { v.VATCheckedAt }</p>
				default:
					<p class="font-mono text-xs text-ink/70">Asked { v.VATCheckedAt }</p>
			}
		}
	</div>
}

// accountVATMarker is the state's word inside the state's frame, drawn as a chip (D2).
//
// 🔴 THE CLASS LITERALS LIVE HERE AND NOT IN GO, AND THAT IS A MEASURED RULE RATHER
// THAN A STYLE PREFERENCE. Tailwind's content globs are web/templates/**/*.templ and
// web/static/js/**/*.js — it does not read Go — so a class name assembled in
// internal/handler is compiled OUT of app.css. Measured while building this screen: the
// neutral tint for the "not checked" state produced zero rules, so that marker rendered
// with a border and no fill while the other three looked right.
// TestAccount_TheVATMarkersClassesLiveWhereTailwindLooks holds it.
//
// 🔴 THE WORD CARRIES THE STATE AND THE COLOUR ONLY PLEDGES IT (skill tappa-brand):
// the text is ink in all four, and the fixed mapping supplies the frame and a tenth of
// it as the ground — the green for a confirmation, the tomato for a refusal, the saffron
// for "we could not tell", the line grey for "nobody has asked".
templ accountVATMarker(v AccountView) {
	switch v.VATState {
		case "valid":
			<span class="inline-flex min-h-7 items-center rounded-full border border-tappa-green bg-tappa-green/10 px-2.5 font-mono text-xs font-bold uppercase tracking-[0.08em] text-ink">
				{ v.VATStateWord }
			</span>
		case "invalid":
			<span class="inline-flex min-h-7 items-center rounded-full border border-tomato bg-tomato/10 px-2.5 font-mono text-xs font-bold uppercase tracking-[0.08em] text-ink">
				{ v.VATStateWord }
			</span>
		case "no-answer":
			<span class="inline-flex min-h-7 items-center rounded-full border border-saffron bg-saffron/10 px-2.5 font-mono text-xs font-bold uppercase tracking-[0.08em] text-ink">
				{ v.VATStateWord }
			</span>
		default:
			// "never checked", and every value this template does not own. A switch on a
			// value from another package must end somewhere, or an unanticipated one
			// renders NOTHING where a state belongs.
			<span class="inline-flex min-h-7 items-center rounded-full border border-line bg-line/10 px-2.5 font-mono text-xs font-bold uppercase tracking-[0.08em] text-ink">
				{ v.VATStateWord }
			</span>
	}
}

// accountForm is the three fields a business may change about itself.
//
// 🔴 EVERY VALUE GOES THROUGH `{ }`, including what the customer typed and is being
// shown again after a refusal, so a name containing markup cannot break this form.
//
// 🔴 THE WARNING UNDER THE ZONE IS NOT DECORATION. Changing it moves this panel's day
// boundary, the wall clock every shift and every lateness verdict is resolved
// against, and both ends of every billing month that has not been frozen yet. The one
// half that is permanent is named: a month frozen while the zone is wrong keeps that
// zone for ever, because nothing may update that table.
//
// A FIELD WITH A MESSAGE IS MARKED INVALID, so the frame a sighted owner sees and the
// state a screen reader announces come from one attribute.
templ accountForm(v AccountView) {
	<form method="post" action={ templ.URL(components.Bound(ctx, v.PostHref)) } class="flex flex-col gap-4 border-t border-dashed border-line pt-4">
		<div class="field-stack">
			<label class="lbl" for="account-name">Business name</label>
			<input
				class="field-input"
				id="account-name"
				type="text"
				name="name"
				value={ v.Form.Name }
				maxlength={ itoa(v.NameMaxLength) }
				required
				if v.ErrorFor("name") != "" {
					aria-invalid="true"
				}
				aria-describedby={ v.DescribedBy("name") }
			/>
			<p class="field-help" id="account-name-help">
				This is what appears on your invoice, on the exports your accountant
				gets, and on every confirmation screen in the panel.
			</p>
			if v.ErrorFor("name") != "" {
				<p class="text-sm text-tomato" id="account-name-error">{ v.ErrorFor("name") }</p>
			}
			if v.Unsaved("name") != "" {
				@accountStillOnFile(v.Unsaved("name"))
			}
		</div>
		<div class="grid grid-cols-1 items-start gap-4 md:grid-cols-2">
			<div class="field-stack min-w-0">
				<label class="lbl" for="account-business_type">Kind of business</label>
				<select
					class="field-input"
					id="account-business_type"
					name="business_type"
					if v.ErrorFor("business_type") != "" {
						aria-invalid="true"
					}
					aria-describedby={ v.DescribedBy("business_type") }
				>
					for _, t := range v.Types {
						if t.Value == v.Form.BusinessType {
							<option value={ t.Value } selected>{ t.Label }</option>
						} else {
							<option value={ t.Value }>{ t.Label }</option>
						}
					}
				</select>
				<p class="field-help" id="account-business_type-help">
					The kind picks the send-off your staff see after a good tap; the
					sentences themselves can't be written by hand.
				</p>
				if v.ErrorFor("business_type") != "" {
					<p class="text-sm text-tomato" id="account-business_type-error">{ v.ErrorFor("business_type") }</p>
				}
				if v.Unsaved("business_type") != "" {
					@accountStillOnFile(v.Unsaved("business_type"))
				}
			</div>
			<div class="field-stack min-w-0">
				<label class="lbl" for="account-timezone">Timezone</label>
				<input
					class="field-input field-input--mono"
					id="account-timezone"
					type="text"
					name="timezone"
					value={ v.Form.Timezone }
					list="account-timezone-options"
					required
					if v.ErrorFor("timezone") != "" {
						aria-invalid="true"
					}
					aria-describedby={ v.DescribedBy("timezone") }
				/>
				<datalist id="account-timezone-options">
					for _, z := range v.ZoneSuggestions {
						<option value={ z }></option>
					}
				</datalist>
				<p class="field-help" id="account-timezone-help">
					An IANA zone name, such as Europe/Malta. The suggestions are only
					suggestions — any name the server can load is accepted.
				</p>
				if v.ErrorFor("timezone") != "" {
					<p class="text-sm text-tomato" id="account-timezone-error">{ v.ErrorFor("timezone") }</p>
				}
				if v.Unsaved("timezone") != "" {
					@accountStillOnFile(v.Unsaved("timezone"))
				}
			</div>
		</div>
		@components.PanelNotice(components.ToneWarn, "What the timezone moves") {
			<p>
				Every date in the panel is worked out in this zone: which day a tap
				belongs to, when a shift starts, and therefore who was late. Changing
				it also moves both ends of every billing month that has not been frozen
				yet.
			</p>
			<p class="mt-2">
				A month that has already been frozen does not move — it stored its own
				dates and its own zone when it was closed. That is also the part that
				cannot be undone: a month frozen while this is set wrongly keeps this
				zone for ever.
			</p>
		}
		<div>
			<button class="btn btn--primary rounded-xl" type="submit">Save changes</button>
		</div>
	</form>
}

// accountPasswordForm is change-my-own-password (T73), drawn for EVERY live admin.
//
// 🔴 IT IS NOT GATED ON v.CanEdit, WHICH IS THE WHOLE POINT (K-A). The Identity form is
// the owner's; a password is personal, so this one is offered to a manager too and posts
// to a DIFFERENT route (v.PasswordPostHref) that carries no owner-only gate. Keeping it a
// separate <form> is what stops accountSave's owner check from ever reaching across it.
//
// 🔴 THE FIELDS ARE NEVER RE-FILLED. A refused change re-renders with a message but no
// value= on any input: a password does not travel back to the browser, and re-typing all
// three is the right cost for a credential (§4.7).
//
// 🔴 THE MESSAGES ARE PANEL NOTICES, NOT COLOURED PROSE. skill tappa-brand: colour rides
// the frame and the ground while the word is ink, and the notice opens with its own word
// ("Done", "Not done"), so the status is never the colour alone. Every value goes
// through `{ }`.
//
// 🔴 NO SYNCHRONIZER TOKEN FIELD, matching every other panel write (sameOriginGate is the
// CSRF defence, not a hidden field), and PanelShell loads no script for it.
templ accountPasswordForm(v AccountView) {
	<form method="post" action={ templ.URL(components.Bound(ctx, v.PasswordPostHref)) } class="panel-card min-w-0" aria-labelledby="account-password-heading">
		@accountCardHeading("account-password-heading", "Your password")
		<p class="text-[13px] leading-normal text-ink/70">
			This changes the password you sign in to Taptime with. Changing it keeps you
			signed in on this device and signs you out everywhere else.
		</p>
		if v.PasswordSaved != "" {
			@components.PanelNotice(components.ToneOK, "Password changed") {
				<p>{ v.PasswordSaved }</p>
			}
		}
		if v.PasswordError != "" {
			@components.PanelNotice(components.ToneAlert, "Password not changed") {
				<p>{ v.PasswordError }</p>
			}
		}
		<div class="field-stack">
			<label class="lbl" for="account-current_password">Current password</label>
			<input
				class="field-input field-input--mono"
				id="account-current_password"
				type="password"
				name="current_password"
				autocomplete="current-password"
				required
				aria-describedby="account-current_password-help"
			/>
			<p class="field-help" id="account-current_password-help">
				Type the password you use now, so we know it is you making the change.
			</p>
		</div>
		<div class="grid grid-cols-1 items-start gap-4 md:grid-cols-2">
			<div class="field-stack min-w-0">
				<label class="lbl" for="account-new_password">New password</label>
				<input
					class="field-input field-input--mono"
					id="account-new_password"
					type="password"
					name="new_password"
					autocomplete="new-password"
					required
					aria-describedby="account-new_password-help"
				/>
				<p class="field-help" id="account-new_password-help">
					At least 8 characters. A few words you will remember beats a short one you will not.
				</p>
			</div>
			<div class="field-stack min-w-0">
				<label class="lbl" for="account-confirm_password">New password again</label>
				<input
					class="field-input field-input--mono"
					id="account-confirm_password"
					type="password"
					name="confirm_password"
					autocomplete="new-password"
					required
					aria-describedby="account-confirm_password-help"
				/>
				<p class="field-help" id="account-confirm_password-help">
					Type the new password once more, so a typo cannot lock you out.
				</p>
			</div>
		</div>
		<div>
			<button class="btn btn--primary rounded-xl" type="submit">Change password</button>
		</div>
	</form>
}

// accountSignOutEverywhere is "Sign out everywhere" (M14-11), drawn only while the panel identity
// flag is on (the handler leaves the href empty otherwise, and then nothing of it is written).
//
// IT IS ITS OWN FORM AND ITS OWN CARD, beside the password: one press, no field. The button is the
// outlined one the page already uses for a secondary act -- it ends sessions, it destroys no data.
// The sentence says the one surprise in plain words: this device is signed out too -- and, only when
// the session's row is linked to an identity, every other business the person belongs to; an
// unlinked row's press reaches this business alone, and the sentence says so. No synchronizer token
// field, like every other panel write.
templ accountSignOutEverywhere(v AccountView) {
	<form method="post" action={ templ.URL(components.Bound(ctx, v.SignOutEverywhereHref)) } class="panel-card min-w-0" aria-labelledby="account-everywhere-heading">
		@accountCardHeading("account-everywhere-heading", "Sign out everywhere")
		<p class="text-[13px] leading-normal text-ink/70">
			if v.SignOutEverywhereEveryBusiness {
				This signs you out of Taptime on every phone and computer, in every business you
				belong to — this device too.
			} else {
				This signs you out of Taptime on every phone and computer in this business — this
				device too.
			}
			Use it if you signed in somewhere you no longer trust. You can sign straight back in
			with your password.
		</p>
		<div>
			<button class="btn btn--line" type="submit">Sign out everywhere</button>
		</div>
	</form>
}

// accountStillOnFile names the gap between the box and the file, for ONE field.
//
// 🔴 IT IS THE OTHER HALF OF KEEPING THE CUSTOMER'S TYPING. The box holds what they
// wrote so a correction is one field rather than three; this says, in the same place,
// that the write did not happen and what the row still holds. Without it a refused save
// leaves somebody looking at their own words in every box, which is what a SUCCESSFUL
// save also looks like.
//
// THE STORED VALUE IS PRINTED IN MONO because it is data, not prose (skill
// tappa-brand), and it goes through `{ }` like everything else on this page.
templ accountStillOnFile(stored string) {
	<p class="text-sm text-ink/85">
		Not saved — on file this is still <span class="font-mono">{ stored }</span>.
	</p>
}

// accountNoForm is what a manager reads where the form would be.
//
// 🔴 §4.6 — THE REFUSAL IS NOT SILENT AND IT IS NOT A 404. A control that simply
// disappears tells nobody anything, and a manager who cannot find the timezone field
// would reasonably conclude the product does not have one.
templ accountNoForm(v AccountView) {
	<p class="border-t border-dashed border-line pt-4 text-[13px] leading-normal text-ink/85">{ v.WhyNotEdit }</p>
}

// accountMessages shows the two sentences this business's staff actually read.
//
// 🔴 THEY ARE RENDERED, NOT DESCRIBED. @brandMessage is result.templ's own component,
// so what is drawn here is byte for byte what an employee sees — which is the only
// version of "the brand messages are visible" that stays true when somebody edits the
// tap screen.
//
// 🔴 AND IT IS KEYED ON v.OnFile, NOT v.Form. The question this block answers is what
// this business's staff read RIGHT NOW; a refused save that typed a different kind of
// business must not change the answer, because nothing about the staff's screen
// changed. The first draft read Form and, on a refused save, showed a restaurant its
// production send-off.
templ accountMessages(v AccountView) {
	<section class="panel-card min-w-0" aria-labelledby="account-messages-heading">
		@accountCardHeading("account-messages-heading", "What your staff read")
		<p class="text-[13px] leading-normal text-ink/70">{ v.BrandNote }</p>
		<div class="grid grid-cols-1 gap-3 md:grid-cols-2">
			<div class="docket">
				<p class="docket-label">After tapping in</p>
				@brandMessage(ResultView{BusinessType: v.OnFile.BusinessType, Direction: "in"})
			</div>
			<div class="docket">
				<p class="docket-label">After tapping out</p>
				@brandMessage(ResultView{BusinessType: v.OnFile.BusinessType, Direction: "out"})
			</div>
		</div>
	</section>
}

// accountDevelopers is the owner's pointer to the Developers section (D1: "Account shows
// Developers only as an owner-only link card").
//
// 🔴 IT IS A LINK AND NOTHING ELSE. No key, no prefix, no count, no webhook address or
// state: those are the owner's and live behind the Developers section's own owner-only
// gate, and this page is readable by a manager. The card is drawn only when the reader
// may open that section (AccountView.DevelopersHref, set from the section's own gate).
// accountManagers links to the owner's "Managers" page (M14-15): drawn only while the panel identity
// flag opens the invitations, and only for an owner (AccountView.ManagersHref).
templ accountManagers(v AccountView) {
	<section class="panel-card min-w-0 flex-row flex-wrap items-center justify-between" aria-labelledby="account-managers-heading">
		<div class="flex min-w-0 flex-[1_1_240px] flex-col gap-1">
			@accountCardHeading("account-managers-heading", "Managers")
			<p class="text-[13px] leading-normal text-ink/70">
				Invite a manager by email and see the invitations you have sent. Only an owner sees it.
			</p>
		</div>
		<a class="btn btn--line" href={ templ.URL(v.ManagersHref) }>Open Managers <span class="ml-1.5" aria-hidden="true">→</span></a>
	</section>
}

templ accountDevelopers(v AccountView) {
	<section class="panel-card min-w-0 flex-row flex-wrap items-center justify-between" aria-labelledby="account-developers-heading">
		<div class="flex min-w-0 flex-[1_1_240px] flex-col gap-1">
			@accountCardHeading("account-developers-heading", "Integration keys and webhook")
			<p class="text-[13px] leading-normal text-ink/70">
				Keys for your payroll or HR system and the address punches are sent to live
				on their own page. Only an owner sees it.
			</p>
		</div>
		<a class="btn btn--line" href={ templ.URL(v.DevelopersHref) }>Open Developers <span class="ml-1.5" aria-hidden="true">→</span></a>
	</section>
}

// accountBrand is the "Your brand" editor (M10 WL-7; ADR 0023 §2, ADR 0024 §6): the
// preview of the tap screen with what is SAVED, and, for an owner, the three forms --
// upload a logo, save a colour, and take either back. pages.BrandEditor carries the
// rules; the section's id is the fragment the three routes send the browser back to.
// The preview is drawn from the page's chrome (c), not from e: see accountBrandPreview.
//
// 🔴 THE PREVIEW IS DRAWN OUTSIDE THE FORMS AND BEFORE THEM, so no form is its
// ancestor and nothing inside it names one (ADR 0023 §2: the tap button's preview face
// cannot submit, and a button drawn inside an editor form would belong to that form).
// The manager reads the preview and the reason, and no form.
//
// THE LOGO AND THE ACCENT ARE STACKED AT EVERY WIDTH, as all three boards draw them: from
// the desk width the card is one of two columns and the colour row would not fit beside
// the logo.
templ accountBrand(e BrandEditor, c PanelChrome) {
	<section id="brand" class="panel-card min-w-0" aria-labelledby="account-brand-heading">
		@accountCardHeading("account-brand-heading", "Your brand")
		<p class="text-[13px] leading-normal text-ink/70">
			Your logo goes on the screens your staff see when they tap in and out, and at
			the top of this panel. Your colour goes on their tap button, and on the strip
			along the top of this panel.
		</p>
		if e.Outcome.Shown() {
			@components.PanelNotice(e.Outcome.Tone, e.Outcome.Heading) {
				<p>{ e.Outcome.Sentence }</p>
			}
		}
		@accountBrandPreview(c)
		if e.CanEdit {
			@accountBrandLogo(e)
			@accountBrandAccent(e)
		} else {
			<p class="text-[13px] leading-normal text-ink/85">{ e.WhyNotEdit }</p>
		}
	</section>
}

// accountBrandPreview is the tap screen as the employee sees it: the header
// (layout.BrandHeader -- logo and co-brand line, the ink wordmark, or the wordmark), the
// greeting (TapPreviewHeading) and the button's face (TapButtonFace with the preview
// value: a button that cannot submit). The face says "Clock in" (M15-12, ADR 0032 §B.1)
// and draws no "Not right? …" under it: a picture of the primary button, the accent's
// slot, and nothing that could be read as a second action. The block is inert, so the button is no tab stop
// and the copy of the screen is not read twice by a screen reader; the caption above it
// says what it is in words.
//
// 🔴 IT TAKES THE CHROME, NOT THE EDITOR. Its header is PanelBrand.TapHeader -- the
// logo and the theme the shell itself was drawn with -- and its greeting the signed-in
// admin's name, so what a refused save puts back on the editor's form (the colour that
// was tried) is not one of its inputs. The accent reaches the button the way it reaches
// the tap screen's: through the theme stylesheet the panel shell links when a colour is
// saved -- the accent's second and last slot on the panel (ADR 0023 §2). The logo is the
// panel's route (layout.PreviewLogo), which the panel cookie reaches.
templ accountBrandPreview(c PanelChrome) {
	<div class="flex flex-col gap-2">
		<p class="lbl">What your staff see when they tap</p>
		<div inert class="flex w-full flex-col gap-3.5 rounded-xl bg-porcelain p-4 md:p-[18px]">
			@layout.BrandHeader(c.Brand.TapHeader())
			@TapPreviewHeading(c.FullName)
			@TapButtonFace(TapButtonPreview, TapClockIn)
		</div>
		<p class="field-help">
			This is a picture of the tap screen with what is saved now. Its button does
			nothing.
		</p>
	</div>
}

// TapPreviewHeading is the tap screen's greeting as the Account preview draws it: the
// docket with "Tapping" and "Hello <name>", in the tap screen's own classes and words.
//
// 🔴 IT EXISTS BECAUSE THE TAP SCREEN'S GREETING IS ITS PAGE'S <h1>. TapHeading drawn
// inside the panel gave the Account page TWO h1 elements, the shell's and the preview's
// (M12-41). TapHeading cannot change -- its bytes are the employee's tap screen
// (CLAUDE.md §9, TestUnbrandedScreens_AreByteIdenticalToTheGolden) -- so the panel draws
// this twin, which differs from it in exactly two tags: a division for the section and a
// paragraph for the heading. The preview is a picture inside a page, not a document of
// its own, so it has no heading of its own either.
//
// THE TWIN IS HELD TO THE ORIGINAL BY A TEST (TestTapPreviewHeading_IsTapHeadingWithoutItsHeading,
// internal/handler): rendering TapHeading and swapping those two tags must give this
// component's bytes, so a change to the tap screen's greeting that is not made here too
// turns that test red instead of letting the preview drift.
templ TapPreviewHeading(employeeName string) {
	<div class="docket">
		<p class="docket-label">Tapping</p>
		<p class="font-display text-3xl font-bold tracking-tight text-ink">
			Hello { employeeName }
		</p>
	</div>
}

// accountBrandLogo is the logo upload, and the way to take the logo off again.
//
// 🔴 THE FORM IS multipart AND IT IS THE ONLY ONE IN THE PRODUCT. The route reads it
// as a stream, one part named logo and nothing else (internal/handler, brandupload.go),
// so this form carries no other field. The native file input sits in a dashed box (no
// drag and drop: that needs a script). The box and the help say what the server checks,
// in the order somebody can act on: the two kinds of file, the size, and that the image
// is a logo -- ADR 0024 §7's "a logo, not a photo of a person". The VIES sentence is the
// activation family's gate (ADR 0023 WL-13): the tap, result and panel screens show the
// logo whatever the register said.
//
// THE SAVED LOGO IS NOT DRAWN A SECOND TIME HERE. The preview above already draws it,
// and the editor outside the preview draws no image (withoutBrandEditor's check in
// internal/handler): a second <img> would be a second header the chrome's counts no
// longer see.
templ accountBrandLogo(e BrandEditor) {
	<div class="flex flex-col gap-2.5 border-t border-dashed border-line pt-4">
		<form method="post" action={ templ.URL(components.Bound(ctx, e.LogoPostHref)) } enctype="multipart/form-data" class="flex flex-col gap-2.5">
			<label class="lbl" for="brand-logo">Logo</label>
			<div class="flex flex-col gap-2 rounded-[14px] border-2 border-dashed border-ink/50 p-3">
				<input
					class="field-input py-2"
					id="brand-logo"
					type="file"
					name="logo"
					accept="image/png,image/jpeg"
					required
					aria-describedby="brand-logo-limit brand-logo-help"
				/>
				<p class="font-mono text-xs text-ink/70" id="brand-logo-limit">PNG or JPEG, up to { itoa(e.LogoMaxKB) } KB</p>
			</div>
			<p class="field-help" id="brand-logo-help">
				A logo, not a photo of a person. We make our own smaller copy, and that copy
				is what your staff see. Your logo shows on the activation screens only once
				your VAT number is verified.
			</p>
			<div>
				<button class="btn btn--primary rounded-xl" type="submit">Upload logo</button>
			</div>
		</form>
		if e.HasLogo {
			<form method="post" action={ templ.URL(components.Bound(ctx, e.ResetPostHref)) }>
				<input type="hidden" name="what" value="logo"/>
				<button class="btn btn--line" type="submit">Remove the logo</button>
			</form>
		}
	</div>
}

// accountBrandAccent is the tap button's colour.
//
// TWO INPUTS AND NO SCRIPT: the colour input, whose own swatch shows a colour that is
// picked but not saved, and a text box for a code somebody already has. The panel loads
// no script, so the two cannot follow each other; the help says that a typed code wins,
// which is the rule the handler applies.
//
// A COLOUR THE BUTTON'S WORD CANNOT BE READ ON IS NOT SAVED (ADR 0023 §3). The form
// then comes back with the colour that was tried in the picker and a dashed saffron box
// under the form: the message, and one press to take the darker version of the same
// colour instead -- a separate form, so the suggestion is never mixed into what was
// typed. Its swatch is a disabled colour input: the browser paints it, and nothing is
// sent from it. The box names no contrast ratio and no text colour: the gate picks paper
// or ink for the word, whichever reads, and the page has no ratio for the saved colour
// to print.
templ accountBrandAccent(e BrandEditor) {
	<div class="flex flex-col gap-2.5 border-t border-dashed border-line pt-4">
		<form method="post" action={ templ.URL(components.Bound(ctx, e.AccentPostHref)) } class="flex flex-col gap-2.5">
			<label class="lbl" for="brand-accent">Accent colour</label>
			<div class="flex flex-wrap items-center gap-2">
				<input
					class="field-input w-24 shrink-0 px-1.5"
					id="brand-accent"
					type="color"
					name="accent"
					value={ e.PickerValue() }
					aria-describedby="brand-accent-help"
				/>
				<input
					class="field-input field-input--mono min-w-0 flex-1 basis-32"
					id="brand-accent-hex"
					type="text"
					name="accent_hex"
					value={ e.Typed }
					maxlength="16"
					autocomplete="off"
					spellcheck="false"
					aria-label="Colour code, like 1F5C41"
					if e.AccentError != "" {
						aria-invalid="true"
					}
					aria-describedby={ e.AccentDescribedBy() }
				/>
				<button class="btn btn--primary rounded-xl" type="submit">Save colour</button>
			</div>
			<p class="field-help" id="brand-accent-help">
				Pick a colour, or type its code in the box. A typed code is used instead of
				the picker. The word on the button has to stay readable, so a colour it
				cannot be read on is not saved.
			</p>
		</form>
		if e.AccentError != "" || e.Suggest != "" {
			<div class="flex flex-col gap-2.5 rounded-[10px] border border-dashed border-saffron bg-saffron/10 px-3.5 py-3">
				if e.AccentError != "" {
					<p class="text-sm leading-normal text-ink" id="brand-accent-error">
						{ e.AccentError } <span class="font-mono">{ e.AccentErrorCode }</span>.
					</p>
				}
				if e.Suggest != "" {
					<form method="post" action={ templ.URL(components.Bound(ctx, e.AccentPostHref)) } class="flex flex-wrap items-center gap-2">
						<input type="hidden" name="accent_hex" value={ e.SuggestHex }/>
						<input class="field-input w-11 shrink-0 px-1" type="color" value={ e.SuggestValue() } disabled aria-label="The suggested colour"/>
						<button class="btn btn--line bg-paper" type="submit">Use <span class="ml-1 font-mono">{ e.Suggest }</span></button>
					</form>
				}
			</div>
		}
		if e.HasAccent {
			<form method="post" action={ templ.URL(components.Bound(ctx, e.ResetPostHref)) }>
				<input type="hidden" name="what" value="accent"/>
				<button class="btn btn--line" type="submit">Back to Taptime green</button>
			</form>
		}
	</div>
}
