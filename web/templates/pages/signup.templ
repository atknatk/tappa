package pages

import (
	"strconv"

	"github.com/atknatk/tappa/web/templates/layout"
)

// The PUBLIC sign-up wizard (M7-02) — handoff §9's three steps, rewritten in templ
// per ADR 0001.
//
// 🔴 READ signupview.go BEFORE EDITING ANYTHING HERE. This family sits under both of
// this package's rules at once: it takes a PASSWORD (so no view carries one) and it
// is the page that closes a sale (so no sentence may promise something the product
// does not do).
//
// IT USES THE MARKETING CHROME, NOT THE PANEL SHELL AND NOT THE PHONE SHELL. A
// visitor arrives here from the landing page and has no identity yet, so the
// navigation and the legal footer they were looking at a moment ago must still be
// there — a sign-up form is exactly where somebody goes looking for the privacy
// policy.
//
// ⚠️ layout.RobotsPrivate ON EVERY SCREEN, unlike the landing page's RobotsPublic.
// The wizard carries form state and its URLs are steps in a flow rather than
// destinations; a crawler indexing /signup/account would put a step nobody can enter
// from cold into search results. layout.Robots is a closed vocabulary precisely so
// this had to be a decision.
//
// THE REDESIGN (M12-45, design "The Pass"): one responsive page per screen. A
// phone gets a sticky progress bar above a plain form on the porcelain page; from
// the tablet width the form sits in a rounded paper card with the progress docket
// above it, and from the desk width the docket stands beside it. The docket is the
// shared kitchen-docket motif and stays sharp (D2); the card, the fields, the chips
// and the buttons are rounded as drawn. No class name is assembled from pieces: every tone is a
// literal in a switch below, because Tailwind reads this file as raw text.

// signupPage is the frame every wizard screen shares: the marketing chrome (wide,
// with the "Already with Taptime?" prompt), the progress when the screen has one, and
// the card the screen's own content goes in.
templ signupPage(title string, p signupProgress) {
	@layout.Marketing(title, layout.RobotsPrivate) {
		@marketingChromeWith(marketingChromeOpts{SignInHref: AdminLoginPath, SignInPrompt: true, Wide: true}) {
			<section class={ signupSectionClass(p.shown()) }>
				<div class={ signupGridClass(p.shown()) }>
					if p.shown() {
						@signupProgressBar(p)
						@signupProgressDocket(p)
					}
					<div class="flex min-w-0 flex-col gap-6 md:rounded-[18px] md:border md:border-line md:bg-paper md:px-8 md:py-[30px] desk:gap-[26px] desk:p-10">
						{ children... }
					</div>
				</div>
			</section>
		}
	}
}

func signupSectionClass(progress bool) string {
	if progress {
		return "px-4 pb-10 md:px-7 md:pb-12 md:pt-7 desk:px-4 desk:pb-16 desk:pt-10"
	}
	return "px-4 pb-10 pt-6 md:px-7 md:pb-12 md:pt-7 desk:px-4 desk:pb-16 desk:pt-10"
}

func signupGridClass(progress bool) string {
	if progress {
		return "mx-auto flex w-full max-w-6xl flex-col gap-6 desk:grid desk:grid-cols-[minmax(0,360px)_minmax(0,680px)] desk:items-start desk:gap-10"
	}
	return "mx-auto flex w-full max-w-[680px] flex-col gap-6"
}

// signupShell is a form screen: signupPage plus the step counter, the heading and the
// blurb.
//
// THE STEP COUNTER IS RENDERED FROM signupSteps RATHER THAN TYPED, for the reason
// pages.TourSteps gives about the mini tour: a slide that counts itself out loud
// ("Step 2 of 3") and a number typed into prose are two sources of truth, and the
// second one drifts the moment a step is added. On a phone the counter is the
// progress bar's own label, so the card's copy is drawn from the tablet width up.
templ signupShell(title string, p signupProgress, heading, blurb string) {
	@signupPage(title, p) {
		<div class="flex flex-col gap-2">
			<p class="lbl hidden md:block">{ p.barLabel() }</p>
			<h1 class="font-display text-[28px] font-bold leading-[1.1] tracking-tight md:text-[30px] desk:text-[34px]">
				{ heading }
			</h1>
			if blurb != "" {
				<p class="text-sm leading-normal text-ink/70 md:text-[15px]">{ blurb }</p>
			}
		</div>
		{ children... }
	}
}

// signupProgressBar is the phone's progress: two words and three segments. It sticks
// under the header while the form scrolls. The bar is a progressbar to assistive
// technology; its segments are decoration.
templ signupProgressBar(p signupProgress) {
	<div class="sticky top-0 z-10 -mx-4 flex flex-col gap-2 border-b border-line bg-porcelain px-4 pb-2.5 pt-3 md:hidden">
		<div class="flex items-baseline justify-between gap-2">
			<p class="font-mono text-[13px] font-bold text-ink">{ p.barLabel() }</p>
			<p class="font-mono text-xs text-ink/70">{ p.barTitle() }</p>
		</div>
		<div
			role="progressbar"
			aria-label="Registration progress"
			aria-valuemin="0"
			aria-valuemax={ strconv.Itoa(signupSteps) }
			aria-valuenow={ strconv.Itoa(p.completed()) }
			aria-valuetext={ p.barLabel() + ": " + p.barTitle() }
			class="grid grid-cols-3 gap-1"
		>
			for i := range signupSteps {
				<span class={ signupSegmentClass(p.state(i + 1)) }></span>
			}
		</div>
	</div>
}

func signupSegmentClass(state string) string {
	switch state {
	case "done":
		return "h-1.5 rounded-sm bg-tappa-green"
	case "now":
		return "h-1.5 rounded-sm bg-ink"
	default:
		return "h-1.5 rounded-sm bg-line"
	}
}

// signupProgressDocket is the progress from the tablet width up: a docket listing the
// three steps, each with its word (done, now, next). From the desk width it stands
// beside the form and also names the business; on the confirmation it carries the
// APPROVED stamp, which is true there and only there (SignupDoneView). The steps are
// never links: going back is the form's own Back.
templ signupProgressDocket(p signupProgress) {
	<nav aria-label="Registration progress" class="hidden md:block">
		<div class="docket flex items-center gap-2.5 px-4 py-3.5 desk:flex-col desk:items-stretch desk:gap-[18px] desk:px-[22px] desk:pb-[22px] desk:pt-6">
			<div class={ signupDocketHeadClass(p.Done) }>
				<div class="hidden min-w-0 flex-col gap-1 desk:flex">
					<p class="lbl">Registration</p>
					<p class="break-words font-display text-lg font-bold tracking-tight text-ink">{ p.name() }</p>
				</div>
				if p.Done {
					<span class="stamp stamp--approved">APPROVED</span>
				}
			</div>
			<ol class="grid min-w-0 flex-1 grid-cols-3 gap-2.5 desk:flex desk:flex-col desk:gap-0 desk:border-t desk:border-dashed desk:border-line">
				for i, title := range signupStepTitles {
					<li
						class="flex min-w-0 items-center gap-2.5 desk:gap-3.5 desk:border-b desk:border-dashed desk:border-line desk:py-3.5"
						if p.state(i+1) == "now" {
							aria-current="step"
						}
					>
						<span class={ signupStepMarkClass(p.state(i + 1)) } aria-hidden="true">{ p.mark(i + 1) }</span>
						<span class="flex min-w-0 flex-col">
							<span class="truncate font-display text-sm font-bold text-ink desk:text-[15px]">{ title }</span>
							<span class="font-mono text-[11px] text-ink/70">{ p.state(i + 1) }</span>
						</span>
					</li>
				}
			</ol>
			if !p.Done {
				<p class="hidden font-display text-xs leading-normal text-ink/70 desk:block">
					Nothing is created until the last step, and you can go back at any point.
				</p>
			}
		</div>
	</nav>
}

// signupDocketHeadClass places the docket's head: from the desk width it is the top
// row (the name, and the stamp when done); on a tablet only the stamp is drawn, after
// the steps, and a screen with no stamp draws no head there at all.
func signupDocketHeadClass(done bool) string {
	if done {
		return "order-last flex flex-none items-start justify-between gap-2.5 desk:order-none"
	}
	return "hidden desk:flex desk:items-start desk:justify-between desk:gap-2.5"
}

func signupStepMarkClass(state string) string {
	switch state {
	case "done":
		return "inline-flex size-9 flex-none items-center justify-center rounded-[10px] bg-tappa-green font-mono text-xs font-bold text-paper"
	case "now":
		return "inline-flex size-9 flex-none items-center justify-center rounded-[10px] bg-ink font-mono text-xs font-bold text-paper"
	default:
		return "inline-flex size-9 flex-none items-center justify-center rounded-[10px] border border-ink/50 bg-paper font-mono text-xs font-bold text-ink"
	}
}

// signupSteps is how many steps the wizard has. See signupShell for why it is a
// constant rather than a number in the prose.
const signupSteps = 3

// fieldError renders the one sentence attached to a field, or nothing.
//
// IT IS role="alert" SO A SCREEN READER IS TOLD, and it carries the tomato token in
// its BORDER and ground with the text in ink — skill tappa-brand's settled anatomy
// after the stamp measurement: colour reinforces, the words carry the meaning, and
// ink on paper clears AA where a coloured sentence would not. Its id is what the
// field's aria-describedby names when the field is refused (fieldInvalid).
templ fieldError(errs map[string]string, field string) {
	if msg, ok := errs[field]; ok {
		<p role="alert" id={ fieldErrorID(field) } class="rounded-[10px] border border-tomato bg-tomato/5 px-3 py-2 text-[13px] leading-normal text-ink">
			{ msg }
		</p>
	}
}

// fieldInvalid reports whether a field was refused, for its aria-invalid (the field
// class draws its error frame from that attribute, so the frame and what a screen
// reader hears cannot disagree).
func fieldInvalid(errs map[string]string, field string) bool {
	_, ok := errs[field]
	return ok
}

func fieldErrorID(field string) string { return "signup-error-" + field }

// signupAlert is the wizard's "this did not work" block: an ink sentence in a tomato
// frame, the word first. It is the wizard's own, not components.Notice, which the
// employee screens share and which this port does not touch.
templ signupAlert(heading string) {
	<div role="alert" class="flex flex-col gap-2 rounded-[14px] border-2 border-tomato bg-tomato/5 px-4 py-4 md:px-5 md:py-[18px]">
		<h2 class="font-display text-base font-bold tracking-tight text-ink">{ heading }</h2>
		<div class="flex flex-col gap-2 text-sm leading-normal text-ink">
			{ children... }
		</div>
	</div>
}

// SignupBusiness is step one: the business name, the VAT number, the trade and
// whether there is one place or several.
templ SignupBusiness(v SignupBusinessView) {
	@signupShell("Start free — Taptime", signupProgress{Step: 1, Name: v.Name}, "Tell us about the business",
		"Three short steps. Nothing is created until the last one, and you can go back at any point.") {
		if v.SignInHref != "" {
			@signupAlert("This business is already with Taptime") {
				<p>
					Sign in with the address you registered, or use a different VAT number if this is
					a second company.
				</p>
				<p>
					<a href={ templ.URL(v.SignInHref) } class="inline-flex min-h-11 items-center font-bold underline underline-offset-4">Go to sign in</a>
				</p>
			}
		}
		<form method="post" action="/signup" class="flex flex-col gap-6">
			<input type="hidden" name="csrf" value={ v.CSRFToken }/>
			<div class="grid gap-5 md:grid-cols-2 desk:grid-cols-1">
				<div class="field-stack">
					<label for="signup-name" class="lbl">Business name</label>
					<input
						id="signup-name"
						name="name"
						type="text"
						autocomplete="organization"
						required
						autofocus
						value={ v.Name }
						class="field-input field-input--mono"
						if fieldInvalid(v.Errors, "name") {
							aria-invalid="true"
							aria-describedby={ fieldErrorID("name") }
						}
					/>
					<p class="field-help">As it appears on your invoices.</p>
					@fieldError(v.Errors, "name")
				</div>
				<div class="field-stack">
					<label for="signup-vat" class="lbl">VAT number</label>
					<input
						id="signup-vat"
						name="vat_number"
						type="text"
						inputmode="text"
						autocomplete="off"
						spellcheck="false"
						required
						value={ v.VATNumber }
						class="field-input field-input--mono uppercase"
						if fieldInvalid(v.Errors, "vat_number") {
							aria-invalid="true"
							aria-describedby={ fieldErrorID("vat_number") }
						}
					/>
					<p class="field-help">
						With the country letters in front — MT12345678 for Malta. Taptime is for registered
						businesses, so this one is required.
					</p>
					@fieldError(v.Errors, "vat_number")
				</div>
			</div>
			<fieldset class="flex flex-col gap-2.5">
				<legend class="lbl mb-2.5">What kind of business</legend>
				<div class="grid grid-cols-2 gap-2 md:flex md:flex-wrap">
					for _, t := range v.Types {
						<label class="cursor-pointer">
							<input
								type="radio"
								name="business_type"
								value={ t.Value }
								checked?={ v.BusinessType == t.Value }
								class="peer sr-only accent-tappa-green"
							/>
							<span class="flex min-h-11 w-full items-center justify-center rounded-[10px] border border-line bg-paper px-3.5 font-mono text-xs uppercase tracking-[0.1em] text-ink peer-checked:border-tappa-green peer-checked:bg-tappa-green/10 peer-checked:shadow-[inset_0_0_0_1px_theme(colors.tappa-green)] peer-focus-visible:ring-2 peer-focus-visible:ring-ink md:w-auto">
								{ t.Label }
							</span>
						</label>
					}
				</div>
				@fieldError(v.Errors, "business_type")
			</fieldset>
			<fieldset class="flex flex-col gap-2.5">
				<legend class="lbl mb-2.5">How many places</legend>
				<div class="grid gap-3 md:grid-cols-2">
					@structureCard(v.Structure, "single", "One place",
						"A single door where your team taps.")
					@structureCard(v.Structure, "multi", "Several places",
						"Branches, sites or floors. You name them on the next step.")
				</div>
				// 🔴 DEPARTMENTS ARE NAMED HERE, OUTSIDE BOTH CARDS, AND THE MOVE IS THE
				// WHOLE POINT. The `multi` card used to end "You can add departments under
				// them later", which made departments read as something the choice above
				// unlocks. Measured, three ways, and all three say it does not:
				//
				//   * the product's own demo data goes the OTHER WAY — Kebab Factory is
				//     `multi` with nine venues and ZERO departments; Kebab Manufacturing is
				//     `single` with one venue and FIVE, every one of them carrying its own
				//     shift (test/fixtures/seed.sql);
				//   * nothing reads tenants.structure after the row is written — CreateTenant
				//     is the only statement that names the column, and no screen, query or
				//     policy branches on it (TestSignupStructure_DecidesNothingAfterSignUp);
				//   * the panel offers "Add a department" to both shapes, measured on two
				//     tenants provisioned end to end through this wizard.
				//
				// So the sentence in the card was telling half of our customers — including
				// exactly the shape that uses departments most in our own data — that a
				// feature was not for them. It belongs to neither card, so it sits under
				// both.
				<p class="field-help">
					Either choice can use departments: a group of people inside a venue, for when
					some of your staff work different hours from the rest of it. They are
					optional, and you add them from your dashboard when you need them.
				</p>
				@fieldError(v.Errors, "structure")
			</fieldset>
			<div>
				<button type="submit" class="btn btn--primary w-full rounded-xl px-6 md:w-auto">Continue</button>
			</div>
		</form>
	}
}

// structureCard is one of the two choices in the "how many places" step.
//
// IT IS A CARD RATHER THAN A RADIO IN A LIST because the choice decides how many
// venues the next step will accept — one, or up to signup.MaxVenues — so it
// deserves a sentence of explanation rather than a word. The input is still a
// radio — the card is its label — so it works with the keyboard and with no
// JavaScript at all.
//
// ⚠️ THAT IS ALSO ALL IT DECIDES, and this comment used to say otherwise ("the
// venue and department model for the life of the tenant"). The column is written
// once and read by nothing afterwards; the caller above carries the measurements.
// A card body that promises more than the next step will deliver is the defect
// M7-01 and M7-02 each shipped once.
templ structureCard(current, value, title, body string) {
	<label class="cursor-pointer">
		<input
			type="radio"
			name="structure"
			value={ value }
			checked?={ current == value }
			class="peer sr-only accent-tappa-green"
		/>
		<span class="flex h-full min-h-24 flex-col gap-1.5 rounded-[14px] border border-line bg-paper p-4 peer-checked:border-tappa-green peer-checked:bg-tappa-green/10 peer-checked:shadow-[inset_0_0_0_1px_theme(colors.tappa-green)] peer-focus-visible:ring-2 peer-focus-visible:ring-ink">
			<span class="font-display text-base font-bold tracking-tight text-ink">{ title }</span>
			<span class="text-[13px] leading-normal text-ink/70">{ body }</span>
		</span>
	</label>
}

// SignupPlaces is step two: the doors a plaque will go beside.
//
// ⚠️ IT ASKS FOR NAMES AND NOTHING ELSE, and that is a product decision worth
// keeping. The evidence a venue is judged on — its IP ranges, its coordinate, its
// shift, its Wi-Fi name — is configured from the dashboard afterwards (M6-06's
// screen), where somebody can look the values up. Asking a stranger for a CIDR block
// on a sign-up form produces wrong data at the one moment nobody can check it, and
// wrong proof-of-place is what turns a good tap into a FLAGGED one.
templ SignupPlaces(v SignupPlacesView) {
	@signupShell("Your places — Taptime", signupProgress{Step: 2, Name: v.BusinessName}, "Where does your team tap?",
		"One line per door. You can rename them and add the rest from your dashboard.") {
		<form method="post" action="/signup/places" class="flex flex-col gap-6">
			<input type="hidden" name="csrf" value={ v.CSRFToken }/>
			<div class="grid gap-3.5 md:grid-cols-2 md:gap-x-5 desk:grid-cols-1">
				for i, name := range v.Venues {
					<div class="field-stack">
						<label for={ "signup-venue-" + strconv.Itoa(i) } class="lbl">
							if v.Multi {
								{ "Place " + strconv.Itoa(i+1) }
							} else {
								Place
							}
						</label>
						<input
							id={ "signup-venue-" + strconv.Itoa(i) }
							name="venue"
							type="text"
							required?={ i == 0 }
							value={ name }
							placeholder="Front door"
							class="field-input field-input--mono"
							if fieldInvalid(v.Errors, "venue_"+strconv.Itoa(i)) {
								aria-invalid="true"
								aria-describedby={ fieldErrorID("venue_" + strconv.Itoa(i)) }
							}
						/>
						@fieldError(v.Errors, "venue_"+strconv.Itoa(i))
					</div>
				}
			</div>
			@fieldError(v.Errors, "venues")
			if v.Multi {
				// 🔴 THE EXTRA ROWS ARE RENDERED BY THE SERVER, NOT BY A SCRIPT. The
				// marketing surface loads no JavaScript at all (its policy names no
				// script-src and layout.Marketing has no slot for one), so "add another"
				// is a plain submit that re-renders the form with one more line. It works
				// on a locked-down work phone, and it keeps this flow's whole state on the
				// server side where it is already signed.
				<p class="field-help">
					Fill a line and press Continue to save it. You can name up to { strconv.Itoa(v.MaxVenues) }
					places here and add more later.
				</p>
			}
			@signupActions("Continue", v.BackHref)
		</form>
	}
}

// signupActions is a step's two buttons: the submit and Back. Back is a plain link to
// the previous step (the wizard's steps are links backwards and posts forwards, so the
// browser's back behaves too). On a phone both are full width, stacked.
templ signupActions(submit, backHref string) {
	<div class="flex flex-col gap-2.5 md:flex-row md:flex-wrap md:items-center md:gap-3">
		<button type="submit" class="btn btn--primary rounded-xl px-6">{ submit }</button>
		<a href={ templ.URL(backHref) } class="btn btn--line min-h-12 px-6">Back</a>
	</div>
}

// SignupAccount is step three: the person who will manage it.
//
// ⚠️ THE BLURB NO LONGER ENDS "You can invite the rest of your managers later."
// (M12-07). The panel invites EMPLOYEES only; inviting another administrator is
// blocked (M7-07 / Q02), so the sentence promised a capability the product does not
// have. TestSignupSurface_PromisesNoManagerInvite holds it out.
templ SignupAccount(v SignupAccountView) {
	@signupShell("Your account — Taptime", signupProgress{Step: 3, Name: v.BusinessName}, "Create your sign-in",
		"This is the account you will manage "+v.BusinessName+" with.") {
		<form method="post" action="/signup/account" class="flex flex-col gap-6">
			<input type="hidden" name="csrf" value={ v.CSRFToken }/>
			// THE HONEYPOT. It is hidden from people three ways at once — off-screen,
			// out of the tab order and out of the accessibility tree — because a field
			// that is merely `display:none` is skipped by some form fillers and a field
			// that is merely off-screen is read aloud by a screen reader.
			// internal/handler/signupratelimit.go owns the NAME and passes it in, so the
			// server's check and this input cannot drift apart.
			<div class="absolute left-[-9999px]" aria-hidden="true">
				<label for="signup-internal-ref">Reference</label>
				<input
					id="signup-internal-ref"
					name={ v.HoneypotField }
					type="text"
					tabindex="-1"
					autocomplete="off"
					data-1p-ignore="true"
					data-lpignore="true"
				/>
			</div>
			<div class="grid grid-cols-[repeat(auto-fit,minmax(260px,1fr))] items-start gap-6">
				<div class="flex flex-col gap-5">
					<div class="field-stack">
						<label for="signup-fullname" class="lbl">Your name</label>
						<input
							id="signup-fullname"
							name="full_name"
							type="text"
							autocomplete="name"
							required
							autofocus
							value={ v.FullName }
							class="field-input"
							if fieldInvalid(v.Errors, "full_name") {
								aria-invalid="true"
								aria-describedby={ fieldErrorID("full_name") }
							}
						/>
						@fieldError(v.Errors, "full_name")
					</div>
					<div class="field-stack">
						<label for="signup-email" class="lbl">Email</label>
						<input
							id="signup-email"
							name="email"
							type="email"
							autocomplete="username"
							required
							value={ v.Email }
							class="field-input field-input--mono"
							if fieldInvalid(v.Errors, "email") {
								aria-invalid="true"
								aria-describedby={ fieldErrorID("email") }
							}
						/>
						<p class="field-help">This is what you sign in with.</p>
						@fieldError(v.Errors, "email")
					</div>
					<div class="field-stack">
						<label for="signup-password" class="lbl">Password</label>
						// NO value ATTRIBUTE, EVER. A refused submission comes back with this
						// field empty and the person types it again — see signupview.go's header
						// for why a password is never echoed into a body.
						<input
							id="signup-password"
							name="password"
							type="password"
							autocomplete="new-password"
							required
							minlength="8"
							class="field-input field-input--mono"
							if fieldInvalid(v.Errors, "password") {
								aria-invalid="true"
								aria-describedby={ fieldErrorID("password") }
							}
						/>
						<p class="field-help">
							At least 8 characters. A few words you will remember beats a short one you will not.
						</p>
						@fieldError(v.Errors, "password")
					</div>
				</div>
				// THE READ-BACK. `transactions` is immutable and a business cannot be
				// deleted (§4.6), so this is the cheapest moment in the whole product to
				// catch a typo in a company name.
				<div class="flex flex-col gap-2 rounded-[14px] border border-line bg-paper px-4 py-3.5 md:bg-porcelain md:px-[18px] md:py-4">
					<p class="lbl">You are creating</p>
					<p class="break-words font-display text-base font-bold tracking-tight text-ink">{ v.BusinessName }</p>
					if len(v.Venues) > 0 {
						<p class="lbl mt-1.5">Places</p>
						<ul class="flex flex-col gap-0.5">
							for _, name := range v.Venues {
								<li class="break-words font-mono text-[13px] text-ink">{ name }</li>
							}
						</ul>
					}
					<p>
						<a href="/signup/places" class="inline-flex min-h-11 items-center font-display text-[13px] font-bold text-tappa-green underline underline-offset-4 hover:text-ink">Change these</a>
					</p>
				</div>
			</div>
			@signupActions("Create my account", "/signup/places")
		</form>
	}
}

// SignupDone is the confirmation — the APPROVED docket the M7-02 card asks for.
//
// 🔴 THE STAMP IS TRUE HERE AND ONLY HERE. This screen is reachable only after the
// provisioning transaction has COMMITTED (internal/handler/signup.go redirects to it
// and nothing else routes here), so the business, its places and its first operator
// exist. The brand's most emphatic component is not spent on a promise — which is
// also why the progress docket beside it carries the same stamp on this screen and
// on no other.
//
// THE DOCKET MOTIF IS THE PRODUCT'S SIGNATURE and this is the first record the
// customer ever sees. Every card in the panel will look like this one.
templ SignupDone(v SignupDoneView) {
	@signupShell("You're set up — Taptime", signupProgress{Done: true, Name: v.BusinessName}, v.BusinessName+" is set up", "") {
		<div class="docket-print pb-2">
			<article class="docket flex flex-col gap-3 px-[18px] py-[18px] md:px-[22px] md:py-5">
				<div class="flex items-start justify-between gap-3">
					<div class="flex min-w-0 flex-col gap-0.5">
						<p class="lbl">Business</p>
						<p class="break-words font-display text-base font-bold tracking-tight text-ink">
							{ v.BusinessName }
						</p>
						<p class="lbl mt-2">VAT</p>
						<p class="font-mono text-sm uppercase text-ink">{ v.VATNumber }</p>
					</div>
					<div class="shrink-0 text-right">
						<span class="stamp stamp--approved">APPROVED</span>
					</div>
				</div>
				if len(v.Venues) > 0 {
					<p class="lbl">Places</p>
					<ul class="flex flex-col gap-0.5">
						for _, name := range v.Venues {
							<li class="break-words font-mono text-sm text-ink">{ name }</li>
						}
					</ul>
				}
			</article>
		</div>
		// The note's frame follows the register's answer (a literal per outcome); the
		// sentence carries the answer itself, so the colour only repeats it.
		<p class={ signupVATNoteClass(v) }>{ v.VATNote() }</p>
		if v.SignInBlocked {
			// 🔴 THE ONE STATE IN WHICH THIS SCREEN MUST NOT SAY "SIGN IN".
			// signupview.go carries the whole argument: the business EXISTS,
			// and it was measured that this address cannot reach the sign-in
			// path. Sending them to a form that answers 401 without an
			// explanation — which it must not give — is the defect this
			// branch was added to stop.
			@signupAlert("This email address cannot sign in") {
				<p>
					{ v.BusinessName } is set up and nothing about it is lost. But this
					email address is already in use by more accounts than we can check at
					once, so signing in with it will not work.
				</p>
				<p>
					Write to us and we will move the business onto an address you can use.
					Please do not register it a second time — it already exists.
				</p>
			}
		}
		<section class="flex flex-col gap-3.5 border-t border-line pt-5 md:pt-[22px]">
			<h2 class="lbl">What happens next</h2>
			<ol class="flex flex-col gap-3 md:gap-3.5">
				if !v.SignInBlocked {
					<li class="grid grid-cols-[28px_1fr] gap-2.5 text-sm leading-normal text-ink md:grid-cols-[34px_1fr] md:gap-3 md:text-[15px]">
						<span class="font-mono font-bold" aria-hidden="true">{ signupDoneStepNo(v.SignInBlocked, 1) }</span>
						<span>
							<span class="font-display font-bold tracking-tight">Sign in.</span>
							Use the email address and password you just chose.
						</span>
					</li>
				}
				<li class="grid grid-cols-[28px_1fr] gap-2.5 text-sm leading-normal text-ink md:grid-cols-[34px_1fr] md:gap-3 md:text-[15px]">
					<span class="font-mono font-bold" aria-hidden="true">{ signupDoneStepNo(v.SignInBlocked, 2) }</span>
					<span>
						<span class="font-display font-bold tracking-tight">Invite your team.</span>
						Each person opens their own link once, on their own phone.
					</span>
				</li>
				<li class="grid grid-cols-[28px_1fr] gap-2.5 text-sm leading-normal text-ink md:grid-cols-[34px_1fr] md:gap-3 md:text-[15px]">
					<span class="font-mono font-bold" aria-hidden="true">{ signupDoneStepNo(v.SignInBlocked, 3) }</span>
					// 🔴 IT NO LONGER SAYS "POSTS THEM TO YOU" (2026-08-14). Nothing in
					// this product knows whether a plaque has been ordered, packed or
					// sent: there is no order, no shipment and no date in the schema.
					// The wording is now locations.templ's, which has said "loads it
					// here" since 2026-08-08 precisely to avoid that claim — so the
					// product stopped promising a delivery on one screen while its own
					// tripwire forbade the same words on another, one click apart.
					// TestSignupSurface_MakesNoDeliveryClaim holds it.
					<span>
						<span class="font-display font-bold tracking-tight">Your plaques.</span>
						Taptime encodes each one and loads it into your dashboard; ask us for the
						ones you need. Until one is mounted there is nothing to tap at.
					</span>
				</li>
			</ol>
		</section>
		if !v.SignInBlocked {
			<div>
				<a href={ templ.URL(v.SignInHref) } class="btn btn--primary w-full rounded-xl px-6 md:w-auto">
					Sign in to your dashboard
				</a>
			</div>
		}
	}
}

func signupVATNoteClass(v SignupDoneView) string {
	switch {
	case v.VATVerified:
		return "rounded-xl border border-tappa-green bg-tappa-green/10 px-3.5 py-3 text-[13px] leading-normal text-ink"
	case v.VATRefused:
		return "rounded-xl border border-saffron bg-saffron-lite px-3.5 py-3 text-[13px] leading-normal text-ink"
	default:
		return "rounded-xl border border-dashed border-ink/50 bg-porcelain px-3.5 py-3 text-[13px] leading-normal text-ink"
	}
}

// SignupProblem is every "this did not work" screen in the wizard. See
// signupview.go for why it is separate from pages.Problem.
//
// IT DRAWS NO PROGRESS: a problem screen does not know how far the visitor got (the
// state that would say so is what failed), so it claims nothing about the steps.
templ SignupProblem(v SignupProblemView) {
	@signupPage("Taptime", signupProgress{}) {
		<div role="alert" class="flex flex-col gap-2 rounded-[14px] border-2 border-tomato bg-tomato/5 px-4 py-4 md:px-5 md:py-[18px]">
			<h1 class="font-display text-[21px] font-bold tracking-tight text-ink md:text-[22px]">{ v.Title }</h1>
			<p class="text-[15px] leading-normal text-ink">{ v.Message }</p>
			if v.Hint != "" {
				<p class="text-sm leading-normal text-ink/70">{ v.Hint }</p>
			}
		</div>
		if v.Retry != "" {
			<div>
				<a href={ templ.URL(v.Retry) } class="btn btn--primary w-full rounded-xl px-6 md:w-auto">
					Start again
				</a>
			</div>
		}
	}
}
