package pages

import (
	"strconv"

	"github.com/atknatk/tappa/web/templates/components"
	"github.com/atknatk/tappa/web/templates/layout"
)

// Activate is the activation screen: identity, the GDPR Art. 13 notice, the
// optional Wi-Fi step, and ONE button.
//
// It follows the tap screen's discipline without being it (skill tappa-brand,
// CLAUDE.md §9): no menu, no tabs, no settings, one action. The difference is
// that this screen legitimately carries text — it is the only moment an employee
// is told what the product records about them, and consent has to be informed to
// be consent.
//
// THE FORM CARRIES NO CODE. It posts two fields: the consent box and the
// synchronizer token. The invite code reached the server in the link and now
// lives in an HttpOnly cookie (internal/handler/cookies.go), so it is not in
// this HTML, not in the address bar after the first hop, and not in a screenshot
// of this page.
//
// IT ALWAYS SAYS WHOSE ACTIVATION THIS IS. The employer and the employee are on
// the docket at the top AND on the line directly above the button, because a
// planted cookie on a session-less phone is still possible (cookies.go, measure
// 3 and its M5-04 note) and the only thing between that and a confused tap is a
// person reading a name they do not recognise before pressing anything.
templ Activate(v ActivateView) {
	@layout.Page("Activate your phone — Tappa") {
		<section class="docket">
			<p class="docket-label">Activating</p>
			<h1 class="font-display text-2xl font-bold tracking-tight text-ink">
				Hello { v.EmployeeName }
			</h1>
			<p class="mt-1 text-ink/70">{ v.EmployerName }</p>
			if v.LocationName != "" {
				<p class="text-ink/70">{ v.LocationName }</p>
			}
		</section>
		if v.HeldByName != "" {
			@components.Notice(components.ToneAlert, "This phone belongs to someone else") {
				<p>
					It is signed in as
					<span class="font-bold">{ v.HeldByName }</span>
					if v.HeldByEmployer != "" {
						({ v.HeldByEmployer })
					}
					. Finishing here signs { v.HeldByName } out and hands this phone to
					{ v.EmployeeName }.
				</p>
				<p class="mt-2 font-bold text-tomato">
					If you did not expect this, close the page and tell your manager. Their
					hours are recorded on this phone.
				</p>
			}
		}
		if v.SecondDevice {
			@components.Notice(components.ToneWarn, "This is a new phone") {
				You are already set up on another phone. Finishing here signs that one out —
				only the phone you are holding will work afterwards. If you did not expect
				this, stop and tell your manager.
			}
		}
		@components.Card("Before you start") {
			<ul class="mt-3 flex flex-col gap-3 text-sm text-ink/85">
				<li>
					<span class="font-bold">What a tap records.</span>
					When you touch the plaque, Tappa saves the time, your phone's internet (IP)
					address and — only at that moment — your location. Nothing runs in the
					background and nothing is recorded between taps.
				</li>
				<li>
					<span class="font-bold">No fingerprints. Ever.</span>
					Tappa collects no biometric data of any kind: no fingerprints, no face, no voice.
					Your phone's own screen lock stays private to your phone.
				</li>
				<li>
					<span class="font-bold">How long records are kept.</span>
					Your attendance records are kept for
					<span class="num font-bold">{ strconv.Itoa(v.RetentionYears) }</span>
					if v.RetentionYears == 1 {
						year,
					} else {
						years,
					}
					as set by your employer.
				</li>
				<li>
					<span class="font-bold">Who is responsible.</span>
					{ v.EmployerName } is the controller of these records; Tappa processes them
					on their behalf. To see, correct or ask about your data, speak to your
					manager.
				</li>
			</ul>
			if v.ShowConfigNotice {
				<p class="mt-4 border-t border-line pt-3 font-mono text-[11px] leading-relaxed text-ink/50">
					Non-production deployment: the retention period above is read from this
					server's configuration and is a placeholder value, not legal advice.
				</p>
			}
		}
		@components.Card("Join the Wi-Fi") {
			if v.WiFiSSID != "" {
				<p class="mt-2 text-sm text-ink/85">
					Connect to
					<span class="num font-bold">{ v.WiFiSSID }</span>
					before you tap: being on the venue's network is how Tappa can tell you are
					really here.
				</p>
			} else {
				<p class="mt-2 text-sm text-ink/85">
					This place has no staff network to join, so Tappa will use your location at
					the moment you tap instead.
				</p>
			}
			<p class="mt-2 text-sm text-ink/60">
				You can skip this — activation works either way. Without the network, taps fall
				back to your location and may need your manager to confirm them.
			</p>
		}
		<form method="post" action="/api/activate" class="flex flex-col gap-4">
			<input type="hidden" name="csrf" value={ v.CSRFToken }/>
			if v.HeldByName != "" {
				<label class="flex items-start gap-3 border-l-4 border-tomato bg-paper px-4 py-4">
					<input
						type="checkbox"
						name="switch"
						value="yes"
						required
						checked?={ v.SwitchConfirmed }
						class="mt-1 h-5 w-5 shrink-0 accent-tomato"
					/>
					<span class="text-sm text-ink/85">
						I understand this signs { v.HeldByName } out of this phone.
					</span>
				</label>
				if v.SwitchMissing {
					@components.Notice(components.ToneAlert, "") {
						<span class="font-bold text-tomato">
							Nothing was changed. Tick the box above if you really mean to take
							this phone over.
						</span>
					}
				}
			}
			<label class="flex items-start gap-3 bg-paper border border-line px-4 py-4">
				<input
					type="checkbox"
					name="consent"
					value="yes"
					required
					class="mt-1 h-5 w-5 shrink-0 accent-tappa-green"
					if v.ConsentMissing {
						aria-invalid="true"
						aria-describedby="consent-error"
					}
				/>
				<span class="text-sm text-ink/85">
					I have read what Tappa records and how long it is kept.
				</span>
			</label>
			if v.ConsentMissing {
				<p id="consent-error" class="border-l-4 border-tomato bg-paper px-4 py-3 text-sm font-bold text-tomato">
					Please tick the box above so we know you have read this. Nothing was
					activated.
				</p>
			}
			<p class="text-center text-sm text-ink/70">
				This sets up this phone for
				<span class="font-bold text-ink">{ v.EmployeeName }</span>
				at
				<span class="font-bold text-ink">{ v.EmployerName }</span>
				.
			</p>
			<button type="submit" class="tap-button">Activate this phone</button>
		</form>
	}
}

// Done is the confirmation. No button (skill tappa-brand): the next thing that
// happens is a physical touch on a plaque, so there is nothing to press here.
templ Done(v DoneView) {
	@layout.Page("You're set up — Tappa") {
		<section class="docket">
			<p class="docket-label">Activated</p>
			<h1 class="font-display text-2xl font-bold tracking-tight text-ink">
				You're set, { v.EmployeeName }
			</h1>
			if v.LocationName != "" {
				<p class="mt-1 text-ink/70">{ v.LocationName }</p>
			}
		</section>
		@components.Notice(components.ToneOK, "This phone is now your time clock.") {
			Hold it near the plaque at the door and press the one button you see. That is
			the whole thing — there is nothing to install and nothing to remember.
		}
		if v.WiFiSSID != "" {
			@components.Card("") {
				<p class="text-sm text-ink/85">
					One last thing: connect to
					<span class="num font-bold">{ v.WiFiSSID }</span>
					when you are at work, so Tappa can see you are on site.
				</p>
			}
		}
		if v.SecondDevice {
			@components.Notice(components.ToneWarn, "") {
				Your other phone has been signed out. Only this one works now.
			}
		}
		<p class="pt-2 text-center font-display text-lg tracking-tight text-ink/70">
			All done — you can close this page.
		</p>
	}
}

// Tour is the mini tour (M5-07): three slides between a FIRST activation and the
// confirmation. It teaches the product in the order somebody meets it — where to
// put the phone, what to press, and what the first tap will be.
//
// IT STORES NOTHING AND IT CANNOT. No `transactions` row, no `audit_log` row and
// no cookie is written on this path; the only thing remembered is which URL the
// visitor is looking at. That is what makes the card's "the tour can be skipped"
// true by construction rather than by promise — skipping and finishing are the
// SAME act, following a link to /activate/done, so neither one changes a record.
// TestTourDB_WritesNothing counts the rows across a full walk and across a skip.
//
// 🔴 WHY SLIDE THREE DOES NOT SAY "YOUR NEXT TAP WILL BE PRACTICE". Measured
// rather than assumed (internal/domain/tap, isPracticeTap): a tap is practice
// when the person has NO PRIOR RECORD AT ALL and the verdict is ok or flag. Three
// measured consequences shaped the words:
//
//   - A REJECTED FIRST TAP SPENDS THE PRACTICE RUN. §4.6 records every decided
//     tap and GetLastTransactionForEmployee carries no verdict predicate, so after
//     a reject — a retired plaque, an invalid SUN, a deactivated account — the
//     next tap is an ordinary one. Measured as the SEQUENCE, not deduced from two
//     halves: TestTourDB_ARejectedFirstTapSpendsThePracticeRun drives a retired
//     plaque, then the same plaque back in service, and reads practice=false off
//     the second row.
//   - SO DOES an `ignored` duplicate, an ordinary earlier `ok` or `flag`, and so
//     would a manual record a manager enters first (M6-04, not reachable today).
//   - SOMEBODY SETTING UP A SECOND PHONE has already tapped, so nothing about
//     their next tap is a practice run. That case never reaches this screen:
//     Submit sends a second-device activation straight to the confirmation. It is
//     the one moment the difference is knowable — employees.status was already
//     'active' (invite.Activation.SecondDeviceReplaced), and a person who has
//     never been activated has never held a session and so has never tapped.
//
// What survives all three is what the slide actually says: the FIRST tap is a
// practice run, a TRAINING mark means that tap does not count toward hours, and
// the screen after a tap is what really happened. That last sentence is not
// decoration — it points the employee at the one surface that REPORTS instead of
// predicting (pages.Result, whose words are pinned in result_test.go).
//
// NO SCRIPT AND NO REMEMBERED PROGRESS. Advancing is a link and a GET, so the tour
// works on a locked-down work phone with JavaScript switched off — the same
// property the activation form has, for the same reason (layout.Page).
templ Tour(v TourView) {
	@layout.Page(TourPageTitle(v.Step)) {
		<section class="docket">
			<p class="docket-label">
				Step { strconv.Itoa(v.Step) } of { strconv.Itoa(TourSteps) }
			</p>
			<h1 class="font-display text-2xl font-bold tracking-tight text-ink">
				@tourHeading(v.Step)
			</h1>
		</section>
		@components.Card("") {
			@tourBody(v.Step)
		}
		@tourNav(v.Step)
	}
}

// tourHeading, tourBody and tourNav all treat an UNKNOWN step as step one, and
// they do it the same way on purpose: the handler already clamps, so a mismatch
// between the three would only ever show up as a slide whose heading, words and
// buttons disagreed about which slide it is.
templ tourHeading(step int) {
	switch step {
		case 2:
			One button
		case 3:
			First tap is practice
		default:
			Tap the plaque
	}
}

templ tourBody(step int) {
	switch step {
		case 2:
			<p class="mt-2 text-sm text-ink/85">
				The page opens with your name on it and a single button. Press it — that is
				the whole thing.
			</p>
			<p class="mt-2 text-sm text-ink/85">
				Tappa works out whether you are arriving or leaving, so you never have to
				choose.
			</p>
		case 3:
			<p class="mt-2 text-sm text-ink/85">
				Go ahead and try it: your first tap is a practice run.
			</p>
			<p class="mt-3">
				<span class="stamp stamp--training">TRAINING</span>
			</p>
			<p class="mt-3 text-sm text-ink/85">
				The screen marks a practice tap like that, and a TRAINING tap never counts
				toward your hours.
			</p>
			<p class="mt-3 text-sm text-ink/70">
				Whatever a tap turns out to be, the screen right after it says so.
			</p>
		default:
			<p class="mt-2 text-sm text-ink/85">
				Hold the top of your phone against the Tappa plaque by the door. Your phone
				opens this page for you — there is nothing to install and nothing to
				remember.
			</p>
			<p class="mt-3 text-sm text-ink/70">
				If your phone does not react, ask your manager.
			</p>
	}
}

// tourNav is the only way forward and the only way out, and both are ANCHORS. A
// link issues a GET and carries no body, so nothing on this screen can post
// anything — the same rule pages.Problem keeps, for the same reason (§9: nothing
// on a screen may produce an attendance record).
//
// EVERY HREF IS A LITERAL. Building "/activate/tour?step=" + a number in Go would
// work, but a URL assembled outside the template is exactly the shape that put
// four stamp classes out of the compiled stylesheet once already, and a literal
// is also what lets a test pin the set of addresses these screens point at.
templ tourNav(step int) {
	switch step {
		case 2:
			<a href="/activate/tour?step=3" class="tap-button flex items-center justify-center">Next</a>
			@tourSkip()
		case 3:
			<a href="/activate/done" class="tap-button flex items-center justify-center">Got it</a>
		default:
			<a href="/activate/tour?step=2" class="tap-button flex items-center justify-center">Next</a>
			@tourSkip()
	}
}

// tourSkip is the escape hatch the card asks for. It is 44px tall because that is
// the smallest target skill tappa-brand allows, and quiet because leaving early
// is a perfectly ordinary choice — the practice tap lands either way, which is
// what TestTourDB_SkippingTheTourStillLeavesThePracticeFlag proves end to end.
templ tourSkip() {
	<a href="/activate/done" class="flex min-h-11 items-center justify-center text-sm text-ink/70">
		Skip the tour
	</a>
}

// Problem is every failure screen. The handler picks the words from a fixed set
// of constants so that an unknown, an expired and an already-used code produce
// BYTE-IDENTICAL output (§4.7: no oracle) — asserted in
// internal/handler/activate_test.go.
//
// ONE TEMPLATE SERVES BOTH FLOWS, so a sentence added here appears on ALL of
// them — ELEVEN screens, counted rather than guessed: five activation failures
// (internal/handler/activate.go: problemNoLink, problemBadLink, problemTooMany,
// problemNoSession, problemServer) and six tap failures (tap.go's tapProblem*).
// An earlier version of this paragraph said "three activation failures", which
// was wrong in exactly the way a field count that stops matching its struct is
// wrong.
//
// THAT REACH IS WHY THE COPY IS PINNED AS WHOLE TEXT rather than by keyword: an
// audit added a plain sentence to this template and to two of the constants and
// the entire suite stayed green. TestProblemScreens_SayExactlyThisAndNothingElse
// renders the six TAP screens and compares the complete document text, so a
// sentence added HERE — the cross-flow vector, the one that reaches all eleven —
// is caught by those six.
//
// THE FIVE ACTIVATION CONSTANTS ARE NOT PINNED, and that is a scope decision
// rather than an oversight. Their words are M5-02's copy, that flow took four
// audit rounds to settle, and a test written from here would quietly take
// ownership of text this task never reviewed. What is checked from here is the
// SHARED surface. The gap is real and worth naming: an edit to
// problemServer.Message ("Nothing was activated and nothing was recorded against
// you") would not be caught by anything in this package.
//
// THE "TRY AGAIN" OF THE M5-06 CARD LIVES HERE AND NOWHERE ELSE, because this is
// the only family of screens where nothing was recorded and a retry can therefore
// change the outcome. It appears only when the handler supplied a RetryURL, which
// it does for three of the five GET-path server errors — see ProblemView.RetryURL
// and internal/handler/tap.go for the measured reasons the others get an
// INSTRUCTION instead of a button that cannot work.
//
// IT IS AN ANCHOR, NOT A FORM. A link issues a GET; it cannot resubmit the body
// of a POST, so no failure screen in this package can produce a second
// attendance record. That is the same rule the confirmation screen keeps by
// having no button at all (§9).
templ Problem(v ProblemView) {
	@layout.Page("Tappa") {
		@components.Notice(components.ToneAlert, "") {
			<h1 class="font-display text-xl font-bold tracking-tight">{ v.Title }</h1>
			<p class="mt-2">{ v.Message }</p>
			if v.Hint != "" {
				<p class="mt-2 text-ink/60">{ v.Hint }</p>
			}
		}
		if v.RetryURL != "" {
			// WHAT templ.URL ACTUALLY CHECKS, read from its source (v0.3.833,
			// url.go) rather than assumed: if the string has a ':' before any '/',
			// the part in front of it must be http, https, mailto, tel, ftp or ftps,
			// otherwise the whole value becomes about:invalid. That is a NARROW
			// guarantee and the useful one here — a future caller cannot turn this
			// anchor into a javascript: or data: handler.
			//
			// IT IS NOT A GENERAL SANITISER, and an earlier version of this comment
			// said it was. Every string with NO colon before a slash passes through
			// UNTOUCHED: relative paths, and scheme-relative //host/... references
			// too. So templ.URL is not what keeps this link on our own origin — the
			// ROUTE is (only chi's /t reaches the handler that sets RetryURL, and
			// //host forms answer 404 before it; measured, see ProblemView.RetryURL).
			// Escaping of the query is templ's attribute escaping, which is a
			// different mechanism again.
			<a href={ templ.URL(v.RetryURL) } class="tap-button flex items-center justify-center">Try again</a>
		}
	}
}

// Confirm is the same-site confirmation step for a cross-site arrival that would
// collide with the session already on this phone (internal/handler: measure 3).
// It stores NOTHING — the code only reaches a cookie if the person holding the
// phone presses the button on this page.
templ Confirm(v ConfirmView) {
	@layout.Page("Continue? — Tappa") {
		@components.Notice(components.ToneAlert, "") {
			<h1 class="font-display text-xl font-bold tracking-tight">This phone is already in use</h1>
			<p class="mt-2">
				Someone is signed in on this phone. You have opened a link that would set it
				up for
				<span class="font-bold">{ v.EmployeeName }</span>
				if v.EmployerName != "" {
					at { v.EmployerName }
				}
				instead.
			</p>
			<p class="mt-2 text-ink/60">
				If you did not expect this page, close it. Nothing has changed.
			</p>
		}
		<form method="post" action="/activate" class="flex flex-col gap-4">
			<input type="hidden" name="code" value={ v.Code }/>
			<button type="submit" class="tap-button">Continue anyway</button>
		</form>
	}
}
