package pages

import (
	"strconv"

	"github.com/atknatk/tappa/web/templates/components"
	"github.com/atknatk/tappa/web/templates/layout"
)

// Activate is the activation WIZARD (ADR 0026): three short steps and a waiting
// screen, each one a plain GET, so it works with JavaScript off.
//
//	1  Welcome      how Taptime works, in three lines
//	2  Privacy      the GDPR Art. 13 notice and the consent box — the only form
//	3  Get ready    the venue Wi-Fi, and "stay in this browser"
//	4  Tap          "now tap the plaque"; the tap itself finishes activation
//
// NOTHING ON THESE SCREENS ACTIVATES ANYTHING. The consent form records consent
// and binds it to this browser; the session is born on the first genuine NFC tap
// (GET /t), which renders Activated. That is why step 4 has no primary button:
// the next action is physical.
//
// THE FORM CARRIES NO CODE. It posts the consent box, the optional switch box and
// the synchronizer token. The invite code lives in an HttpOnly cookie
// (internal/handler/cookies.go), not in this HTML.
//
// IT ALWAYS SAYS WHOSE ACTIVATION THIS IS. The employee's name heads step 1 and the
// employer is named on every step, because a planted cookie on a session-less
// phone is still possible (cookies.go, measure 3): the defence that remains is a
// person reading a name they do not recognise before agreeing to anything.
//
// THE BUSINESS'S BRAND (M10 WL-13, user decisions of 2026-10-09) is look: the tap
// screen's header -- the logo in its 24 px slot over the co-brand line, or the ink
// wordmark when there is an accent and no logo -- and the accent's theme stylesheet,
// which fills the primary button of steps 1 to 3. With an accent linked, the wizard's
// other green marks turn ink -- the progress bar, the step numbers, the ticked consent
// box -- so the tenant's button is the one accent colour on the screen (decision 3, K-2a
// extended). The theme body does not change; the ink classes are chosen here, per
// render. A zero layout.Brand renders the page this template rendered before WL-13,
// byte for byte (internal/handler, TestUnbrandedScreens_AreByteIdenticalToTheGolden).
// The logo is already dropped for a business VIES did not verify (decision 2).
templ Activate(v ActivateView, look layout.Brand) {
	if v.Step == ActivateStepTap {
		@layout.PageWithScript("Tap the plaque — Taptime", "/static/js/activate.js", look) {
			@wizardShell(v, look.Accented()) {
				@wizardTap(v)
			}
		}
	} else {
		@layout.ActivationPage(wizardTitle(v.Step), look) {
			@wizardShell(v, look.Accented()) {
				switch v.Step {
					case 2:
						@wizardPrivacy(v, look.Accented())
					case 3:
						@wizardReady(v, look.Accented())
					default:
						@wizardWelcome(v, look.Accented())
				}
			}
		}
	}
}

func wizardTitle(step int) string {
	switch step {
	case 2:
		return "Your privacy — Taptime"
	case 3:
		return "Get ready — Taptime"
	default:
		return "Welcome — Taptime"
	}
}

func wizardStepName(step int) string {
	switch step {
	case 2:
		return "Privacy"
	case 3:
		return "Get ready"
	case ActivateStepTap:
		return "Tap"
	default:
		return "Welcome"
	}
}

// wizardSegment is one bar of the progress indicator. The classes are LITERALS in
// this file on purpose: Tailwind reads .templ files and not .go files, so a class
// assembled anywhere else would silently drop out of the stylesheet.
//
// accented is the page's theme link (M10 WL-13): a done bar keeps its done class and
// takes the ink fill on top of it -- a utility, so it wins over the component's green
// by layer order -- and a bar still to come is unchanged.
func wizardSegment(n, current int, accented bool) string {
	switch {
	case n > current:
		return "wizard-segment"
	case accented:
		return "wizard-segment wizard-segment--done bg-ink"
	default:
		return "wizard-segment wizard-segment--done"
	}
}

// wizardIndex is the 01 / 02 / 03 of steps 1 and 3: green on Taptime's page, ink beside
// a tenant accent (M10 WL-13). Literals here, for wizardSegment's reason.
func wizardIndex(accented bool) string {
	if accented {
		return "wizard-index text-ink"
	}
	return "wizard-index"
}

// wizardConsent is the consent box's frame: Taptime's green edge and ground once ticked,
// or ink ones beside a tenant accent (M10 WL-13). Literals here, for wizardSegment's
// reason; the box's own tick colour is written on the input below, where the
// native-control scan reads it.
func wizardConsent(accented bool) string {
	if accented {
		return "wizard-consent has-[:checked]:border-ink has-[:checked]:bg-ink/5"
	}
	return "wizard-consent"
}

// wizardShell is the frame every step shares: progress, the step's body, and the
// actions pinned toward the bottom of a phone screen where a thumb reaches them.
templ wizardShell(v ActivateView, accented bool) {
	<div class="wizard">
		<nav aria-label="Setup progress">
			<p class="docket-label">
				Step <span class="num">{ strconv.Itoa(clampStep(v.Step)) }</span> of <span class="num">{ strconv.Itoa(ActivateStepTap) }</span>
				· { wizardStepName(clampStep(v.Step)) }
			</p>
			<ol class="mt-2 grid grid-cols-4 gap-1.5" role="list">
				for n := 1; n <= ActivateStepTap; n++ {
					<li class={ wizardSegment(n, clampStep(v.Step), accented) } aria-current?={ n == clampStep(v.Step) }>
						<span class="sr-only">{ wizardStepName(n) }</span>
					</li>
				}
			</ol>
		</nav>
		{ children... }
	</div>
}

// heldByLabel is "Name — Employer" or just the name. Built in Go so no
// punctuation lands after a name that may itself end in a full stop ("Ltd.").
func heldByLabel(v ActivateView) string {
	if v.HeldByEmployer == "" {
		return v.HeldByName
	}
	return v.HeldByName + " — " + v.HeldByEmployer
}

func clampStep(step int) int {
	if step < 1 || step > ActivateStepTap {
		return 1
	}
	return step
}

// wizardHolder is the two warnings that must be seen BEFORE agreeing to anything:
// this phone carries somebody else's session, or this person is replacing their
// own other phone. They sit on steps 1 and 2.
templ wizardHolder(v ActivateView) {
	if v.HeldByName != "" {
		@components.Notice(components.ToneAlert, "This phone belongs to someone else") {
			<p>It is signed in as <span class="font-bold">{ heldByLabel(v) }</span></p>
			<p class="mt-2">Finishing setup hands this phone to { v.EmployeeName } and signs { v.HeldByName } out of it.</p>
			<p class="mt-2 font-bold text-ink">
				If you did not expect this, close the page and tell your manager. Their
				hours are recorded on this phone.
			</p>
		}
	}
	if v.SecondDevice {
		@components.Notice(components.ToneWarn, "This is a new phone") {
			You are already set up on another phone. When you finish here, that one is
			signed out — only the phone you are holding will work. If you did not
			expect this, stop and tell your manager.
		}
	}
}

templ wizardWelcome(v ActivateView, accented bool) {
	<section class="wizard-panel">
		<p class="docket-label">{ v.EmployerName }</p>
		<h1 class="mt-1 font-display text-3xl font-bold leading-tight tracking-tight text-ink">
			<span class="block">Hi { v.EmployeeName }</span>
			<span class="block text-ink/70">Let's set up your phone.</span>
		</h1>
		<p class="mt-3 text-base text-ink/85">
			{ v.EmployerName } uses Taptime to record your shifts. Setup takes about a
			minute, and there is nothing to install.
		</p>
	</section>
	<section class="docket wizard-panel">
		<p class="docket-label">How it works</p>
		<ol class="mt-3 flex flex-col gap-4" role="list">
			<li class="flex gap-3">
				<span class={ wizardIndex(accented) }>01</span>
				<div>
					<p class="font-display text-base font-bold tracking-tight">Tap the plaque</p>
					<p class="mt-0.5 font-display text-sm text-ink/80">
						Hold the top of your phone against the Taptime plaque by the door. A page
						opens by itself.
					</p>
				</div>
			</li>
			<li class="flex gap-3">
				<span class={ wizardIndex(accented) }>02</span>
				<div>
					<p class="font-display text-base font-bold tracking-tight">Press one button</p>
					<p class="mt-0.5 font-display text-sm text-ink/80">
						Taptime works out whether you are arriving or leaving, so you never have to
						choose.
					</p>
				</div>
			</li>
			<li class="flex gap-3">
				<span class={ wizardIndex(accented) }>03</span>
				<div>
					<p class="font-display text-base font-bold tracking-tight">Nothing in the background</p>
					<p class="mt-0.5 font-display text-sm text-ink/80">
						No fingerprints, no face scan. Your location is read only at the moment you
						tap — never between taps.
					</p>
				</div>
			</li>
		</ol>
	</section>
	@wizardHolder(v)
	<div class="wizard-actions">
		<a href="/activate?step=2" class="tap-button flex items-center justify-center">Next</a>
	</div>
}

// wizardPrivacy is the GDPR Art. 13 notice and the consent box. The words of the
// notice are the activation page's (M5-02), unchanged in substance; what changed
// is that agreeing no longer activates anything (ADR 0026).
templ wizardPrivacy(v ActivateView, accented bool) {
	<section class="wizard-panel">
		<p class="docket-label">Your privacy</p>
		<h1 class="mt-1 font-display text-3xl font-bold leading-tight tracking-tight text-ink">
			What Taptime records — and what it never does.
		</h1>
	</section>
	@wizardHolder(v)
	<section class="docket wizard-panel">
		<ul class="flex flex-col gap-4 font-display text-sm text-ink/85" role="list">
			<li>
				<p class="text-base font-bold tracking-tight text-ink">What a tap records</p>
				<p class="mt-0.5">
					When you touch the plaque, Taptime saves the time, your phone's internet (IP)
					address and — only at that moment — your location. Nothing runs in the
					background and nothing is recorded between taps.
				</p>
			</li>
			<li>
				<p class="text-base font-bold tracking-tight text-ink">No fingerprints. Ever.</p>
				<p class="mt-0.5">
					Taptime collects no biometric data of any kind: no fingerprints, no face, no
					voice. Your phone's own screen lock stays private to your phone.
				</p>
			</li>
			<li>
				<p class="text-base font-bold tracking-tight text-ink">How long records are kept</p>
				<p class="mt-0.5">
					Your attendance records are kept for
					<span class="num font-bold">{ strconv.Itoa(v.RetentionYears) }</span>
					if v.RetentionYears == 1 {
						year,
					} else {
						years,
					}
					as set by your employer.
				</p>
			</li>
			<li>
				<p class="text-base font-bold tracking-tight text-ink">Who is responsible</p>
				<p class="mt-0.5">
					{ v.EmployerName } is the controller of these records; Taptime processes them
					on their behalf. To see, correct or ask about your data, speak to your
					manager.
				</p>
			</li>
		</ul>
		if v.ShowConfigNotice {
			<p class="mt-4 border-t border-line pt-3 font-mono text-[11px] leading-relaxed text-ink/70">
				Non-production deployment: the retention period above is read from this
				server's configuration and is a placeholder value, not legal advice.
			</p>
		}
	</section>
	<form method="post" action="/api/activate" class="wizard-actions">
		<input type="hidden" name="csrf" value={ v.CSRFToken }/>
		if v.HeldByName != "" {
			<label class="flex items-start gap-3 border-l-4 border-tomato bg-paper px-4 py-4">
				<input
					type="checkbox"
					name="switch"
					value="yes"
					required
					checked?={ v.SwitchConfirmed }
					class="mt-0.5 h-6 w-6 shrink-0 accent-tomato"
				/>
				<span class="text-sm text-ink/85">
					I understand this signs { v.HeldByName } out of this phone.
				</span>
			</label>
			if v.SwitchMissing {
				@components.Notice(components.ToneAlert, "") {
					<span class="font-bold text-ink">
						Nothing was changed. Tick the box above if you really mean to take this
						phone over.
					</span>
				}
			}
		}
		<label class={ wizardConsent(accented) }>
			<input
				type="checkbox"
				name="consent"
				value="yes"
				required
				checked?={ v.Consented }
				if accented {
					class="mt-0.5 h-6 w-6 shrink-0 accent-ink"
				} else {
					class="mt-0.5 h-6 w-6 shrink-0 accent-tappa-green"
				}
				if v.ConsentMissing {
					aria-invalid="true"
					aria-describedby="consent-error"
				}
			/>
			<span class="text-sm text-ink/85">
				I have read what Taptime records and how long it is kept.
			</span>
		</label>
		if v.ConsentMissing {
			<p id="consent-error" class="border-l-4 border-tomato bg-paper px-4 py-3 text-sm font-bold text-ink">
				Please tick the box above so we know you have read this.
			</p>
		}
		<p class="text-center text-sm text-ink/70">
			Setting up this phone for <span class="font-bold text-ink">{ v.EmployeeName }</span> at <span class="font-bold text-ink">{ v.EmployerName }</span>
		</p>
		<button type="submit" class="tap-button">Agree and continue</button>
		<a href="/activate?step=1" class="wizard-back">Back</a>
	</form>
}

// wizardReady is the two practical things that decide whether the first tap
// works: being on the venue's network, and tapping from THIS browser — the
// session cookie lives in the browser that receives it, and an NFC tag opens the
// phone's DEFAULT browser, which is not the in-app browser of the chat or mail
// app the invitation link was probably opened from.
templ wizardReady(v ActivateView, accented bool) {
	<section class="wizard-panel">
		<p class="docket-label">Get ready</p>
		<h1 class="mt-1 font-display text-3xl font-bold leading-tight tracking-tight text-ink">
			Two quick things before you tap.
		</h1>
	</section>
	<section class="docket wizard-panel">
		<div class="flex gap-3">
			<span class={ wizardIndex(accented) }>01</span>
			<div class="font-display">
				<p class="text-base font-bold tracking-tight">Join the Wi-Fi</p>
				if v.WiFiSSID != "" {
					<p class="mt-1 text-sm text-ink/85">
						Connect to
						<span class="num font-bold">{ v.WiFiSSID }</span>
						when you are at work. Being on the venue's network is how Taptime knows
						you are really there.
					</p>
					<p class="mt-1 text-sm text-ink/70">
						You can skip this. Your taps then use your location instead, and your
						manager may need to confirm them.
					</p>
				} else {
					<p class="mt-1 text-sm text-ink/85">
						This workplace has no staff network to join, so Taptime checks your
						location at the moment you tap instead.
					</p>
				}
			</div>
		</div>
		<div class="mt-5 flex gap-3 border-t border-dashed border-line pt-5">
			<span class={ wizardIndex(accented) }>02</span>
			<div class="font-display">
				<p class="text-base font-bold tracking-tight">Stay in this browser</p>
				<p class="mt-1 text-sm text-ink/85">
					Your phone remembers you in the browser where you finish setup — and tapping
					the plaque always opens your phone's usual browser, like Safari or Chrome.
				</p>
				<p class="mt-2 text-sm text-ink/85">
					<span class="font-bold">Opened this link inside a chat or email app?</span>
					Open it in Safari or Chrome first — look for “Open in browser” in that app's
					menu — and go through these steps there.
				</p>
			</div>
		</div>
	</section>
	<div class="wizard-actions">
		<a href="/activate?step=4" class="tap-button flex items-center justify-center">I'm ready</a>
		<a href="/activate?step=2" class="wizard-back">Back</a>
	</div>
}

// wizardTap is the waiting screen. Its words are true with and without the
// script: without it, the tap opens a page that says "Activation complete" and
// this one simply stays as it is; with it (web/static/js/activate.js), this page
// notices through GET /activate/status and swaps itself to the same message.
//
// THE SUCCESS BLOCK IS IN THE HTML FROM THE START, hidden. The script only flips
// two `hidden` attributes — it writes no markup and no text, so there is nothing
// for it to inject and the CSP needs no inline anything.
templ wizardTap(v ActivateView) {
	<div data-activation-wait data-status-url={ v.StatusURL } class="flex flex-col gap-6">
		<div data-wait-pending class="flex flex-col gap-6">
			<section class="wizard-panel">
				<p class="docket-label">Last step</p>
				<h1 class="mt-1 font-display text-3xl font-bold leading-tight tracking-tight text-ink">
					Now tap the plaque.
				</h1>
				<p class="mt-3 text-base text-ink/85">
					Hold the top of your phone against any Taptime plaque at your workplace,
					<span class="font-bold">{ v.EmployerName }</span>
				</p>
				<p class="mt-2 text-base text-ink/85">
					That first tap finishes setting up this phone — it doesn't clock you in.
				</p>
			</section>
			@plaqueWait()
			<p class="wizard-waiting" role="status">
				<span class="wizard-waiting-dot" aria-hidden="true"></span>
				Waiting for your tap…
			</p>
			if v.SecondDevice || v.HeldByName != "" {
				@components.Notice(components.ToneWarn, "") {
					if v.HeldByName != "" {
						Your tap signs { v.HeldByName } out of this phone.
					} else {
						Your tap signs your other phone out.
					}
				}
			}
			<p class="text-center text-sm text-ink/70">
				When the tap goes through, your phone shows “Activation complete”.
			</p>
			<p class="border-l-4 border-saffron bg-paper px-4 py-3 text-sm text-ink/85">
				<span class="font-bold">Tapped and saw “Finish setup in this browser”?</span>
				The plaque opened a different browser from this one. Open the link your
				workplace sent you in that browser and go through the steps there.
			</p>
			<div class="wizard-actions">
				<a href="/activate?step=3" class="wizard-back">Back</a>
			</div>
		</div>
		<div data-wait-done hidden tabindex="-1" class="flex flex-col gap-6">
			@activatedBody(v.EmployeeName, v.SecondDevice)
		</div>
	</div>
	@components.DevTapStrip(true)
}

// plaqueWait is the waiting animation: a plaque, and a phone that comes down to
// meet it while two rings spread. Pure CSS (input.css, .plaque-wait); it stops
// moving under prefers-reduced-motion and says nothing to a screen reader, which
// gets the status line below it instead.
//
// IT STAYS TAPTIME'S ON A BRANDED PAGE (M10 WL-13), rings and word alike, and it takes
// no brand argument so that nothing can hand it one. The drawing is the PHYSICAL plaque
// on the wall, and that plaque is Taptime's: its print carries the Taptime mark whatever
// business mounted it (ADR 0023 §9 item 4 -- the plaque is not a tenant slot). Drawing
// the tenant's colour or logo on it would show the employee a plaque that does not exist
// at their door, on the screen whose one job is to send them to the real one.
templ plaqueWait() {
	<div class="plaque-wait" aria-hidden="true">
		<span class="plaque-wait-ring"></span>
		<span class="plaque-wait-ring plaque-wait-ring--late"></span>
		<span class="plaque-wait-plaque">
			<span class="font-display text-lg font-bold tracking-tight text-tappa-green">taptime</span>
			<span class="mt-1 font-mono text-[9px] uppercase tracking-widest text-ink/70">Hold your phone here</span>
		</span>
		<span class="plaque-wait-phone"></span>
	</div>
}

// AlreadySetUp greets a phone that is already activated and comes back to the
// activation link or the reloaded waiting tab. Neutral, no button (§9): the next
// thing to do is tap a plaque.
//
// look is the brand of the business whose session this phone holds (M10 WL-13): the
// header and the theme link, nothing else -- the stamp and the notice keep the colours
// that tell the state (ADR 0023 §6).
templ AlreadySetUp(v AlreadySetUpView, look layout.Brand) {
	@layout.ActivationPage("Already set up — Taptime", look) {
		<div class="wizard">
			<section class="docket wizard-panel">
				<div class="flex items-start justify-between gap-3">
					<p class="docket-label">Setup</p>
					<span class="stamp stamp--approved">Activated</span>
				</div>
				<h1 class="mt-3 font-display text-3xl font-bold leading-tight tracking-tight text-ink">
					This phone is already set up
				</h1>
				if v.EmployeeName != "" {
					<p class="mt-1 font-display text-base text-ink/85">Signed in as { v.EmployeeName }</p>
				}
			</section>
			@components.Notice(components.ToneOK, "") {
				Tap a plaque to check in. There is nothing else to do here.
			}
			<p class="pt-2 text-center font-display text-lg tracking-tight text-ink/70">
				You can close this page.
			</p>
		</div>
		@components.DevTapStrip(false)
	}
}

// Activated is what the ACTIVATING TAP renders (ADR 0026): this phone now has a
// session. No button (§9): the next thing that happens is another touch on a
// plaque, and that one is an ordinary check-in.
//
// look is the brand of the business the new session belongs to (M10 WL-13), as on
// AlreadySetUp.
templ Activated(v ActivatedView, look layout.Brand) {
	@layout.ActivationPage("Activation complete — Taptime", look) {
		<div class="wizard">
			@activatedBody(v.EmployeeName, v.SecondDevice)
		</div>
		@components.DevTapStrip(false)
	}
}

templ activatedBody(name string, secondDevice bool) {
	<section class="docket wizard-panel">
		<div class="flex items-start justify-between gap-3">
			<p class="docket-label">Setup</p>
			<span class="stamp stamp--approved">Activated</span>
		</div>
		<h1 class="mt-3 font-display text-3xl font-bold leading-tight tracking-tight text-ink">
			Activation complete
		</h1>
		if name != "" {
			<p class="mt-1 font-display text-base text-ink/85">This phone is set up for { name }</p>
		}
	</section>
	@components.Notice(components.ToneOK, "This phone is now your time clock.") {
		To check in, tap the plaque again — that next tap counts.
	}
	if secondDevice {
		@components.Notice(components.ToneWarn, "") {
			Your other phone has been signed out. Only this one works now.
		}
	}
	<p class="pt-2 text-center font-display text-lg tracking-tight text-ink/70">
		You can close this page.
	</p>
}

// Problem is every failure screen. The handler picks the words from a fixed set
// of constants so that an unknown, an expired and an already-used code produce
// BYTE-IDENTICAL output (§4.7: no oracle) — asserted in
// internal/handler/activate_test.go.
//
// IT TAKES NO BRAND AND RENDERS Page, WHICH HAS NO BRAND PARAMETER (M10 WL-13). A
// business's look can be known only from a USABLE invitation, so a problem screen in
// that business's colours would answer the question these screens exist not to answer:
// "was this link one of theirs, and is it still alive". Confirm below holds to the same
// rule for the same reason.
//
// ONE TEMPLATE SERVES BOTH FLOWS, so a sentence added here appears on ALL of
// them — SIXTEEN screens since ADR 0026, counted rather than guessed: ten
// activation failures (internal/handler/activate.go: problemNoLink,
// problemBadLink, problemTooMany, problemServer and the six problemActivation*
// refusals of the activating tap; problemNoSession went with /activate/done) and
// six tap failures (tap.go's tapProblem*). Earlier versions of this paragraph
// said "three" and then "five" activation failures, which was wrong in exactly
// the way a field count that stops matching its struct is wrong.
//
// THAT REACH IS WHY THE COPY IS PINNED AS WHOLE TEXT rather than by keyword: an
// audit added a plain sentence to this template and to two of the constants and
// the entire suite stayed green. TestProblemScreens_SayExactlyThisAndNothingElse
// renders the six TAP screens and compares the complete document text, so a
// sentence added HERE — the cross-flow vector, the one that reaches all eleven —
// is caught by those six.
//
// THE ACTIVATION CONSTANTS ARE NOT PINNED HERE, and that is a scope decision
// rather than an oversight. Their words are M5-02's copy, that flow took four
// audit rounds to settle, and a test written from here would quietly take
// ownership of text this task never reviewed. What is checked from here is the
// SHARED surface. The gap is real and worth naming: an edit to
// problemServer.Message ("Nothing was activated and nothing was recorded against
// you") would not be caught by anything in this package.
//
// THE "TRY AGAIN" OF THE M5-06 CARD LIVES HERE AND NOWHERE ELSE, because this is
// the only family of screens where nothing was recorded and a retry can therefore
// change the outcome. It appears only when the handler supplied a RetryURL, which
// it does for three of the five GET-path server errors — see ProblemView.RetryURL
// and internal/handler/tap.go for the measured reasons the others get an
// INSTRUCTION instead of a button that cannot work.
//
// IT IS AN ANCHOR, NOT A FORM. A link issues a GET; it cannot resubmit the body
// of a POST, so no failure screen in this package can produce a second
// attendance record. That is the same rule the confirmation screen keeps by
// having no button at all (§9).
templ Problem(v ProblemView) {
	@layout.Page("Taptime") {
		@components.Notice(components.ToneAlert, "") {
			<h1 class="font-display text-xl font-bold tracking-tight">{ v.Title }</h1>
			<p class="mt-2">{ v.Message }</p>
			if v.Hint != "" {
				<p class="mt-2 text-ink/70">{ v.Hint }</p>
			}
		}
		if v.RetryURL != "" {
			// WHAT templ.URL ACTUALLY CHECKS, read from its source (v0.3.833,
			// url.go) rather than assumed: if the string has a ':' before any '/',
			// the part in front of it must be http, https, mailto, tel, ftp or ftps,
			// otherwise the whole value becomes about:invalid. That is a NARROW
			// guarantee and the useful one here — a future caller cannot turn this
			// anchor into a javascript: or data: handler.
			//
			// IT IS NOT A GENERAL SANITISER, and an earlier version of this comment
			// said it was. Every string with NO colon before a slash passes through
			// UNTOUCHED: relative paths, and scheme-relative //host/... references
			// too. So templ.URL is not what keeps this link on our own origin — the
			// ROUTE is (only chi's /t reaches the handler that sets RetryURL, and
			// //host forms answer 404 before it; measured, see ProblemView.RetryURL).
			// Escaping of the query is templ's attribute escaping, which is a
			// different mechanism again.
			<a href={ templ.URL(v.RetryURL) } class="tap-button flex items-center justify-center">Try again</a>
		}
	}
}

// Confirm is the same-site confirmation step for a cross-site arrival that would
// collide with the session already on this phone (internal/handler: measure 3).
// It stores NOTHING — the code only reaches a cookie if the person holding the
// phone presses the button on this page.
templ Confirm(v ConfirmView) {
	@layout.Page("Continue? — Taptime") {
		@components.Notice(components.ToneAlert, "") {
			<h1 class="font-display text-xl font-bold tracking-tight">This phone is already in use</h1>
			<p class="mt-2">
				Someone is signed in on this phone. You have opened a link that would set it
				up for
				<span class="font-bold">{ v.EmployeeName }</span>
				if v.EmployerName != "" {
					at { v.EmployerName }
				}
				instead.
			</p>
			<p class="mt-2 text-ink/70">
				If you did not expect this page, close it. Nothing has changed.
			</p>
		}
		<form method="post" action="/activate" class="flex flex-col gap-4">
			<input type="hidden" name="code" value={ v.Code }/>
			<button type="submit" class="tap-button">Continue anyway</button>
		</form>
	}
}
