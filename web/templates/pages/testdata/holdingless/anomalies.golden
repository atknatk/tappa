<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"><meta name="robots" content="noindex, nofollow"><meta name="referrer" content="no-referrer"><title>Panel — Taptime</title><link rel="stylesheet" href="/static/css/app.css"></head><body class="min-h-screen bg-porcelain text-ink antialiased"><div class="panel-frame"><div class="panel-side"><header class="side-head"><div class="side-lockup"><span class="side-mark" aria-hidden="true">t.</span><div class="side-words"><span class="side-word">taptime</span> <span class="side-tag">punchless</span></div></div></header><nav class="side-nav" aria-label="Panel sections"><div class="side-group"><a href="/admin" class="tab-link"><svg class="tab-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 5h18"></path> <path d="M7.5 5v3M17.5 5v3"></path> <rect x="5" y="8" width="5" height="9" rx="1"></rect> <rect x="15" y="8" width="5" height="11" rx="1"></rect></svg><span class="tab-no" aria-hidden="true">01</span> <span class="tab-label">The Pass</span> <span class="tab-short">Pass</span></a><a href="/admin/review" class="tab-link"><svg class="tab-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 3v18"></path> <path d="M7 21h10"></path> <rect x="6" y="9" width="12" height="7" rx="1"></rect></svg><span class="tab-no" aria-hidden="true">02</span> <span class="tab-label">The Spike</span> <span class="tab-short">Spike</span><span class="tab-count" aria-label="the number waiting for review could not be read">?</span></a><a href="/admin/employees" class="tab-link"><svg class="tab-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="9" cy="8" r="3.5"></circle> <path d="M2.5 20c.8-3.6 3.4-5.5 6.5-5.5s5.7 1.9 6.5 5.5"></path> <path d="M16 4.5a3.5 3.5 0 0 1 0 7M18 14.8c1.8.7 3 2.4 3.5 5.2"></path></svg><span class="tab-no" aria-hidden="true">03</span> <span class="tab-label">People</span> <span class="tab-short">People</span></a><a href="/admin/locations" class="tab-link"><svg class="tab-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z"></path> <circle cx="12" cy="9.5" r="2.5"></circle></svg><span class="tab-no" aria-hidden="true">04</span> <span class="tab-label">Venues &amp; plaques</span> <span class="tab-short">Venues</span></a><a href="/admin/reports" class="tab-link"><svg class="tab-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 3h12v18l-2-1.5L14 21l-2-1.5L10 21l-2-1.5L6 21z"></path> <path d="M9 8h6M9 12h6"></path></svg><span class="tab-no" aria-hidden="true">05</span> <span class="tab-label">The Roll</span> <span class="tab-short">Roll</span></a><a href="/admin/anomalies" class="tab-link"><svg class="tab-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="6" cy="17" r="2"></circle> <circle cx="12" cy="10" r="2"></circle> <circle cx="18" cy="15" r="2"></circle> <path d="M15 3.5l5 5M20 3.5l-5 5"></path></svg><span class="tab-no" aria-hidden="true">06</span> <span class="tab-label">Odd shapes</span> <span class="tab-short">Odd</span></a><a href="/admin/policies" class="tab-link"><svg class="tab-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 7h10M18 7h2M4 17h4M12 17h8"></path> <circle cx="16" cy="7" r="2"></circle> <circle cx="10" cy="17" r="2"></circle></svg><span class="tab-no" aria-hidden="true">07</span> <span class="tab-label">Rules</span> <span class="tab-short">Rules</span></a></div><div class="side-group side-group--foot"><a href="/admin/account" class="tab-link"><svg class="tab-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 21V8l8-5 8 5v13"></path> <path d="M9 21v-6h6v6"></path></svg><span class="tab-no" aria-hidden="true">··</span> <span class="tab-label">Account</span> <span class="tab-short">Account</span></a></div></nav><div class="side-foot"><p class="side-who"><span class="side-who-label">Signed in as</span> <span class="side-who-name"></span> <span class="side-who-role"></span></p><form method="post" action="/admin/logout"><button type="submit" class="btn btn--quiet side-signout">Sign out</button></form></div></div><main class="panel-main"><div class="panel-well"><form class="filter-bar" method="get" action="" aria-label="Choose a week"><div class="filter-field"><label class="docket-label" for="anomaly-week">Week containing</label> <input class="filter-input" id="anomaly-week" type="date" name="week" value=""></div><div class="filter-actions"><button class="btn btn--primary" type="submit">Show</button> <a class="btn btn--quiet" href="">Previous week</a> <a class="btn btn--quiet" href="">Next week</a> <a class="btn btn--quiet" href="">This week</a></div></form> <p class="font-mono text-sm text-ink/85">Mon 7 – Sun 13 September 2026 <span class="text-ink/70">· Europe/Malta</span></p><section class="docket"><p class="docket-label">Records examined this week</p><p class="font-mono text-3xl font-bold tracking-tight text-ink">12 records</p><p class="mt-1 text-xs text-ink/85">10 of these were judged Training taps and manager-typed rows are counted here — a training tap is a real touch of a plaque, and a typed row carries no touch at all. Both are named below.</p><p class="mt-1 text-xs text-ink/70">Two bases</p><div class="mt-3 flex flex-wrap gap-2"><span class="tally tally--queued">1 of 10 verified by GPS alone</span> <span class="tally tally--queued">1 of 11 read outside the venue</span> </div><p class="mt-3 text-xs text-ink/85">none on the network</p>    <p class="mt-2 text-xs text-ink/70">1 record carries no policy snapshot</p></section> <section class="border-l-4 border-saffron bg-saffron-lite px-4 py-4"><p class="font-display font-bold tracking-tight">What this page does not see</p><div class="mt-1 text-sm text-ink/85"><p>A plaque page that was opened and never used is not recorded anywhere, so the number of opened-but-unused pages is not on this screen. What IS on it is the counter gap above: the plaque's own chip counts every read, so collected pages leave a jump behind whether or not they are ever used.</p><p class="mt-2">Which device a person signed in from is not recorded either — only a coarse browser family, which every phone of the same make shares. So "several people activated from one device" cannot be told from "several people use the same model of phone", and this page does not guess at it.</p><p class="mt-2">The list of people who tap together compares each tap with the ONE before it at that venue. Where three people arrive in a burst, the first and the third are not paired with each other — the two neighbouring pairs are listed instead, so the group is visible but that one combination is not.</p></div></section> <h2 class="font-display text-lg font-bold tracking-tight text-ink">Per person</h2><p class="text-xs text-ink/70">Only people with at least one of these counts above zero appear here. The totals above cover everybody who tapped.</p> <div class="flex flex-col gap-4"><section class="docket"><div class="report-head"><p class="report-who">Maria Borg</p><p class="report-total">4 records</p></div><div class="mt-2 flex flex-wrap gap-2"><span class="tally tally--queued">1 verified by GPS alone</span> </div></section></div> <h2 class="font-display text-lg font-bold tracking-tight text-ink">Per venue</h2><p class="text-xs text-ink/70">Every venue with taps this week, clean ones included. A high rate at one venue beside a low one at another is as likely to be a Wi-Fi problem as anything else — both are worth knowing.</p> <div class="flex flex-col gap-4"><section class="docket"><div class="report-head"><p class="report-who">KF St Julians</p><p class="report-total">12 records</p></div><div class="mt-2 flex flex-wrap gap-2"><span class="tally tally--queued">1 of 10</span> <span class="tally tally--queued">1 of 11</span></div></section></div>   <h2 class="font-display text-lg font-bold tracking-tight text-ink">Check-ins with no checkout</h2><p class="text-sm text-ink/85">A check-in with no later checkout, anywhere in the record. The Roll counts a slightly different thing — it pairs a week's records into shifts — so the two figures can differ without either being wrong.</p><p class="text-xs text-ink/70">Training taps are not in this list. A training tap is a check-in nothing ever closes, so counting it would add one false entry for every new starter.</p><section class="flex flex-col gap-2 rounded-[18px] border border-dashed border-ink/50 p-6"><p class="lbl">Odd shapes · check-ins with no checkout</p><h2 class="font-display text-[19px] font-bold leading-tight tracking-tight text-ink">Every check-in this week has a checkout after it</h2><div class="text-sm leading-normal text-ink/70"><p>Nothing in this week is waiting for a missing record.</p></div></section> <h2 class="font-display text-lg font-bold tracking-tight text-ink">Which rule decided</h2><p class="text-sm text-ink/85">Every record names the rule that judged it. A rule firing is not a problem in itself; a rule firing far more than last week is worth a look.</p> <div class="flex flex-col gap-4"><section class="docket"><div class="report-head"><p class="report-who">base:ip-or-gps-ok</p><p class="report-total">10 records</p></div><p class="docket-label mt-1">baseline</p></section></div></div></main><nav class="bar" aria-label="Panel sections, phone"><a href="/admin" class="bar-link"><span class="bar-pill"><svg class="nav-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 5h18"></path> <path d="M7.5 5v3M17.5 5v3"></path> <rect x="5" y="8" width="5" height="9" rx="1"></rect> <rect x="15" y="8" width="5" height="11" rx="1"></rect></svg></span> <span>Pass</span></a> <a href="/admin/review" class="bar-link"><span class="bar-pill"><svg class="nav-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 3v18"></path> <path d="M7 21h10"></path> <rect x="6" y="9" width="12" height="7" rx="1"></rect></svg></span> <span>Spike</span><span class="tab-count" aria-label="the number waiting for review could not be read">?</span></a> <a href="/admin/reports" class="bar-link"><span class="bar-pill"><svg class="nav-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 3h12v18l-2-1.5L14 21l-2-1.5L10 21l-2-1.5L6 21z"></path> <path d="M9 8h6M9 12h6"></path></svg></span> <span>Roll</span></a> <a href="/admin/employees" class="bar-link"><span class="bar-pill"><svg class="nav-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="9" cy="8" r="3.5"></circle> <path d="M2.5 20c.8-3.6 3.4-5.5 6.5-5.5s5.7 1.9 6.5 5.5"></path> <path d="M16 4.5a3.5 3.5 0 0 1 0 7M18 14.8c1.8.7 3 2.4 3.5 5.2"></path></svg></span> <span>People</span></a> <details class="bar-more"><summary class="bar-link"><span class="bar-pill"><svg class="nav-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="5" cy="12" r="1.6"></circle> <circle cx="12" cy="12" r="1.6"></circle> <circle cx="19" cy="12" r="1.6"></circle></svg></span> <span>More</span></summary><div class="bar-sheet"><ul class="sheet-list"><li><a href="/admin/locations" class="sheet-link"><svg class="nav-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z"></path> <circle cx="12" cy="9.5" r="2.5"></circle></svg><span>Venues &amp; plaques</span></a></li><li><a href="/admin/anomalies" class="sheet-link"><svg class="nav-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="6" cy="17" r="2"></circle> <circle cx="12" cy="10" r="2"></circle> <circle cx="18" cy="15" r="2"></circle> <path d="M15 3.5l5 5M20 3.5l-5 5"></path></svg><span>Odd shapes</span></a></li><li><a href="/admin/policies" class="sheet-link"><svg class="nav-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 7h10M18 7h2M4 17h4M12 17h8"></path> <circle cx="16" cy="7" r="2"></circle> <circle cx="10" cy="17" r="2"></circle></svg><span>Rules</span></a></li><li><a href="/admin/account" class="sheet-link"><svg class="nav-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 21V8l8-5 8 5v13"></path> <path d="M9 21v-6h6v6"></path></svg><span>Account</span></a></li></ul><div class="sheet-foot"><p class="text-sm text-ink/70">Signed in as <strong class="font-bold text-ink"></strong> · <span class="font-mono uppercase tracking-widest"></span></p><form method="post" action="/admin/logout"><button type="submit" class="btn btn--quiet w-full">Sign out</button></form></div></div></details></nav></div></body></html>