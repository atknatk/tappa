package pages

import "github.com/atknatk/tappa/web/templates/layout"

// The PUBLIC landing page (M7-01) — handoff §9, rewritten in templ per ADR 0001.
//
// 🔴 READ landingview.go BEFORE EDITING THE COPY HERE. Every claim on this page is
// answerable with "which code, schema or test provides this?", and that file
// records the answers. A landing page is made entirely of claims; this repository's
// recurring defect is the sentence that promises what the product does not do.
//
// THE MOTIF IS CARRIED, THE COMPONENT IS NOT — and that was a decision with a
// measurement behind it. components.TransactionDocket renders eleven fields out of
// a components.DocketView that internal/domain/ledger fills from a real row. A
// marketing page needs four of them, and supplying the other seven means printing
// an invented plaque uid and counter on a public page in the exact shape a genuine
// record takes. What is shared instead is the STYLESHEET — the docket frame, its
// perforation, the small-caps label and the rubber stamp are the same rules the
// panel renders, so the motif cannot drift — and this page adds no colour, no
// token and (bar one animation) no rule of its own.

// Landing is the page at /.
templ Landing(v LandingView) {
	@layout.Marketing("Tappa — punchless time and attendance", layout.RobotsPublic) {
		@marketingChrome(v.SignInHref) {
			@landingHero(v)
			@landingSteps()
			@landingEvidence()
			@landingComparison()
			@landingAudiences()
			@landingPricing(v)
			@landingFAQ()
			@landingCTA(v)
		}
	}
}

// landingHero is the slogan, the plaque and one printed record.
//
// THE SLOGAN IS FIXED (skill tappa-brand): "No app. No device. No fingerprints.
// Just tap." It is split across four lines so the four denials read as four
// denials, and TestLanding_CarriesTheSlogan asserts the sentence survives as text.
templ landingHero(v LandingView) {
	<section class="border-b border-line px-4 py-10 sm:py-16">
		<div class="mx-auto w-full max-w-3xl">
			<p class="docket-label">Time and attendance, Malta</p>
			<h1 class="mt-3 font-display text-3xl font-bold leading-tight tracking-tight sm:text-4xl">
				No app.
				<br/>
				No device.
				<br/>
				No fingerprints.
				<br/>
				<span class="text-tappa-green">Just tap.</span>
			</h1>
			<p class="mt-5 max-w-xl text-base text-ink/85">
				A printed plaque goes up by the door. Your team holds their own phone to it, the
				browser opens, one button — in or out. Nothing to install, nothing to carry and
				no reader on the wall to power.
			</p>
			<div class="mt-8 grid gap-6 sm:grid-cols-2">
				@landingPlaque()
				<div>
					<p class="docket-label">Example — what a manager sees</p>
					<div class="mt-2 docket-print">
						@landingSampleDocket()
					</div>
					<p class="mt-2 text-xs text-ink/70">
						One card per tap: where, who, which way, and what the decision was based on.
						This one is made up — it is here to show the shape of a record, not a real shift.
					</p>
				</div>
			</div>
		</div>
	</section>
}

// landingPlaque is the wall plaque, drawn rather than photographed.
//
// The wording on it is skill tappa-brand's plaque copy. The touch target is drawn
// with a dashed ring because it is where an antenna is, not a button — a solid ring
// would read as something to press.
templ landingPlaque() {
	<div>
		<p class="docket-label">On the wall</p>
		<div class="mt-2 border border-line bg-paper px-4 py-8 text-center">
			<p class="font-display text-lg font-bold tracking-tight text-tappa-green">tappa</p>
			<p class="docket-label mt-1">punchless</p>
			<div class="mx-auto mt-6 flex h-24 w-24 items-center justify-center rounded-full border-2 border-dashed border-line">
				<span class="docket-label">tap here</span>
			</div>
			<p class="mt-6 font-display text-base font-bold tracking-tight">Hold your phone here</p>
			<p class="mt-1 text-xs text-ink/70">Passive chip. No power, no battery, no network.</p>
		</div>
	</div>
}

// landingSampleDocket is an ILLUSTRATION built from the shared stylesheet.
//
// It deliberately renders fewer fields than the real card and names no plaque uid
// and no counter: an invented identifier printed in the shape of a real one is the
// one thing a public page must not do. The stamp keeps its settled anatomy — the
// word is ink, the status colour is the frame and the tenth-strength ground.
templ landingSampleDocket() {
	<article class="docket">
		<div class="flex items-start justify-between gap-3">
			<div class="min-w-0">
				<p class="docket-label">Where</p>
				<p class="truncate font-display text-sm font-bold tracking-tight text-ink">Front door</p>
				<p class="mt-2 docket-label">Who</p>
				<p class="truncate font-display text-sm font-bold tracking-tight text-ink">A. Sample</p>
			</div>
			<div class="shrink-0 text-right">
				<span class="stamp stamp--approved">APPROVED</span>
			</div>
		</div>
		<dl class="mt-3 grid grid-cols-2 gap-x-4 gap-y-1">
			<div>
				<dt class="docket-label">Direction</dt>
				<dd class="uppercase tracking-widest text-ink">in</dd>
			</div>
			<div>
				<dt class="docket-label">Time</dt>
				<dd class="text-ink">14:03:22</dd>
			</div>
			<div>
				<dt class="docket-label">Network</dt>
				<dd class="text-ink">matched</dd>
			</div>
			<div>
				<dt class="docket-label">Position</dt>
				<dd class="text-ink">matched</dd>
			</div>
		</dl>
	</article>
}

// landingSteps is handoff §9's three steps.
templ landingSteps() {
	@marketingSection("how", "How it works", "Three things happen, and only one of them repeats") {
		<ol class="mt-6 grid gap-4 sm:grid-cols-3">
			for _, s := range LandingSteps {
				<li class="border border-line bg-paper px-4 py-4">
					<p class="font-mono text-sm font-bold text-tappa-green">{ s.Ordinal }</p>
					<h3 class="mt-1 font-display text-base font-bold tracking-tight">{ s.Title }</h3>
					<p class="mt-2 text-sm text-ink/85">{ s.Body }</p>
				</li>
			}
		</ol>
	}
}

// landingEvidence is CLAUDE.md §5's four proofs, plus the two limits that come with
// them. THE LIMITS ARE PART OF THE SECTION, not a footnote somewhere else: a page
// that lists four proofs and stops has described a system that always knows, and
// this one does not always know.
templ landingEvidence() {
	@marketingSection("evidence", "What a record is made of", "Four pieces of evidence, weighed every time") {
		<dl class="mt-6 grid gap-4 sm:grid-cols-2">
			for _, e := range LandingEvidence {
				<div class="border border-line bg-paper px-4 py-4">
					<dt>
						<span class="font-display text-base font-bold tracking-tight">{ e.Label }</span>
						<span class="mt-1 block docket-label">{ e.Answers }</span>
					</dt>
					<dd class="mt-2 text-sm text-ink/85">{ e.Body }</dd>
				</div>
			}
		</dl>
		<div class="mt-6 grid gap-4 sm:grid-cols-2">
			<div class="border border-dashed border-line bg-paper px-4 py-4">
				<h3 class="font-display text-base font-bold tracking-tight">When the evidence is thin</h3>
				<p class="mt-2 text-sm text-ink/85">
					No network match and no position means Tappa cannot say where the tap happened.
					It does not guess and it does not throw the tap away: it writes the record, marks
					it FLAGGED and puts it in a manager's queue. Nothing is ever approved silently,
					and no tap is ever lost for want of proof.
				</p>
			</div>
			<div class="border border-dashed border-line bg-paper px-4 py-4">
				<h3 class="font-display text-base font-bold tracking-tight">When there is no one-time code</h3>
				<p class="mt-2 text-sm text-ink/85">
					A check-in can reach Tappa without the plaque's one-time code — an older phone
					cannot read a chip in the background. That check-in is no proof of a physical
					touch, so it needs your venue's network address; a position on its own is not
					enough for it. That rule is yours to change.
				</p>
			</div>
		</div>
	}
}

// landingComparison is the comparison table.
//
// 🔴 THE FOOTNOTE IS NOT OPTIONAL AND IS ASSERTED BY A TEST. The table compares how
// two approaches work; it makes no claim about accuracy, reliability or safety,
// because nobody here has measured one. See LandingComparison for the rule every
// cell in the middle column was written under.
templ landingComparison() {
	@marketingSection("compare", "Against a fingerprint terminal", "The same job, done with different evidence") {
		<div class="mt-6 overflow-x-auto border border-line bg-paper">
			<table class="w-full min-w-[36rem] text-left text-sm">
				<caption class="sr-only">How a fingerprint terminal and Tappa each work</caption>
				<thead>
					<tr class="border-b border-line">
						<th scope="col" class="px-4 py-3 docket-label">&nbsp;</th>
						<th scope="col" class="px-4 py-3 docket-label">Fingerprint terminal</th>
						<th scope="col" class="px-4 py-3 docket-label">Tappa</th>
					</tr>
				</thead>
				<tbody>
					for _, row := range LandingComparison {
						<tr class="border-b border-line last:border-b-0">
							<th scope="row" class="px-4 py-3 align-top font-display font-bold tracking-tight">{ row.Aspect }</th>
							<td class="px-4 py-3 align-top text-ink/85">{ row.Terminal }</td>
							<td class="px-4 py-3 align-top text-ink">{ row.Tappa }</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		<p class="mt-3 text-xs text-ink/70">
			This table compares how the two approaches work. It is not a benchmark: we have
			measured no device against Tappa and make no claim about accuracy or reliability.
		</p>
	}
}

// landingAudiences is handoff §9's chain-versus-facility split.
templ landingAudiences() {
	@marketingSection("shapes", "Two shapes", "A chain and a single site are not the same problem") {
		<div class="mt-6 grid gap-4 sm:grid-cols-2">
			for _, a := range LandingAudiences {
				<div class="border border-line bg-paper px-4 py-4">
					<h3 class="font-display text-lg font-bold tracking-tight">{ a.Title }</h3>
					<p class="mt-1 text-sm text-ink/70">{ a.Lede }</p>
					<ul class="mt-3 flex flex-col gap-2 text-sm text-ink/85">
						for _, p := range a.Points {
							<li class="border-l-2 border-line pl-3">{ p.Text }</li>
						}
					</ul>
				</div>
			}
		</div>
	}
}

// landingPricing is handoff §11's offer.
//
// 🔴 THE PRICE IS NOT WRITTEN HERE. It arrives on the view because the same number
// is a column default in migration 00016 (tenants.price_per_employee_month) and the
// two must not drift; TestLanding_PriceMatchesTheSchemaItIsCharged re-reads the
// migration. The free period is the same story: plan='founding' adds three months
// in tappa_first_chargeable_month, and the panel's billing screen reads that
// function rather than a constant.
templ landingPricing(v LandingView) {
	@marketingSection("pricing", "What it costs", "One price, and the first months are free") {
		<div class="mt-6 grid gap-4 sm:grid-cols-2">
			<div class="docket">
				<p class="docket-label">Per employee, per month</p>
				<p class="mt-1 font-mono text-4xl font-bold text-ink">&#8364;{ v.PricePerEmployeeMonth }</p>
				<p class="mt-3 text-sm text-ink/85">
					Plaques are included, and so are replacements. You are billed for the people who
					could actually clock in that month: somebody you invited who never opened their
					link is not billed, and somebody who leaves is billed only for the months they
					were still working.
				</p>
			</div>
			<div class="border border-saffron bg-saffron-lite px-4 py-4">
				<p class="docket-label">Founding offer</p>
				<h3 class="mt-1 font-display text-lg font-bold tracking-tight">
					{ itoa(v.FreeMonths) } months free, then the price is locked
				</h3>
				<p class="mt-2 text-sm text-ink/85">
					The first { itoa(v.FreeMonths) } months cost nothing, and the price you start on
					is the price you keep for as long as you stay. In exchange we ask for a reference
					and permission to write up how it went.
				</p>
				<p class="mt-2 text-sm text-ink/85">
					Tappa counts those free months itself and the dashboard shows you which month is
					the first chargeable one, so the offer is not something you have to remember.
				</p>
			</div>
		</div>
	}
}

// landingFAQ is handoff §9's FAQ. Plain markup rather than a disclosure widget:
// there is no script on this page, and an answer nobody can find is not an answer.
templ landingFAQ() {
	@marketingSection("faq", "Questions", "The ones we are actually asked") {
		<dl class="mt-6 flex flex-col gap-4">
			for _, q := range LandingFAQ {
				<div class="border-l-4 border-line bg-paper px-4 py-4">
					<dt class="font-display text-base font-bold tracking-tight">{ q.Q }</dt>
					<dd class="mt-2 text-sm text-ink/85">{ q.A }</dd>
				</div>
			}
		</dl>
	}
}

// landingCTA is the last block.
//
// 🔴 IT RENDERS A BUTTON ONLY WHEN THERE IS SOMEWHERE FOR IT TO GO. The sign-up
// wizard is M7-02 and is not mounted, so today the second branch runs and the page
// says so in words. Shipping a "Start free" button that answers 404 would be
// exactly the class of defect this page was written to avoid, and
// TestMarketing_EveryInternalLinkResolves follows every link here against the real
// router rather than trusting this comment.
templ landingCTA(v LandingView) {
	<section id="start" class="border-t border-line px-4 py-10 sm:py-14">
		<div class="mx-auto w-full max-w-3xl">
			<h2 class="font-display text-2xl font-bold tracking-tight">Go punchless</h2>
			if v.SignupHref != "" {
				<p class="mt-2 max-w-xl text-base text-ink/85">
					Set your organisation up in three steps. You will need your VAT number and the
					addresses of the places you want to record.
				</p>
				<p class="mt-6">
					<a href={ templ.URL(v.SignupHref) } class="btn btn--primary">Start free</a>
				</p>
			} else {
				<p class="mt-2 max-w-xl text-base text-ink/85">
					Self-service sign-up is not open yet, so there is no form to fill in on this page.
					Until it is, accounts are set up by hand — plaques, venues and the first manager
					account together.
				</p>
				<p class="mt-2 max-w-xl text-sm text-ink/70">
					We are not publishing a contact address here until the company details below are
					published with it.
				</p>
			}
			<p class="mt-6">
				<a href={ templ.URL(v.SignInHref) } class="btn btn--quiet">Sign in to your dashboard</a>
			</p>
		</div>
	</section>
}

// marketingSection is the frame every landing block shares: an anchor, a small-caps
// eyebrow and a heading. Written as a component rather than pasted eight times —
// skill tappa-brand's rule that a repeated chain is a component that has not been
// written yet, and eight is well past the point.
templ marketingSection(id, eyebrow, heading string) {
	<section id={ id } class="border-b border-line px-4 py-10 sm:py-14">
		<div class="mx-auto w-full max-w-3xl">
			<p class="docket-label">{ eyebrow }</p>
			<h2 class="mt-2 font-display text-2xl font-bold tracking-tight">{ heading }</h2>
			{ children... }
		</div>
	</section>
}

// marketingChrome is the navigation and the footer that both the landing page and
// the four legal pages carry.
//
// IT LIVES IN pages RATHER THAN IN layout because the footer's links come from
// LegalPages, which is the same table internal/handler mounts the routes from. One
// list: adding a legal document adds its route and its footer link together, and
// removing one cannot leave a link behind.
//
// 🔴 THE FOOTER'S §4.1 SENTENCE IS WORDED THE WAY pages.Activate WORDS IT, and that
// is not house style — it removed the need to widen a red-line scanner. The first
// draft phrased the denial without naming the three things, which trips
// redline-check.sh's R1 and forced a new allowlist entry; the employee-facing screen
// has used the fuller phrasing since M5-02, and that clears the scanner's ORIGINAL
// exemption because the denial it already recognises appears ON THE SAME LINE.
// Matching it therefore does two things at once: the public page and the screen a
// worker actually reads now make the §4.1 promise in the same words, and half of
// this task's widening was given back. ADR 0012 records what remains and why.
// KEEP THE DENIAL ON ONE LINE — the scanner is line-local.
templ marketingChrome(signInHref string) {
	<a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-10 focus:border focus:border-ink focus:bg-paper focus:px-3 focus:py-2">
		Skip to content
	</a>
	<header class="border-b border-line px-4 py-4">
		<div class="mx-auto flex w-full max-w-3xl items-center justify-between gap-4">
			<a href="/" class="flex items-baseline gap-2">
				<span class="font-display text-lg font-bold tracking-tight text-tappa-green">tappa</span>
				<span class="font-mono text-[10px] uppercase tracking-widest text-ink/70">punchless</span>
			</a>
			<a href={ templ.URL(signInHref) } class="font-display text-sm font-bold tracking-tight text-ink underline underline-offset-4 hover:text-tappa-green">
				Sign in
			</a>
		</div>
	</header>
	<main id="main">
		{ children... }
	</main>
	<footer class="px-4 py-10">
		<div class="mx-auto w-full max-w-3xl">
			<p class="docket-label">Tappa</p>
			<p class="mt-2 max-w-xl text-sm text-ink/85">
				Punchless time and attendance.
				Tappa collects no biometric data of any kind: no fingerprints, no face, no voice.
				A phone's position is read only at the moment somebody presses the button.
			</p>
			<nav class="mt-6 flex flex-wrap gap-x-6 gap-y-2" aria-label="Legal">
				for _, p := range LegalPages {
					<a href={ templ.URL(p.Path) } class="font-mono text-xs uppercase tracking-widest text-ink/70 underline underline-offset-4 hover:text-ink">
						{ p.NavLabel }
					</a>
				}
			</nav>
		</div>
	</footer>
}
