package pages

import (
	"github.com/atknatk/tappa/web/templates/components"
	"github.com/atknatk/tappa/web/templates/layout"
)

// The PANEL screens. skill tappa-brand governs every class below: palette tokens
// only, Space Grotesk for display, IBM Plex Mono for anything that is data, the
// kitchen-docket motif for a record-shaped row, touch targets at least 44px, and
// no dark theme.
//
// THE SIGN-IN FAMILY — sign-in, "which business?" and the recovery screens in
// adminreset.templ — RENDERS layout.Auth (design "The Pass", M12-43/M12-44): a
// full-bleed document each page lays out itself. Only the sign-in page passes a
// script (the password reveal); the others pass "" and their policy, adminCSP,
// names no script-src at all, so a path written there would load nothing
// (TestAdminLoginPassword_OnlyTheSignInPageWidensIt). A sign-in that works with
// JavaScript disabled works on a locked-down work laptop too. The family is
// Taptime's own: no tenant logo, accent or stripe on any of it
// (TestPanelBrand_TheSignInFamilyStaysTaptime).

// AdminLogin is the panel sign-in form: one email, one password, one button.
//
// 🔴 THE FAILURE SENTENCE IS FIXED AND NAMES NO CAUSE — migration 00011's PHASE B
// OBLIGATION 1. "That email is not registered", "wrong password" and "your account
// is disabled" are three different sentences and all three are forbidden here: the
// first two are an enumeration oracle and the third tells an attacker they have
// found a real account AND its password. The view model has no field to carry a
// reason, so this template could not write one even if it tried.
//
// The wording still follows the brand's rule that an error says what to do next —
// it just cannot say what went wrong.
//
// 🔴 IT IS A SPLIT SCREEN AS OF 2026-09-14 (the user's drawing), AND THE SIGN-IN
// MECHANICS ARE UNTOUCHED BY THAT. The form still posts email, password and csrf to
// /admin/login; the failure notice still renders inside the same template the
// handler re-renders with 401; the recovery link is still the third state
// AdminLoginView.ResetHref describes. What changed is the frame around them: a dark
// brand half (adminLoginBrandPanel) and a light form half, which is why this is the
// one panel screen that renders layout.Auth rather than layout.Page — see that
// shell's comment for why a fifth one exists.
//
// 🔴 WHAT THE DRAWING ASKED FOR AND THIS PAGE DOES NOT RENDER: an "Email me a
// sign-in link" button and the OR rule above it. THERE IS NO PASSWORDLESS SIGN-IN
// IN THIS PRODUCT — adminlogin.go mounts one password flow and the "which business?"
// picker beside it, internal/adminauth compares a stored digest, and nothing
// anywhere mints a link that authenticates. A button that does nothing is the
// defect this repository catches most often, so the button is absent and
// TestAdminLogin_OffersNoSignInLinkItCannotSend keeps it absent.
templ AdminLogin(v AdminLoginView) {
	@layout.Auth("Sign in — Taptime", adminPasswordScript) {
		<div class="flex min-h-screen flex-col desk:flex-row">
			@adminLoginBrandPanel()
			<main class="flex min-w-0 flex-1 flex-col gap-6 px-4 py-6 md:gap-8 md:px-10 md:py-14 desk:flex-[1_1_560px] desk:px-16 desk:pb-12 desk:pt-8">
				if v.SignupHref != "" {
					// Below the form on a phone (after a dashed rule), above it from the
					// tablet up — one block moved by its order, not a second copy.
					<div class="order-last flex flex-col items-center gap-0.5 border-t border-dashed border-line pt-3.5 md:order-first md:flex-row md:flex-wrap md:justify-end md:gap-x-3.5 md:border-t-0 md:pt-0">
						<p class="text-[13px] text-ink/70 md:text-sm">Not using Taptime yet?</p>
						<a
							href={ templ.SafeURL(v.SignupHref) }
							class="inline-flex min-h-11 items-center font-display text-sm font-bold tracking-tight text-tappa-green underline underline-offset-4 hover:text-ink"
						>
							Start now — first { itoa(v.FreeMonths) } months free →
						</a>
					</div>
				}
				<div class="flex flex-1 flex-col items-center justify-center gap-5">
					<section class="flex w-full max-w-[440px] flex-col gap-[22px] md:max-w-[480px] md:rounded-[18px] md:border md:border-line md:bg-paper md:px-9 md:pb-8 md:pt-9 desk:max-w-[440px]">
						<div class="flex flex-col gap-1.5 md:gap-2">
							<h1 class="font-display text-3xl font-bold leading-none tracking-tight md:text-[32px] desk:text-[34px]">Welcome back</h1>
							<p class="text-[15px] text-ink/70">Sign in to your business panel.</p>
						</div>
						if v.Recovered {
							@components.Notice(components.ToneOK, "Your new password is set") {
								<p>
									Every Taptime session was signed out, on every device. Sign in with the new password.
								</p>
							}
						}
						if v.Failed {
							@components.Notice(components.ToneAlert, "We could not sign you in") {
								<p>Check the email address and the password, then try again.</p>
							}
						}
						<form method="post" action="/admin/login" class="flex flex-col gap-4 md:gap-[18px]">
							<input type="hidden" name="csrf" value={ v.CSRFToken }/>
							<div class="field-stack">
								<label for="admin-email" class="lbl">Work email</label>
								<input
									id="admin-email"
									name="email"
									type="email"
									autocomplete="username"
									required
									autofocus
									placeholder="you@yourcompany.com"
									class="field-input field-input--mono min-h-12 placeholder:text-ink/70"
								/>
							</div>
							<div class="field-stack">
								<label for="admin-password" class="lbl">Password</label>
								<div class="relative">
									// 🔴 EVERY ATTRIBUTE ON THIS INPUT IS ONE A PASSWORD MANAGER READS:
									// name, id, autocomplete="current-password" and required are what it
									// uses to decide this is the field it stored a secret for. The
									// right padding reserves the 44px the reveal button occupies so a
									// long value does not run underneath it — a manager reads
									// attributes, not padding.
									//
									// THERE IS NO PLACEHOLDER (M12-43). The row of bullets the field
									// used to show looked like a value already typed; an empty box with
									// its label above says the same thing without pretending.
									//
									// type="password" is the SERVED value and stays that way. The script
									// swaps it to "text" and back; a browser that runs no script never
									// sees anything but this.
									<input
										id="admin-password"
										name="password"
										type="password"
										autocomplete="current-password"
										required
										class="field-input field-input--mono min-h-12 pr-12"
									/>
									@adminPasswordToggle()
								</div>
							</div>
							<button type="submit" class="btn btn--primary min-h-[54px] w-full rounded-xl md:min-h-[52px]">Sign in</button>
						</form>
						if v.ResetHref != "" {
							<p class="-mt-2 text-center text-sm">
								// The touch-target class is not decoration here: this is the link somebody
								// reaches for after a failed sign-in, often on a phone, and
								// TestPanelScreens_EveryPressTargetCarriesATouchTargetClass measures every
								// anchor on a panel screen against the brand's 44px floor.
								<a href={ templ.SafeURL(v.ResetHref) } class="inline-flex min-h-11 items-center text-ink/70 underline underline-offset-4 hover:text-ink">Forgot password?</a>
							</p>
						}
					</section>
					<p class="max-w-[440px] text-center text-[13px] text-ink/70">
						This is the manager panel. Employees do not sign in — they tap the plaque.
					</p>
				</div>
			</main>
		</div>
	}
}

// adminPasswordScript is the ONE script this product's panel surface loads outside
// the transactions section, named here so the path is written once and read by the
// shell, by internal/handler/adminlogin.go's policy comment and by the test that
// fetches it.
const adminPasswordScript = "/static/js/adminpassword.js"

// adminPasswordToggle is the reveal button that sits inside the password field.
//
// 🔴 IT SHIPS [hidden] AND THE SCRIPT REVEALS IT, WHICH IS THE WHOLE DESIGN. The
// requirement was "it appears once the person starts typing", and the cheap reading
// of that is a button in the markup that a script later wires up. That reading has a
// failure mode this product cannot accept: a browser that blocks the script — or a
// policy that refuses it, which is exactly what every OTHER panel screen's
// Content-Security-Policy does — would paint a control that does nothing when
// pressed, on the one screen where a person is already unsure whether they typed
// their password correctly. Hidden-by-default inverts that: no script means no
// button, and the form behaves exactly as it did before this task.
//
// 🔴 type="button" IS LOAD-BEARING. A <button> inside a <form> with no type is a
// SUBMIT button, so pressing "show password" would post the form. That is one
// attribute between "reveal the secret" and "attempt a sign-in with a half-typed
// one", and TestAdminLoginPassword_ToggleIsARealButtonThatDoesNotSubmit holds it.
//
// IT IS A REAL <button> RATHER THAN A <div> OR AN <a> for the accessibility that
// comes free with it: it is in the tab order without tabindex, Enter and Space press
// it without a key handler, and a screen reader announces it as a button. The state
// it carries is announced two ways — aria-pressed for the toggle semantics and an
// aria-label that says what the next press will DO — because a pressed state alone
// leaves "Show password, pressed" ambiguous about which way it now is.
//
// BOTH ICONS ARE IN THE MARKUP and the script swaps which one is [hidden], so there
// is no icon geometry in JavaScript and nothing to draw at runtime. They are inline
// SVG in currentColor at stroke-width 1.6 — the same hand as the rest of the product's
// line work — and aria-hidden, because the button's own name already says everything.
templ adminPasswordToggle() {
	<button
		type="button"
		class="pw-toggle"
		hidden
		data-pw-toggle
		aria-controls="admin-password"
		aria-pressed="false"
		aria-label="Show password"
	>
		<svg class="pw-toggle-icon" data-pw-icon="show" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
			<path d="M2 12s3.6-6.5 10-6.5S22 12 22 12s-3.6 6.5-10 6.5S2 12 2 12Z"></path>
			<circle cx="12" cy="12" r="3"></circle>
		</svg>
		<svg class="pw-toggle-icon" data-pw-icon="hide" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" hidden>
			<path d="M2 12s3.6-6.5 10-6.5c1.6 0 3 .4 4.2 1"></path>
			<path d="M20.4 9.2c1 1.4 1.6 2.8 1.6 2.8s-3.6 6.5-10 6.5c-1.9 0-3.5-.6-4.8-1.3"></path>
			<path d="M9.9 9.9a3 3 0 0 0 4.2 4.2"></path>
			<path d="m3.5 3.5 17 17"></path>
		</svg>
	</button>
}

// adminLoginBrandPanel is the dark half of the sign-in screen (design "The Pass",
// M12-43): the lockup, a rail of dockets, the heading and its claims.
//
// ⚠️ EVERY COLOUR HERE IS A PALETTE TOKEN, MEASURED ON ink (WCAG 2.1, sRGB
// composite): paper 16.17:1 · paper/70 8.50:1 · line 10.62:1. The 4 px bar along the
// top is decorative tappa-green and is NOT the panel's accent stripe — the sign-in
// family is Taptime's own (TestPanelBrand_TheSignInFamilyStaysTaptime).
//
// 🔴 THE DOCKETS ARE A DRAWING, NOT RECORDS. The names, venues and times are made
// up (the landing scene's precedent), nothing is read to draw them, and the whole
// rail is aria-hidden: a screen reader meets the lockup, the heading and the claims.
// The tilts are literal classes on three fixed elements.
//
// The paragraph is drawn from the desk width up: stacked above the form, every row
// of this half is a row the person who came to sign in scrolls past.
templ adminLoginBrandPanel() {
	<aside aria-label="Taptime" class="relative flex flex-col gap-[18px] overflow-hidden bg-ink px-5 pb-[26px] pt-[22px] text-paper md:grid md:grid-cols-[minmax(0,1fr)_330px] md:items-end md:gap-x-8 md:gap-y-[26px] md:px-10 md:pb-9 md:pt-7 desk:flex desk:items-stretch desk:min-w-0 desk:flex-[1_1_520px] desk:justify-between desk:gap-12 desk:px-16 desk:py-10">
		<span aria-hidden="true" class="absolute inset-x-0 top-0 h-1 bg-tappa-green"></span>
		<a href="/" class="inline-flex min-h-11 w-fit flex-col justify-center gap-0.5 text-paper md:col-span-2">
			<span class="font-display text-[22px] font-bold leading-none tracking-tight md:text-2xl desk:text-[26px]">taptime</span>
			<span class="font-mono text-[10px] uppercase tracking-widest text-paper/70 md:text-[11px]">punchless</span>
		</a>
		<div aria-hidden="true" class="relative pt-1.5 md:col-start-2 md:row-start-2 md:pt-2 desk:w-full desk:max-w-[520px] desk:pt-2.5">
			<span class="absolute -inset-x-5 top-1.5 h-1.5 rounded bg-porcelain md:-left-2.5 md:-right-16 md:top-2 md:h-[7px] desk:-left-16 desk:-right-6 desk:top-2.5 desk:h-2"></span>
			<div class="flex gap-2.5 pb-2 md:gap-3 md:pb-0 desk:gap-[18px] desk:pl-2">
				@adminLoginDocket("KF Valletta", "Maria Borg", "IN 07:58", "-rotate-2", true, "")
				@adminLoginDocket("KF Hamrun", "Kevin Borg", "IN 08:02", "rotate-[1.5deg]", false, "TRUST 70")
				@adminLoginDocket("KF Msida", "Grace Attard", "OUT 16:31", "-rotate-[0.8deg]", false, "TRUST 100")
			</div>
		</div>
		<div class="flex flex-col gap-3 md:col-start-1 md:row-start-2 desk:max-w-[460px]">
			<h2 class="font-display text-[26px] font-bold leading-none tracking-tight md:text-[40px] desk:text-5xl">{ AdminLoginHeadline }</h2>
			<p class="hidden text-[15px] leading-normal text-line desk:block">
				for i, line := range AdminLoginProof {
					if i > 0 {
						{ " " }
					}
					{ line }
				}
			</p>
		</div>
	</aside>
}

// adminLoginDocket is one hanging docket on the sign-in rail: a clip, then the
// docket turned about its top edge. tilt is one of the literal classes the caller
// writes, so the stylesheet carries all three.
templ adminLoginDocket(venue, name, when, tilt string, stamped bool, foot string) {
	<div class="flex w-[100px] flex-none flex-col items-center desk:w-[150px]">
		<span class="relative z-10 h-[11px] w-[26px] rounded-b bg-ink/50 md:h-[13px] md:w-[30px] desk:h-4 desk:w-10 desk:rounded-b-md"></span>
		<div class={ "docket -mt-[3px] flex w-full origin-top flex-col gap-1 px-[9px] pb-2 pt-2.5 text-ink md:gap-1.5 md:px-2.5 md:pb-2.5 md:pt-3 desk:-mt-1 desk:gap-2 desk:px-3.5 desk:pb-3.5 desk:pt-4", tilt }>
			<span class="lbl hidden desk:block">{ venue }</span>
			<span class="font-display text-[11px] font-bold md:text-xs desk:text-[15px]">{ name }</span>
			<span class="font-mono text-xs md:text-[13px] desk:text-lg desk:font-bold">{ when }</span>
			if stamped {
				<span class="desk:self-end"><span class="stamp stamp--approved px-1 py-px text-[8px] md:px-[5px] md:py-0.5 md:text-[9px] desk:px-2.5 desk:py-1 desk:text-[11px]">Approved</span></span>
			}
			if foot != "" {
				<span class="hidden border-t border-dashed border-line pt-1.5 font-mono text-[11px] text-ink/70 desk:block">{ foot }</span>
			}
		</div>
	</div>
}

// AdminChoose is the "which business?" step: it renders only businesses whose
// stored password ACTUALLY VERIFIED (PHASE B OBLIGATION 5 — the set is built in
// internal/adminauth and signed on the way here).
//
// THE KICKER SAYS "Password accepted", NOT "Signed in". No session exists until a
// business is picked; the drawing's "Signed in · one more step" claimed one.
//
// EACH ROW IS A DOCKET hung from the rail by a clip (design "The Pass", M12-44):
// the brand's signature motif for a record, sharp-cornered. The rail and the clips
// are drawn from the desk width up, where the dockets sit side by side and turn
// by position (the rail's own tilt rules); below it they stack straight.
//
// EACH ROW IS ITS OWN FORM rather than one form with radio buttons: it makes the
// whole row-plus-button a single decision with nothing to select first, and it
// keeps a keyboard user one tab away from submitting. The tenant id is a hidden
// field per form, and the server does not believe it — it checks membership of the
// signed set. Each button names its business, so a screen reader's list of buttons
// tells them apart.
templ AdminChoose(v AdminChooseView) {
	@layout.Auth("Which business? — Taptime", "") {
		@AuthHeader("")
		<main class="mx-auto flex w-full max-w-[1040px] flex-col gap-[22px] px-4 pb-10 pt-4 md:gap-[30px] md:px-10 md:pb-14 md:pt-6 desk:gap-9 desk:px-14 desk:pb-[72px] desk:pt-8">
			<div class="flex flex-col gap-2 md:gap-2.5 desk:max-w-[620px]">
				<p class="lbl">Password accepted · one more step</p>
				<h1 class="font-display text-3xl font-bold leading-none tracking-tight md:text-[40px] desk:text-5xl">Which business?</h1>
				<p class="max-w-[560px] text-[15px] leading-normal text-ink/70 md:text-base">
					You manage more than one. Pick the one you want to work in — you can sign out and switch at any time.
				</p>
			</div>
			<div class="choose-rail relative desk:pt-2.5">
				<span aria-hidden="true" class="absolute inset-x-0 top-2.5 hidden h-2 rounded bg-ink desk:block"></span>
				<ol class="grid gap-[22px] desk:gap-6 desk:px-4 desk:[grid-template-columns:repeat(auto-fit,minmax(260px,1fr))]">
					for _, b := range v.Businesses {
						<li class="rail-item flex min-w-0 flex-col items-center">
							<span aria-hidden="true" class="relative z-10 hidden h-[18px] w-[46px] rounded-b-md bg-ink/70 desk:block"></span>
							<article class="docket w-full px-4 py-[18px] font-display md:px-[22px] md:py-5 desk:-mt-1 desk:px-5 desk:pb-5 desk:pt-[22px]">
								<form method="post" action="/admin/login/choose" class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between md:gap-5 desk:flex-col desk:items-stretch desk:gap-3.5">
									<input type="hidden" name="csrf" value={ v.CSRFToken }/>
									<input type="hidden" name="tenant_id" value={ b.TenantID }/>
									<div class="flex min-w-0 items-start justify-between gap-2.5 md:flex-1 md:items-center md:justify-start md:gap-7 desk:flex-col desk:items-stretch desk:gap-3.5">
										<div class="flex min-w-0 flex-col gap-1">
											<p class="lbl">Business</p>
											<p class="break-words text-xl font-bold leading-tight tracking-tight text-ink md:text-[22px]">{ b.TenantName }</p>
										</div>
										<div class="flex flex-none flex-col rounded-md border border-ink px-2 py-[3px] md:gap-1 md:rounded-none md:border-0 md:border-l md:border-dashed md:border-line md:px-0 md:py-0 md:pl-[22px] desk:border-l-0 desk:border-t desk:pl-0 desk:pt-3">
											<p class="lbl sr-only md:not-sr-only">Your role</p>
											<p class="font-mono text-[11px] font-bold uppercase tracking-widest text-ink md:text-[13px] desk:text-sm">{ b.Role }</p>
										</div>
									</div>
									<button type="submit" class="btn btn--primary w-full gap-2 rounded-xl md:w-auto md:max-w-[45%] md:flex-none desk:w-full desk:max-w-none">
										<span class="min-w-0 break-words">Continue to { b.TenantName }</span>
										<span aria-hidden="true" class="hidden md:inline">→</span>
									</button>
								</form>
							</article>
						</li>
					}
				</ol>
			</div>
		</main>
	}
}

// AuthHeader is the sign-in family's top bar outside the sign-in page itself:
// a decorative tappa-green bar (never the accent stripe — this family is
// Taptime's), the taptime / punchless lockup and, when signInHref is set, the way
// back to the sign-in form. The lockup is text, not a link: on these screens the
// only way anywhere is the sign-in form or the step in front of the person.
templ AuthHeader(signInHref string) {
	<span aria-hidden="true" class="block h-1 bg-tappa-green"></span>
	<header class="flex min-h-14 items-center justify-between gap-3 px-4 py-2.5 md:px-10 md:py-[22px] desk:px-14">
		@AuthLockup()
		if signInHref != "" {
			<a href={ templ.SafeURL(signInHref) } class="inline-flex min-h-11 items-center gap-1 font-display text-sm font-bold text-tappa-green underline-offset-4 hover:text-ink hover:underline">
				<span aria-hidden="true">←</span>
				Back to sign in
			</a>
		}
	</header>
}

// AuthLockup is the sign-in family's wordmark on porcelain: "taptime" in ink over
// the "punchless" line (ink/70, 5.70:1 on porcelain).
templ AuthLockup() {
	<p class="flex flex-col gap-0.5">
		<span class="font-display text-xl font-bold leading-none tracking-tight text-ink md:text-2xl">taptime</span>
		<span class="font-mono text-[10px] uppercase tracking-widest text-ink/70 md:text-[11px]">punchless</span>
	</p>
}

// PanelShell is the chrome a panel section that loads NO SCRIPT renders inside:
// brand lockup, who is signed in, sign-out, the navigation, and the section's heading.
//
// 🔴 IT WAS EXTRACTED BY M6-03 AND THE ALTERNATIVE WAS THE FAILURE THIS REPO KEEPS
// PAYING FOR. Until M6-03 there was one panel page and this markup lived inside it.
// Giving Transactions real content meant either a second page carrying a COPY of
// the lockup, the sign-out form and the navigation — a second representation, two
// places to drift, and the drift unnoticeable because a page missing sign-out looks
// exactly like one that has it — or this. The body is the only thing that differs
// between a built section and an empty one.
//
// 🔴 IT TAKES NO SCRIPT PARAMETER, AND UNTIL 2026-08-06 IT DID. One shell with a
// script string meant giving any section a script was editing "" to a path: an edit
// that compiled, rendered, and was refused only by a test — measured by an audit,
// which made it. Splitting the shell in two (PanelShellWithScript below) makes that
// same edit a COMPILE ERROR, which is the user decision recorded in
// docs/plan/m6-dashboard.md. layout.Panel and layout.PageWithScript use the same
// shape for the same reason.
//
// ⚠️ THE OTHER ROUTE IS OPEN AND IS NAMED HERE ON PURPOSE: a section can still write
// @PanelShellWithScript. That compiles, and
// TestPanelScreens_ScriptsAndPolicyAgreeAndReachNoThirdParty is what turns red on
// it. So this split does not make widening impossible — it makes the cheapest form
// of it impossible, and leaves the remaining form deliberate and netted.
templ PanelShell(c PanelChrome) {
	@layout.Panel("Panel — Taptime", c.Brand.Theme) {
		@panelChrome(c) {
			{ children... }
		}
	}
}

// PanelShellWithScript is PanelShell for the ONE section that loads a script.
//
// 🔴 IT IS A SECOND NAMED COMPONENT RATHER THAN A PARAMETER ON THE FIRST, and that
// is the whole point of the split (user decision, 2026-08-06). Until then both
// shells were one function taking a script string, so giving a scriptless section a
// script was editing "" to a path — a change that COMPILED, RENDERED, and was
// refused only by a test. Now the same edit does not compile, because PanelShell
// has no slot to put it in.
//
// ⚠️ WHAT THIS DOES NOT DO, STATED BECAUSE THE OPPOSITE IS THE TEMPTING SENTENCE:
// it does not make widening impossible. Naming THIS component from another section
// still compiles; what stops it there is
// TestPanelScreens_ScriptsAndPolicyAgreeAndReachNoThirdParty, which is measured to
// go red on exactly that move. So the guarantee is narrower and worth having: the
// cheapest edit — changing a string — is now rejected by the compiler, and the
// remaining route requires naming a different component on purpose.
templ PanelShellWithScript(c PanelChrome, script string) {
	@layout.PanelWithScript("Panel — Taptime", script, c.Brand.Theme) {
		@panelChrome(c) {
			{ children... }
		}
	}
}

// panelChrome is the markup both shells wrap, extracted so the split above costs
// one copy of a component call rather than one copy of the chrome. A second copy of
// the lockup, the sign-out form and the navigation is the "second representation"
// shape this file already argues against — the reason PanelShell exists at all.
//
// THE SHELL OF DESIGN "THE PASS" (user-approved 2026-10-20). One .panel-side holds
// the header and the tablet/desktop navigation and changes shape with the width:
// the phone's top bar below md, an 88px ink icon rail from md, a 248px ink sidebar
// from desk. The phone's navigation is BarNav, a bottom bar with a no-script "More"
// sheet, displayed only below md. The section's body keeps its own markup inside a
// content well (.panel-well, about 72rem wide; input.css says why) beside the navigation.
// The section's heading is the shell's too: panelHead below.
//
// A BRANDED BUSINESS'S HEADER TAKES THE WORDMARK'S PLACE, and nothing else in the
// chrome changes (M10 WL-8; panelbrandview.go has the rule and the zero value). The
// header exists ONCE in the document at every width, so the stripe, the logo and the
// name are drawn once — the swap TestPanelBrand_ABrandedBusinessGetsItsHeaderOnEverySection
// undoes.
//
// SIGN-OUT IS THE SAME FORM IN TWO PLACES: the rail/sidebar's foot and the phone's
// More sheet. Only one of them is displayed at a width; both post to /admin/logout
// exactly as the single form did.
templ panelChrome(c PanelChrome) {
	<div class="panel-frame">
		<div class="panel-side">
			if c.Brand.Branded() {
				@panelBrandHeader(c.Brand)
			} else {
				@PanelWordmark()
			}
			@components.SideNav(panelNavMain(c), panelNavFoot(c), c.CurrentHref())
			<div class="side-foot">
				<p class="side-who">
					<span class="side-who-label">Signed in as</span>
					<span class="side-who-name">{ c.FullName }</span>
					<span class="side-who-role">{ c.Role }</span>
				</p>
				<form method="post" action="/admin/logout">
					<button type="submit" class="btn btn--quiet side-signout">Sign out</button>
				</form>
			</div>
		</div>
		<main class="panel-main">
			<div class="panel-well">
				if a := panelActionsOf(ctx); c.hasHead(a) {
					@panelHead(c, a)
				} else if h, ok := c.Heading(); ok {
					@panelHeading(h)
				}
				{ children... }
			</div>
		</main>
		@components.BarNav(panelNavBar(c), panelNavSheet(c), c.CurrentHref()) {
			<p class="text-sm text-ink/70">
				Signed in as <strong class="font-bold text-ink">{ c.FullName }</strong> · <span class="font-mono uppercase tracking-widest">{ c.Role }</span>
			</p>
			<form method="post" action="/admin/logout">
				<button type="submit" class="btn btn--quiet w-full">Sign out</button>
			</form>
		}
	</div>
}

// panelHeading is the one <h1> of a panel page (PanelChrome.Heading picks its words). The
// size steps with the width -- 30 px on the phone, 36 px on the tablet, 44 px on the desk --
// set solid (line height equal to the size) with the boards' tight negative tracking. Ink on
// porcelain, never the accent.
//
// THE TABLET STEP REPEATS THE SOLID LEADING, ON PURPOSE. The tablet's size utility carries a
// line height of its own (40 px) and is emitted inside the tablet media rule, after the base
// leading, so without the repeat the title is set at 40 px from the tablet up -- the desk's
// arbitrary 44 px sets no line height and inherits it (measured in the compiled stylesheet).
templ panelHeading(h string) {
	<h1 class="font-display text-3xl md:text-4xl desk:text-[44px] font-bold leading-none md:leading-none tracking-[-0.035em]">{ h }</h1>
}

// panelHead is the heading when a section set a kicker, a trail or actions (M12-01; the actions
// come from PanelActions, adminview.go says why they are not a PanelChrome field). Its order
// is the boards': the trail, then the eyebrow, then the title, with the actions on the title's
// row, at its right, moving under it when the row runs out of width.
//
// THE TRAIL IS AN ORDERED LIST IN A NAV NAMED "Breadcrumb", the pattern assistive technology
// announces as one. The last crumb is this page: text, marked as the current page, never a
// link -- a link to the page one is on is a control that does nothing. The slashes between
// crumbs are drawing, so they are not read. Each earlier crumb is a 44 px target like every
// other link in the panel.
//
// THE EYEBROW IS A PARAGRAPH, not part of the h1, so the heading a reader jumps to is the
// title alone.
templ panelHead(c PanelChrome, actions templ.Component) {
	<div class="panel-head">
		if len(c.Crumbs) > 0 {
			<nav aria-label="Breadcrumb" class="panel-crumbs">
				<ol class="panel-crumbs-list">
					for i, cr := range c.Crumbs {
						<li class="panel-crumbs-item">
							if i == len(c.Crumbs)-1 {
								<span aria-current="page">{ cr.Label }</span>
							} else {
								if cr.Href != "" {
									<a href={ templ.URL(cr.Href) } class="panel-crumb">{ cr.Label }</a>
								} else {
									<span>{ cr.Label }</span>
								}
								<span aria-hidden="true">/</span>
							}
						</li>
					}
				</ol>
			</nav>
		}
		<div class="panel-head-row">
			<div class="panel-head-text">
				if c.Kicker != "" {
					<p class="lbl">{ c.Kicker }</p>
				}
				if h, ok := c.Heading(); ok {
					@panelHeading(h)
				}
			</div>
			if actions != nil {
				<div class="panel-actions">
					@actions
				</div>
			}
		</div>
	</div>
}

// PanelWordmark is the chrome's header when the business has no brand: the product's
// lockup, "taptime" over "punchless" — ink on the phone's porcelain top bar, paper on
// the ink sidebar (16.2:1; the tagline at 70%, 8.5:1) — and the "t." mark on the
// tablet's rail, where the word does not fit. It is exported so the brand tests can
// render the unbranded opening they compare against.
templ PanelWordmark() {
	<header class="side-head">
		<div class="side-lockup">
			<span class="side-mark" aria-hidden="true">t.</span>
			<div class="side-words">
				<span class="side-word">taptime</span>
				<span class="side-tag">punchless</span>
			</div>
		</div>
	</header>
}

// panelBrandHeader is the business's header (M10 WL-8; ADR 0023 §2, K4): the 4 px
// stripe in its accent when the accent's stylesheet is linked, then its logo when it
// has one, its name, and the co-brand line under the name. The stripe is decoration,
// hidden from assistive technology and empty, and it runs across the top of the
// rail, the sidebar or the phone's top bar. The name is ink on the phone's porcelain
// and paper on the ink sidebar (16.2:1); the co-brand line keeps the tagline's tone
// (ink at 70% on porcelain 5.70:1, paper at 70% on ink 8.5:1). On the tablet's rail
// the name block is visually hidden but still read.
//
// WITHOUT A LOGO, THE RAIL SHOWS THE NAME'S FIRST LETTER where an unbranded panel
// shows Taptime's "t." — a branded business's rail is not Taptime's mark (2026-10-20
// audit). aria-hidden: the name itself is read from the visually hidden block.
//
// THE LOGO SITS ON A PAPER TILE, because logos are drawn for a light ground and the
// rail and sidebar are ink. The <img> keeps its 32px-slot box (PanelLogoOf); on the
// 88px rail it may only shrink.
//
// THE LOGO'S ALT IS EMPTY, ON PURPOSE (orchestrator decision, WL-8 round 1): the name
// is the visible text right beside it, so a named alt is read twice, and a logo that
// fails to load would print the name inside its own box and push the page down by as
// many lines as the name takes. With an empty alt the box stays as wide and as tall
// as its attributes (ADR 0023 WL-8 note has both measurements). The tap screen, where
// the name is not shown, keeps the name as its alt (WL-9).
templ panelBrandHeader(b PanelBrand) {
	<header class="side-head side-head--named">
		if b.Theme.Linked() {
			<div aria-hidden="true" class="panel-stripe"></div>
		}
		<div class="side-lockup">
			if b.DrawsLogo() {
				<span class="side-logo">
					<img src={ b.Logo.Src } width={ itoa(b.Logo.Width) } height={ itoa(b.Logo.Height) } alt=""/>
				</span>
			} else {
				<span class="side-mark" aria-hidden="true">{ initialOf(b.Name) }</span>
			}
			<div class="side-named">
				<p class="side-name">{ b.Name }</p>
				<p class="side-coline">taptime · punchless</p>
			</div>
		</div>
	</header>
}

// AdminDashboard is a section that has NOTHING IN IT YET, and says so.
//
// 🔴 FOUR OF THE SIX SECTIONS STILL RENDER THIS. M6-02 built the skeleton, M6-03
// filled Transactions and M6-04 added the review queue; Employees, Locations,
// Reports and Policies are M6-05, M6-06, M6-07 and M6-09. An empty state that
// names its task is the honest shape: a manager who opens Reports learns that the
// section is coming, rather than concluding that they have no hours.
templ AdminDashboard(v AdminDashboardView) {
	@PanelShell(v.PanelChrome) {
		if s, ok := v.Section(); ok {
			@components.EmptyState(s.Label + " is not built yet") {
				<p>{ s.Blurb }</p>
				<p class="mt-2">
					It arrives with <span class="font-mono uppercase">{ s.Task }</span>.
				</p>
			}
		}
	}
}

// panelTabs adapts the section list to the navigation components.
// THE COMPONENTS DO NOT IMPORT THE SECTION TABLE, deliberately: components.SideNav
// and BarNav know about labels, icons and hrefs and nothing about the panel's
// roadmap, so the same navigation can carry a different set of sections later
// without the components changing.
// 🔴 THE BADGE IS ATTACHED HERE AND ONLY TO THE REVIEW TAB. The component knows
// what a badge looks like; which section has one is the panel's business, and
// binding it by TAB rather than by position means reordering the sections cannot
// move the number onto the wrong link.
// 🔴 AN OwnerOnly SECTION IS FILTERED OUT HERE AND NOWHERE ELSE (M6-12). This is the
// NAVIGATION, not the routing table: internal/handler still ranges over the whole of
// PanelSections when it mounts, so every section keeps its route and a tab whose link
// 404s remains impossible to introduce. Hiding the link is the courtesy half; the
// server refuses the route itself, and neither substitutes for the other. Every one
// of the four lists below is built from this one, so the filter applies to the
// sidebar, the rail, the phone's bar and its More sheet alike.
func panelTabs(c PanelChrome) []navTab {
	out := make([]navTab, 0, len(PanelSections))
	n := 0
	for _, s := range PanelSections {
		if s.OwnerOnly && c.Role != adminRoleOwner {
			continue
		}
		if s.GroupOnly && !c.InGroup {
			continue
		}
		t := components.Tab{Label: s.Label, Href: s.Href, Short: s.Short, Icon: s.Icon}
		if !s.Footer {
			n++
			t.No = twoDigits(n)
		}
		if s.Tab == TabReview {
			t.Badge = c.Pending.Label()
			t.BadgeLabel = c.Pending.Describe()
		}
		out = append(out, navTab{Tab: t, footer: s.Footer, barSlot: s.BarSlot})
	}
	return out
}

// navTab is a drawn tab and the two table facts that decide which list it joins.
type navTab struct {
	components.Tab
	footer  bool
	barSlot int
}

// twoDigits is the sidebar's "01".."99".
func twoDigits(n int) string {
	if n < 10 {
		return "0" + itoa(n)
	}
	return itoa(n)
}

// panelNavMain and panelNavFoot are the sidebar's two groups, in table order.
func panelNavMain(c PanelChrome) []components.Tab {
	return pickTabs(c, func(t navTab) bool { return !t.footer })
}
func panelNavFoot(c PanelChrome) []components.Tab {
	return pickTabs(c, func(t navTab) bool { return t.footer })
}

// panelNavSheet is what the phone's More sheet lists: every drawn tab without a bar
// slot, in table order.
func panelNavSheet(c PanelChrome) []components.Tab {
	return pickTabs(c, func(t navTab) bool { return t.barSlot == 0 })
}

// panelNavBar is the phone's bottom bar, in slot order (the design's Pass, Spike,
// Roll, People) rather than table order.
func panelNavBar(c PanelChrome) []components.Tab {
	tabs := panelTabs(c)
	var out []components.Tab
	for slot := 1; slot <= len(tabs); slot++ {
		for _, t := range tabs {
			if t.barSlot == slot {
				out = append(out, t.Tab)
			}
		}
	}
	return out
}

func pickTabs(c PanelChrome, keep func(navTab) bool) []components.Tab {
	var out []components.Tab
	for _, t := range panelTabs(c) {
		if keep(t) {
			out = append(out, t.Tab)
		}
	}
	return out
}

// NOTE — currentHref MOVED to PanelChrome.CurrentHref (adminview.go) in M6-03.
// Two views now render the same navigation, and a package-level function taking one
// of them would have needed a second copy for the other.
