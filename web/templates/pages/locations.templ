package pages

import "github.com/atknatk/tappa/web/templates/components"

// The LOCATIONS section — the panel's answer to "where do we work, and what counts
// as being there?" (M6-06 phase A).
//
// 🔴 IT RENDERS PanelShell, NOT PanelShellWithScript, AND THAT IS THE WHOLE SCRIPT
// DECISION. PanelShell has no script slot (user decision, 2026-08-06: the split
// exists so that giving a section a script is a COMPILE error rather than an edit to
// a string), so this section could not load one without naming a different component
// on purpose. It does not need to: every control here is a link, a form field or a
// submit button. The one place a script would have helped is the address-range
// repeater, and that is a textarea instead — the trade is written down at
// components.VenueFormView.Ranges rather than felt.
//
// 🔴 §4.7 — NOTHING BELOW RENDERS A SECRET, AND THE VIEW MODEL IS WHY. LocationsView
// has no field for a key, a token, a hash or an employee name, so this template
// could not print one. The Wi-Fi network name IS rendered and is not a secret:
// migration 00010 argues that at length — it is the network a venue publishes to its
// own staff, and it is explicitly not evidence of anything.
//
// 🔴 §4.6 — THE EMPTY STATE IS GATED ON HAVING ASKED. "This business has no venues"
// is a claim about a business and the product may not make one it has not measured;
// v.Queried is set only after the database answered, and a failed read renders a
// problem page in the handler rather than an empty list here.
//
// 🔴 THE CONTROLS ARRIVED WITH THEIR HANDLERS. A screen offering something the
// server does not implement is this repository's most expensive class of mistake,
// and it takes two nets because it has two halves:
//
//	does the control lead somewhere SERVED?   TestLocationsSection_
//	  EveryControlLeadsSomewhereThatExists drives every form target and every link
//	  on this page through the real router.
//	would the server REFUSE what it offers?   TestLocationsSection_
//	  OffersNoActionTheServerWouldRefuse requires the department form's venue
//	  control to be ABSENT when editing — because UpdateDepartment cannot move one —
//	  with the sentence that explains it present, and a NEW department's form as the
//	  control.
templ AdminLocations(v LocationsView) {
	@PanelShell(v.PanelChrome) {
		if v.RemovalReceipt != nil {
			// 🔴 THE ONLY PLACE A REMOVAL IS ACKNOWLEDGED, AND IT IS GATED ON THE RECEIPT
			// RATHER THAN ON Done. The handler built this only after finding the
			// signed-in admin's OWN audit entry for the id in the address, in the same
			// request (user decision, 2026-08-09, reading C'). A stranger's URL leaves it
			// nil and this whole block disappears.
			@components.Notice(components.ToneOK, removalHeading(v.Done, v.RemovalReceipt.Name)) {
				<p>
					It is gone from the list below. Its records are kept — nothing that
					already happened there has changed, and the removal itself is in the
					audit trail.
				</p>
			}
		} else if v.Done != "" && !ClaimsARemoval(v.Done) && !ClaimsAPlaqueAct(v.Done) {
			@components.Notice(components.ToneOK, doneVenueHeading(v.Done)) {
				switch v.Done {
					case "venue-added", "venue-saved":
						// 🔴 THE SENTENCE POINTS AT THE LIST RATHER THAN RESTATING THE SAVE.
						// What a manager most needs to check after editing a venue is whether
						// it still has proof of place, and the card below says so on the venue
						// itself — a banner repeating "static IPs: none" would be a second
						// place for that fact to drift out of step with the row.
						<p>The venue below is as it now stands. Check its address ranges and coordinate — they are what taps here are checked against.</p>
					default:
						<p>The department below is as it now stands.</p>
				}
			}
		}
		if v.Problem != "" {
			@components.Notice(components.ToneWarn, problemVenueHeading(v.Problem)) {
				switch v.Problem {
					case "unreadable":
						<p>We could not read that submission, so nothing was changed.</p>
					case "unknown-venue":
						<p>That venue is not one of this business's. Nothing was changed.</p>
					case "unknown-department":
						<p>That department is not one of this business's. Nothing was changed.</p>
					case "venue-in-use", "department-in-use":
						// 🔴 THE RACE, SAID AS WHAT IT IS. The screen offered the control
						// because nothing pointed at the row when it rendered; something
						// does now. Nothing is wrong with the request and nothing was lost.
						<p>Something was added to it while you were looking, so it is no longer empty and nothing was removed. Open it again to see what is there now.</p>
					case "not-permitted":
						// 🔴 NOTHING IS WRONG WITH THE REQUEST OR THE ROW — the act is
						// reserved. Saying "you cannot" without saying WHO can would leave
						// a manager with nowhere to go.
						<p>Removing a venue or a department cannot be undone, so it is reserved for an owner. Nothing was removed — ask one of your business's owners.</p>
					case "confirm-required":
						<p>Removing something asks first. Nothing was removed — open it again and use the remove link.</p>
					case "confirm-stale":
						<p>That confirmation was for something else — you may have opened another one in the meantime. Nothing was removed.</p>
					case "unknown-plaque":
						<p>That plaque id is not one of this business's. Nothing was changed.</p>
					case "plaque-not-stock":
						// 🔴 THE RACE, SAID AS WHAT IT IS. The card offered that plaque because it
						// was in stock when the page rendered; somebody mounted it in between. The
						// statement's own precondition refused, so nothing was written — neither
						// half of the replacement happened.
						<p>Somebody mounted that spare while you were looking, so nothing was changed. Open the plaque again and pick another spare.</p>
					case "plaque-not-active":
						<p>That plaque is not on a wall any more — somebody may have replaced it already. Nothing was changed.</p>
					case "plaque-no-wall":
						<p>That plaque is not on a wall, so there is nothing to take down. Nothing was changed.</p>
					case "same-plaque":
						<p>A plaque cannot replace itself. Nothing was changed — pick a spare from the box.</p>
					case "plaque-frozen":
						// 🔴 A DEVELOPMENT-ONLY STATE, AND THE SCREEN SAYS IT RATHER THAN
						// ANSWERING 500. Migration 00013 froze the rows whose id was written in a
						// spelling it no longer accepts; they are listed because they exist, and
						// the database refuses every write to them.
						<p>That plaque's id was recorded in a spelling this system no longer accepts, so nothing can be written to it. Nothing was changed.</p>
					default:
						<p>We could not load your venues. Nothing was changed — try again in a moment.</p>
				}
			}
		}
		if v.PlaqueReceipt != nil {
			// 🔴 THE ONLY PLACE A PLAQUE ACT IS ACKNOWLEDGED, AND IT IS GATED ON THE
			// RECEIPT RATHER THAN ON Done — the same rule the removal banner above
			// follows. The handler built this only after finding the signed-in admin's
			// OWN audit entry for the plaque in the address, for the action that word
			// claims, in the same request. A stranger's URL leaves it nil and this whole
			// block disappears.
			@components.Notice(components.ToneOK, plaqueHeading(*v.PlaqueReceipt)) {
				if v.PlaqueReceipt.Unmounted {
					<p>
						It is back in stock, ready to mount somewhere else. Nothing was retired
						and no spare was used — but a tap at that door is rejected until you put
						a plaque up there.
					</p>
				} else if v.PlaqueReceipt.Replaced {
					<p>
						The old plaque is retired and its record stays — every tap it ever took
						still resolves. A tap on it now is rejected, so take it off the wall.
					</p>
				} else {
					<p>The plaque is now in service. From now on a tap on it is a tap at that place.</p>
				}
			}
		}
		if v.VenueForm != nil {
			@components.VenueForm(*v.VenueForm)
		}
		if v.DepartmentForm != nil {
			@components.DepartmentForm(*v.DepartmentForm)
		}
		if v.PlaqueForm != nil {
			@components.PlaqueCard(*v.PlaqueForm)
		}
		<section class="flex flex-col gap-4">
			<div class="flex flex-wrap items-center justify-between gap-3">
				<h2 class="font-display text-lg font-bold tracking-tight text-ink">Venues</h2>
				<a class="btn btn--primary" href={ templ.URL(v.AddVenueHref) }>Add a venue</a>
			</div>
			if v.VenuesCapped {
				// §4.6: a cut list says it was cut. Staying silent would tell a manager
				// they run exactly this many venues when they run more.
				@components.Notice(components.ToneWarn, "This list is not complete") {
					<p>
						Only the first { v.VenueLimit } venues are shown. If your business really
						has more than this, tell us — the screen was built for an estate of tens,
						not hundreds.
					</p>
				}
			}
			if len(v.Venues) > 0 {
				for _, ven := range v.Venues {
					@components.VenueRow(ven)
				}
			} else if v.Queried {
				@components.EmptyState("No venues yet") {
					// 🔴 A CLAIM ABOUT THE RECORDS, NOT ABOUT THE BUSINESS. "You have no
					// venues" would be a claim about the world; what the product measured is
					// that this business has no location rows, which is the ordinary state of
					// a tenant on its first day.
					<p>No venues have been added to this business yet. A venue is a place people tap in at — add the first one to get started.</p>
				}
			}
		</section>
		<section class="flex flex-col gap-4">
			<div class="flex flex-wrap items-center justify-between gap-3">
				<h2 class="font-display text-lg font-bold tracking-tight text-ink">Departments</h2>
				if len(v.Venues) > 0 {
					<a class="btn btn--primary" href={ templ.URL(v.AddDepartmentHref) }>Add a department</a>
				}
			</div>
			if v.DepartmentsCapped {
				@components.Notice(components.ToneWarn, "This list is not complete") {
					<p>Only the first { v.DepartmentLimit } departments are shown.</p>
				}
			}
			if len(v.Departments) > 0 {
				for _, d := range v.Departments {
					@components.DepartmentRow(d)
				}
			} else if v.Queried {
				@components.EmptyState("No departments") {
					if len(v.Venues) > 0 {
						// 🔴 IT SAYS THIS IS NORMAL, because it is. Migration 00003 makes a
						// department optional precisely because a bar does not model them, and
						// an empty state that reads like a gap would send a manager looking for
						// something to fix.
						<p>
							This business does not use departments, which is perfectly normal — a bar
							or a small venue usually does not need them. Add one if some of your staff
							work different hours from the rest of the venue.
						</p>
					} else {
						// 🔴 THE CONTROL IS ABSENT ABOVE AND THIS SAYS WHY. A department must
						// sit in a venue (departments.location_id is NOT NULL), so with no
						// venues there is nothing to add one to — and an "Add a department"
						// button here would lead to a form whose only submission the server
						// must refuse.
						<p>Add a venue first — a department is part of one.</p>
					}
				}
			}
		</section>
		// --- THE WALL PLAQUES (M6-06 phase B) --------------------------------------
		//
		// 🔴 THREE LISTS, NOT ONE, AND THE ARGUMENT IS IN LocationsView. Each answers
		// one question a manager arrives with: what is on my walls, what is in the box,
		// what has come off. The query's own order — stock first, then by LOCATION
		// UUID — is deterministic but sorts the mounted half by a value this page never
		// prints.
		//
		// 🔴 §4.7 — NOTHING BELOW RENDERS A KEY AND NOTHING CAN. The view models carry
		// no field one could travel in, and the "Key" line on each docket is a word
		// derived from whether the plaque has a wall. components/plaqueview.go states
		// exactly what backs it and what does not (backlog T7).
		<section class="flex flex-col gap-4">
			<div class="flex flex-wrap items-center justify-between gap-3">
				<h2 class="font-display text-lg font-bold tracking-tight text-ink">Plaques on the wall</h2>
			</div>
			if v.PlaquesCapped {
				@components.Notice(components.ToneWarn, "This list is not complete") {
					<p>Only the first { v.PlaqueLimit } plaques are shown.</p>
				}
			}
			if len(v.Mounted) > 0 {
				for _, p := range v.Mounted {
					@components.PlaqueRow(p)
				}
			} else if v.PlaquesQueried {
				@components.EmptyState("No plaques are mounted") {
					if len(v.Stock) > 0 {
						<p>You have plaques in stock below. Open one to mount it at a venue.</p>
					} else {
						// 🔴 THE SENTENCE SAYS WHERE PLAQUES COME FROM, because there is no
						// button and there must not be: the panel cannot create a plaque — that
						// would mean holding its key (user decision, 2026-08-08).
						<p>
							No plaques have been loaded for this business yet. Tappa encodes each
							plaque and loads it here; ask us for the ones you need and they will
							appear in stock, ready to mount.
						</p>
					}
				}
			}
		</section>
		<section class="flex flex-col gap-4">
			<div class="flex flex-wrap items-center justify-between gap-3">
				<h2 class="font-display text-lg font-bold tracking-tight text-ink">In stock</h2>
			</div>
			if len(v.Stock) > 0 {
				for _, p := range v.Stock {
					@components.PlaqueRow(p)
				}
			} else if v.PlaquesQueried {
				@components.EmptyState("Nothing in stock") {
					<p>
						Every plaque loaded for this business is on a wall or out of service. Ask us
						for spares — you need one in the box before you can replace a plaque that
						fails.
					</p>
				}
			}
		</section>
		if len(v.OutOfService) > 0 {
			<section class="flex flex-col gap-4">
				<div class="flex flex-wrap items-center justify-between gap-3">
					<h2 class="font-display text-lg font-bold tracking-tight text-ink">Out of service</h2>
				</div>
				// 🔴 THE OLD ROWS ARE STILL HERE, AND THAT IS THE POINT OF THIS LIST (§4.3,
				// §4.6). A replaced plaque is never deleted — the database refuses it —
				// because every tap it ever took resolves through its id. This is where that
				// history is readable.
				@components.Notice(components.ToneWarn, "These are kept on purpose") {
					<p>
						A plaque that has been replaced, or reported lost, keeps its record: the taps
						it took still point at it. Taps on these are rejected.
					</p>
				}
				for _, p := range v.OutOfService {
					@components.PlaqueRow(p)
				}
			</section>
		}
	}
}

// doneVenueHeading names what the page can SHOW, which is not the same as what the
// query string says happened.
//
// 🔴 EVERY HEADING HERE NAMES A STATE, NOT AN EVENT, and that is the M6-04 lesson
// applied rather than relearned. "Placement saved" was measured unbacked on the
// roster: a URL in a browser that had never posted anything rendered an action claim.
// The four words below say what the list beneath them SHOWS, which the same request
// read from the database — so a replayed address restates something true instead of
// inventing a change.
//
// 🔴 THE TWO REMOVAL WORDS ARE NOT AMONG THEM, AND THEY ARE HANDLED ELSEWHERE IN THIS
// FILE. doneVenueHeading is reached only for a word that backs itself; a removal is
// acknowledged by the RemovalReceipt branch at the top of AdminLocations, and
// removalHeading builds its text. Keeping the two apart is what stops a removal word
// from ever falling through to a heading printed on Done alone.
//
// ⚠️ THIS PARAGRAPH USED TO SAY A REMOVAL COULD NOT BE ACKNOWLEDGED AT ALL — "the
// claim is not made at all", "what confirms a removal is the list itself" — and by
// the time it was read again all three sentences were false. That was a real risk
// rather than an untidiness: C' is the ONLY guard against the F1 defect, and a
// maintainer who believed this comment could delete the RemovalReceipt path as dead
// code. The history, because it is the whole argument for the mechanism:
//
//	the words shipped UNBACKED and an audit measured the M6-05 defect again —
//	GET ?done=venue-deleted, in a browser that had never posted anything, rendered
//	"Venue removed — The venue has been removed";
//	they were then REMOVED, which was true but silent, so a manager who had just
//	deleted a venue saw no acknowledgement at all;
//	and they are now back and VERIFIED (user decision, 2026-08-09, reading C').
//	employees.templ allows an action claim on one condition — that the handler
//	checks it against a row THE SAME REQUEST READ — and after a deletion the
//	surviving row is the AUDIT ENTRY. So the claim is made, and it is checked.
//
// ClaimsARemoval says whether a word asserts something that no longer exists, and so
// may only be printed against a verified receipt.
//
// IT IS EXPORTED SO A TEST CAN COMPARE IT WITH THE HANDLER'S OWN LIST. Two lists that
// disagree would let a word be rendered on Done alone, which is the defect this whole
// mechanism replaces.
//
// 🔴 IT IS A FUNCTION RATHER THAN A CONDITION SPELLED OUT AT THE CALL SITE so the
// template cannot drift from the handler: internal/handler/locations.go holds the same
// two words in venueRemovalWords, and TestRemovalWords_AgreeBetweenHandlerAndTemplate
// requires the two lists to match.
func ClaimsARemoval(done string) bool {
	return done == "venue-deleted" || done == "department-deleted"
}

// removalHeading names what was removed, from the TRAIL rather than from the URL.
//
// THE NAME MAY BE EMPTY — a trail row from a future action with a different detail
// shape carries none — and then the heading says what happened without naming it,
// which is still true. It never falls back to anything the client supplied.
func removalHeading(done, name string) string {
	what := "Venue"
	if done == "department-deleted" {
		what = "Department"
	}
	if name == "" {
		return what + " removed"
	}
	return what + " removed: " + name
}

// ClaimsAPlaqueAct says whether a word asserts that something HAPPENED to a plaque,
// and so may only be printed against a verified trail entry.
//
// 🔴 IT IS A SEPARATE PREDICATE FROM ClaimsARemoval RATHER THAN A LONGER ONE,
// because the two are verified against DIFFERENT things: a removal against the
// removal's own audit row, a plaque act against the action that act writes. Merging
// them would make one list gate two mechanisms, and the next word added would
// inherit whichever check happened to be first.
//
// IT IS EXPORTED SO A TEST CAN COMPARE IT WITH THE HANDLER'S OWN LIST — the same
// reason ClaimsARemoval is. Two lists that disagree would let a word be rendered on
// Done alone, which is the defect this mechanism replaces.
func ClaimsAPlaqueAct(done string) bool {
	return done == "plaque-mounted" || done == "plaque-replaced" ||
		done == "plaque-unmounted"
}

// plaqueHeading names what the trail confirmed, from the TRAIL rather than from the
// URL.
//
// THE NAME MAY BE EMPTY — a trail row whose detail carries no `name` — and then the
// heading says what happened without naming anything, which is still true. It never
// falls back to something the client supplied: the uid in the address is only ever a
// lookup key.
func plaqueHeading(r components.PlaqueReceiptView) string {
	if r.Unmounted {
		if r.Name == "" {
			return "Plaque taken off the wall"
		}
		return "Plaque taken off the wall at " + r.Name
	}
	if r.Replaced {
		if r.Name == "" {
			return "Plaque replaced"
		}
		return "Plaque replaced — the new one is " + r.Name
	}
	if r.Name == "" {
		return "Plaque mounted"
	}
	return "Plaque mounted at " + r.Name
}

func doneVenueHeading(done string) string {
	switch done {
	case "venue-added":
		return "Venue added"
	case "department-added":
		return "Department added"
	case "department-saved":
		return "Department as it now stands"
	default:
		return "Venue as it now stands"
	}
}

func problemVenueHeading(problem string) string {
	switch problem {
	case "venue-in-use", "department-in-use":
		return "It is not empty any more"
	case "not-permitted":
		return "That is an owner's to remove"
	case "confirm-required", "confirm-stale":
		return "Nothing was removed"
	case "unreadable":
		return "We could not read that"
	case "unknown-venue":
		return "We could not find that venue"
	case "unknown-department":
		return "We could not find that department"
	case "unknown-plaque":
		return "We could not find that plaque"
	case "plaque-not-stock":
		return "That plaque is not in the box any more"
	case "plaque-not-active":
		return "That plaque is not on a wall any more"
	case "plaque-no-wall":
		return "There is nothing to take down"
	case "same-plaque":
		return "A plaque cannot replace itself"
	case "plaque-frozen":
		return "That plaque cannot be changed"
	default:
		return "We could not load your venues"
	}
}
