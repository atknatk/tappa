package pages

import (
	"strconv"

	"github.com/atknatk/tappa/web/templates/layout"
)

// The four LEGAL documents under /legal (M7-01, Q23; publishable since M7-06).
//
// 🔴 EACH DOCUMENT IS A SKELETON UNTIL SOMEBODY PUBLISHES A TEXT FOR IT, AND THE
// PAGE SAYS SO IN LARGE TYPE WHILE IT IS ONE. M7-01 shipped all four as skeletons
// because a privacy policy names a controller, an imprint names a registered
// company and retention periods are commitments — none of those facts was in this
// repository, and writing plausible ones would have produced a document that is
// legally wrong and looks finished. M7-06 did not change that judgement; it built
// a form (migration 00020) so the facts can arrive from the person who has them
// instead of from a developer editing Go source -- since M10 OP-10 the platform
// operator's /operator/legal, on the operator's own host.
//
// ⚠️ THE STATE IS PER DOCUMENT AND THERE IS NO "THE LEGAL PAGES ARE LIVE" MOMENT.
// Publishing the privacy policy replaces the skeleton on /legal/privacy, makes that
// one page indexable, and leaves the other three saying exactly what they said
// before — in the same request. Anything else would need a page to speak for
// documents it is not.
//
// WHAT A SKELETON MUST NOT LOOK LIKE, and this is the whole of the design: it must
// not look EMPTY (a reader cannot tell an unfinished page from a broken one) and it
// must not look READY (a reader must never act on it). So each page states what it
// will contain, states plainly that it is not in force, and prints the list of
// facts it is waiting for. The empty-state frame is borrowed for exactly that
// meaning — skill tappa-brand: a dashed border says "nothing has been printed
// here", where the docket's solid one says "something happened".
//
// THE COOKIE NOTICE IS DIFFERENT AND IS BUILT DIFFERENTLY. Which cookies this
// product sets is a fact in the code, so that table is real content derived from
// the constants that write the cookies (internal/handler's cookieNotice). Only the
// legal framing around it is waiting.

// THE REDESIGN (M12-46, design "The Pass"): still a PUBLIC page, never a panel
// screen. Beside the document (below it on a tablet and a phone) a navigation lists
// the four documents, marks the one being read, and says which are not in force yet.
// That mark is read from what is published and from nothing about the visitor, so
// every visitor gets the same bytes and the public caching still holds.
//
// THE CHROME IS THE PUBLIC SITE'S (LP-11): PublicChrome, in its own roots so the
// document's utility classes keep their spacing, with Start free and the phone bar.
// Its footer marks the document being read in its Legal column, as the navigation
// beside the text does; no header entry is marked, none of them being this page.
//
// THE BODY SITS IN THE CHROME'S BOX (PublicBodyFrame, LP-14), as the Legal board draws it,
// so the navigation starts where the wordmark does. That box is 1100 px inside its padding
// on a wide desk, 52 px less than the 1152 the body had before, so from the desk width the
// navigation's column is at most 260 px, the board's own split (a 260 px list growing to
// 300 only once the text has its 820): the text is 800 px wide at 1440 (812 before; a
// 300 px list would leave it 760), and the cookie notice, whose table fills its column,
// grows 63 px there instead of 273 (measured in Chrome).

// Legal renders one document.
templ Legal(v LegalPageView) {
	@layout.Marketing(v.Page.Title+" — Taptime", v.Robots(), v.Share) {
		@PublicChrome(PublicChromeOpts{Current: v.Page.Path, SignInHref: v.SignInHref, SignupHref: v.SignupHref, OwnRoots: true}) {
			<div class={ PublicBodyFrame + " " + PublicBodyRing + " pb-12 pt-5 md:pb-14 md:pt-7 desk:pb-16 desk:pt-10" }>
				<div class="flex flex-col gap-6 desk:grid desk:grid-cols-[minmax(0,260px)_minmax(0,820px)] desk:items-start desk:gap-10">
					@legalNav(v)
					<article class="flex min-w-0 flex-col gap-7">
						<div class="flex flex-col gap-2.5">
							<p class="lbl">Legal<span class="desk:hidden">{ " · " + v.Page.Path }</span></p>
							<h1 class="font-display text-3xl font-bold leading-none tracking-tight md:text-4xl desk:text-[44px]">{ v.Page.Title }</h1>
							<p class="max-w-[620px] text-[15px] leading-normal text-ink md:text-[17px]">{ v.Page.Lede }</p>
						</div>
						if v.Published() {
							@legalBody(v)
						}
						if len(v.Cookies) > 0 {
							@legalCookieTable(v.Cookies)
						}
						if !v.Published() {
							@legalDraftNotice(v.Page)
						}
					</article>
				</div>
			</div>
		}
	}
}

// legalNav lists the four documents (LegalPages, the slice the routes and the footer
// come from). Two columns on a phone, one row on a tablet, a column beside the text
// from the desk width. The current document is marked with aria-current and a heavier
// frame; a document with no published text carries the words "Not in force yet" —
// the words carry it, the saffron frame only repeats them.
templ legalNav(v LegalPageView) {
	<nav aria-label="Legal documents" class="flex flex-col gap-2.5">
		<p class="lbl hidden desk:block">Legal</p>
		<ul class="grid grid-cols-2 gap-2 md:grid-cols-4 desk:flex desk:flex-col desk:gap-1.5">
			for _, p := range LegalPages {
				<li class="min-w-0">
					<a
						href={ templ.URL(p.Path) }
						class={ legalNavLinkClass(v.IsCurrent(p.Path)) }
						if v.IsCurrent(p.Path) {
							aria-current="page"
						}
					>
						<span class="font-display text-sm font-bold text-ink desk:hidden">{ p.NavLabel }</span>
						<span class="hidden font-display text-[15px] font-bold text-ink desk:inline">{ p.Title }</span>
						<span class="hidden font-mono text-[11px] text-ink/70 desk:block">{ p.Path }</span>
						if !v.SlugPublished(p.Path) {
							<span class="self-start rounded-md border border-dashed border-saffron bg-saffron/10 px-1.5 py-0.5 font-mono text-[10px] font-bold uppercase tracking-[0.1em] text-ink">Not in force yet</span>
						}
					</a>
				</li>
			}
		</ul>
	</nav>
}

func legalNavLinkClass(current bool) string {
	if current {
		return "flex h-full min-h-14 flex-col gap-1.5 rounded-[14px] border-2 border-ink bg-paper px-3 py-2.5 desk:px-4 desk:py-3.5"
	}
	return "flex h-full min-h-14 flex-col gap-1.5 rounded-[14px] border border-line px-3 py-2.5 hover:border-ink active:border-ink active:bg-paper desk:px-4 desk:py-3.5"
}

// legalBody is the PUBLISHED text (M7-06).
//
// 🔴 EVERY PARAGRAPH GOES THROUGH `{ }`, WHICH IS html.EscapeString. Nothing here
// reaches templ.Raw, and that is not a preference: this repo has zero call sites of
// it and none of the twelve tests that scan .templ files would notice a first one
// appearing (internal/handler/policies_test.go documents that blind spot about
// itself). So the ONE screen where a person pastes free text into a page a stranger
// loads is the one screen that must not be the exception. The paragraph split
// happens in Go, in internal/domain/legal.Paragraphs, and arrives here as strings.
//
// THE DATE IS SHOWN BECAUSE A LEGAL DOCUMENT WITH NO DATE CANNOT BE CITED. It is
// mono, which is this brand's rule for anything that is data rather than prose.
templ legalBody(v LegalPageView) {
	<section class="flex flex-col gap-6">
		<div class="flex max-w-[680px] flex-col gap-4 text-base leading-relaxed text-ink/85">
			for _, p := range v.Body {
				<p>{ p }</p>
			}
		</div>
		if v.PublishedAt != "" {
			<p class="border-t border-line pt-4 text-xs text-ink/70">
				Published <span class="font-mono">{ v.PublishedAt }</span>.
			</p>
		}
	</section>
}

// legalDraftNotice is the visible "this is not in force yet" block.
//
// IT IS SAFFRON because the brand's status mapping puts a warning there and this is
// one; the word carries the meaning and the colour only repeats it, which is the
// accessibility rule the whole product follows. The list of needed facts is
// rendered rather than hidden in a planning document: a reader who is entitled to
// this document deserves to see what it is waiting on, and so does whoever has to
// supply it. The numbers in front of the facts are their places in the list,
// counted here, never typed.
templ legalDraftNotice(p LegalPage) {
	<section class="flex flex-col gap-3 rounded-[14px] border-2 border-dashed border-saffron bg-saffron-lite px-4 py-4 md:rounded-2xl md:px-6 md:py-[22px]">
		<h2 class="font-display text-lg font-bold tracking-tight md:text-xl">This text has not been published yet</h2>
		<p class="text-sm leading-normal text-ink">
			Nothing on this page is in force. It is a placeholder so the document has an
			address before it has a text, and it will be replaced with the real one — no
			part of it should be relied on in the meantime.
		</p>
		<p class="mt-1 font-mono text-[11px] uppercase tracking-[0.12em] text-ink">Waiting on</p>
		<ol class="flex flex-col gap-2">
			for i, n := range p.Needs {
				<li class="grid grid-cols-[26px_1fr] gap-1.5 text-sm leading-normal text-ink md:grid-cols-[30px_1fr] md:gap-2">
					<span class="font-mono font-bold" aria-hidden="true">{ legalNeedNo(i) }</span>
					<span>{ n }</span>
				</li>
			}
		</ol>
	</section>
}

// legalNeedNo is a fact's place in the draft's list, two digits.
func legalNeedNo(i int) string {
	if i+1 < 10 {
		return "0" + strconv.Itoa(i+1)
	}
	return strconv.Itoa(i + 1)
}

// legalCookieTable is the REAL half of the cookie notice.
//
// 🔴 EVERY ROW COMES FROM THE CODE THAT WRITES THE COOKIE, not from prose. The
// names are the constants themselves and the rest is read off the same files;
// internal/handler's TestCookieNotice_ListsExactlyTheCookiesTheProductSets derives
// the set from source and fails if the product grows a cookie this table does not
// mention. A disclosure obligation kept by hand is a disclosure obligation that
// goes stale on the next feature.
//
// Every value is set in the data typeface, which is the brand's rule for anything
// that is data rather than prose.
//
// BELOW THE DESK WIDTH IT FOLLOWS THE DRAFT NOTICE (the board's order there: what
// is not in force first, then the table); from the desk width it comes first.
//
// ONE LIST, TWO SHAPES (M12-46, as the screen file asks): a table from the tablet
// width up and a card per cookie on a phone, where five columns cannot be read. The
// attributes are printed once under the table when every row shares them (AllFlags)
// and per row otherwise.
templ legalCookieTable(rows []CookieRow) {
	<section class="order-2 flex flex-col gap-3 desk:order-none">
		<h2 class="font-display text-[21px] font-bold tracking-tight md:text-2xl">The cookies Taptime sets</h2>
		<p class="max-w-[640px] text-sm leading-normal text-ink">
			All of them are necessary to sign in and to record a shift. There is no
			advertising cookie, no analytics cookie and nothing embedded from another site —
			every stylesheet, typeface and script this product loads is served from this
			domain, so no third party is contacted by opening a page.
		</p>
		<div class="hidden overflow-x-auto rounded-2xl border border-line bg-paper md:block">
			<table class="w-full min-w-[42rem] text-left text-sm">
				<caption class="sr-only">Cookie name, purpose, lifetime, scope and attributes</caption>
				<thead>
					<tr class="border-b border-line">
						<th scope="col" class="px-4 py-3 docket-label">Name</th>
						<th scope="col" class="px-4 py-3 docket-label">What it is for</th>
						<th scope="col" class="px-4 py-3 docket-label">Lifetime</th>
						<th scope="col" class="px-4 py-3 docket-label">Sent to</th>
						if AllFlags(rows) == "" {
							<th scope="col" class="px-4 py-3 docket-label">Attributes</th>
						}
					</tr>
				</thead>
				<tbody>
					for _, c := range rows {
						<tr class="border-b border-dashed border-line last:border-b-0">
							<th scope="row" class="whitespace-nowrap px-4 py-3 align-top font-mono font-bold text-ink">{ c.Name }</th>
							<td class="px-4 py-3 align-top leading-normal text-ink">{ c.Purpose }</td>
							<td class="px-4 py-3 align-top font-mono text-ink">{ c.Lifetime }</td>
							<td class="whitespace-nowrap px-4 py-3 align-top font-mono text-ink">{ c.Scope }</td>
							if AllFlags(rows) == "" {
								<td class="px-4 py-3 align-top font-mono text-ink">{ c.Flags }</td>
							}
						</tr>
					}
				</tbody>
			</table>
		</div>
		<ul class="flex flex-col gap-2.5 md:hidden">
			for _, c := range rows {
				<li class="flex flex-col gap-2 rounded-[14px] border border-line bg-paper p-3.5">
					<p class="break-all font-mono text-sm font-bold text-ink">{ c.Name }</p>
					<p class="text-[13px] leading-normal text-ink">{ c.Purpose }</p>
					<dl class="grid grid-cols-[auto_1fr] gap-x-3 gap-y-1 border-t border-dashed border-line pt-2 font-mono text-xs">
						<dt class="text-ink/70">Lifetime</dt>
						<dd class="text-ink">{ c.Lifetime }</dd>
						<dt class="text-ink/70">Sent to</dt>
						<dd class="text-ink">{ c.Scope }</dd>
						if AllFlags(rows) == "" {
							<dt class="text-ink/70">Attributes</dt>
							<dd class="text-ink">{ c.Flags }</dd>
						}
					</dl>
				</li>
			}
		</ul>
		<p class="text-xs leading-normal text-ink/70">
			if f := AllFlags(rows); f != "" {
				Every cookie is <span class="font-mono">{ f }</span>.
			}
			Secure is set whenever Taptime is served over https, which is every deployment that
			is not a developer's own machine. HttpOnly means no page script can read the value.
		</p>
	</section>
}
