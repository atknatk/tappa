package pages

import "github.com/atknatk/tappa/web/templates/components"

// The REPORTS section (M6-07 phase A) — worked hours, week by week.
//
// 🔴 IT RENDERS PanelShell, NOT PanelShellWithScript. This section loads no script:
// changing week is a link, and there is nothing to append. That keeps the panel's
// widened Content-Security-Policy on exactly ONE url, which is the cardinality
// TestPanelScreens_ScriptsAndPolicyAgreeAndReachNoThirdParty pins.
//
// 🔴 §4.3 — THIS IS A READ. There is no form that posts, no button that closes an
// open entry and no control that edits a total. transactions is immutable; the
// correction a manager makes to an unclosed check-in is a NEW record plus audit_log
// and belongs to M6-08. The view model has no field a form target could travel in.
//
// 🔴 §4.6 — EVERY QUANTITY THIS PAGE EXCLUDES FROM THE PAYROLL FIGURE IS PRINTED
// SOMEWHERE ON IT. Hours awaiting a decision, hours a manager refused, entries nobody
// closed, training taps, shifts that began before the week and records with nobody on
// them: none of them is in the total, and every one of them has its own line. A total
// that quietly differed from the transactions list would be a total nobody could check.
//
// ⚠️ THE HEADING USED TO SAY "EVERY NUMBER THE REPORT HOLDS BACK", WHICH IS WIDER THAN
// THE LIST UNDER IT. reject and ignored records are not on this page at all -- and they
// are not "held back" either: migration 0005 gives them no direction, so they pair into
// no interval and there are no HOURS to withhold. Where they ARE counted is the
// transactions section, which lists every record the day holds. The claim here is about
// hours, so it now says so.
//
// 🔴 §4.6 — AND THE EMPTY STATE IS GATED ON HAVING ASKED. "Nobody worked this week"
// is a claim about a business; v.Queried is set only after the database answered, and
// a failed read renders a problem page in the handler rather than an empty week here.
//
// skill tappa-brand governs the surface: the kitchen docket is the record motif, every
// number is IBM Plex Mono, the status-to-colour mapping is the fixed one (a decision
// still waiting is saffron, a refusal is tomato, a manager-typed row is the neutral
// `line`), and no meaning is carried by colour alone — every chip says its own word.
templ AdminReports(v ReportsView) {
	@PanelActions(reportActions(v)) {
		@PanelShell(v.PanelChrome) {
			if v.Incomplete {
				// 🔴 THE ONE SENTENCE THIS SECTION MUST NEVER SOFTEN. A truncated read makes
				// every figure below a floor rather than a total, and a floor printed like a
				// total is how a payroll comes out short with nothing to show for it.
				@components.PanelNotice(components.ToneAlert, "These totals are incomplete") {
					<p>
						This week holds more records than one report reads at once, so the hours
						below are a floor and not a total. Nothing has been lost — every record is
						still on The Pass.
					</p>
				}
			}
			@templ.Join(businessDayRelease(v.Release), reportWeekForm(v))
			if v.Queried {
				// THE RECEIPT FIRST IN THE DOCUMENT, at every width: a phone reads the week's
				// figure before the people it is made of. From the desk up the receipt is
				// placed in the right-hand column and the people in the left, by the grid's
				// placement rather than by a second copy of either.
				<div class="flex flex-col gap-6 desk:grid desk:grid-cols-[minmax(0,1fr)_minmax(280px,320px)] desk:items-start desk:gap-7">
					@reportReceipt(v)
					<div class="flex min-w-0 flex-col gap-6 desk:col-start-1 desk:row-start-1">
						@reportPeople(v)
						@reportVenues(v)
						@templ.Join(reportOpen(v), reportPartners(v))
					</div>
				</div>
			}
		}
	}
}

// reportActions are the heading's controls: the week stepper, the way back to this week,
// and the export.
//
// THE STEPPER IS TWO LINKS AND A LABEL, so every week is an address -- bookmarkable,
// shareable, and working with no script. The arrows are drawing; each link carries its
// own name for a screen reader.
//
// THE EXPORT SITS WITH THE WEEK CONTROLS because that is what it is: one more thing you do
// to the week you are looking at. Its href names the week on the screen (ExportHref).
templ reportActions(v ReportsView) {
	<div role="group" aria-label="Week" class="inline-flex items-center justify-between rounded-xl border border-line bg-paper max-md:w-full">
		<a class="inline-flex min-h-11 w-11 items-center justify-center rounded-xl text-ink hover:bg-ink/5 focus:outline-none focus-visible:ring-2 focus-visible:ring-ink" href={ templ.URL(v.PrevHref) } aria-label="Previous week">
			<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M15 6l-6 6 6 6"></path></svg>
		</a>
		<span class="px-1.5 font-mono text-[13px] text-ink">{ v.WeekShort }</span>
		<a class="inline-flex min-h-11 w-11 items-center justify-center rounded-xl text-ink hover:bg-ink/5 focus:outline-none focus-visible:ring-2 focus-visible:ring-ink" href={ templ.URL(v.NextHref) } aria-label="Next week">
			<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M9 6l6 6-6 6"></path></svg>
		</a>
	</div>
	// Offered even on the current week: after paging several weeks away it is the way back.
	<a class="inline-flex min-h-11 items-center px-2 font-display text-sm font-bold text-ink underline underline-offset-4 focus:outline-none focus-visible:ring-2 focus-visible:ring-ink" href={ templ.URL(v.ThisWeekHref) }>This week</a>
	<a class="btn btn--line gap-2" href={ templ.URL(v.ExportHref) } download>
		<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 4v11M7 10l5 5 5-5M5 20h14"></path></svg>
		CSV for the accountant
	</a>
}

// reportWeekForm is the way to a week the arrows would take long to reach: any day inside
// it. A PLAIN GET FORM WITH NO SCRIPT, for the reasons the stepper gives. A manager thinking
// "the week Maria was ill" knows a day, not a Monday, which is why the label says so.
templ reportWeekForm(v ReportsView) {
	<div class="flex flex-col gap-3 md:flex-row md:flex-wrap md:items-end md:justify-between">
		<form class="flex items-end gap-2" method="get" action={ templ.URL(v.ThisWeekHref) } aria-label="Choose a week">
			<div class="field-stack w-44">
				<label class="lbl" for="report-week">Week containing</label>
				<input class="field-input field-input--mono" id="report-week" type="date" name="week" value={ v.WeekValue }/>
			</div>
			<button class="btn btn--line" type="submit">Show</button>
		</form>
		// 🔴 THE SENTENCE THE CAPS ON THIS PAGE ARE JUSTIFIED BY. Both listings below stop
		// at a hundred rows and each says so where it stops; this says what the answer is,
		// once, next to the control that gives it.
		<p class="font-mono text-xs leading-normal text-ink/70 md:max-w-md">
			The CSV holds every person and every open check-in — the lists below are
			shortened, the file is not.
		</p>
	</div>
}

// reportReceipt is the week on one receipt: the payroll figure, and everything that is
// deliberately not in it (§4.6). It is a docket -- the same perforated paper, sharp
// corners -- and every line it carries is printed at every width: the phone does not get a
// shorter receipt.
//
// ONE COLUMN ON A PHONE AND ON THE DESK, TWO ON A TABLET (the figures beside the open box),
// by the same markup.
templ reportReceipt(v ReportsView) {
	<aside aria-label="Week total" class="min-w-0 py-2 desk:col-start-2 desk:row-start-1">
		<div class="docket flex flex-col gap-3.5 px-[18px] pb-5 pt-[18px] md:grid md:grid-cols-[1.1fr_1fr] md:items-start md:gap-[22px] md:px-[22px] desk:flex desk:flex-col desk:gap-3.5 desk:px-6 desk:pb-[26px] desk:pt-6">
			<div class="flex flex-col gap-2.5 desk:gap-3.5">
				<div class="flex flex-col items-center gap-0.5 text-center md:flex-row md:flex-wrap md:items-baseline md:justify-between md:gap-2 md:text-left desk:flex-col desk:items-center desk:gap-0.5 desk:text-center">
					if v.TenantName != "" {
						<p class="font-display text-lg font-bold tracking-tight text-ink">{ v.TenantName }</p>
					}
					// THE ZONE IS ON THE RECEIPT because it decides where the days begin: a week
					// bounded by the wrong midnight is a different week.
					<p class="lbl">Week { itoa(v.WeekNumber) } · { v.WeekLabel } · { v.ZoneLabel }</p>
				</div>
				<dl class="flex flex-col gap-1.5 border-t border-dashed border-line pt-2.5 text-[13px] text-ink">
					@receiptLine("People with hours", itoa(v.PeopleTotal))
					@receiptLine("Worked shifts", itoa(v.Totals.Shifts))
					// 🔴 TRI-STATE (§4.6): a roster read that did not answer is said in words,
					// never as 0; one that was never asked claims nothing. Shifts that could
					// not be compared with a home venue are their own line, so an unjudged
					// week never reads as "nobody worked elsewhere".
					if v.HomesFailed {
						@receiptLine("At another venue", "could not be read")
					} else if v.HomesQueried {
						@receiptLine("At another venue", itoa(v.Totals.OtherVenue))
						if v.Totals.OtherVenueUnknown > 0 {
							@receiptLine("Not compared with a home venue", itoa(v.Totals.OtherVenueUnknown))
						}
					}
					@receiptLine("Arrivals typed by a manager", itoa(v.Totals.ManualArrivals))
					@receiptLine("Approved on The Spike", itoa(v.Totals.Approved))
					@receiptLine("Open check-ins, not counted", itoa(v.Totals.Open))
					// M15-06: the checkout-side twin of the line above (ADR 0032 §A.6's (b) and (c)).
					@receiptLine("Checkouts with no open check-in", itoa(v.Totals.OutWithoutIn))
					@receiptLine("Waiting for a decision", v.Totals.AwaitingFigure)
					@receiptLine("A manager refused", v.Totals.RefusedFigure)
				</dl>
				<div class="flex items-baseline justify-between gap-2 border-t border-dashed border-line pt-2.5 text-ink">
					<p class="text-[13px] font-bold">TOTAL<span class="sr-only">, hours worked this week</span></p>
					<p class="text-3xl font-bold tracking-tight md:text-[26px] desk:text-3xl">{ v.Totals.Worked }</p>
				</div>
			</div>
			<div class="flex flex-col gap-2.5">
				if v.Totals.Open > 0 || v.Totals.OutWithoutIn > 0 {
					// "NOT CLOSED YET." rather than "Incomplete.": that word belongs to the
					// truncation notice above, which is a different fault.
					//
					// 🔴 TWO CAUSES, ONE SENTENCE (M15-06). A check-in with no checkout and a
					// checkout with no open check-in to close are the two halves of a shift the
					// report cannot pair, and each leaves the total short in the same way, so the
					// box is drawn for either and names the ones present (shortHeading and the two
					// lines below). Drawn for open check-ins alone it said nothing on a week whose
					// only gap was a missing check-in -- measured by the M15-06 review.
					<div class="flex flex-col gap-1 rounded-[10px] border border-dashed border-saffron bg-saffron/10 px-3 py-2.5 font-display text-[13px] leading-normal text-ink">
						<p class="font-bold">{ shortHeading(v.Totals.Open, v.Totals.OutWithoutIn) }</p>
						if v.Totals.Open > 0 {
							<p>{ openCount(v.Totals.Open) } with no checkout.</p>
						}
						if v.Totals.OutWithoutIn > 0 {
							<p>{ checkoutCount(v.Totals.OutWithoutIn) } with no open check-in to close.</p>
						}
						// 🔴 THE SENTENCE Q18 REQUIRES, AND IT SAYS "SHORT" RATHER THAN IMPLYING
						// IT. Counting an unclosed entry as zero hours would silently under-pay
						// somebody; saying nothing about it would do the same thing more quietly.
						<p>
							The figure above is SHORT by whatever these add up to. Nothing here is
							counted as zero hours — it is simply not counted, and it stays visible
							until somebody deals with it.
						</p>
						<a class="inline-flex min-h-11 items-center gap-1 font-bold underline underline-offset-4 focus:outline-none focus-visible:ring-2 focus-visible:ring-ink" href={ templ.URL(v.AnomaliesHref) }>{ shortLink(v.Totals.Open, v.Totals.OutWithoutIn) } <span aria-hidden="true">→</span></a>
						if len(v.Open) > 0 {
							<a class="inline-flex min-h-11 items-center gap-1 font-bold underline underline-offset-4 focus:outline-none focus-visible:ring-2 focus-visible:ring-ink" href="#open">See the open list <span aria-hidden="true">↓</span></a>
						}
					</div>
				} else if v.Totals.Awaiting != "" || v.Totals.Refused != "" {
					<p class="font-display text-xs leading-normal text-ink">
						The figure above is SHORT by whatever these add up to. Nothing here is
						counted as zero hours — it is simply not counted, and it stays visible
						until somebody deals with it.
					</p>
				}
				<div class="flex flex-col gap-1.5 font-display text-xs leading-normal text-ink/70">
					// 🔴 THE ATTRIBUTION RULE IS ON THE SCREEN, because the alternative reading
					// gives different daily columns for the same week and a reader cannot tell
					// which one they are looking at. §5's overnight shift is the case that makes
					// the two differ.
					<p>
						{ shiftCount(v.Totals.Shifts) } across { peopleCount(v.PeopleTotal) }. A shift
						counts on the day it STARTED, so an overnight shift belongs to the evening it
						began.
					</p>
					if v.PracticeTaps > 0 {
						<p>{ trainingCount(v.PracticeTaps) }.</p>
					}
					if v.StartedEarlier > 0 {
						<p>{ startedEarlierLine(v.StartedEarlier) }</p>
					}
					if v.Totals.TooLong > 0 {
						<p>{ tooLongLine(v.Totals.TooLong) }</p>
					}
					if v.Totals.OutWithoutIn > 0 {
						<p>{ outWithoutInLine(v.Totals.OutWithoutIn) }</p>
					}
					if v.Unattributable > 0 {
						<p>{ unattributableLine(v.Unattributable) }</p>
					}
				</div>
				<p class="text-center font-mono text-[11px] tracking-[0.1em] text-ink/70" aria-hidden="true">— PUNCHLESS · TAPTIME —</p>
			</div>
		</div>
	</aside>
}

// receiptLine is one figure on the receipt: the words, then the number, on one line.
templ receiptLine(label, value string) {
	<div class="flex justify-between gap-2">
		<dt>{ label }</dt>
		<dd class="whitespace-nowrap text-right">{ value }</dd>
	</div>
}

// reportPeople is The Roll itself: one row per person, seven days and the week's total.
//
// ONE MARKUP AT EVERY WIDTH (screen file 3.3). From the tablet up the rows are a scrolling
// sheet inside their card; on a phone the same rows reflow into cards, the header row is
// kept for a screen reader only, and every cell carries the day's name. Nothing is printed
// twice.
//
// skill tappa-brand's "Yapma" list refuses a plain row for a RECORD; a row here is a
// person's week, summed from records, and the records themselves stay dockets (the open
// list below, The Pass).
templ reportPeople(v ReportsView) {
	if len(v.People) > 0 {
		if v.PeopleShown < v.PeopleTotal {
			@components.PanelNotice(components.ToneWarn, "Not everybody is listed") {
				<p>
					{ shownOfLine(v.PeopleShown, v.PeopleTotal) } The totals above cover
					everybody; only this list is shortened. Download the CSV for every row.
				</p>
			}
		}
		<section aria-label="Hours by person" class="min-w-0 rounded-[18px] border border-line bg-paper max-md:rounded-none max-md:border-0 max-md:bg-transparent">
			<div class="overflow-x-auto pb-1 pt-2 max-md:overflow-visible max-md:p-0">
				<table class="roll-table">
					<thead class="max-md:sr-only">
						<tr>
							<th scope="col" class="lbl py-3 pl-5 pr-2 text-left font-normal">Person</th>
							for _, h := range v.DayHeadings {
								<th scope="col" class="lbl whitespace-nowrap px-0.5 py-3 text-center font-normal tracking-[0.06em]">{ h }</th>
							}
							<th scope="col" class="lbl py-3 pl-2 pr-5 text-right font-normal">Total</th>
						</tr>
					</thead>
					<tbody class="roll-body">
						for _, p := range v.People {
							<tr class="roll-row">
								<th scope="row" class="roll-who">
									<span class="roll-name">{ p.Name }</span>
									if rollSub(p) != "" {
										<span class="roll-sub">{ rollSub(p) }</span>
									}
									@reportTallies(p)
								</th>
								for i := range v.DayHeadings {
									<td class="roll-day">
										<span class="roll-letter" aria-hidden="true">{ dayLetter(v.DayLetters, i) }</span>
										@rollCell(dayCell(p.Daily, i), markAt(p.Marks, i))
									</td>
								}
								<td class="roll-sum">{ p.Worked }<span class="roll-shifts">{ shiftCount(p.Shifts) }</span></td>
							</tr>
						}
					</tbody>
				</table>
			</div>
			@rollLegend(v)
		</section>
	} else if v.Queried {
		@components.PanelEmpty(SectionLabel(TabReports), "No hours were recorded this week", components.PanelEmptyCTA{}) {
			// 🔴 "NO HOURS WERE RECORDED" IS NOT "NOBODY WORKED". §5 row 3 sends
			// somebody with no session to the activation page and writes NO RECORD AT
			// ALL, so a week in which every plaque was touched by new starters produces
			// exactly this page. Stating their absence would be reporting on something
			// never measured.
			<p>Nothing in this week pairs into a worked shift. Pick another week above.</p>
		}
	}
}

// reportTallies are the qualifiers under a person's name, each a word and not a bare count:
// late arrivals, arrivals with no yardstick, hours held out of the total, typed arrivals,
// check-ins nobody closed.
templ reportTallies(p ReportRowView) {
	if p.Late != "" || p.Unmeasured != "" || p.Awaiting != "" || p.Refused != "" || p.Manual != "" || p.Open != "" || p.InMissing != "" {
		<span class="mt-1.5 flex flex-wrap gap-1">
			if p.Late != "" {
				<span class="tally tally--queued roll-qual">{ p.Late }</span>
			}
			if p.Unmeasured != "" {
				<span class="tally tally--manual roll-qual">{ p.Unmeasured }</span>
			}
			if p.Awaiting != "" {
				<span class="tally tally--queued roll-qual">{ p.Awaiting } waiting</span>
			}
			if p.Refused != "" {
				<span class="tally tally--rejected roll-qual">{ p.Refused } refused</span>
			}
			if p.Manual != "" {
				<span class="tally tally--manual roll-qual">{ p.Manual }</span>
			}
			if p.Open != "" {
				<span class="tally tally--queued roll-qual">{ p.Open }</span>
			}
			if p.InMissing != "" {
				<span class="tally tally--queued roll-qual">{ p.InMissing }</span>
			}
		</span>
	}
}

// rollCell is one day of one person. The state is said in words to a screen reader in every
// cell, and the colour only repeats it: the dash, "open" and the letter M are drawing for
// the eye and the hidden words are the meaning.
templ rollCell(hours string, m ReportMarkView) {
	<span class={ rollCellClass(hasHours(hours), m) }>
		if hasHours(hours) {
			{ hours }
		} else if m.Open {
			open
		} else {
			<span aria-hidden="true">—</span>
		}
		if m.Manual {
			<span class="roll-mark" aria-hidden="true">M</span>
		}
		<span class="sr-only">{ rollCellWords(hasHours(hours), m) }</span>
	</span>
}

// rollLegend says what each look of a cell means, in words beside the swatches.
//
// 🔴 THE M IS A CHECK-IN A MANAGER TYPED, AND THE LEGEND SAYS THAT AND NOTHING WIDER: a typed
// checkout does not set it (ledger.DayMarks.Manual), so "manual entry" would claim more
// than the mark counts.
templ rollLegend(v ReportsView) {
	<div class="flex flex-col gap-2 border-t border-line px-5 py-3 font-mono text-xs text-ink/70 max-md:border-0 max-md:px-0">
		<p class="flex flex-wrap gap-x-[18px] gap-y-2">
			<span class="inline-flex items-center gap-1.5"><span class="inline-block size-3 rounded-[3px] bg-tappa-green/15" aria-hidden="true"></span>worked</span>
			<span class="inline-flex items-center gap-1.5"><span class="inline-block size-3 rounded-[3px] ring-1 ring-inset ring-ink" aria-hidden="true"></span>at a venue other than their home venue</span>
			<span class="inline-flex items-center gap-1.5"><span class="inline-block size-3 rounded-[3px] border border-dashed border-saffron bg-saffron/10" aria-hidden="true"></span>open check-in, not counted</span>
			<span class="inline-flex items-center gap-1.5"><span class="rounded-[3px] border border-ink/70 px-1 text-[10px] font-bold" aria-hidden="true">M</span>check-in typed by a manager</span>
			<span class="inline-flex items-center gap-1.5"><span aria-hidden="true">—</span>no hours counted</span>
		</p>
		if v.HomesFailed {
			// §4.6: the marks are absent because the read failed, not because nobody worked
			// away from home -- and the page says which.
			<p>The home venues could not be read this time, so no day is marked as another venue.</p>
		}
	</div>
}

// reportVenues is the same week split by where the shifts STARTED: somebody who taps in at
// one venue and out at another worked the shift they started, and §5 treats moving down the
// chain as ordinary rather than suspicious.
templ reportVenues(v ReportsView) {
	if len(v.Venues) > 0 {
		<section aria-labelledby="roll-venues" class="flex flex-col gap-2.5">
			<h2 id="roll-venues" class="font-display text-lg font-bold tracking-tight text-ink md:text-xl">Per venue</h2>
			<ul class="grid grid-cols-1 overflow-hidden rounded-[18px] border border-line bg-paper md:grid-cols-2">
				for _, l := range v.Venues {
					<li class="-mb-px flex items-baseline justify-between gap-2.5 border-b border-dashed border-line px-[18px] py-3">
						<span class="flex min-w-0 flex-col gap-0.5">
							<span class="font-display text-sm font-bold text-ink">{ l.Name }</span>
							<span class="font-mono text-[11px] text-ink/70">{ shiftCount(l.Shifts) } started here</span>
						</span>
						<span class="whitespace-nowrap font-mono text-sm font-bold text-ink">{ l.Worked }</span>
					</li>
				}
			</ul>
		</section>
	}
}

// reportOpen is the "needs action" list Q18 requires. Each entry is a record, so each is a
// docket.
templ reportOpen(v ReportsView) {
	if len(v.Open) > 0 {
		<section id="open" aria-labelledby="roll-open" class="flex flex-col gap-2.5">
			<h2 id="roll-open" class="font-display text-lg font-bold tracking-tight text-ink md:text-xl">Open — no checkout</h2>
			// 🔴 THE TWO SENTENCES THIS LIST OWES ITS READER. The first is the Q18 rule:
			// the system does not invent a checkout. The second is the limit the M6-07 card
			// insists on — the row cannot say WHY it is open, so the screen does not guess.
			<p class="text-sm leading-normal text-ink">
				Taptime does not invent a checkout. These check-ins are in none of the totals
				above, and a manager enters the missing record.
			</p>
			<p class="text-[13px] leading-normal text-ink/70">
				A row cannot say why it is open. Somebody still on shift and somebody who
				forgot to tap out look the same here; how long it has been open is all this
				list measures.
			</p>
			// MONO, BECAUSE IT IS A COUNT. It is the one thing the list CAN say about the
			// whole backlog, and it covers every entry rather than the page: the handler
			// tallies it before the listing is shortened.
			if needsActionLine(v.Totals.NeedsAction, v.Totals.Open) != "" {
				<p class="font-mono text-[13px] text-ink">
					{ needsActionLine(v.Totals.NeedsAction, v.Totals.Open) }
				</p>
			}
			if v.OpenShown < v.OpenTotal {
				@components.PanelNotice(components.ToneWarn, "Not every open check-in is listed") {
					<p>
						{ shownOfOpenLine(v.OpenShown, v.OpenTotal) } The count above is the whole
						of it; only this list is shortened. Download the CSV for every row.
					</p>
				}
			}
			<div class="flex flex-col gap-3">
				for _, o := range v.Open {
					<section class="docket">
						<div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
							<div class="flex min-w-0 flex-col gap-0.5">
								<p class="font-display text-[15px] font-bold text-ink">{ o.Who }</p>
								<p class="lbl">{ o.Venue }</p>
							</div>
							<div class="flex flex-wrap items-center gap-2">
								<p class="font-mono text-[13px] text-ink">{ o.At }</p>
								if o.NeedsAction {
									<span class="tally tally--rejected pill-tally">Needs action</span>
								} else {
									<span class="tally tally--queued pill-tally">Still open</span>
								}
								if o.Manual {
									<span class="tally tally--manual pill-tally">Entered by a manager</span>
								}
							</div>
						</div>
					</section>
				}
			</div>
		</section>
	}
}

// dayCell prints one day's figure, guarding the index rather than trusting that the
// headings and the row have the same length. They come from the same Period today;
// an out-of-range read would panic mid-render and lose the whole page.
func dayCell(daily []string, i int) string {
	if i < 0 || i >= len(daily) {
		return "—"
	}
	return daily[i]
}

// dayLetter is the day's name above a cell on a phone; "" past the headings, since the
// cell's own words already say what it holds.
func dayLetter(letters []string, i int) string {
	if i < 0 || i >= len(letters) {
		return ""
	}
	return letters[i]
}

// markAt is dayCell's twin for the marks: an index the marks do not reach is a day with
// no mark, never a panic mid-render.
func markAt(marks []ReportMarkView, i int) ReportMarkView {
	if i < 0 || i >= len(marks) {
		return ReportMarkView{}
	}
	return marks[i]
}

// hasHours says whether a day's figure is hours rather than the absence of them. The
// handler writes a dash for a day with none; an empty string is the same absence.
func hasHours(s string) bool {
	return s != "" && s != "—"
}

// rollCellClass picks a day cell's look. Every name is written out whole here, so the
// stylesheet's scan finds it. A day with hours AND an open check-in takes the open look
// (screen file R11): the hours are real, and the open entry beside them is what needs a
// manager.
func rollCellClass(worked bool, m ReportMarkView) string {
	c := "roll-cell"
	switch {
	case m.Open:
		c += " roll-cell--open"
	case worked:
		c += " roll-cell--worked"
	default:
		c += " roll-cell--none"
	}
	if m.Other {
		c += " roll-cell--other"
	}
	if m.Manual {
		c += " roll-cell--manual"
	}
	return c
}

// rollCellWords is what a screen reader hears after the cell's figure: the state the look
// carries, in words. Every cell has some. (The template puts the space before them.)
func rollCellWords(worked bool, m ReportMarkView) string {
	var w string
	switch {
	case worked:
		w = "worked"
		if m.Open {
			w += ", and an open check-in, not counted"
		}
	case m.Open:
		w = "check-in with no checkout, not counted"
	default:
		w = "no hours counted"
	}
	if m.Other {
		w += ", at another venue"
	}
	if m.Manual {
		w += ", check-in typed by a manager"
	}
	if m.InMissing {
		// Words only: the person's row says it on the page (the tally under the name), and a
		// cell look of its own would be a new legend entry for a mark the tally already carries.
		w += ", a checkout with no open check-in"
	}
	return w
}

// rollSub is the line under a person's name: title and home venue, each omitted when the
// roster has none.
func rollSub(p ReportRowView) string {
	switch {
	case p.Role != "" && p.HomeVenue != "":
		return p.Role + " · " + p.HomeVenue
	case p.Role != "":
		return p.Role
	default:
		return p.HomeVenue
	}
}

// The count helpers below exist because "1 shifts" is the kind of thing a reader
// stops trusting a report over. They are here rather than in the handler for the same
// reason emptyRosterHeading is: the sentence is a property of the template.
func shiftCount(n int) string {
	if n == 1 {
		return "1 shift"
	}
	return itoa(n) + " shifts"
}

func peopleCount(n int) string {
	if n == 1 {
		return "1 person"
	}
	return itoa(n) + " people"
}

// needsActionLine is what the open list says about the WHOLE backlog rather than about
// the hundred rows under it.
//
// 🔴 IT EXISTS BECAUSE THE FIELD DID NOT HAVE A READER, and the handler's loop was
// justified by one: it refuses to break early "or the count beside the list would be a
// count of the page" -- and there was no count beside the list. An unread field is the
// exact thing db/queries/transactions.sql refuses in its own column list ("NOTHING IS
// SELECTED THAT HAS NO READER"), so it is fixed in the direction that keeps the
// sentence true.
//
// IT NAMES NO THRESHOLD. The number of hours is internal/domain/tap's (StaleOpenIn) and
// repeating it here would be a second representation of it in prose -- and a manager
// does not need the figure, they need to know which rows are theirs to fix.
func needsActionLine(needsAction, open int) string {
	switch {
	case open == 0:
		return ""
	case needsAction == 0:
		// A MEASURED "none", which is a different sentence from silence: every entry
		// here is recent enough to be somebody still on shift.
		return "None of these has been open long enough to look like a missed checkout."
	case needsAction == 1:
		return "1 of these has been open too long to be somebody still on shift."
	default:
		return itoa(needsAction) + " of these have been open too long to be somebody still on shift."
	}
}

// shortHeading opens the box that says the total is short. "Not closed yet." is about a
// check-in, so a week whose only gap is a checkout with no open check-in to close gets its own
// words; with both, the check-in's heading stays and the two lines below say each.
func shortHeading(open, outWithoutIn int) string {
	switch {
	case open > 0:
		return "Not closed yet."
	case outWithoutIn == 1:
		return "A check-in is missing."
	default:
		return "Check-ins are missing."
	}
}

// shortLink names what the link to Odd shapes lands on: the open check-ins, the missing
// check-ins, or both lists. One link either way -- both lists are on the same page.
func shortLink(open, outWithoutIn int) string {
	switch {
	case open > 0 && outWithoutIn > 0:
		return "Open and missing check-ins on Odd shapes"
	case outWithoutIn > 0:
		return "Missing check-ins on Odd shapes"
	default:
		return "Open check-ins on Odd shapes"
	}
}

func checkoutCount(n int) string {
	if n == 1 {
		return "1 checkout"
	}
	return itoa(n) + " checkouts"
}

func openCount(n int) string {
	if n == 1 {
		return "1 check-in"
	}
	return itoa(n) + " check-ins"
}

func trainingCount(n int) string {
	if n == 1 {
		return "1 training tap, not counted"
	}
	return itoa(n) + " training taps, not counted"
}

func shownOfLine(shown, total int) string {
	return "Showing " + itoa(shown) + " of " + itoa(total) + " people, by name."
}

// shownOfOpenLine is its twin for the open list, ordered oldest first -- which is the
// order a manager works a backlog in, so the shortened list keeps the entries that
// have been waiting longest rather than an arbitrary hundred.
func shownOfOpenLine(shown, total int) string {
	return "Showing the " + itoa(shown) + " oldest of " + itoa(total) + " open check-ins."
}

// startedEarlierLine names the seam between two reports rather than leaving a reader
// to wonder why the transactions list holds a checkout this week has no hours for.
func startedEarlierLine(n int) string {
	if n == 1 {
		return "1 checkout belongs to a shift that began before this week; its hours are in the previous report."
	}
	return itoa(n) + " checkouts belong to shifts that began before this week; their hours are in the previous report."
}

// tooLongLine explains the pairs the engine itself calls a probable forgotten
// checkout: they are listed as open rather than paid as very long shifts.
func tooLongLine(n int) string {
	if n == 1 {
		return "1 check-in was closed so much later that it is treated as a missed checkout rather than a shift; it is in the open list below."
	}
	return itoa(n) + " check-ins were closed so much later that they are treated as missed checkouts rather than shifts; they are in the open list below."
}

// outWithoutInLine explains the checkouts with no open check-in for them to close
// (ledger.Totals.OutWithoutIn, M15-06): nothing is guessed for them, and Odd shapes lists them.
func outWithoutInLine(n int) string {
	if n == 1 {
		return "1 checkout has no open check-in for it to close, so no hours are counted for the shift it ends; it is listed on Odd shapes under \"Check-in missing\"."
	}
	return itoa(n) + " checkouts have no open check-in for them to close, so no hours are counted for the shifts they end; they are listed on Odd shapes under \"Check-in missing\"."
}

// unattributableLine covers the record §4.6 requires to exist and no chain can hold:
// a direction with nobody on it.
func unattributableLine(n int) string {
	if n == 1 {
		return "1 record in this week names no employee, so no hours could be attributed to anybody. It is still on The Pass."
	}
	return itoa(n) + " records in this week name no employee, so no hours could be attributed to anybody. They are still on The Pass."
}

// reportPartners is JOINED to reportOpen (templ.Join) rather than called as a sibling: a sibling
// call writes a separator into every page, a business in no holding included (measured: one byte
// against the page before M11 API-1c). Empty, it renders nothing, so that page is byte-identical.
//
// reportPartners lists the week's records of a PARTNER business's staff at this business's
// venues (M11 API-1c, ADR 0027 §9). Rendered only when there is one, so a business in no holding
// sees this section exactly as before.
//
// 🔴 NO HOURS, ON PURPOSE: the record is the employer's, and so are its hours. This business sees
// only the taps on its own plaques -- never the chain between them -- so a total here would count
// time nobody worked. The records a partner's manager typed by hand are listed apart and counted
// in nothing (K-1a: they carry no physical evidence and cannot be disputed here).
templ reportPartners(v ReportsView) {
	if len(v.Partners) > 0 || len(v.PartnerManual) > 0 {
		<h2 class="font-display text-lg font-bold tracking-tight text-ink">Partner staff at your venues</h2>
		<p class="text-sm text-ink/85">
			Staff of another business in your group tapped your plaques. The records and the
			hours are their employer&#39;s; they are in none of the totals above.
		</p>
		if v.PartnersMore {
			@components.Notice(components.ToneWarn, "Not every record is listed") {
				<p>This week holds more partner-staff records than one page lists.</p>
			}
		}
		<div class="flex flex-col gap-4">
			for _, p := range v.Partners {
				@reportPartnerDocket(p)
			}
		</div>
		if len(v.PartnerManual) > 0 {
			<h3 class="font-display text-base font-bold tracking-tight text-ink">Entered by their employer</h3>
			<p class="text-sm text-ink/85">
				Their manager typed these for one of your venues. They carry no tap, and they
				are counted in nothing here.
			</p>
			<div class="flex flex-col gap-4">
				for _, p := range v.PartnerManual {
					@reportPartnerDocket(p)
				}
			</div>
		}
	}
}

templ reportPartnerDocket(p ReportPartnerView) {
	<section class="docket">
		<div class="report-head">
			<p class="report-who">{ p.Who }</p>
			<p class="report-day">{ p.At }</p>
		</div>
		<p class="docket-label mt-1">
			{ p.Venue }
			if p.Employer != "" {
				· { p.Employer }
			}
			if p.Ref != "" {
				· { p.Ref }
			}
		</p>
		<div class="mt-2 flex flex-wrap items-center gap-2">
			if p.Direction != "" {
				<span class="font-mono text-sm uppercase tracking-widest text-ink">{ p.Direction }</span>
			}
			<span class={ "tally", p.Tally }>{ p.Outcome }</span>
			<span class="font-mono text-xs text-ink/70">Hours: at their employer</span>
		</div>
	</section>
}
