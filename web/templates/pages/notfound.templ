package pages

import "github.com/atknatk/tappa/web/templates/layout"

// THE PUBLIC SITE'S 404 (LP-12, user decision K4): the shared chrome, one sentence and
// a way back to the home page. No board draws it; it is the chrome around the public
// pages' own opening, in the same classes.
//
// THE SAME BYTES FOR EVERY PATH AND EVERY VISITOR. The page does not print the address
// that was asked for: a reflected path is an injection surface and a line a crawler
// copies into its index. It takes nothing but the chrome's two ways in.
//
// NOT INDEXED. A search engine that kept it would list an address that has no page.
//
// Which requests get it, and which keep the router's plain answer, is
// internal/handler's decision (notfound.go) and ADR 0034's.

// NotFoundView is what the 404 page needs: the chrome's two ways in.
type NotFoundView struct {
	SignInHref string
	SignupHref string
}

// NotFoundTitle is the page's title.
const NotFoundTitle = "Page not found — Taptime"

// NotFoundSentence is the page's one sentence. It says what the status code says and
// nothing about the product, so it rests on no fact but the response itself.
const NotFoundSentence = "There is no page at this address."

// NotFoundHomeLabel is the words of the one way on.
const NotFoundHomeLabel = "Back to the home page"

// NotFound is the page the public site answers an unknown address with.
templ NotFound(v NotFoundView) {
	@layout.Marketing(NotFoundTitle, layout.RobotsPrivate, layout.Share{}) {
		<div class="lp">
			@PublicChrome(PublicChromeOpts{SignInHref: v.SignInHref, SignupHref: v.SignupHref}) {
				<div class="band band--porcelain">
					<section class="lp-pageHead" aria-labelledby="notfound-title">
						<div class="lp-wrap">
							<p class="lp-eyebrow lp-pageEyebrow">404</p>
							<h1 id="notfound-title" class="lp-h1">{ NotFoundSentence }</h1>
							<a class="lp-button lp-button--green" href="/">{ NotFoundHomeLabel }</a>
						</div>
					</section>
				</div>
			}
		</div>
	}
}
