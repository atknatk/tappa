package pages

import (
	"strconv"

	"github.com/atknatk/tappa/web/templates/components"
)

// The API KEYS section (M11 API-3, ADR 0028 §3) -- the owner's integration keys.
//
// 🔴 THE RAW KEY IS DRAWN ON ONE RESPONSE ONLY: the answer to "create". Every other render has
// v.NewKey empty and the list shows each key's hint -- its prefix and four characters -- which is
// not the key and cannot be turned into it.
//
// 🔴 IT LOADS NO SCRIPT. Copying the key is the browser's own selection; every act is a form post
// on the panel's write chain (the Origin check before the resolver, owner-only in the handler and
// again in the domain).
//
// skill tappa-brand: every stored value is IBM Plex Mono, status is a WORD (Live, Revoked) and
// never a colour alone, notices carry their meaning in the heading.
templ AdminAPIKeys(v APIKeysView) {
	@PanelShell(v.PanelChrome) {
		if v.Problem != "" {
			@components.Notice(components.ToneAlert, "That did not happen") {
				<p>{ v.Problem }</p>
			}
		}
		if v.Done != "" {
			@components.Notice(components.ToneOK, "Done") {
				<p>{ v.Done }</p>
			}
		}
		if v.NewKey != "" {
			@apiKeyShownOnce(v)
		}
		if len(v.BudgetAlerts) > 0 {
			@apiKeyBudgetAlerts(v)
		}
		if v.Webhook.NewKey != "" {
			@webhookKeyShownOnce(v.Webhook)
		}
		@apiKeysIntro(v)
		if v.Available && !v.ListFailed {
			if v.APIEnabled {
				@apiKeyCreateForm(v)
			}
			@apiKeysList(v)
		}
		if !v.ListFailed {
			@webhookSection(v.Webhook)
		}
	}
}

// apiKeyShownOnce is the one place the raw key is ever printed.
templ apiKeyShownOnce(v APIKeysView) {
	@components.Notice(components.ToneOK, "Copy this key now — it is shown once") {
		<p>
			This is the key named <span class="font-mono">{ v.NewKeyName }</span>. Give it to your
			HR or payroll system now. Taptime keeps only a one-way check value of it, so it cannot be shown
			again: if it is lost, revoke it below and create another.
		</p>
		<label class="docket-label mt-3 block" for="api-key-new">Your new key</label>
		<input
			class="filter-input mt-1 w-full font-mono"
			id="api-key-new"
			type="text"
			readonly
			autocomplete="off"
			spellcheck="false"
			value={ v.NewKey }
		/>
	}
}

// apiKeyBudgetAlerts is the owner's alert of ADR 0028 §12 (K-25): a key that deactivated as many
// employees in an hour as the integration may was refused further deactivations. The owner reads
// which key and when, and what to do if the integration did not mean it. Status is the heading's
// word; the warning tone only reinforces it.
templ apiKeyBudgetAlerts(v APIKeysView) {
	@components.Notice(components.ToneWarn, "A key reached its limit for deactivating employees") {
		<p>
			An integration key may deactivate only so many employees in an hour. These keys reached
			that limit in the last day, and the deactivations past it were refused. If your HR or payroll
			system did not mean to remove that many people, revoke the key below and check the system.
		</p>
		<ul class="mt-2 text-sm">
			for _, a := range v.BudgetAlerts {
				<li>
					<span class="font-mono">{ a.KeyName }</span> — <span class="font-mono">{ a.At }</span>
					if a.Budget > 0 {
						— limit <span class="font-mono">{ strconv.Itoa(a.Budget) }</span> an hour
					}
				</li>
			}
		</ul>
	}
}

// apiKeysIntro says what a key is and, when the operator has not opened the API, why nothing can
// be created.
templ apiKeysIntro(v APIKeysView) {
	<section class="bg-paper border border-line px-4 py-4">
		<h2 class="font-display text-lg font-bold tracking-tight">Integration keys</h2>
		<p class="mt-2 max-w-2xl text-sm text-ink/85">
			A key lets your HR or payroll system keep your staff and venues in step with Taptime and
			collect your punches. Anybody holding a key can do that for this business, so give each
			system its own key and revoke one the moment it is no longer needed.
		</p>
		if !v.Available {
			<p class="mt-2 max-w-2xl text-sm text-ink/85">
				Integration keys are not available on this deployment.
			</p>
		} else if !v.APIEnabled && !v.ListFailed {
			@components.Notice(components.ToneWarn, "API access is off for this business") {
				<p>
					Taptime switches the integration API on for a business on request. Until then no
					key can be created, and any key listed below is refused. You can still revoke them.
				</p>
			}
		}
	</section>
}

templ apiKeyCreateForm(v APIKeysView) {
	<form method="post" action={ templ.URL(v.PostHref) } class="bg-paper border border-line px-4 py-4">
		<h2 class="font-display text-lg font-bold tracking-tight">Create a key</h2>
		<div class="mt-4 flex flex-col gap-1">
			<label class="docket-label" for="api-key-name">Name</label>
			<input
				class="filter-input"
				id="api-key-name"
				type="text"
				name="name"
				required
				maxlength={ itoa(v.NameMaxLength) }
				value={ v.NameValue }
				autocomplete="off"
				aria-describedby="api-key-name-help"
			/>
			<p class="text-xs text-ink/70" id="api-key-name-help">
				Which system will use it, for example "Payroll". Two live keys cannot share a name.
			</p>
			if v.NameError != "" {
				<p class="text-sm text-ink">{ v.NameError }</p>
			}
		</div>
		<div class="mt-4">
			<button class="btn btn--primary" type="submit">Create key</button>
		</div>
	</form>
}

templ apiKeysList(v APIKeysView) {
	<section class="bg-paper border border-line px-4 py-4">
		<h2 class="font-display text-lg font-bold tracking-tight">Keys</h2>
		if len(v.Keys) == 0 {
			<p class="mt-2 text-sm text-ink/85">No key has been created for this business.</p>
		} else {
			<ul class="mt-3 flex flex-col gap-3">
				for _, k := range v.Keys {
					<li class="docket">
						<div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
							<p class="font-display font-bold tracking-tight text-ink">{ k.Name }</p>
							if k.Live() {
								<p class="font-mono text-xs uppercase tracking-widest text-ink">Live</p>
							} else {
								<p class="font-mono text-xs uppercase tracking-widest text-ink/70">Revoked</p>
							}
						</div>
						<dl class="mt-2 grid grid-cols-1 gap-x-4 gap-y-1 sm:grid-cols-2">
							<div>
								<dt class="docket-label">Starts with</dt>
								<dd class="font-mono text-sm text-ink">{ k.PrefixHint }…</dd>
							</div>
							<div>
								<dt class="docket-label">Created</dt>
								<dd class="font-mono text-sm text-ink">{ k.CreatedOn }</dd>
							</div>
							<div>
								<dt class="docket-label">Last used</dt>
								<dd class="font-mono text-sm text-ink">{ k.LastUsed }</dd>
							</div>
							if !k.Live() {
								<div>
									<dt class="docket-label">Revoked</dt>
									<dd class="font-mono text-sm text-ink">{ k.RevokedOn }</dd>
								</div>
							}
						</dl>
						if k.Live() {
							<form method="post" action={ templ.URL(v.RevokeHref) } class="mt-3">
								<input type="hidden" name="key_id" value={ k.ID }/>
								<button class="btn btn--quiet" type="submit">Revoke</button>
							</form>
						}
					</li>
				}
			</ul>
			if v.AnyLive() {
				<form method="post" action={ templ.URL(v.RevokeAllHref) } class="mt-4 border-t border-line pt-4">
					<p class="max-w-2xl text-sm text-ink/85">
						If a key may have leaked and you do not know which, revoke them all. Every
						integration stops at once until you give it a new key.
					</p>
					<label class="mt-2 flex min-h-11 items-center gap-2 text-sm text-ink">
						<input type="checkbox" name="confirm" value="yes" required class="min-h-11 w-11 accent-tappa-green"/>
						Yes, stop every integration now
					</label>
					<button class="btn btn--quiet mt-2" type="submit">Revoke every key</button>
				</form>
			}
		}
	</section>
}

// ---------------------------------------------------------------- the webhook (M11 API-9) --
//
// 🔴 THE SIGNING KEY IS DRAWN ON TWO RESPONSES ONLY: the answers to "create the webhook" and
// "rotate its key". Every other render has NewKey empty; the endpoint's docket shows the address
// (the owner's own, on the owner's own page), its switch and its key's age -- never the key.
//
// 🔴 NO SCRIPT, like the rest of the section: every act is a form post on the panel's write chain.
// The test ping redirects back with its result, so a reload shows the result and sends nothing.
//
// skill tappa-brand: stored values in IBM Plex Mono, the switch is a WORD (On, Off), the result of a
// ping is a sentence in a Notice whose heading carries its meaning.

// webhookKeyShownOnce is the one place the signing key is ever printed.
templ webhookKeyShownOnce(w WebhookView) {
	@components.Notice(components.ToneOK, "Copy the webhook's signing key now — it is shown once") {
		<p>
			Your system uses this key to check that a webhook really comes from Taptime: every message
			carries an X-Taptime-Signature header, sha256= and the HMAC-SHA256 of the message body under
			this key. Taptime keeps it sealed and cannot show it again: if it is lost, rotate it below.
		</p>
		<label class="docket-label mt-3 block" for="webhook-key-new">Signing key</label>
		<input
			class="filter-input mt-1 w-full font-mono"
			id="webhook-key-new"
			type="text"
			readonly
			autocomplete="off"
			spellcheck="false"
			value={ w.NewKey }
		/>
	}
}

templ webhookSection(w WebhookView) {
	<section class="bg-paper border border-line px-4 py-4" id="webhook">
		<h2 class="font-display text-lg font-bold tracking-tight">Webhook</h2>
		<p class="mt-2 max-w-2xl text-sm text-ink/85">
			Taptime can send each punch to your HR or payroll system the moment it is recorded. Give the
			address your system receives webhooks at: one address for this business.
		</p>
		if !w.Configured {
			<p class="mt-2 max-w-2xl text-sm text-ink/85">The webhook is not configured on this deployment.</p>
		}
		if w.Configured {
			if !w.APIEnabled {
				@components.Notice(components.ToneWarn, "API access is off for this business") {
					<p>
						Taptime switches the integration API on for a business on request. Until then the
						webhook cannot be created, changed or tested, and nothing is sent to it. You can
						still switch it off.
					</p>
				}
			}
			if w.PingShown {
				if w.PingDelivered {
					@components.Notice(components.ToneOK, "The test message arrived") {
						<p>{ w.PingSentence }</p>
					}
				} else {
					@components.Notice(components.ToneAlert, "The test message did not arrive") {
						<p>{ w.PingSentence }</p>
					}
				}
			}
			if w.Exists {
				@webhookDocket(w)
			} else if w.APIEnabled {
				@webhookAddressForm(w, w.CreateHref, "Create webhook", "webhook-address-new")
			} else {
				<p class="mt-2 text-sm text-ink/85">This business has no webhook.</p>
			}
		}
	</section>
}

templ webhookDocket(w WebhookView) {
	<div class="docket mt-3">
		<div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
			<p class="font-display font-bold tracking-tight text-ink">This business's webhook</p>
			if w.Active {
				<p class="font-mono text-xs uppercase tracking-widest text-ink">On</p>
			} else {
				<p class="font-mono text-xs uppercase tracking-widest text-ink/70">Off</p>
			}
		</div>
		<dl class="mt-2 grid grid-cols-1 gap-x-4 gap-y-1">
			<div>
				<dt class="docket-label">Address</dt>
				if w.AddressRefused {
					<dd class="text-sm text-ink">The saved address no longer passes the address rules. Give a new one below.</dd>
				} else {
					<dd class="font-mono text-sm text-ink break-all">{ w.Address }</dd>
				}
			</div>
			<div>
				<dt class="docket-label">Created</dt>
				<dd class="font-mono text-sm text-ink">{ w.CreatedOn }</dd>
			</div>
			<div>
				<dt class="docket-label">Signing key</dt>
				if w.RotatedOn != "" {
					<dd class="font-mono text-sm text-ink">Rotated { w.RotatedOn }</dd>
				} else {
					<dd class="font-mono text-sm text-ink">Since it was created</dd>
				}
			</div>
			if w.APIEnabled {
				<div>
					<dt class="docket-label">Test messages this hour</dt>
					<dd class="font-mono text-sm text-ink">{ itoa(w.Spent) } of { itoa(w.Limit) }</dd>
				</div>
			}
		</dl>
		if w.APIEnabled {
			if w.Active {
				if w.BucketFull() {
					<p class="mt-3 text-sm text-ink">
						The hour's { itoa(w.Limit) } test messages are used. The next one is free at
						<span class="font-mono">{ w.NextSlot }</span>.
					</p>
				} else {
					<form method="post" action={ templ.URL(w.PingHref) } class="mt-3">
						<p class="max-w-2xl text-sm text-ink/85">
							Send a signed test message (event "ping") to the address and see what your system answers.
						</p>
						<button class="btn btn--primary mt-2" type="submit">Send a test message</button>
					</form>
				}
			}
			<div class="mt-4 border-t border-line pt-4">
				@webhookAddressForm(w, w.AddressHref, "Change address", "webhook-address-change")
			</div>
			<form method="post" action={ templ.URL(w.RotateHref) } class="mt-4 border-t border-line pt-4">
				<p class="max-w-2xl text-sm text-ink/85">
					If the signing key may have leaked, give the webhook a new one. Your system must switch to
					the new key: messages signed with the old one stop at once.
				</p>
				<label class="mt-2 flex min-h-11 items-center gap-2 text-sm text-ink">
					<input type="checkbox" name="confirm" value="yes" required class="min-h-11 w-11 accent-tappa-green"/>
					Yes, replace the signing key now
				</label>
				<button class="btn btn--quiet mt-2" type="submit">Rotate the signing key</button>
			</form>
		}
		if w.Active {
			<form method="post" action={ templ.URL(w.DisableHref) } class="mt-4 border-t border-line pt-4">
				<p class="max-w-2xl text-sm text-ink/85">
					Switching the webhook off stops every message to it at once. It can be switched on again.
				</p>
				<button class="btn btn--quiet mt-2" type="submit">Switch the webhook off</button>
			</form>
		} else if w.APIEnabled {
			<form method="post" action={ templ.URL(w.EnableHref) } class="mt-4 border-t border-line pt-4">
				<button class="btn btn--quiet" type="submit">Switch the webhook on</button>
			</form>
		}
	</div>
}

templ webhookAddressForm(w WebhookView, action, label, fieldID string) {
	<form method="post" action={ templ.URL(action) } class="mt-3">
		<div class="flex flex-col gap-1">
			<label class="docket-label" for={ fieldID }>Address</label>
			<input
				class="filter-input font-mono"
				id={ fieldID }
				type="url"
				name="address"
				required
				maxlength={ itoa(w.AddressMaxLength) }
				value={ w.AddressValue }
				placeholder="https://hooks.example.com/taptime"
				autocomplete="off"
				spellcheck="false"
				aria-describedby={ fieldID + "-help" }
			/>
			<p class="text-xs text-ink/70" id={ fieldID + "-help" }>
				https:// and a host name, on the standard port, with no user name, query string or fragment.
			</p>
			if w.AddressError != "" {
				<p class="text-sm text-ink">{ w.AddressError }</p>
			}
		</div>
		<div class="mt-3">
			<button class="btn btn--primary" type="submit">{ label }</button>
		</div>
	</form>
}
