package pages

import "strconv"

// AdminLiveQRCode is the answer to "Add a live QR screen" (M16-20): the code, how long it works,
// where to type it. It loads no script; the code is plain text the manager reads or copies.
//
// THE COMMENTS IN THIS FILE NAME NO CLASS: Tailwind reads them as source (skill tappa-brand).
templ AdminLiveQRCode(v LiveQRCodeView) {
	@PanelShell(v.PanelChrome) {
		<div class="panel-measure flex max-w-3xl flex-col gap-5">
			<section class="panel-card min-w-0" aria-labelledby="live-qr-code-h">
				<p class="lbl">Live QR screen · { v.VenueName }</p>
				<h2 id="live-qr-code-h" class="font-display text-lg font-bold tracking-tight text-ink">Type this code on the screen</h2>
				<div class="docket flex flex-col items-center gap-2 py-6">
					<p class="docket-label">Pairing code</p>
					<p class="select-all break-all text-center font-mono text-3xl font-bold tracking-widest text-ink md:text-4xl">{ v.Code }</p>
				</div>
				<ol class="flex list-decimal flex-col gap-1.5 pl-5 text-sm leading-snug text-ink">
					<li>On the tablet or TV, open <span class="break-all font-mono">{ v.ScreenURL }</span>.</li>
					<li>Type the code above and press “Pair this screen”.</li>
					<li>The screen shows a QR code that changes every 20 seconds. Staff scan it with their phone to tap in or out.</li>
				</ol>
				<p class="text-[13px] leading-snug text-ink/70">
					The code works once, for { strconv.Itoa(v.Minutes) } minutes, and this is the only time it is shown. If it runs out, add another screen.
				</p>
			</section>
			<a class="btn btn--line self-start" href={ templ.URL(v.BackHref) }>Back to { v.VenueName }</a>
		</div>
	}
}
