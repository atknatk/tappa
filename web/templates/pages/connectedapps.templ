package pages

import "github.com/atknatk/tappa/web/templates/components"

// THE CONNECTED APPS CARD (issue #37, ADR 0047 §12) -- under the Developers section, owner-only like
// it. An app connects from its own site (the owner presses "Connect Taptime" there and approves on
// Taptime's consent page); this card lists what is connected and ends a connection.
//
// 🔴 IT LOADS NO SCRIPT AND SHOWS NO SECRET. A connection has no value to print: its tokens are the
// app's, hashed here. Disconnect is one form post on the panel's write chain, open while the business
// is suspended (K-26: a write that narrows what the business exposes).
//
// skill tappa-brand: every stored value is IBM Plex Mono, a state is a WORD in a pill (Connected,
// Expired, Turned off by Taptime, Approver disabled), never a colour alone; the destructive button is
// the panel's danger button.
templ AdminConnectedApps(v ConnectedAppsView) {
	@PanelShell(v.PanelChrome) {
		<div class="panel-measure flex flex-col gap-5 md:gap-6">
			if v.Problem != "" {
				@components.PanelNotice(components.ToneAlert, "That did not happen") {
					<p>{ v.Problem }</p>
				}
			}
			if v.Done != "" {
				@components.PanelNotice(components.ToneOK, "") {
					<p>{ v.Done }</p>
				}
			}
			<section class="panel-card" aria-labelledby="connected-apps-title">
				<div class="flex flex-col gap-1.5">
					<h2 id="connected-apps-title" class="font-display text-[19px] font-bold leading-tight tracking-[-0.02em] text-ink md:text-xl desk:text-[22px]">Connected apps</h2>
					<p class="max-w-2xl text-sm leading-normal text-ink/70">
						Apps an owner of this business connected from the app&#39;s own site. Each one can do
						only what is listed under it, for this business alone. A connection belongs to the
						business, not to the person who approved it: it keeps working when they leave.
						Disconnect it here and the app is refused from its next request.
					</p>
					<p class="max-w-2xl text-sm leading-normal text-ink/70">
						<a class="hit-link font-bold text-ink underline underline-offset-4 hover:text-tappa-green" href={ templ.URL(v.KeysHref) }>Back to integration keys</a>
					</p>
				</div>
				if !v.Available {
					<p class="max-w-2xl text-sm text-ink/70">Connected apps are not available on this deployment.</p>
				} else {
					if v.IntegrationsOff {
						@components.PanelNotice(components.ToneWarn, "Integrations are turned off for this business by Taptime") {
							<p>
								Every connected app is refused until Taptime turns them on again. The connections
								stay listed, and you can still disconnect them.
							</p>
						}
					}
					if len(v.Apps) == 0 {
						<p class="text-sm text-ink/70">No app is connected to this business.</p>
					} else {
						<ul class="flex flex-col">
							for _, a := range v.Apps {
								@connectedAppRow(v, a)
							}
						</ul>
					}
				}
			</section>
		</div>
	}
}

// connectedAppRow is one connection: the app, its state, its scopes, when and by whom, its last use,
// and the Disconnect button (its accessible name carries the app's name).
templ connectedAppRow(v ConnectedAppsView, a ConnectedAppRow) {
	<li class="flex flex-col gap-3 border-t border-dashed border-line py-3 md:flex-row md:items-start md:justify-between">
		<div class="flex min-w-0 flex-col gap-1">
			<p class="flex flex-wrap items-center gap-2">
				<span class="break-words font-display text-[15px] font-bold text-ink">{ a.AppName }</span>
				switch  {
					case a.AppDisabled:
						<span class="mono-pill border-line text-ink/70">Turned off by Taptime</span>
					case a.Expired:
						<span class="mono-pill border-line text-ink/70">Expired</span>
					default:
						<span class="mono-pill border-tappa-green bg-tappa-green/10">Connected</span>
				}
			</p>
			if a.AppDisabled {
				<p class="text-sm text-ink/70">This app was turned off by Taptime. It cannot reach this business.</p>
			} else if a.Expired {
				<p class="text-sm text-ink/70">Expired — reconnect from the app.</p>
			}
			<ul class="flex flex-col text-sm text-ink" aria-label="What it can do">
				for _, s := range a.Scopes {
					<li>{ s }</li>
				}
			</ul>
			<p class="flex flex-wrap items-center gap-2 font-mono text-xs text-ink/70">
				<span>Connected { a.ConnectedOn }</span>
				if a.ApprovedBy != "" {
					<span class="break-words">by { a.ApprovedBy }</span>
				}
				if a.ApproverDisabled {
					<span class="mono-pill border-line">Approver disabled</span>
				}
			</p>
			<p class="font-mono text-xs text-ink/70">Last used { a.LastUsed }</p>
		</div>
		<form method="post" action={ templ.URL(components.Bound(ctx, v.DisconnectHref)) } class="flex-none">
			<input type="hidden" name="grant_id" value={ a.GrantID }/>
			<button class="btn btn--danger w-full md:w-auto" type="submit">Disconnect<span class="sr-only">{ " " + a.AppName }</span></button>
		</form>
	</li>
}
