<?xml version="1.0" encoding="utf-8"?>
<!--
  The staff app's permissions are a closed list (M16-11, CLAUDE.md §4.2): NFC, INTERNET, and
  the two location permissions a one-shot, foreground, at-the-tap reading needs (Android 12+
  asks for the coarse one next to the fine one). Nothing else: no background or service
  location, no camera, nothing a library brings in. MergedManifestTest reads the MERGED
  manifest, every library's included, and fails on any other permission.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Ordinary NFC permission, not a runtime one. -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Runtime permissions, asked for at the tap only (M16-13), never at start. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- M16-46/47: the "Still at work?" reminder and the lock-screen timer are LOCAL notifications.
         Android 13+ asks for this when a switch is turned on in Settings, never at the tap. No exact
         alarm, no boot receiver, no foreground service. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      M16-11 review B-3, decided by M16-13: the location permissions make Google Play treat
      android.hardware.location as a REQUIRED feature (aapt2 dump badging: uses-implied-feature),
      which hides the app from a phone without one. Location is backup evidence and never a
      requirement (CLAUDE.md §5 rows 6-7: an IP match alone is enough, a tap without a fix is
      recorded), so the feature is declared optional. NFC is not required either (ADR 0045: an
      NFC-less phone installs the app for Faz D's QR path).
    -->
    <uses-feature android:name="android.hardware.location" android:required="false" />

    <!--
      androidx.core declares and requests an app-private signature permission
      (<applicationId>.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION) for ContextCompat's
      not-exported receivers on API < 33. This app registers no receiver AT RUNTIME, so the
      pair is removed by name (measured in the merged manifest, README.md). Its one receiver
      (StaffReceiver, M16-46) is declared in this manifest, not exported; a manifest receiver is
      not registered through ContextCompat, so the removal stands.
    -->
    <permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />
    <uses-permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />

    <!--
      allowBackup=false: no cloud backup. On Android 12+ that flag alone still lets
      device-to-device transfer copy the app's data, so dataExtractionRules excludes every
      domain from both. The device key is non-exportable anyway (M16-12); the rest of the app
      data must not travel either (card M16-11).
      usesCleartextTraffic=false: HTTPS only, said explicitly (M16-12; MergedManifestTest).
    -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.Taptime"
        tools:targetApi="31">

        <!--
          configChanges: Compose redraws for a rotation, a resize or a theme change without the
          activity being rebuilt, so the pending activation (invite code, server challenge) stays
          in memory and never goes into a saved-state Bundle (M16-12, MainActivity).
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|fontScale|uiMode|locale|layoutDirection"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
              THE PLAQUE (M16-13, ADR 0045 §2.1: same plaque, same URL). An NFC read of the plaque's
              URI record: https://<host>/t?tag=..&ctr=..&cmac=.., is dispatched here; with the
              app installed, Android's tag dispatch prefers an app's NDEF_DISCOVERED filter to the
              browser (to be measured on a real phone, M16-14). The path is exactly /t: the
              activation link (/activate) is not the app's (Q40).
            -->
            <intent-filter>
                <action android:name="android.nfc.action.NDEF_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="https" android:host="${plaqueHost}" android:path="/t" />
            </intent-filter>
            <!--
              The same URL opened as a link (the plaque's printed QR, <host>/t?tag=<UID>, scanned by
              the camera; a link in a message): an App Link, verified against
              /.well-known/assetlinks.json (M16-08).
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="${plaqueHost}" android:path="/t" />
            </intent-filter>
            <!--
              A VENUE SCREEN'S LIVE QR (M16-22, ADR 0045 §2.5; Q36 (c)): the system camera reads the
              screen's rotating code, https://<host>/q?t=<token>, and this App Link opens the app with
              it. There is no QR reader in the app and no camera permission. Verified against the
              same /.well-known/assetlinks.json (Android verifies the host; the path is this filter's).
              A filter of its own, VIEW only: a QR is never an NFC read.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="${plaqueHost}" android:path="/q" />
            </intent-filter>
        </activity>

        <!--
          M16-46/47: the reminder's alarm and the timer's swipe, reached only by this app's own
          immutable PendingIntents.
        -->
        <receiver
            android:name=".staff.StaffReceiver"
            android:exported="false" />

        <!--
          The home-screen widget (2026-11-24). Exported because the launcher's host delivers
          APPWIDGET_UPDATE; it filters that one action and only redraws from the app's own stored
          state: it reads nothing from the broadcast and makes no request.
        -->
        <receiver
            android:name=".staff.PresenceWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/taptime_widget_info" />
        </receiver>

        <!--
          emoji2's EmojiCompatInitializer (through Compose ui) asks the system font provider,
          on most phones Google Play services, for a downloadable emoji font at start, and that
          provider may fetch it from Google: an unasked-for Google dependency (ADR 0045 §2.2,
          review finding B-2). Its startup entry is removed by name; the other initialisers
          (lifecycle process, profileinstaller) stay. MergedManifestTest pins the removal.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                tools:node="remove" />
        </provider>
    </application>
</manifest>
