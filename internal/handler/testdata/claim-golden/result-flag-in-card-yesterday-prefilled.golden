status: 200
content-security-policy: default-src 'none'; script-src 'self'; style-src 'self'; font-src 'self'; form-action 'self'; base-uri 'none'; frame-ancestors 'none'
---
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"><meta name="robots" content="noindex, nofollow"><meta name="referrer" content="no-referrer"><title>Tapped — Taptime</title><link rel="stylesheet" href="/static/css/app.css"></head><body class="min-h-screen bg-porcelain text-ink antialiased"><main class="mx-auto flex w-full max-w-md flex-col gap-6 px-4 py-8"><header class="flex items-baseline justify-between"><span class="font-display text-lg font-bold tracking-tight text-tappa-green">taptime</span> <span class="font-mono text-[10px] uppercase tracking-widest text-ink/70">punchless</span></header><section class="docket"><div class="flex items-start justify-between gap-4"><div><p class="docket-label">St Julians</p><h1 class="font-display text-3xl font-bold tracking-tight text-ink">Clocked in <span class="block font-mono text-xl font-normal text-ink/70">14:03:22</span></h1></div><span class="stamp stamp--flagged">FLAGGED</span></div><dl class="mt-3 grid grid-cols-2 gap-x-4 gap-y-1"><dt class="docket-label">Trust</dt><dd class="font-mono">100</dd></dl><p class="mt-2 text-ink/70">network proof of place: the source IP matches the location</p></section><form method="post" action="/api/claim" class="flex flex-col gap-3 rounded-[18px] border border-line bg-paper p-4" data-claim-card><input type="hidden" name="ctx" value="{{TAP-CONTEXT}}"> <p class="text-ink">Yesterday you clocked in at 09:12 but there&#39;s no clock-out.</p><label for="claim-at" class="font-display text-lg font-bold tracking-tight text-ink">What time did you leave?</label> <input id="claim-at" type="time" name="at" value="17:00" required class="min-h-11 w-full rounded-[10px] border border-line bg-paper px-3 font-mono text-lg text-ink"> <button type="submit" class="min-h-11 w-full rounded-xl bg-tappa-green px-4 font-display text-lg font-bold tracking-tight text-paper focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2">Send to my manager</button><p class="text-sm text-ink/70">You can skip this.</p></form> <p class="mt-4 text-ink/70">Recorded — it needs your manager's approval before it counts toward your hours. Tell them if that looks wrong.</p> <p class="mt-2 text-ink/70">You can close this page.</p></main></body></html>