ass="tab-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 7h10M18 7h2M4 17h4M12 17h8"></path> <circle cx="16" cy="7" r="2"></circle> <circle cx="10" cy="17" r="2"></circle></svg><span class="tab-no" aria-hidden="true">07</span> <span class="tab-label">Rules</span> <span class="tab-short">Rules</span></a></div><div class="side-group side-group--foot"><a href="/admin/account" class="tab-link"><svg class="tab-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 21V8l8-5 8 5v13"></path> <path d="M9 21v-6h6v6"></path></svg><span class="tab-no" aria-hidden="true">··</span> <span class="tab-label">Account</span> <span class="tab-short">Account</span></a></div></nav><div class="side-foot"><p class="side-who"><span class="side-who-label">Signed in as</span> <span class="side-who-name"></span> <span class="side-who-role"></span></p><form method="post" action="/admin/logout"><button type="submit" class="btn btn--quiet side-signout">Sign out</button></form></div></div><main class="panel-main"><div class="panel-well"> <form class="filter-bar" method="get" action="/admin/reports" aria-label="Choose a week"><div class="filter-field"><label class="docket-label" for="report-week">Week containing</label> <input class="filter-input" id="report-week" type="date" name="week" value="2026-09-07"></div><div class="filter-actions"><button class="btn btn--primary" type="submit">Show</button> <a class="btn btn--quiet" href="/admin/reports?week=2026-09-06">Previous week</a> <a class="btn btn--quiet" href="/admin/reports?week=2026-09-14">Next week</a> <a class="btn btn--quiet" href="/admin/reports">This week</a><a class="btn btn--quiet" href="/admin/reports.csv?week=2026-09-07" download>Download CSV</a></div></form><p class="font-mono text-xs text-ink/85">The CSV holds every person and every open check-in — the lists below are shortened, the file is not.</p>    <p class="font-mono text-sm text-ink/85">Mon 7 – Sun 13 September 2026 <span class="text-ink/70">· Europe/Malta</span></p><section class="docket"><p class="docket-label">Hours worked this week</p><p class="font-mono text-3xl font-bold tracking-tight text-ink">8h 00m</p><p class="mt-1 text-xs text-ink/85">1 shift across 1 person.A shift counts on the day it STARTED, so an overnight shift belongs to the evening it began.</p><div class="mt-3 flex flex-wrap gap-2"></div></section> <h2 class="font-display text-lg font-bold tracking-tight text-ink">Per person</h2> <div class="flex flex-col gap-4"><section class="docket"><div class="report-head"><p class="report-who">Maria Borg</p><p class="report-total">8h 00m</p></div><p class="docket-label mt-1">1 shift</p><dl class="report-days"><div><dt class="docket-label">Mon 7</dt><dd class="report-day">—</dd></div><div><dt class="docket-label">Tue 8</dt><dd class="report-day">—</dd></div><div><dt class="docket-label">Wed 9</dt><dd class="report-day">—</dd></div><div><dt class="docket-label">Thu 10</dt><dd class="report-day">—</dd></div><div><dt class="docket-label">Fri 11</dt><dd class="report-day">—</dd></div><div><dt class="docket-label">Sat 12</dt><dd class="report-day">—</dd></div><div><dt class="docket-label">Sun 13</dt><dd class="report-day">—</dd></div></dl></section></div> <h2 class="font-display text-lg font-bold tracking-tight text-ink">Per venue</h2><div class="flex flex-col gap-4"><section class="docket"><div class="report-head"><p class="report-who">St Julians</p><p class="report-total">8h 00m</p></div><p class="docket-label mt-1">1 shift started here</p></section></div> </div></main><nav class="bar" aria-label="Panel sections, phone"><a href="/admin" class="bar-link"><span class="bar-pill"><svg class="nav-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 5h18"></path> <path d="M7.5 5v3M17.5 5v3"></path> <rect x="5" y="8" width="5" height="9" rx="1"></rect> <rect x="15" y="8" width="5" height="11" rx="1"></rect></svg></span> <span>Pass</span></a> <a href="/admin/review" class="bar-link"><span class="bar-pill"><svg class="nav-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 3v18"></path> <path d="M7 21h10"></path> <rect x="6" y="9" width="12" height="7" rx="1"></rect></svg></span> <span>Spike</span><span class="tab-count" aria-label="the number waiting for review could not be read">?</span></a> <a href="/admin/reports" class="bar-link"><span class="bar-pill"><svg class="nav-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 3h12v18l-2-1.5L14 21l-2-1.5L10 21l-2-1.5L6 21z"></path> <path d="M9 8h6M9 12h6"></path></svg></span> <span>Roll</span></a> <a href="/admin/employees" class="bar-link"><span class="bar-pill"><svg class="nav-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="9" cy="8" r="3.5"></circle> <path d="M2.5 20c.8-3.6 3.4-5.5 6.5-5.5s5.7 1.9 6.5 5.5"></path> <path d="M16 4.5a3.5 3.5 0 0 1 0 7M18 14.8c1.8.7 3 2.4 3.5 5.2"></path></svg></span> <span>People</span></a> <details class="bar-more"><summary class="bar-link"><span class="bar-pill"><svg class="nav-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="5" cy="12" r="1.6"></circle> <circle cx="12" cy="12" r="1.6"></circle> <circle cx="19" cy="12" r="1.6"></circle></svg></span> <span>More</span></summary><div class="bar-sheet"><ul class="sheet-list"><li><a href="/admin/locations" class="sheet-link"><svg class="nav-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z"></path> <circle cx="12" cy="9.5" r="2.5"></circle></svg><span>Venues &amp; plaques</span></a></li><li><a href="/admin/anomalies" class="sheet-link"><svg class="nav-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="6" cy="17" r="2"></circle> <circle cx="12" cy="10" r="2"></circle> <circle cx="18" cy="15" r="2"></circle> <path d="M15 3.5l5 5M20 3.5l-5 5"></path></svg><span>Odd shapes</span></a></li><li><a href="/admin/policies" class="sheet-link"><svg class="nav-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 7h10M18 7h2M4 17h4M12 17h8"></path> <circle cx="16" cy="7" r="2"></circle> <circle cx="10" cy="17" r="2"></circle></svg><span>Rules</span></a></li><li><a href="/admin/account" class="sheet-link"><svg class="nav-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 21V8l8-5 8 5v13"></path> <path d="M9 21v-6h6v6"></path></svg><span>Account</span></a></li></ul><div class="sheet-foot"><p class="text-sm text-ink/70">Signed in as <strong class="font-bold text-ink"></strong> · <span class="font-mono uppercase tr