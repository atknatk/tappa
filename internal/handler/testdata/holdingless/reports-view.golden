<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"><meta name="robots" content="noindex, nofollow"><meta name="referrer" content="no-referrer"><title>Panel — Taptime</title><link rel="stylesheet" href="/static/css/app.css"></head><body class="min-h-screen bg-porcelain text-ink antialiased"><div class="panel-frame"><div class="panel-side"><header class="side-head"><div class="side-lockup"><span class="side-mark" aria-hidden="true">t.</span><div class="side-words"><span class="side-word">taptime</span> <span class="side-tag">punchless</span></div></div></header><nav class="side-nav" aria-label="Panel sections"><div class="side-group"><a href="/admin" class="tab-link"><svg class="tab-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 5h18"></path> <path d="M7.5 5v3M17.5 5v3"></path> <rect x="5" y="8" width="5" height="9" rx="1"></rect> <rect x="15" y="8" width="5" height="11" rx="1"></rect></svg><span class="tab-no" aria-hidden="true">01</span> <span class="tab-label">The Pass</span> <span class="tab-short">Pass</span></a><a href="/admin/review" class="tab-link"><svg class="tab-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 3v18"></path> <path d="M7 21h10"></path> <rect x="6" y="9" width="12" height="7" rx="1"></rect></svg><span class="tab-no" aria-hidden="true">02</span> <span class="tab-label">The Spike</span> <span class="tab-short">Spike</span><span class="tab-count" aria-label="the number waiting for review could not be read">?</span></a><a href="/admin/employees" class="tab-link"><svg class="tab-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor