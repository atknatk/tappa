<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"><meta name="robots" content="noindex, nofollow"><meta name="referrer" content="no-referrer"><title>Panel — Taptime</title><link rel="stylesheet" href="/static/css/app.css"></head><body class="min-h-screen bg-porcelain text-ink antialiased"><div class="panel-frame"><div class="panel-side"><header class="side-head"><div class="side-lockup"><span class="side-mark" aria-hidden="true">t.</span><div class="side-words"><span class="side-word">taptime</span> <span class="side-tag">punchless</span></div></div></header><nav class="side-nav" aria-label="Panel sections"><div class="side-group"><a href="/admin" class="tab-link"><svg class="tab-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 5h18"></path> <path d="M7.5 5v3M17.5 5v3"></path> <rect x="5" y="8" width="5" height="9" rx="1"></rect> <rect x="15" y="8" width="5" height="11" rx="1"></rect></svg><span class="tab-no" aria-hidden="true">01</span> <span class="tab-label">The Pass</span> <span class="tab-short">Pass</span></a><a href="/admin/review" class="tab-link"><svg class="tab-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 3v18"></path> <path d="M7 21h10"></path> <rect x="6" y="9" width="12" height="7" rx="1"></rect></svg><span class="tab-no" aria-hidden="true">02</span> <span class="tab-label">The Spike</span> <span class="tab-short">Spike</span><span class="tab-count" aria-label="the number waiting for review could not be read">?</span></a><a href="/admin/employees" class="tab-link"><svg class="tab-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="9" cy="8" r="3.5"></circle> <path d="M2.5 20c.8-3.6 3.4-5.5 6.5-5.5s5.7 1.9 6.5 5.5"></path> <path d="M16 4.5a3.5 3.5 0 0 1 0 7M18 14.8c1.8.7 3 2.4 3.5 5.2"></path></svg><span class="tab-no" aria-hidden="true">03</span> <span class="tab-label">People</span> <span class="tab-short">People</span></a><a href="/admin/locations" class="tab-link"><svg class="tab-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z"></path> <circle cx="12" cy="9.5" r="2.5"></circle></svg><span class="tab-no" aria-hidden="true">04</span> <span class="tab-label">Venues &amp; plaques</span> <span class="tab-short">Venues</span></a><a href="/admin/reports" class="tab-link"><svg class="tab-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 3h12v18l-2-1.5L14 21l-2-1.5L10 21l-2-1.5L6 21z"></path> <path d="M9 8h6M9 12h6"></path></svg><span class="tab-no" aria-hidden="true">05</span> <span class="tab-label">The Roll</span> <span class="tab-short">Roll</span></a><a href="/admin/anomalies" class="tab-link"><svg class="tab-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="6" cy="17" r="2"></circle> <circle cx="12" cy="10" r="2"></circle> <circle cx="18" cy="15" r="2"></circle> <path d="M15 3.5l5 5M20 3.5l-5 5"></path></svg><span class="tab-no" aria-hidden="true">06</span> <span class="tab-label">Odd shapes</span> <span class="tab-short">Odd</span></a><a href="/admin/policies" class="tab-link"><svg class="tab-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 7h10M18 7h2M4 17h4M12 17h8"></path> <circle cx="16" cy="7" r="2"></circle> <circle cx="10" cy="17" r="2"></circle></svg><span class="tab-no" aria-hidden="true">07</span> <span class="tab-label">Rules</span> <span class="tab-short">Rules</span></a></div><div class="side-group side-group--foot"><a href="/admin/account" class="tab-link"><svg class="tab-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 21V8l8-5 8 5v13"></path> <path d="M9 21v-6h6v6"></path></svg><span class="tab-no" aria-hidden="true">··</span> <span class="tab-label">Account</span> <span class="tab-short">Account</span></a></div></nav><div class="side-foot"><p class="side-who"><span class="side-who-label">Signed in as</span> <span class="side-who-name"></span> <span class="side-who-role"></span></p><form method="post" action="/admin/logout"><button type="submit" class="btn btn--quiet side-signout">Sign out</button></form></div></div><main class="panel-main"><div class="panel-well"><div class="panel-head"><div class="panel-head-row"><div class="panel-head-text"><p class="lbl">Week 37 · 7 – 13 Sep · nothing here decides anything</p></div><div class="panel-actions"><div role="group" aria-label="Week" class="inline-flex items-center rounded-xl border border-line bg-paper"><a class="inline-flex min-h-11 w-11 items-center justify-center text-ink" href="/admin/anomalies?week=2026-09-06" aria-label="Previous week"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M15 6l-6 6 6 6"></path></svg></a> <span class="px-1.5 font-mono text-[13px] text-ink">7 – 13 Sep</span> <a class="inline-flex min-h-11 w-11 items-center justify-center text-ink" href="/admin/anomalies?week=2026-09-14" aria-label="Next week"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M9 6l6 6-6 6"></path></svg></a></div></div></div></div><form class="flex flex-wrap items-end justify-between gap-x-4 gap-y-2.5" method="get" action="/admin/anomalies" aria-label="Choose a week"><p class="font-mono text-[13px] text-ink/80">Mon 7 – Sun 13 September 2026 <span class="text-ink/70">· Europe/Malta</span></p><div class="flex w-full flex-wrap items-end gap-2 md:w-auto"><label class="lbl self-center" for="anomaly-week">Week containing</label> <input class="field-input field-input--mono min-w-0 flex-[1_1_140px] md:w-44 md:flex-none" id="anomaly-week" type="date" name="week" value="2026-09-07"> <button class="btn btn--primary rounded-xl" type="submit">Show</button> <a class="btn btn--line" href="/admin/anomalies">This week</a></div></form> <section class="docket flex flex-col gap-2 px-4 pt-[18px] pb-5 md:px-[22px] md:pt-5 md:pb-[22px] desk:px-6 desk:pt-[22px] desk:pb-6" aria-labelledby="odd-totals"><p class="lbl" id="odd-totals">Records examined this week</p><p class="font-mono text-[26px] font-bold tracking-[-0.02em] text-ink md:text-[28px] desk:text-3xl">12 records</p><p class="font-display text-[13px] leading-normal text-ink/80">10 of these were judged on evidence the engine gathered; the rest carry none, which is what a typed record looks like. Training taps and manager-typed rows are counted here — a training tap is a real touch of a plaque, and a typed row carries no touch at all. Both are named below.</p><p class="font-display text-[13px] leading-normal text-ink/70">Two bases are in use below. 10 records were judged on evidence the engine gathered (an address match or a distance reading); 11 carry the rule snapshot the counter-gap, outside-the-venue and other-venue figures are read from. Each figure names the base it is out of.</p><div class="flex flex-wrap gap-2 pt-1.5"><span class="odd-chip tally--queued">1 of 10 verified by GPS alone · 10%</span> <span class="odd-chip tally--queued">1 of 11 read outside the venue · 9%</span> <span class="odd-chip tally--rejected">1 of 11 after a counter gap · 9%</span> </div><p class="mt-1.5 font-display text-[13px] leading-normal text-ink/80">0 of 1 also matched the venue&#39;s registered address range. None of them answered from inside the venue&#39;s own range, so none has that shape.</p>    <p class="font-display text-[13px] leading-normal text-ink/70">1 record carries no policy snapshot, so the counter-gap, outside-the-venue and other-venue counts cannot be answered for it. It is not counted as clean.</p></section> <section class="odd-callout odd-callout--warn" aria-labelledby="odd-unseen"><h2 class="font-display text-[15px] font-bold" id="odd-unseen">What this page does not see</h2><p>A plaque page that was opened and never used is not recorded anywhere, so the number of opened-but-unused pages is not on this screen. What IS on it is the counter gap above: the plaque's own chip counts every read, so collected pages leave a jump behind whether or not they are ever used.</p><p>Which device a person signed in from is not recorded either — only a coarse browser family, which every phone of the same make shares. So "several people activated from one device" cannot be told from "several people use the same model of phone", and this page does not guess at it.</p><p>The list of people who tap together compares each tap with the ONE before it at that venue. Where three people arrive in a burst, the first and the third are not paired with each other — the two neighbouring pairs are listed instead, so the group is visible but that one combination is not.</p></section> <div class="flex flex-col gap-4"><section class="odd-card order-1 md:order-none" aria-labelledby="odd-mix"><div class="flex flex-col gap-1"><div class="flex flex-wrap items-baseline justify-between gap-2"><h2 class="odd-title" id="odd-mix">Evidence mix by venue</h2><p class="font-mono text-xs text-ink/70">share of judged records · count = judged</p></div><p class="text-[13px] leading-normal text-ink/70">Every venue with taps this week, clean ones included. A high rate at one venue beside a low one at another is as likely to be a Wi-Fi problem as anything else — both are worth knowing.</p><p class="text-[13px] leading-normal text-ink/70">Each bar splits a venue's judged records by what matched: both its network and the distance reading, the network only, the distance only, or neither.</p></div><ul class="flex flex-col gap-3"><li class="flex flex-col gap-1"><div class="grid grid-cols-[minmax(0,1fr)_auto] items-center gap-x-2.5 gap-y-1 md:grid-cols-[150px_minmax(0,1fr)_84px] desk:grid-cols-[124px_minmax(0,1fr)_84px]"><p class="truncate text-[13px] font-bold text-ink" title="St Julians">St Julians</p><div class="col-span-2 row-start-2 flex h-3.5 overflow-hidden rounded bg-porcelain md:col-span-1 md:col-start-2 md:row-start-1 md:h-[18px]" role="img" aria-label="St Julians, 10 judged: 0 both, 0 network only, 1 distance only, 0 neither, 9 not split"><span class="h-full shrink-0 w-[10%] bg-saffron border-r border-paper"></span><span class="h-full shrink-0 w-[90%] bg-paper"></span></div><p class="col-start-2 row-start-1 whitespace-nowrap text-right font-mono text-xs text-ink md:col-start-3">10 judged</p></div><p class="font-mono text-[11px] leading-normal text-ink/70 md:pl-[160px] desk:pl-[134px]">0 both · 0 network only · 1 distance only · 0 neither · 9 not split</p><p class="font-mono text-[11px] leading-normal text-ink/70 md:pl-[160px] desk:pl-[134px]">12 records · 1 of 11 read outside the venue · 9%</p></li></ul><ul class="grid grid-cols-2 gap-x-3 gap-y-1.5 border-t border-dashed border-line pt-3 font-mono text-[11px] text-ink/70 md:flex md:flex-wrap md:gap-3.5 md:text-xs" aria-label="Legend"><li class="inline-flex items-center gap-1.5"><span class="size-3 flex-none rounded-[3px] bg-tappa-green" aria-hidden="true"></span>both</li><li class="inline-flex items-center gap-1.5"><span class="size-3 flex-none rounded-[3px] bg-tappa-green/50" aria-hidden="true"></span>network only</li><li class="inline-flex items-center gap-1.5"><span class="size-3 flex-none rounded-[3px] bg-saffron" aria-hidden="true"></span>distance only</li><li class="inline-flex items-center gap-1.5"><span class="size-3 flex-none rounded-[3px] bg-line ring-1 ring-inset ring-ink/50" aria-hidden="true"></span>neither</li><li class="inline-flex items-center gap-1.5"><span class="size-3 flex-none rounded-[3px] bg-paper ring-1 ring-inset ring-ink" aria-hidden="true"></span>not split</li></ul></section><div class="contents md:grid md:grid-cols-2 md:items-start md:gap-4"><div class="contents md:flex md:min-w-0 md:flex-col md:gap-4"><section class="odd-card order-5 md:order-none" aria-labelledby="odd-people"><div class="flex flex-col gap-1"><h2 class="odd-title" id="odd-people">Per person</h2><p class="text-[13px] leading-normal text-ink/70">Only people with at least one of these counts above zero appear here. The totals above cover everybody who tapped.</p></div><ul class="flex flex-col"><li class="flex flex-col gap-1.5 border-t border-dashed border-line py-2.5"><p class="flex justify-between gap-2"><span class="text-sm font-bold text-ink">Maria Borg</span> <span class="font-mono text-xs text-ink">4 records</span></p><p class="flex flex-wrap gap-1.5"><span class="odd-chip tally--queued">1 verified by GPS alone</span> </p></li></ul></section></div><div class="contents md:flex md:min-w-0 md:flex-col md:gap-4"><section class="odd-card order-4 md:order-none" aria-labelledby="odd-distance"><div class="flex flex-wrap items-baseline justify-between gap-2"><h2 class="odd-title" id="odd-distance">Verified by GPS alone</h2><p class="font-mono text-xs text-ink/70">no network match · per person</p></div><ul class="flex flex-col"><li class="grid min-h-9 grid-cols-[minmax(0,1fr)_80px_auto] items-center gap-2.5 border-t border-dashed border-line py-1 desk:grid-cols-[minmax(0,1fr)_120px_auto]"><span class="truncate text-sm font-bold text-ink" title="Maria Borg">Maria Borg</span> <span class="flex h-2 overflow-hidden rounded bg-porcelain" aria-hidden="true"><span class="h-full shrink-0 bg-saffron w-full"></span></span> <span class="min-w-7 text-right font-mono text-[13px] text-ink">1<span class="sr-only"> verified by GPS alone</span></span></li></ul></section><section class="odd-card order-6 md:order-none" aria-labelledby="odd-open"><div class="flex flex-col gap-1.5"><div class="flex flex-wrap items-baseline justify-between gap-2"><h2 class="odd-title" id="odd-open">Left open</h2><p class="font-mono text-xs text-ink/70">not counted in hours</p></div><p class="text-[13px] leading-normal text-ink/80">A check-in no checkout closed: the person's next record is another check-in, a checkout on a later business day or more than 18 hours on, or nothing yet. The Roll leaves the same check-ins open, so its count and this list agree — except when this list is shortened, or when a week is too busy for The Roll to read in full (The Roll then says so).</p><p class="text-xs leading-normal text-ink/70">Training taps are not in this list. A training tap is a check-in nothing ever closes, so counting it would add one false entry for every new starter.</p></div> <ul class="flex flex-col"><li class="flex flex-col gap-1.5 border-t border-dashed border-line py-3"><p class="flex flex-wrap items-center justify-between gap-2"><span class="text-sm font-bold text-ink">Joe</span> <span class="odd-chip odd-chip--open">open 5d</span></p><p class="font-mono text-[11px] text-ink/70">St Julians · IN Wed 9 Sep 09:00</p><p class="flex flex-wrap gap-1.5"><span class="odd-chip tally--queued">Still open</span> </p></li></ul></section></div></div><section class="odd-card order-7 md:order-none" aria-labelledby="odd-rules"><div class="flex flex-col gap-1"><h2 class="odd-title" id="odd-rules">Which rule decided</h2><p class="text-[13px] leading-normal text-ink/70">Every record names the rule that judged it. A rule firing is not a problem in itself; a rule firing far more than last week is worth a look.</p></div><ul class="flex flex-col gap-2.5"><li class="grid grid-cols-[minmax(0,1fr)_auto] items-center gap-x-3 gap-y-1 md:grid-cols-[220px_minmax(0,1fr)_96px]"><p class="flex min-w-0 flex-wrap gap-x-2 font-mono text-xs text-ink"><span class="break-all">base:ip-or-gps-ok</span> <span class="text-ink/70">baseline</span></p><span class="col-span-2 row-start-2 flex h-2 overflow-hidden rounded bg-ink/5 md:col-span-1 md:col-start-2 md:row-start-1 md:h-3 md:bg-porcelain" aria-hidden="true"><span class="h-full shrink-0 bg-ink w-full"></span></span><p class="col-start-2 row-start-1 whitespace-nowrap text-right font-mono text-xs text-ink md:col-start-3">10 records</p></li></ul></section></div></div></main><nav class="bar" aria-label="Panel sections, phone"><a href="/admin" class="bar-link"><span class="bar-pill"><svg class="nav-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 5h18"></path> <path d="M7.5 5v3M17.5 5v3"></path> <rect x="5" y="8" width="5" height="9" rx="1"></rect> <rect x="15" y="8" width="5" height="11" rx="1"></rect></svg></span> <span>Pass</span></a> <a href="/admin/review" class="bar-link"><span class="bar-pill"><svg class="nav-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 3v18"></path> <path d="M7 21h10"></path> <rect x="6" y="9" width="12" height="7" rx="1"></rect></svg></span> <span>Spike</span><span class="tab-count" aria-label="the number waiting for review could not be read">?</span></a> <a href="/admin/reports" class="bar-link"><span class="bar-pill"><svg class="nav-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 3h12v18l-2-1.5L14 21l-2-1.5L10 21l-2-1.5L6 21z"></path> <path d="M9 8h6M9 12h6"></path></svg></span> <span>Roll</span></a> <a href="/admin/employees" class="bar-link"><span class="bar-pill"><svg class="nav-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="9" cy="8" r="3.5"></circle> <path d="M2.5 20c.8-3.6 3.4-5.5 6.5-5.5s5.7 1.9 6.5 5.5"></path> <path d="M16 4.5a3.5 3.5 0 0 1 0 7M18 14.8c1.8.7 3 2.4 3.5 5.2"></path></svg></span> <span>People</span></a> <details class="bar-more"><summary class="bar-link"><span class="bar-pill"><svg class="nav-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="5" cy="12" r="1.6"></circle> <circle cx="12" cy="12" r="1.6"></circle> <circle cx="19" cy="12" r="1.6"></circle></svg></span> <span>More</span></summary><div class="bar-sheet"><ul class="sheet-list"><li><a href="/admin/locations" class="sheet-link"><svg class="nav-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z"></path> <circle cx="12" cy="9.5" r="2.5"></circle></svg><span>Venues &amp; plaques</span></a></li><li><a href="/admin/anomalies" class="sheet-link"><svg class="nav-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="6" cy="17" r="2"></circle> <circle cx="12" cy="10" r="2"></circle> <circle cx="18" cy="15" r="2"></circle> <path d="M15 3.5l5 5M20 3.5l-5 5"></path></svg><span>Odd shapes</span></a></li><li><a href="/admin/policies" class="sheet-link"><svg class="nav-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 7h10M18 7h2M4 17h4M12 17h8"></path> <circle cx="16" cy="7" r="2"></circle> <circle cx="10" cy="17" r="2"></circle></svg><span>Rules</span></a></li><li><a href="/admin/account" class="sheet-link"><svg class="nav-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 21V8l8-5 8 5v13"></path> <path d="M9 21v-6h6v6"></path></svg><span>Account</span></a></li></ul><div class="sheet-foot"><p class="text-sm text-ink/70">Signed in as <strong class="font-bold text-ink"></strong> · <span class="font-mono uppercase tracking-widest"></span></p><form method="post" action="/admin/logout"><button type="submit" class="btn btn--quiet w-full">Sign out</button></form></div></div></details></nav></div></body></html>