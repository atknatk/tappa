status: 400
content-security-policy: default-src 'none'; script-src 'self'; style-src 'self'; font-src 'self'; form-action 'self'; base-uri 'none'; frame-ancestors 'none'; connect-src 'self'
---
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"><meta name="robots" content="noindex, nofollow"><meta name="referrer" content="no-referrer"><title>Welcome — Taptime</title><link rel="stylesheet" href="/static/css/app.css"></head><body class="min-h-screen bg-porcelain text-ink antialiased"><main class="mx-auto flex w-full max-w-md flex-col gap-6 px-4 py-8"><header class="flex items-baseline justify-between"><span class="font-display text-lg font-bold tracking-tight text-tappa-green">taptime</span> <span class="font-mono text-[10px] uppercase tracking-widest text-ink/70">punchless</span></header><div class="wizard"><nav aria-label="Setup progress"><p class="docket-label">Step <span class="num">1</span> of <span class="num">3</span> · Welcome</p><ol class="mt-2 grid grid-cols-3 gap-1.5" role="list"><li class="wizard-segment wizard-segment--done" aria-current><span class="sr-only">Welcome</span></li><li class="wizard-segment"><span class="sr-only">Get ready</span></li><li class="wizard-segment"><span class="sr-only">Tap</span></li></ol></nav><section class="wizard-panel"><p class="docket-label">Kebab Factory Ltd</p><h1 class="mt-1 font-display text-3xl font-bold leading-tight tracking-tight text-ink"><span class="block">Hi Maria Borg</span> <span class="block text-ink/70">Let's set up your phone.</span></h1></section><section class="docket wizard-panel"><p class="font-display text-base text-ink/85">Kebab Factory Ltd uses Taptime to record your shifts. Each tap saves the time, your phone's IP address and, if your phone shares it, your location at that moment. Your location is never tracked between taps. No fingerprints, no face, no voice.</p></section><form method="post" action="/api/activate" class="wizard-actions"><input type="hidden" name="csrf" value="TESTcsrfTESTcsrfTESTcsrfTESTcsrfTESTcsrf123"> <p id="consent-error" class="border-l-4 border-tomato bg-paper px-4 py-3 text-sm font-bold text-ink">Please press Agree and continue so we know you have read this.</p><p class="text-center font-display text-sm text-ink/85">By continuing, you agree to the <a id="terms-open" href="#terms" class="hit-link terms-open">terms and privacy details.</a></p><button type="submit" name="consent" value="yes" class="tap-button" aria-describedby="consent-error">Agree and continue</button></form><section id="terms" class="terms-sheet" role="dialog" aria-modal="true" aria-labelledby="terms-title" tabindex="-1"><div class="terms-card"><div class="terms-scroll"><h2 id="terms-title" class="font-display text-xl font-bold tracking-tight text-ink">Terms and privacy</h2><h3 class="terms-heading">Who is responsible</h3><p class="terms-body">Kebab Factory Ltd is responsible for your attendance records. Taptime processes them on its behalf.</p><h3 class="terms-heading">What is recorded</h3><p class="terms-body">The time of each tap, the venue, your phone's IP address and, if your phone shares it, your location at that moment. A cookie keeps this phone signed in, so you don't need a password. Your location is never tracked between taps. No fingerprints, no face, no voice.</p><h3 class="terms-heading">Why</h3><p class="terms-body">To record your working hours for Kebab Factory Ltd.</p><p class="terms-body mt-4">For more information, visit:</p><a href="/legal/privacy" target="_blank" rel="noopener" class="terms-doc">Privacy policy</a> <a href="/legal/terms" target="_blank" rel="noopener" class="terms-doc">Terms of service</a></div><div class="terms-foot"><a href="#terms-open" class="terms-close">Close</a></div></div></section></div></main></body></html>