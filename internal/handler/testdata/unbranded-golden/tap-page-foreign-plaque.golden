status: 200
content-security-policy: default-src 'none'; script-src 'self'; style-src 'self'; font-src 'self'; form-action 'self'; base-uri 'none'; frame-ancestors 'none'
---
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"><meta name="robots" content="noindex, nofollow"><meta name="referrer" content="no-referrer"><title>Tap — Taptime</title><link rel="stylesheet" href="/static/css/app.css"><script src="/static/js/tap.js" defer></script></head><body class="min-h-screen bg-porcelain text-ink antialiased"><main class="mx-auto flex w-full max-w-md flex-col gap-6 px-4 py-8"><header class="flex items-baseline justify-between"><span class="font-display text-lg font-bold tracking-tight text-tappa-green">taptime</span> <span class="font-mono text-[10px] uppercase tracking-widest text-ink/70">punchless</span></header><section class="docket"><p class="docket-label">Tapping</p><h1 class="font-display text-3xl font-bold tracking-tight text-ink">Hello Maria Borg</h1></section><form method="post" action="/api/checkin" data-tap-form class="flex flex-col gap-4"><input type="hidden" name="ctx" value="{{TAP-CONTEXT}}"> <input type="hidden" name="lat" value="" data-tap-lat> <input type="hidden" name="lng" value="" data-tap-lng> <input type="hidden" name="acc" value="" data-tap-acc> <button type="submit" class="tap-button" data-tap-button>Tap</button></form></main></body></html>