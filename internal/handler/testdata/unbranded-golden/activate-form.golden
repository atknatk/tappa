status: 200
content-security-policy: default-src 'none'; script-src 'self'; style-src 'self'; font-src 'self'; form-action 'self'; base-uri 'none'; frame-ancestors 'none'; connect-src 'self'
---
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"><meta name="robots" content="noindex, nofollow"><meta name="referrer" content="no-referrer"><title>Welcome — Taptime</title><link rel="stylesheet" href="/static/css/app.css"></head><body class="min-h-screen bg-porcelain text-ink antialiased"><main class="mx-auto flex w-full max-w-md flex-col gap-6 px-4 py-8"><header class="flex items-baseline justify-between"><span class="font-display text-lg font-bold tracking-tight text-tappa-green">taptime</span> <span class="font-mono text-[10px] uppercase tracking-widest text-ink/70">punchless</span></header><div class="wizard"><nav aria-label="Setup progress"><p class="docket-label">Step <span class="num">1</span> of <span class="num">4</span> · Welcome</p><ol class="mt-2 grid grid-cols-4 gap-1.5" role="list"><li class="wizard-segment wizard-segment--done" aria-current><span class="sr-only">Welcome</span></li><li class="wizard-segment"><span class="sr-only">Privacy</span></li><li class="wizard-segment"><span class="sr-only">Get ready</span></li><li class="wizard-segment"><span class="sr-only">Tap</span></li></ol></nav><section class="wizard-panel"><p class="docket-label">Kebab Factory Ltd</p><h1 class="mt-1 font-display text-3xl font-bold leading-tight tracking-tight text-ink"><span class="block">Hi Maria Borg</span> <span class="block text-ink/70">Let's set up your phone.</span></h1><p class="mt-3 text-base text-ink/85">Kebab Factory Ltd uses Taptime to record your shifts. Setup takes about a minute, and there is nothing to install.</p></section><section class="docket wizard-panel"><p class="docket-label">How it works</p><ol class="mt-3 flex flex-col gap-4" role="list"><li class="flex gap-3"><span class="wizard-index">01</span><div><p class="font-display text-base font-bold tracking-tight">Tap the plaque</p><p class="mt-0.5 font-display text-sm text-ink/80">Hold the top of your phone against the Taptime plaque by the door. A page opens by itself.</p></div></li><li class="flex gap-3"><span class="wizard-index">02</span><div><p class="font-display text-base font-bold tracking-tight">Press one button</p><p class="mt-0.5 font-display text-sm text-ink/80">Taptime works out whether you are arriving or leaving, so you never have to choose.</p></div></li><li class="flex gap-3"><span class="wizard-index">03</span><div><p class="font-display text-base font-bold tracking-tight">Nothing in the background</p><p class="mt-0.5 font-display text-sm text-ink/80">No fingerprints, no face scan. Your location is read only at the moment you tap — never between taps.</p></div></li></ol></section><div class="wizard-actions"><a href="/activate?step=2" class="tap-button flex items-center justify-center">Next</a></div></div></main></body></html>