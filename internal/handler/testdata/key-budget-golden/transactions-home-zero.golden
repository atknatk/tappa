<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"><meta name="robots" content="noindex, nofollow"><meta name="referrer" content="no-referrer"><title>Panel — Taptime</title><link rel="stylesheet" href="/static/css/app.css"><script src="/static/vendor/htmx.min.js" defer></script></head><body class="min-h-screen bg-porcelain text-ink antialiased"><main class="mx-auto flex w-full max-w-5xl flex-col gap-6 px-4 py-6"><header class="flex items-baseline justify-between"><span class="font-display text-lg font-bold tracking-tight text-tappa-green">taptime</span> <span class="font-mono text-[10px] uppercase tracking-widest text-ink/70">punchless</span></header><div class="flex flex-wrap items-baseline justify-between gap-3"><div><p class="docket-label">Signed in as</p><p class="font-display text-xl font-bold tracking-tight"></p></div><div class="flex items-center gap-3"><span class="font-mono text-xs uppercase tracking-widest text-ink/70"></span><form method="post" action="/admin/logout"><button type="submit" class="btn btn--quiet">Sign out</button></form></div></div><nav class="tab-bar" aria-label="Panel sections"><a href="/admin" class="tab-link">Transactions</a><a href="/admin/review" class="tab-link">Review queue<span class="tab-count" aria-label="the number waiting for review could not be read">?</span></a><a href="/admin/employees" class="tab-link">Employees</a><a href="/admin/locations" class="tab-link">Locations &amp; Wall Tags</a><a href="/admin/reports" class="tab-link">Reports</a><a href="/admin/anomalies" class="tab-link">Anomalies</a><a href="/admin/policies" class="tab-link">Policies</a><a href="/admin/account" class="tab-link">Account</a></nav>         <p class="font-mono text-sm text-ink/85"> <span class="text-ink/70">· </span></p><form class="filter-bar" method="get" action="" role="search" aria-label="Filter transactions"><div class="filter-field"><label class="docket-label" for="filter-date">Day</label> <input class="filter-input" id="filter-date" type="date" name="date" value=""></div><div class="filter-field"><label class="docket-label" for="filter-location">Location</label> <select class="filter-input" id="filter-location" name="location"><option value="" selected>All locations</option> </select></div><div class="filter-field"><label class="docket-label" for="filter-department">Department</label> <select class="filter-input" id="filter-department" name="department"><option value="" selected>All departments</option> </select></div><div class="filter-field"><label class="docket-label" for="filter-employee">Employee</label><input class="filter-input" id="filter-employee" type="text" name="employee" value="" placeholder="Part of a name" autocomplete="off" spellcheck="false"></div><div class="filter-field"><label class="docket-label" for="filter-verdict">Verdict</label> <select class="filter-input" id="filter-verdict" name="verdict"><option value="" selected>Any verdict</option> </select></div><div class="filter-field"><label class="docket-label" for="filter-channel">Channel</label> <select class="filter-input" id="filter-channel" name="channel"><option value="" selected>Any channel</option> </select></div><div class="filter-actions"><button type="submit" class="btn btn--primary">Apply</button> </div></form> </main></body></html>