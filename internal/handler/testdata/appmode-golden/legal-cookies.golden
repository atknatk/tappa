<main id="main">
<div class="mx-auto w-full px-4 md:px-10 desk:max-w-[1180px] desk:px-[clamp(16px,3vw,40px)] [&amp;_:focus-visible]:outline [&amp;_:focus-visible]:outline-2 [&amp;_:focus-visible]:outline-offset-2 [&amp;_:focus-visible]:outline-ink pb-12 pt-5 md:pb-14 md:pt-7 desk:pb-16 desk:pt-10">
<div class="flex flex-col gap-6 desk:grid desk:grid-cols-[minmax(0,260px)_minmax(0,820px)] desk:items-start desk:gap-10">
<nav aria-label="Legal documents" class="flex flex-col gap-2.5">
<p class="lbl hidden desk:block">Legal
</p>
<ul class="grid grid-cols-2 gap-2 md:grid-cols-4 desk:flex desk:flex-col desk:gap-1.5">
<li class="min-w-0">
<a href="/legal/privacy" class="flex h-full min-h-14 flex-col gap-1.5 rounded-[14px] border border-line px-3 py-2.5 hover:border-ink active:border-ink active:bg-paper desk:px-4 desk:py-3.5">
