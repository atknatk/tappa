</span> 
<span class="self-start rounded-md border border-dashed border-saffron bg-saffron/10 px-1.5 py-0.5 font-mono text-[10px] font-bold uppercase tracking-[0.1em] text-ink">Not in force yet
</span>
</a>
</li>
<li class="min-w-0">
<a href="/legal/terms" class="flex h-full min-h-14 flex-col gap-1.5 rounded-[14px] border border-line px-3 py-2.5 hover:border-ink active:border-ink active:bg-paper desk:px-4 desk:py-3.5">
<span class="font-display text-sm font-bold text-ink desk:hidden">Terms
</span> 
<span class="hidden font-display text-[15px] font-bold text-ink desk:inline">Terms of service
</span> 
<span class="hidden font-mono text-[11px] text-ink/70 desk:block">/legal/terms
</span> 
<span class="self-start rounded-md border border-dashed border-saffron bg-saffron/10 px-1.5 py-0.5 font-mono text-[10px] font-bold uppercase tracking-[0.1em] text-ink">Not in force yet
</span>
</a>
</li>
<li class="min-w-0">
<a href="/legal/imprint" class="flex h-full min-h-14 flex-col gap-1.5 rounded-[14px] border border-line px-3 py-2.5 hover:border-ink active:border-ink active:bg-paper desk:px-4 desk:py-3.5">
<span class="font-display text-sm font-bold text-ink desk:hidden">Company details
</span> 
<span class="hidden font-display text-[15px] font-bold text-ink desk:inline">Company details
</span> 
<span class="hidden font-mono text-[11px] text-ink/70 desk:block">/legal/imprint
</span> 
<span class="self-start rounded-md border border-dashed border-saffron bg-saffron/10 px-1.5 py-0.5 font-mono text-[10px] font-bold uppercase tracking-[0.1em] text-ink">Not in force yet
</span>
</a>
</li>
<li class="min-w-0">
<a href="/legal/cookies" class="flex h-full min-h-14 flex-col gap-1.5 rounded-[14px] border-2 border-ink bg-paper px-3 py-2.5 desk:px-4 desk:py-3.5" aria-current="page">
<span class="font-display text-sm font-bold text-ink desk:hidden">Cookies
</span> 
<span class="hidden font-display text-[15px] font-bold text-ink desk:inline">Cookies
</span> 
<span class="hidden font-mono text-[11px] text-ink/70 desk:block">/legal/cookies
</span> 
<span class="self-start rounded-md border border-dashed border-saffron bg-saffron/10 px-1.5 py-0.5 font-mono text-[10px] font-bold uppercase tracking-[0.1em] text-ink">Not in force yet
</span>
</a>
