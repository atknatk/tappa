status: 400
content-security-policy: default-src 'none'; style-src 'self'; font-src 'self'; form-action 'self'; base-uri 'none'; frame-ancestors 'none'
---

<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="robots" content="noindex, nofollow">
<meta name="referrer" content="no-referrer">
<title>Taptime
</title>
<meta name="author" content="Codevera Labs">
<link rel="author" href="https://codeveralabs.com">
<link rel="stylesheet" href="/static/css/app.css">
</head>
<body class="min-h-screen bg-porcelain text-ink antialiased">
<div class="lp lp-topStill">
<a class="lp-skip" href="#main">Skip to content
</a>
<header class="lp-head" aria-label="Site">
<div class="lp-headIn">
<a class="lp-mark" href="/">
<span class="lp-markWords">
<span class="lp-markName">taptime
<svg class="lp-markStop" viewBox="0 0 168 300" aria-hidden="true" focusable="false">
<path d="M46 0H122A46 46 0 0 1 168 46V254A46 46 0 0 1 122 300H46A46 46 0 0 1 0 254V46A46 46 0 0 1 46 0Z">
</path>
</svg>
</span>
<span class="lp-markTag">punchless
</span>
</span>
</a>
<div class="lp-headEnd">
<nav class="lp-headNav" aria-label="Primary">
<a class="navlink" href="/product">Product
</a> 
<a class="navlink" href="/security">Security
</a> 
<a class="navlink" href="/pricing">Pricing
</a> 
<span class="lp-headSep" aria-hidden="true">
</span> 
<span class="lp-signinPair">
<span class="lp-signinAsk">Already with Taptime?
</span> 
<a class="lp-signin" href="/admin/login">Sign in
</a>
</span> 
</nav>
<details class="menu">
<summary>
<span class="mopen">Menu
</span>
<span class="mclose">Close
</span>
</summary>
<nav aria-label="Menu">
<span class="lp-lbl lp-menuHead">Pages
</span>
<div class="lp-menuList">
<a class="mlink" href="/product">
<span>Product tour
</span> 
<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
<path d="M9 6l6 6-6 6">
</path>
</svg>
</a>
<a class="mlink" href="/security">
<span>Security
</span> 
<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
<path d="M9 6l6 6-6 6">
</path>
</svg>
</a>
<a class="mlink" href="/pricing">
<span>Pricing
</span> 
<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
<path d="M9 6l6 6-6 6">
</path>
</svg>
</a>
<a class="mlink" href="/for/restaurants">
<span>For restaurants &amp; bars
</span> 
<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
<path d="M9 6l6 6-6 6">
</path>
</svg>
</a>
<a class="mlink" href="/for/production">
<span>For production &amp; facilities
</span> 
<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
<path d="M9 6l6 6-6 6">
</path>
</svg>
</a>
<a class="mlink" href="/docs/api">
<span>API docs
</span> 
<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
<path d="M9 6l6 6-6 6">
</path>
</svg>
</a>
</div>
</nav>
</details>
</div>
</div>
</header>
</div>
<main id="main">
<section class="mx-auto w-full px-4 md:px-10 desk:max-w-[1180px] desk:px-[clamp(16px,3vw,40px)] [&amp;_:focus-visible]:outline [&amp;_:focus-visible]:outline-2 [&amp;_:focus-visible]:outline-offset-2 [&amp;_:focus-visible]:outline-ink pb-10 pt-6 md:pb-12 md:pt-7 desk:pb-16 desk:pt-10">
<div class="mx-auto flex w-full max-w-[680px] flex-col gap-6">
<div class="flex min-w-0 flex-col gap-6 md:rounded-[18px] md:border md:border-line md:bg-paper md:px-8 md:py-[30px] desk:gap-[26px] desk:p-10">
<div role="alert" class="flex flex-col gap-2 rounded-[14px] border-2 border-tomato bg-tomato/5 px-4 py-4 md:px-5 md:py-[18px]">
<h1 class="font-display text-[21px] font-bold tracking-tight text-ink md:text-[22px]">Your browser didn&#39;t keep the form
</h1>
<p class="text-[15px] leading-normal text-ink">Taptime needs a cookie to carry your answers from one step to the next, and this browser is not storing one.
</p>
<p class="text-sm leading-normal text-ink/70">Allow cookies for this site, or turn off private browsing, then start again.
</p>
</div>
<div>
<a href="/signup" class="btn btn--primary w-full rounded-xl px-6 md:w-auto focus:ring-0 active:bg-ink active:shadow-[inset_0_0_0_2px_theme(colors.tappa-green)] active:translate-y-px">Start again
</a>
</div>
</div>
</div>
</section>
</main>
<div class="lp">
<footer class="lp-foot">
<div class="lp-footIn">
<div class="lp-footAbout">
<span class="lp-footMark">
<svg class="lp-footSign" viewBox="26 -650 612 650" aria-hidden="true" focusable="false">
<path d="M260 0Q211 0 180.5 -30.5Q150 -61 150 -112V-392H26V-496H150V-650H276V-496H412V-392H276V-134Q276 -104 304 -104H400V0Z">
</path>
<path d="M516 -300H592A46 46 0 0 1 638 -254V-46A46 46 0 0 1 592 0H516A46 46 0 0 1 470 -46V-254A46 46 0 0 1 516 -300Z">
</path>
</svg>
<span class="lp-footCopy">© 2026 Taptime · Malta
</span>
</span> 
<span class="lp-footLine">tap in · tap out · that's it
</span>
<div class="lp-footNote">
<span class="lp-lbl">Taptime
</span>
<p>Punchless time and attendance. Taptime collects no biometric data of any kind: no fingerprints, no face, no voice. A phone's position is read only at the moment somebody presses the button.
</p>
</div>
<p class="lp-footLine">Built by 
<a href="https://codeveralabs.com" rel="noopener" class="flink">Codevera Labs
</a>
</p>
</div>
<nav class="fcol" aria-label="Product">
<span class="lp-lbl lp-fcolHead">Product
</span> 
<a href="/product">Product tour
</a>
<a href="/security">Security
</a>
<a href="/pricing">Pricing
</a>
<a href="/for/restaurants">For restaurants &amp; bars
</a>
<a href="/for/production">For production &amp; facilities
</a>
<a href="/docs/api">API docs
</a>
</nav>
<nav class="fcol" aria-label="Legal">
<span class="lp-lbl lp-fcolHead">Legal
</span> 
<a href="/legal/privacy">Privacy
</a>
<a href="/legal/terms">Terms
</a>
<a href="/legal/imprint">Company details
</a>
<a href="/legal/cookies">Cookies
</a>
</nav>
</div>
</footer>
</div>
</body>
</html>