# Tappa — ortam degiskenleri sablonu.
# Kopyala: cp .env.example .env   (.env asla commit edilmez)

# --- HTTP ---
TAPPA_ADDR=:8080
TAPPA_BASE_URL=http://localhost:8080
# Reverse proxy arkasindaysa gercek istemci IP'si buradan cozulur.
# Bos birakma: proof-of-place (statik IP) yanlis calisir.
TAPPA_TRUSTED_PROXIES=127.0.0.1/32

# --- Database ---
# Uygulama RLS'e tabi, NON-SUPERUSER, BYPASSRLS'siz rol ile baglanir.
DATABASE_URL=postgres://tappa_app:tappa@localhost:5432/tappa?sslmode=disable
# Migration ayri, yetkili rol ile calisir.
DATABASE_MIGRATE_URL=postgres://tappa_owner:tappa@localhost:5432/tappa?sslmode=disable

# --- Session / crypto ---
# 32 byte, base64. Uret: openssl rand -base64 32
TAPPA_SESSION_HMAC_KEY=
# NTAG AES anahtarlarini saran master key (envelope encryption). 32 byte base64.
TAPPA_TAG_KEK=

# --- Karar motoru esikleri (bkz. CLAUDE.md §5) ---
TAPPA_GPS_RADIUS_M=150
TAPPA_DEBOUNCE_SECONDS=60

# --- Web push (VAPID) — roadmap 4 ---
TAPPA_VAPID_PUBLIC_KEY=
TAPPA_VAPID_PRIVATE_KEY=

# --- Gozlemlenebilirlik ---
TAPPA_LOG_LEVEL=debug
TAPPA_ENV=dev
