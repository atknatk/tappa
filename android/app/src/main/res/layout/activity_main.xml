<?xml version="1.0" encoding="utf-8"?>
<!--
  One screen. The panel is the operator tool; the WebView sits on top of it only
  while signing in. tappa-brand: porcelain ground, ink text, paper card with one
  `line` border. No decoration.

  TYPOGRAPHY DEVIATION, NAMED: the brand asks for Space Grotesk (display) and IBM
  Plex Mono (data). This layout uses the platform's `sans-serif` and `monospace`
  (Roboto and the system mono on the target phone). Bundling the two faces would add
  ~77 KiB of woff2 already vendored under web/static/fonts/ plus a font-resource
  step; an operator tool used to encode a handful of plaques did not justify it in
  this round. README.md carries the same note; the roles (sans for words, mono for
  data) are kept even though the faces are not.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/porcelain"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom"
            android:baselineAligned="false">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/ink"
                android:textSize="24sp"
                android:textStyle="bold"
                android:letterSpacing="-0.02"
                android:fontFamily="sans-serif" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginBottom="4dp"
                android:text="@string/subtitle"
                android:textColor="@color/ink"
                android:textSize="11sp"
                android:letterSpacing="0.12"
                android:fontFamily="monospace" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/serverRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical">

            <EditText
                android:id="@+id/serverField"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/field"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:hint="@string/server_hint"
                android:importantForAutofill="no"
                android:inputType="textUri|textNoSuggestions"
                android:imeOptions="actionDone"
                android:maxLines="1"
                android:textColor="@color/ink"
                android:textColorHint="@color/ink_hint"
                android:textSize="14sp"
                android:fontFamily="monospace" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <Button
                    android:id="@+id/saveButton"
                    style="@style/Button.Quiet"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="@string/save" />

                <Button
                    android:id="@+id/checkButton"
                    style="@style/Button.Quiet"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="@string/check" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/docket"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/stamp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:rotation="-6"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:textColor="@color/ink"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.18"
                android:fontFamily="sans-serif" />

            <TextView
                android:id="@+id/headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/ink"
                android:textSize="22sp"
                android:textStyle="bold"
                android:letterSpacing="-0.02"
                android:fontFamily="sans-serif" />

            <TextView
                android:id="@+id/message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/ink"
                android:textSize="16sp"
                android:lineSpacingMultiplier="1.2"
                android:fontFamily="sans-serif" />

            <TextView
                android:id="@+id/detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textColor="@color/ink"
                android:textSize="14sp"
                android:fontFamily="monospace" />
        </LinearLayout>

        <Button
            android:id="@+id/primaryButton"
            style="@style/Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/sign_in" />

        <Button
            android:id="@+id/signOutButton"
            style="@style/Button.Quiet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/sign_out" />
    </LinearLayout>

    <WebView
        android:id="@+id/web"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />
</FrameLayout>
